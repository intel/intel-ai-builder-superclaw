{
  "name": "openwork-server",
  "version": "0.11.169",
  "description": "Filesystem-backed API for OpenWork remote clients",
  "type": "module",
  "bin": {
    "openwork-server": "dist/bin/openwork-server"
  },
  "scripts": {
    "dev": "OPENWORK_DEV_MODE=1 bun src/cli.ts",
    "test": "bun test",
    "test:ci": "bun test",
    "build": "tsc -p tsconfig.json",
    "build:bin": "bun build --compile src/cli.ts --outfile dist/bin/openwork-server",
    "build:bin:all": "bun ./script/build.ts --outdir dist/bin --target bun-darwin-arm64 --target bun-darwin-x64 --target bun-linux-x64 --target bun-linux-arm64 --target bun-windows-x64",
    "start": "bun dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "prepack": "node -e \"for (const f of ['LICENSE', 'NOTICE']) require('fs').copyFileSync('../../' + f, f)\"",
    "prepublishOnly": "pnpm build:bin"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "keywords": [
    "openwork",
    "server",
    "opencode",
    "headless",
    "cli"
  ],
  "license": "Apache-2.0 AND MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@different-ai/openwork-contracts": "workspace:*",
    "@different-ai/openwork-mcp-policy": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.205.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.205.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.205.0",
    "@opentelemetry/resources": "^2.1.0",
    "@opentelemetry/sdk-logs": "^0.205.0",
    "@opentelemetry/sdk-metrics": "^2.1.0",
    "@opentelemetry/semantic-conventions": "^1.37.0",
    "jsonc-parser": "^3.2.1",
    "minimatch": "^11.0.1",
    "yaml": "^2.8.4"
  },
  "devDependencies": {
    "@types/minimatch": "^5.1.2",
    "@types/node": "^22.10.2",
    "bun-types": "^1.3.6",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@10.34.3"
}
