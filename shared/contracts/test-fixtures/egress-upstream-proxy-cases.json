{
  "_comment": [
    "Golden table for the upstream proxy a planner is given (design D4): which inputs are accepted, and",
    "the addresses a plan's permit then carries. Read by",
    "shared/contracts/src/__tests__/egress-network-connector.test.ts (EgressUpstreamProxySchema) and by",
    "host/sandbox_policy/tests/test_egress_plan.py (the Python planner, which refuses the same inputs as",
    "upstream_proxy_shape_invalid). `addresses` null means refused; otherwise it is what",
    "egressUpstreamPermitAddresses gives: IPv4 before IPv6 and each family by value, every address in",
    "the spelling the descriptor's ranges use. So a permit changes only with the set of addresses, not",
    "their order or spelling. An address given twice, and an IPv4 address spelled v4-mapped, are",
    "refused: the Sandbox Manager deduplicates and converts before it plans, so either is a producer bug."
  ],
  "cases": [
    {
      "name": "one address per family",
      "upstream_proxy": { "addresses": ["10.0.0.8", "fd00::8"], "port": 8080 },
      "addresses": ["10.0.0.8", "fd00:0000:0000:0000:0000:0000:0000:0008"]
    },
    {
      "name": "a public address",
      "upstream_proxy": { "addresses": ["93.184.215.14"], "port": 3128 },
      "addresses": ["93.184.215.14"]
    },
    {
      "name": "an upper-case spelling",
      "upstream_proxy": { "addresses": ["FD00::8"], "port": 8080 },
      "addresses": ["fd00:0000:0000:0000:0000:0000:0000:0008"]
    },
    {
      "name": "the fully expanded spelling",
      "upstream_proxy": { "addresses": ["fd00:0000:0000:0000:0000:0000:0000:0008"], "port": 8080 },
      "addresses": ["fd00:0000:0000:0000:0000:0000:0000:0008"]
    },
    {
      "name": "an embedded IPv4 tail on an address that is not v4-mapped",
      "upstream_proxy": { "addresses": ["2001:db8::10.0.0.8"], "port": 8080 },
      "addresses": ["2001:0db8:0000:0000:0000:0000:0a00:0008"]
    },
    {
      "name": "addresses out of order",
      "upstream_proxy": { "addresses": ["fd00::8", "10.0.0.9", "10.0.0.8"], "port": 8080 },
      "addresses": ["10.0.0.8", "10.0.0.9", "fd00:0000:0000:0000:0000:0000:0000:0008"]
    },
    {
      "name": "IPv4 ordered by value, not by text",
      "upstream_proxy": { "addresses": ["10.0.0.10", "10.0.0.9", "9.0.0.1"], "port": 8080 },
      "addresses": ["9.0.0.1", "10.0.0.9", "10.0.0.10"]
    },
    {
      "name": "IPv6 ordered by value, not by text",
      "upstream_proxy": { "addresses": ["fd00::10", "fd00::9", "fd00::a"], "port": 8080 },
      "addresses": [
        "fd00:0000:0000:0000:0000:0000:0000:0009",
        "fd00:0000:0000:0000:0000:0000:0000:000a",
        "fd00:0000:0000:0000:0000:0000:0000:0010"
      ]
    },
    {
      "name": "the most addresses one proxy may have",
      "upstream_proxy": {
        "addresses": [
          "10.0.0.1",
          "10.0.0.2",
          "10.0.0.3",
          "10.0.0.4",
          "10.0.0.5",
          "10.0.0.6",
          "10.0.0.7",
          "10.0.0.8"
        ],
        "port": 8080
      },
      "addresses": [
        "10.0.0.1",
        "10.0.0.2",
        "10.0.0.3",
        "10.0.0.4",
        "10.0.0.5",
        "10.0.0.6",
        "10.0.0.7",
        "10.0.0.8"
      ]
    },
    {
      "name": "the lowest port",
      "upstream_proxy": { "addresses": ["10.0.0.8"], "port": 1 },
      "addresses": ["10.0.0.8"]
    },
    {
      "name": "the highest port",
      "upstream_proxy": { "addresses": ["10.0.0.8"], "port": 65535 },
      "addresses": ["10.0.0.8"]
    },
    {
      "name": "a host name",
      "upstream_proxy": { "addresses": ["proxy.example.com"], "port": 8080 },
      "addresses": null
    },
    {
      "name": "IPv4 loopback",
      "upstream_proxy": { "addresses": ["127.0.0.1"], "port": 8080 },
      "addresses": null
    },
    {
      "name": "IPv4 loopback other than 127.0.0.1",
      "upstream_proxy": { "addresses": ["127.1.2.3"], "port": 8080 },
      "addresses": null
    },
    {
      "name": "IPv6 loopback",
      "upstream_proxy": { "addresses": ["::1"], "port": 8080 },
      "addresses": null
    },
    {
      "name": "v4-mapped loopback",
      "upstream_proxy": { "addresses": ["::ffff:127.0.0.1"], "port": 8080 },
      "addresses": null
    },
    {
      "name": "an IPv4 address spelled v4-mapped",
      "upstream_proxy": { "addresses": ["::ffff:10.0.0.8"], "port": 8080 },
      "addresses": null
    },
    {
      "name": "an IPv4 address and its v4-mapped spelling",
      "upstream_proxy": { "addresses": ["::ffff:10.0.0.8", "10.0.0.8"], "port": 8080 },
      "addresses": null
    },
    {
      "name": "one address spelled twice",
      "upstream_proxy": { "addresses": ["fd00::8", "fd00:0:0:0:0:0:0:8"], "port": 8080 },
      "addresses": null
    },
    {
      "name": "loopback beside an address that is not",
      "upstream_proxy": { "addresses": ["10.0.0.8", "127.0.0.1"], "port": 8080 },
      "addresses": null
    },
    {
      "name": "a zone index",
      "upstream_proxy": { "addresses": ["fe80::1%3"], "port": 8080 },
      "addresses": null
    },
    {
      "name": "no address",
      "upstream_proxy": { "addresses": [], "port": 8080 },
      "addresses": null
    },
    {
      "name": "one address more than the contract allows",
      "upstream_proxy": {
        "addresses": [
          "10.0.0.1",
          "10.0.0.2",
          "10.0.0.3",
          "10.0.0.4",
          "10.0.0.5",
          "10.0.0.6",
          "10.0.0.7",
          "10.0.0.8",
          "10.0.0.9"
        ],
        "port": 8080
      },
      "addresses": null
    },
    {
      "name": "a leading zero",
      "upstream_proxy": { "addresses": ["010.0.0.8"], "port": 8080 },
      "addresses": null
    },
    {
      "name": "a prefix",
      "upstream_proxy": { "addresses": ["10.0.0.0/8"], "port": 8080 },
      "addresses": null
    },
    {
      "name": "surrounding white space",
      "upstream_proxy": { "addresses": [" 10.0.0.8"], "port": 8080 },
      "addresses": null
    },
    {
      "name": "an address given as a number",
      "upstream_proxy": { "addresses": [167772168], "port": 8080 },
      "addresses": null
    },
    {
      "name": "port zero",
      "upstream_proxy": { "addresses": ["10.0.0.8"], "port": 0 },
      "addresses": null
    },
    {
      "name": "a port past the range",
      "upstream_proxy": { "addresses": ["10.0.0.8"], "port": 65536 },
      "addresses": null
    },
    {
      "name": "a port given as text",
      "upstream_proxy": { "addresses": ["10.0.0.8"], "port": "8080" },
      "addresses": null
    },
    {
      "name": "a port given as a boolean",
      "upstream_proxy": { "addresses": ["10.0.0.8"], "port": true },
      "addresses": null
    },
    {
      "name": "no port",
      "upstream_proxy": { "addresses": ["10.0.0.8"] },
      "addresses": null
    },
    {
      "name": "a field the contract does not have",
      "upstream_proxy": { "addresses": ["10.0.0.8"], "port": 8080, "username": "proxy-user" },
      "addresses": null
    },
    {
      "name": "a list instead of an object",
      "upstream_proxy": ["10.0.0.8", 8080],
      "addresses": null
    }
  ]
}
