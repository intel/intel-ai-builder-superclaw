      "expected_reasons": ["member_not_readable"]
    },
    {
      "name": "an executable role that may not execute",
      "note": "The role says the file is run; the access must agree or the launch is a lie.",
      "overrides": {
        "members": [
          {
            "path": "main.exe",
            "role": "supervisor_executable",
            "requirement": "required",
            "isolation_tier": "bootstrap",
            "access": { "read": true, "execute": true }
          },
          {
            "path": "runtime.exe",
            "role": "runtime_executable",
            "requirement": "required",
            "isolation_tier": "file_tool",
            "access": { "read": true, "execute": false }
          },
          {
            "path": "shell/sh.exe",
            "role": "shell_executable",
            "requirement": "required_when_verified",
            "isolation_tier": "file_tool",
            "access": { "read": true, "execute": true }
          },
          {
            "path": "config-source/opencode.jsonc",
            "role": "config_source",
            "requirement": "required",
