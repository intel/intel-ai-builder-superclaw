    },
    {
      "name": "an env name ending in a newline",
      "note": "Python's `$` matches before one trailing newline and JavaScript's does not, so an unanchored mirror accepts here what the source of truth refuses.",
      "overrides": {
        "launch": {
          "program_member": "main.exe",
          "argv_groups": [
            { "tokens": ["serve", "--openwork-port", "{{supervisor_port}}"], "present_member": null }
