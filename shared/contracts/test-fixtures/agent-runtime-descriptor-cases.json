{
  "note": "Golden refusal table for the agent runtime descriptor. Read by shared/contracts/src/__tests__/agent-runtime-descriptor.test.ts and host/sandbox_manager/tests/unit/test_agent_runtime_rules.py, so both implementations answer the same table. Each case replaces whole top-level fields of `base` and lists every reason the descriptor must be refused for.",
  "base": {
    "contract_version": 1,
    "runtime_id": "opencode",
    "runtime_version_pin": { "source": "payload_manifest", "field": "payload_version" },
    "members": [
      {
        "path": "main.exe",
        "role": "supervisor_executable",
        "requirement": "required",
        "isolation_tier": "bootstrap",
        "access": { "read": true, "execute": true }
      },
      {
        "path": "runtime.exe",
        "role": "runtime_executable",
        "requirement": "required",
        "isolation_tier": "file_tool",
        "access": { "read": true, "execute": true }
      },
      {
        "path": "shell/sh.exe",
        "role": "shell_executable",
        "requirement": "required_when_verified",
        "isolation_tier": "file_tool",
        "access": { "read": true, "execute": true }
      },
      {
        "path": "config-source/opencode.jsonc",
        "role": "config_source",
        "requirement": "required",
        "isolation_tier": "bootstrap",
        "access": { "read": true, "execute": false }
      }
    ],
    "launch": {
      "program_member": "main.exe",
      "argv_groups": [
        { "tokens": ["serve", "--openwork-port", "{{supervisor_port}}"], "present_member": null },
        { "tokens": ["--runtime-bin", "{{member:runtime.exe}}"], "present_member": null }
      ],
      "env_template": { "RUNTIME_CONFIG_DIR": "{{state_config_dir}}/opencode" }
    },
    "readiness_probe": {
      "kind": "http_get",
      "host_placeholder": "loopback_host",
      "port_placeholder": "supervisor_port",
      "path": "/health",
      "timeout_seconds": 60,
      "poll_interval_seconds": 0.5
    },
    "shutdown": { "kind": "process_tree_kill", "grace_seconds": 5, "job_object_backstop": true },
    "adapters": { "config_projection": "opencode_jsonc_extract", "guard": "native_pinned_shell" }
  },
  "cases": [
    {
      "name": "the base descriptor",
      "note": "The synthetic base must be legal, else every other case proves nothing.",
      "overrides": {},
      "expected_reasons": []
    },
    {
      "name": "a runtime with no members",
      "note": "A payload-backed runtime that declares nothing cannot be checked against a payload.",
      "overrides": { "members": [] },
      "expected_reasons": ["member_list_empty"]
    },
    {
      "name": "the same path declared twice",
      "note": "Two roles for one file make the requirement and the access of that file ambiguous.",
      "overrides": {
        "members": [
          {
            "path": "main.exe",
            "role": "supervisor_executable",
            "requirement": "required",
            "isolation_tier": "bootstrap",
            "access": { "read": true, "execute": true }
          },
          {
            "path": "runtime.exe",
            "role": "runtime_executable",
            "requirement": "required",
            "isolation_tier": "file_tool",
            "access": { "read": true, "execute": true }
          },
          {
            "path": "shell/sh.exe",
            "role": "shell_executable",
            "requirement": "required_when_verified",
            "isolation_tier": "file_tool",
            "access": { "read": true, "execute": true }
          },
          {
            "path": "config-source/opencode.jsonc",
            "role": "config_source",
            "requirement": "required",
            "isolation_tier": "bootstrap",
            "access": { "read": true, "execute": false }
          },
          {
            "path": "hooks/probe.py",
            "role": "sidecar_script",
            "requirement": "required_when_verified",
            "isolation_tier": "bootstrap",
            "access": { "read": true, "execute": false }
          },
          {
            "path": "hooks/probe.py",
            "role": "sidecar_script",
            "requirement": "required_when_verified",
            "isolation_tier": "bootstrap",
            "access": { "read": true, "execute": false }
          }
        ]
      },
      "expected_reasons": ["duplicate_member_path"]
    },
    {
      "name": "a member path spelled for one platform",
      "note": "Member paths are payload-relative POSIX so the same descriptor resolves everywhere.",
      "overrides": {
        "members": [
          {
            "path": "main.exe",
            "role": "supervisor_executable",
            "requirement": "required",
            "isolation_tier": "bootstrap",
            "access": { "read": true, "execute": true }
          },
          {
            "path": "runtime.exe",
            "role": "runtime_executable",
            "requirement": "required",
            "isolation_tier": "file_tool",
            "access": { "read": true, "execute": true }
          },
          {
            "path": "shell/sh.exe",
            "role": "shell_executable",
            "requirement": "required_when_verified",
            "isolation_tier": "file_tool",
            "access": { "read": true, "execute": true }
          },
          {
            "path": "config-source/opencode.jsonc",
            "role": "config_source",
            "requirement": "required",
            "isolation_tier": "bootstrap",
            "access": { "read": true, "execute": false }
          },
          {
            "path": "hooks\\probe.py",
            "role": "sidecar_script",
            "requirement": "required_when_verified",
            "isolation_tier": "bootstrap",
            "access": { "read": true, "execute": false }
          }
        ]
      },
      "expected_reasons": ["member_path_not_posix_relative"]
    },
    {
      "name": "two supervisors",
      "note": "A singleton role names one file; two of them make the launch program ambiguous.",
      "overrides": {
        "members": [
          {
            "path": "main.exe",
            "role": "supervisor_executable",
            "requirement": "required",
            "isolation_tier": "bootstrap",
            "access": { "read": true, "execute": true }
          },
          {
            "path": "main-alt.exe",
            "role": "supervisor_executable",
            "requirement": "required",
            "isolation_tier": "bootstrap",
            "access": { "read": true, "execute": true }
          },
          {
            "path": "runtime.exe",
            "role": "runtime_executable",
            "requirement": "required",
            "isolation_tier": "file_tool",
            "access": { "read": true, "execute": true }
          },
          {
            "path": "shell/sh.exe",
            "role": "shell_executable",
            "requirement": "required_when_verified",
            "isolation_tier": "file_tool",
            "access": { "read": true, "execute": true }
          },
          {
            "path": "config-source/opencode.jsonc",
