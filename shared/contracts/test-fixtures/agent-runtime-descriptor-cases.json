    },
    {
      "name": "a launch program that is not a declared member",
      "note": "The spawned program must be covered by the same member rules as everything else.",
      "overrides": {
        "launch": {
          "program_member": "ghost.exe",
          "argv_groups": [
            { "tokens": ["serve", "--openwork-port", "{{supervisor_port}}"], "present_member": null }
