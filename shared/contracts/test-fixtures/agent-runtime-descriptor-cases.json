      "expected_reasons": ["executable_role_not_marked_executable"]
    },
    {
      "name": "config data marked executable",
      "note": "Execute on a data member widens the payload's attack surface for nothing.",
      "overrides": {
        "members": [
          {
            "path": "main.exe",
            "role": "supervisor_executable",
            "requirement": "required",
            "isolation_tier": "bootstrap",
            "access": { "read": true, "execute": true }
          },
          {
            "path": "runtime.exe",
            "role": "runtime_executable",
