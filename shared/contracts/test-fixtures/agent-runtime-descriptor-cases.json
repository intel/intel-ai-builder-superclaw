    },
    {
      "name": "an argv token outside the template grammar",
      "overrides": {
        "launch": {
          "program_member": "main.exe",
          "argv_groups": [
            { "tokens": ["serve", "--openwork-port", "{{supervisor_port}}"], "present_member": null },
            { "tokens": ["--home", "{{user_home}}"], "present_member": null }
          ],
          "env_template": {}
        }
      },
      "expected_reasons": ["template_token_shape_invalid"]
    },
    {
      "name": "an argv token naming an undeclared member",
      "note": "Every path the launch passes must be a member, or the payload check cannot cover it.",
      "overrides": {
        "launch": {
          "program_member": "main.exe",
          "argv_groups": [
            { "tokens": ["serve", "--openwork-port", "{{supervisor_port}}"], "present_member": null },
