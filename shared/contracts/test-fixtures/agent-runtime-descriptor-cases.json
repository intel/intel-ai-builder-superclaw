      "expected_reasons": ["program_member_not_declared"]
    },
    {
      "name": "a launch program declared non-executable",
      "overrides": {
        "launch": {
          "program_member": "config-source/opencode.jsonc",
          "argv_groups": [
            { "tokens": ["serve", "--openwork-port", "{{supervisor_port}}"], "present_member": null }
          ],
          "env_template": {}
        }
      },
      "expected_reasons": ["program_member_not_executable"]
    },
    {
      "name": "a launch program that a payload may omit",
      "note": "Nothing launches at all without it, so it cannot be conditionally present.",
      "overrides": {
        "launch": {
          "program_member": "shell/sh.exe",
          "argv_groups": [
            { "tokens": ["serve", "--openwork-port", "{{supervisor_port}}"], "present_member": null }
