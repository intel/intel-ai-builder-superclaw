    },
    {
      "name": "a role filed under the wrong isolation tier",
      "note": "The tier is derived from the role, so a hand-written mismatch is a typo, not a choice.",
      "overrides": {
        "members": [
          {
            "path": "main.exe",
            "role": "supervisor_executable",
            "requirement": "required",
            "isolation_tier": "bootstrap",
            "access": { "read": true, "execute": true }
          },
          {
            "path": "runtime.exe",
            "role": "runtime_executable",
            "requirement": "required",
