{
  "$id": "https://different.ai/openwork-contracts/egress-policy-refusal.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": 4,
      "type": "number"
    },
    "refusals": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "locator": {
            "additionalProperties": false,
            "properties": {
              "address_family": {
                "anyOf": [
                  {
                    "enum": [
                      "ipv4",
                      "ipv6"
                    ],
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "endpoint": {
                "anyOf": [
                  {
                    "enum": [
                      "llmrouter_manager",
                      "sandbox_manager",
                      "security_manager_data_plane",
                      "service_hub",
                      "openwork_server",
                      "opencode",
                      "intent_classifier",
                      "deep_research_sidecar",
                      "opencode_router",
                      "connector",
                      "egress_proxy_shell",
                      "egress_proxy_channel"
                    ],
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "layer_authority": {
                "anyOf": [
                  {
                    "enum": [
                      "primary",
                      "supplementary"
                    ],
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "port": {
                "anyOf": [
                  {
                    "maximum": 65535,
                    "minimum": 1,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "precondition": {
                "anyOf": [
                  {
                    "enum": [
                      "base_filtering_engine_running",
                      "dynamic_port_range_known",
                      "declared_ports_outside_dynamic_port_range",
                      "sublayer_weight_uncontested"
                    ],
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "rule_class": {
                "anyOf": [
                  {
                    "enum": [
                      "external_outbound_block",
                      "loopback_non_allowlisted_block",
                      "internal_outbound_block",
                      "icmp_connect_block",
                      "icmp_resource_assignment_block",
                      "name_resolution_port_block",
                      "file_sharing_port_block",
                      "upstream_proxy_permit"
