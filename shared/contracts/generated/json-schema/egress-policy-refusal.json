                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "tier": {
                "anyOf": [
                  {
                    "enum": [
                      "bootstrap",
                      "file_tool",
                      "network_connector",
                      "channel"
                    ],
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
