{
  "$id": "https://different.ai/openwork-contracts/primary-bundle-prepare-response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": 1,
      "type": "number"
    },
    "correlation_operation_id": {
      "pattern": "^hub:[A-Za-z0-9][A-Za-z0-9._-]*$",
      "type": "string"
    },
    "idempotency_key": {
      "minLength": 1,
      "type": "string"
    },
    "message": {
      "type": [
        "string",
        "null"
      ]
    },
    "pct": {
      "maximum": 100,
      "minimum": 0,
      "type": "number"
    },
    "prepare_operation_id": {
      "pattern": "^lrm:[A-Za-z0-9][A-Za-z0-9._-]*$",
      "type": "string"
    },
    "state": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "type": "string"
    }
  },
  "required": [
    "contract_version",
    "correlation_operation_id",
    "prepare_operation_id",
    "idempotency_key",
    "state",
    "pct",
    "message"
  ],
  "title": "PrimaryBundlePrepareResponse",
  "type": "object"
}
