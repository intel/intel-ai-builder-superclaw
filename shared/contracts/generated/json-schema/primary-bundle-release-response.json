{
  "$id": "https://different.ai/openwork-contracts/primary-bundle-release-response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": 1,
      "type": "number"
    },
    "correlation_operation_id": {
      "pattern": "^hub:[A-Za-z0-9][A-Za-z0-9._-]*$",
      "type": "string"
    },
    "idempotency_key": {
      "minLength": 1,
      "type": "string"
    },
    "state": {
      "const": "succeeded",
      "type": "string"
    }
  },
  "required": [
    "contract_version",
    "correlation_operation_id",
    "idempotency_key",
    "state"
  ],
  "title": "PrimaryBundleReleaseResponse",
  "type": "object"
}
