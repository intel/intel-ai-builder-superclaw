{
  "$id": "https://different.ai/openwork-contracts/broker-start-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": 1,
      "type": "number"
    },
    "launch_role": {
      "enum": [
        "supervisor_executable",
        "token_service_executable",
        "runtime_executable",
        "connector_executable",
        "connector_service",
        "egress_proxy",
        "hdr_sidecar",
        "shell_executable",
        "test_fixed_sleep_child"
      ],
      "type": "string"
    },
    "manifest_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "manifest_version": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "path_bindings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "pattern": "^(?:[A-Za-z]:\\\\|\\\\\\\\\\?\\\\[A-Za-z]:\\\\)(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Ll][Oo][Cc][Kk]\\$|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|\\\\|$))(?!\\.{1,2}(?:\\\\|$))[^<>:\"/\\\\|?*\\u0000-\\u001f]*[^<>:\"/\\\\|?*\\u0000-\\u001f .](?:\\\\(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Ll][Oo][Cc][Kk]\\$|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|\\\\|$))(?!\\.{1,2}(?:\\\\|$))[^<>:\"/\\\\|?*\\u0000-\\u001f]*[^<>:\"/\\\\|?*\\u0000-\\u001f .])*$",
            "type": "string"
          },
          "placeholder": {
            "enum": [
              "payload_root",
              "workspace_root",
              "state_config_root",
              "state_data_root",
              "state_logs_root",
              "state_temp_root",
              "state_protected_root",
              "isolation_root"
            ],
            "type": "string"
          }
        },
        "required": [
          "placeholder",
          "path"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "scalar_bindings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "placeholder": {
            "enum": [
              "loopback_host",
              "supervisor_port",
              "runtime_port",
              "router_health_port",
              "connector_port",
              "egress_proxy_shell_port",
              "egress_proxy_channel_port",
              "hdr_port",
              "llmrouter_port",
              "hdr_api_token",
              "hdr_ready_token",
              "hdr_enabled",
              "host_token",
              "host_token_sha256",
              "openwork_token",
              "router_control_token",
              "router_scoped_token",
              "lrm_api_key",
              "privacy_api_key",
              "runtime_password",
              "intent_classifier_token",
              "runtime_deployment_b64",
              "runtime_desired_fingerprint",
              "runtime_instance_id",
              "runtime_launch_attempt_id",
              "local_proxy_url",
              "local_proxy_bypass"
            ],
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              }
            ]
          }
        },
        "required": [
          "placeholder",
          "value"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "workspace_root_id": {
      "anyOf": [
        {
          "pattern": "^wsr_[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "contract_version",
    "manifest_version",
    "manifest_digest",
    "launch_role",
    "workspace_root_id",
    "path_bindings",
    "scalar_bindings"
  ],
  "title": "BrokerStartRequest",
  "type": "object"
}
