{
  "$id": "https://different.ai/openwork-contracts/slack-identity-save-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "app_token": {
      "pattern": "^[\\x21-\\x7e]{1,512}$",
      "type": "string"
    },
    "bot_token": {
      "pattern": "^[\\x21-\\x7e]{1,512}$",
      "type": "string"
    },
    "directory": {
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^[^\\p{Cc}\\p{Cf}]+$",
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    }
  },
  "required": [
    "bot_token",
    "app_token"
  ],
  "title": "SlackIdentitySaveRequest",
  "type": "object"
}
