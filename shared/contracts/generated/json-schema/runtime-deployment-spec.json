{
  "$id": "https://different.ai/openwork-contracts/runtime-deployment-spec.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "deployment_id": {
      "pattern": "^runtime-deployment-[0-9a-f]{32}$",
      "type": "string"
    },
    "product_profile_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "product_profile_id": {
      "enum": [
        "lite",
        "standard",
        "pro"
      ],
      "type": "string"
    },
    "profile_revision": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "schema_version": {
      "const": 2,
      "type": "number"
    },
    "source_operation_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "deployment_id",
    "source_operation_id",
    "product_profile_id",
    "product_profile_digest",
    "profile_revision"
  ],
  "title": "RuntimeDeploymentSpec",
  "type": "object"
}
