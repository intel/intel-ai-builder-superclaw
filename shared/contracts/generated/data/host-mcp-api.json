  "call_refusal_text": {
    "approval_timeout": "The approval request on the user's computer expired before they answered, so the action was not run. Tell the user it expired and ask whether to try again; do not retry it on your own.",
    "cancelled": "The request was cancelled before the user answered, so the action was not run.",
    "cancelled_by_user": "The user cancelled this action on their computer, so it did not finish. Do not retry it unless the user asks you to.",
    "denied": "The user denied this action on their computer, so it was not run. Do not retry it unless the user asks you to.",
    "server_unavailable": "The MCP server on the user's computer is not running, so the action was not run. Tell the user.",
    "session_locked": "The user's computer is locked, so the action was not run. Tell the user and wait for them to unlock it before trying again.",
    "stopped_by_user": "The user stopped the tools on their computer, so the action was not run. Do not retry it; tell the user they can resume the tools in SuperClaw."
  },
  "errors": {
    "approval_not_found": {
      "message": "No approval has that id.",
      "status": 404
    },
    "approval_not_pending": {
      "message": "That approval has already been decided or has expired.",
      "status": 409
    },
    "approval_scope_not_offered": {
      "message": "That approval does not offer the chosen scope.",
      "status": 409
    },
    "host_browser_not_configured": {
      "message": "The host browser is not set up.",
      "status": 409
    },
    "host_browser_unavailable": {
      "message": "Microsoft Edge was not found on this computer.",
      "status": 501
    },
    "host_mcp_browser_automation_refused": {
      "message": "Browser automation servers can't run on this computer outside the sandbox. Add it without that option and use the SuperClaw browser instead.",
      "status": 400
    },
    "host_mcp_call_not_found": {
      "message": "That action has already finished or does not exist.",
      "status": 404
    },
    "host_mcp_server_limit": {
      "message": "No more host MCP servers can be registered. Remove one first.",
      "status": 409
    },
    "host_mcp_server_not_found": {
      "message": "No host MCP server has that name.",
      "status": 404
    },
    "host_mcp_server_start_failed": {
      "message": "The host MCP server could not be started.",
      "status": 502
    },
    "invalid_request": {
      "message": "The request is not one this endpoint accepts.",
      "status": 400
    },
    "runtime_token_invalid": {
      "message": "The runtime token is missing or is not this server's.",
      "status": 401
    },
    "servicehub_forwarding_required": {
      "message": "This endpoint is reached only through ServiceHub.",
      "status": 401
    }
  },
  "rules": {
    "active_calls_max": 16,
    "approval_timeout_ms": 600000,
    "approvals_max_wait_ms": 20000,
    "browser_automation_commands": {
      "binaries": [
        "playwright-mcp",
        "chrome-devtools",
        "chrome-devtools-mcp",
        "playwright-mcp-server",
        "mcp-server-puppeteer"
      ],
      "packages": [
        "@playwright/mcp",
        "chrome-devtools-mcp",
        "@executeautomation/playwright-mcp-server",
        "@modelcontextprotocol/server-puppeteer",
        "puppeteer-mcp-server",
        "@browsermcp/mcp",
        "@agent-infra/mcp-server-browser"
      ]
    },
    "cdp": {
      "allowed_cdp_domains": [
        "Accessibility",
        "Browser",
        "CSS",
        "Console",
        "DOM",
        "Debugger",
        "Emulation",
        "Fetch",
        "Input",
        "Inspector",
        "Log",
        "Network",
        "Overlay",
        "Page",
        "Performance",
        "Runtime",
        "Security",
        "Target"
      ],
      "block_private_network_destinations": true,
      "blocked_cdp_methods": [
        "Browser.close",
        "Browser.crash",
        "Browser.crashGpuProcess",
        "Browser.executeBrowserCommand",
        "Browser.grantPermissions",
        "Browser.setDownloadBehavior",
        "Browser.setPermission",
        "Network.clearBrowserCache",
        "Network.continueInterceptedRequest",
        "Network.loadNetworkResource",
        "Page.setDownloadBehavior",
        "Target.attachToBrowserTarget",
        "Target.exposeDevToolsProtocol",
        "Target.setRemoteLocations"
      ],
      "blocked_url_schemes": [
        "file",
        "chrome",
        "edge",
        "devtools",
        "view-source",
        "chrome-extension",
        "javascript",
        "data"
      ]
    },
    "cdp_url_prefix": "ws://127.0.0.1:18831/mcp-host/cdp/",
    "command_arg_max_chars": 4096,
    "default_approval_mode": "prompt",
    "edge_required_args": [
      "--auth-server-allowlist=none.invalid",
      "--auth-negotiate-delegate-allowlist=none.invalid",
      "--disable-features=msEdgeSidebarV2,msImplicitSignin"
    ],
    "environment_max_keys": 64,
    "forwarded_credential_header": "X-SuperClaw-Forwarded-Credential",
    "forwarded_credential_label": "superclaw/servicehub-forwarded-request/v1",
    "idle_stop_ms": 180000,
    "no_progress_approval_timeout_ms": 50000,
    "pending_max": 64,
    "port": 18831,
    "progress_keepalive_ms": 15000,
    "proxy_prefix": "/mcp-host",
    "runtime_url_prefix": "http://127.0.0.1:18831/mcp-host/mcp/",
    "server_max": 64,
    "server_name_pattern": "^[A-Za-z0-9_][A-Za-z0-9_-]*$",
    "text_max_utf16_units": 512,
    "token_pattern": "^[A-Za-z0-9_-]{32,128}$",
    "unguarded_paths": [
      "/mcp-host/v1/health",
      "/mcp-host/v1/status",
      "/mcp-host/v1/summary"
    ],
    "upload_roots_max": 8,
    "user_control_retries_max": 3,
    "windows_reserved_device_names": [
      "CON",
      "PRN",
      "AUX",
      "NUL",
      "COM1",
      "LPT1",
      "COM2",
      "LPT2",
      "COM3",
      "LPT3",
      "COM4",
      "LPT4",
      "COM5",
      "LPT5",
      "COM6",
      "LPT6",
      "COM7",
      "LPT7",
      "COM8",
      "LPT8",
      "COM9",
      "LPT9"
    ]
  }
}
