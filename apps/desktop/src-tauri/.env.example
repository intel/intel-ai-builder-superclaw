# Debug-build-only convenience (see src/telemetry/otlp_env.rs::load_debug_env_file).
# Copy to .env (gitignored) and fill in real dev values to test telemetry/feedback
# delivery locally without exporting shell env vars. Never read by release builds.
#
# There is no default OTLP collector baked into source. Set OTEL_EXPORTER_OTLP_ENDPOINT
# to your own collector's URL, or leave it unset to keep telemetry/feedback disabled locally.
OTEL_EXPORTER_OTLP_ENDPOINT=
SUPERCLAW_EDGE_CREDENTIAL_ID=
SUPERCLAW_OTLP_EDGE_TOKEN=
SUPERCLAW_FEEDBACK_EDGE_TOKEN=
