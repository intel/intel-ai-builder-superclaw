{
  "name": "@different-ai/openwork-ui",
  "private": true,
  "version": "0.11.169",
  "type": "module",
  "scripts": {
    "dev": "cross-env OPENWORK_DEV_MODE=1 vite",
    "build": "cross-env BUILD_DEBUG=0 vite build",
    "build:debug": "cross-env BUILD_DEBUG=1 vite build",
    "dev:web": "cross-env OPENWORK_DEV_MODE=1 vite",
    "build:web": "cross-env BUILD_DEBUG=0 vite build",
    "preview": "vite preview",
    "check:design-tokens": "node scripts/check-design-tokens.mjs",
    "test:design-tokens": "node --test scripts/design-token-compiler.check.mjs scripts/design-token-rules.check.mjs",
    "test:shell-backdrop": "node --test scripts/dark-shell-backdrop.check.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "bun test --isolate --path-ignore-patterns=**/mcp-ui*.test.tsx --path-ignore-patterns=**/mcp-form-fields.test.tsx",
    "test:mcp-ui": "vitest run --environment happy-dom src/features/mcp/mcp-ui.test.tsx src/features/mcp/mcp-ui-auth.test.tsx src/features/mcp/mcp-ui-tool-policy.test.tsx src/features/mcp/mcp-form-fields.test.tsx",
    "test:workspace-files-panel": "vitest run --config vitest.workspace-files-panel.config.ts",
    "test:ci": "pnpm typecheck && pnpm test && pnpm test:mcp-ui && pnpm test:workspace-files-panel && pnpm test:design-tokens && pnpm test:shell-backdrop && pnpm check:design-tokens",
    "test:health": "node scripts/health.mjs",
    "test:mention-send": "node scripts/mention-send.mjs",
    "test:sessions": "node scripts/sessions.mjs",
    "test:refactor": "pnpm typecheck && pnpm test:health && pnpm test:sessions",
    "test:events": "node scripts/events.mjs",
    "test:todos": "node scripts/todos.mjs",
    "test:permissions": "node scripts/permissions.mjs",
    "test:session-switch": "node scripts/session-switch.mjs",
    "test:fs-engine": "node scripts/fs-engine.mjs",
    "test:local-file-path": "node scripts/local-file-path.mjs",
    "test:e2e": "pnpm test:local-file-path && node scripts/e2e.mjs && node scripts/session-switch.mjs && node scripts/fs-engine.mjs",
    "bump:patch": "node scripts/bump-version.mjs patch",
    "bump:minor": "node scripts/bump-version.mjs minor",
    "bump:major": "node scripts/bump-version.mjs major",
    "bump:set": "node scripts/bump-version.mjs --set"
  },
  "dependencies": {
    "@different-ai/openwork-contracts": "workspace:*",
    "@fontsource/intel-one-mono": "^5.2.2",
    "@opencode-ai/sdk": "1.18.25",
    "@radix-ui/colors": "^3.0.0",
    "@solid-primitives/event-bus": "^1.1.2",
    "@solid-primitives/storage": "^4.3.3",
    "@solidjs/router": "^0.15.4",
    "@tanstack/solid-virtual": "^3.13.19",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-deep-link": "^2.4.7",
    "@tauri-apps/plugin-dialog": "~2.6.0",
    "@tauri-apps/plugin-http": "~2.5.6",
    "@tauri-apps/plugin-notification": "^2",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@tauri-apps/plugin-process": "~2.3.1",
    "exceljs": "^4.4.0",
    "fuzzysort": "^3.1.0",
    "jsonc-parser": "^3.2.1",
    "lucide-solid": "^0.562.0",
    "marked": "^17.0.1",
    "solid-js": "^1.9.12",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/vite": "^4.1.18",
    "cross-env": "^10.1.0",
    "happy-dom": "^21.0.4",
    "postcss": "8.5.24",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.6.3",
    "vite": "6.4.5",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@10.34.3"
}
