+//
+
+// the grouped rasterization (wg_panels mode 2) instances of the exact gemm, in a device image of their own
+#include "gguf_gemm_launch.hpp"
+
+void gguf_gemm_launch_grouped(bool soa, ggml_type type, const uint8_t * w, const sycl::half * act, float * dst, int M,
+                              int N, int K, int ks, const gguf_xmx::gemm_epi & epi, sycl::queue & q) {
+    if (soa) {
+        gguf_gemm_launch<true, 2>(type, w, act, dst, M, N, K, ks, epi, q);
+    } else {
+        gguf_gemm_launch<false, 2>(type, w, act, dst, M, N, K, ks, epi, q);
+    }
+}
+
+void gguf_glu_launch_grouped(ggml_type type, const uint8_t * g, const uint8_t * u, const sycl::half * act,
+                             sycl::half * out, int M, int N, int K, sycl::queue & q, bool geglu) {
+    gguf_glu_launch<2, true>(type, g, u, act, out, M, N, K, q, geglu);
+}
diff --git a/ggml/src/ggml-sycl/gguf_gemm_i8.cpp b/ggml/src/ggml-sycl/gguf_gemm_i8.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..3875997ffc10afbac5967718fefb4a29ce024e09
--- /dev/null
+++ b/ggml/src/ggml-sycl/gguf_gemm_i8.cpp
@@ -0,0 +1,229 @@
+//
+// MIT license
+// Copyright (C) 2024 Intel Corporation
+// SPDX-License-Identifier: MIT
+//
+
+// the int8-activation gemms (gguf_gemm_i8_kernels.hpp), in their own device image: see gguf_gemm_launch.hpp for why the
+// f16 kernels keep theirs
+
+#include "gguf_gemm.hpp"
+#include "gguf_gemm_i8_kernels.hpp"
+
+#include <algorithm>
+
+static int64_t gguf_a8_rows(int64_t M) {
+    return (M + gguf_xmx::I8_MP - 1) / gguf_xmx::I8_MP * gguf_xmx::I8_MP;
+}
+
+bool ggml_sycl_gguf_i8_ok(ggml_type type, int64_t N, int64_t K) {
+    if ((double) N * K > 4.0e9) {   // gather offsets are 32-bit
+        return false;
+    }
+    switch (type) {
+        case GGML_TYPE_Q8_0: return N % 16 == 0 && K % 512 == 0;   // N % 128 != 0 takes the few-row form
+        case GGML_TYPE_Q3_K:
+        case GGML_TYPE_Q4_K:
+        case GGML_TYPE_Q5_K:
+        case GGML_TYPE_Q6_K:
+        case GGML_TYPE_IQ4_XS:
+        case GGML_TYPE_IQ4_NL: return N % 128 == 0 && K % 512 == 0;
+        default:             return false;
+    }
+}
+
+size_t ggml_sycl_gguf_a8_bytes(int64_t M, int64_t K) {
+    const int64_t Mp = gguf_a8_rows(M);
+    return (size_t) Mp * K + (size_t) Mp / 8 * (K / 32) * sizeof(float) + (size_t) Mp / 8 * (K / 512) * 128 * sizeof(sycl::half);
+}
+
+ggml_sycl_gguf_a8 ggml_sycl_gguf_a8_view(void * buf, int64_t M, int64_t K) {
+    const int64_t     Mp = gguf_a8_rows(M);
+    ggml_sycl_gguf_a8 a8;
+    a8.aq = (int8_t *) buf;
+    a8.as = (float *) ((char *) buf + (size_t) Mp * K);
+    a8.xs = (sycl::half *) ((char *) a8.as + (size_t) Mp / 8 * (K / 32) * sizeof(float));
+    return a8;
+}
+
+void ggml_sycl_gguf_a8_from_act(const sycl::half * act, const ggml_sycl_gguf_a8 & a8, int64_t M, int64_t K,
+                                queue_ptr stream) {
+    GGML_ASSERT(K % 512 == 0);
+    gguf_xmx::a8_from_tiles(*stream, act, a8.aq, a8.as, a8.xs, (int) M, (int) K);
+}
+
+// tokens per group of the weight-outer rasterization, once the s8 activations outgrow L2 (as gguf_rast for f16); 512 and
+// 2048 were 1-4% slower at ub 2048 / 4096
+constexpr int I8_GROUP = 1024;
+
+// do the s8 activations of the token rows in flight (a group's) outgrow B70's 24 MB L2 next to the weight panels? Then
+// the Q4_K / Q6_K gemms prefetch them a super-block ahead: on the 27B's FFN down (K 17408, M 1024) Q4_K 135 -> 156 TOPS,
+// Q6_K 90 -> 109, against the two k slices they had before; short K loses 5-8% to the extra sends
+static bool gguf_i8_pfa(ggml_type type, int64_t M, int64_t K) {
+    return type != GGML_TYPE_Q8_0 && std::min<int64_t>(M, I8_GROUP) * K > (int64_t) 12 * 1024 * 1024;
+}
+
+int ggml_sycl_gguf_i8_splits(ggml_type type, int64_t M, int64_t N, int64_t K) {
+    if (type == GGML_TYPE_Q8_0 && N % 128 != 0) {
+        // a few rows (the 27B's delta-net alpha / beta, N 48) leave a grid of a handful of work-groups: four k slices
+        return K % 1024 == 0 ? 4 : 1;
+    }
+    if (gguf_i8_pfa(type, M, K)) {
+        return 1;
+    }
+    // two k slices on long K otherwise (40 weight panels of the 27B's down projection would leave the grid thin)
+    const int64_t unit = type == GGML_TYPE_Q8_0 ? 256 : 512;
+    return K >= 8192 && (K / unit) % 2 == 0 ? 2 : 1;
+}
+
+template <bool NL>
+static void iq4_i8(sycl::queue & q, const uint8_t * w8, const ggml_sycl_gguf_a8 & a8, float * dst, int M, int N, int K,
+                   const gguf_xmx::gemm_epi & epi, int ks, bool grp, bool pfa, int group) {
+    using namespace gguf_xmx;
+    if (pfa) {
+        grp ? (void) gemm_i8_iq4<8, 4, 2, NL, 8, 1, 1>(q, w8, a8.aq, a8.as, dst, M, N, K, epi, group)
+            : (void) gemm_i8_iq4<8, 4, 1, NL, 8, 1, 1>(q, w8, a8.aq, a8.as, dst, M, N, K, epi);
+    } else if (grp) {
+        ks == 2 ? (void) gemm_i8_iq4<4, 4, 2, NL, 8, 2>(q, w8, a8.aq, a8.as, dst, M, N, K, epi, group)
+                : (void) gemm_i8_iq4<4, 4, 2, NL, 8>(q, w8, a8.aq, a8.as, dst, M, N, K, epi, group);
+    } else {
+        ks == 2 ? (void) gemm_i8_iq4<4, 4, 1, NL, 8, 2>(q, w8, a8.aq, a8.as, dst, M, N, K, epi)
+                : (void) gemm_i8_iq4<4, 4, 1, NL, 8>(q, w8, a8.aq, a8.as, dst, M, N, K, epi);
+    }
+}
+
+void ggml_sycl_gguf_gemm_i8(ggml_type type, const void * w, const ggml_sycl_gguf_a8 & a8, float * dst, int64_t M,
+                            int64_t N, int64_t K, queue_ptr stream, const float * res, const float * res2,
+                            const float * rs, float * part, float * tiles, const float * glu, sycl::half * pack) {
+    GGML_ASSERT(ggml_sycl_gguf_i8_ok(type, N, K));
+    using namespace gguf_xmx;
+    gemm_epi epi{ res, res2, rs, part };
+    epi.tiles = tiles;
+    epi.glu   = glu;
+    epi.pack  = pack;
+    const int      ks = part != nullptr ? ggml_sycl_gguf_i8_splits(type, M, N, K) : 1;
+    const uint8_t * w8 = (const uint8_t *) w;
+    const int Mi = (int) M, Ni = (int) N, Ki = (int) K;
+    constexpr int GROUP = I8_GROUP;
+    const bool    grp   = M > GROUP && M * (K / ks) > (int64_t) 12 * 1024 * 1024;
+    const bool    pfa   = gguf_i8_pfa(type, M, K);
+    switch (type) {
+        case GGML_TYPE_Q8_0:
+            if (N % 128 != 0) {   // 16 rows x 16 tokens per thread, 8 threads along the tokens
+                ks == 4 ? (void) gemm_i8_q8_0<1, 8, 1, 1, 2, 4>(*stream, w8, a8.aq, a8.as, dst, Mi, Ni, Ki, epi)
+                        : (void) gemm_i8_q8_0<1, 8, 1, 1, 2>(*stream, w8, a8.aq, a8.as, dst, Mi, Ni, Ki, epi);
+            } else if (grp) {
+                ks == 2 ? (void) gemm_i8_q8_0<8, 4, 2, 1, 8, 2>(*stream, w8, a8.aq, a8.as, dst, Mi, Ni, Ki, epi, GROUP)
+                        : (void) gemm_i8_q8_0<8, 4, 2, 1, 8>(*stream, w8, a8.aq, a8.as, dst, Mi, Ni, Ki, epi, GROUP);
+            } else {
+                ks == 2 ? (void) gemm_i8_q8_0<8, 4, 1, 1, 8, 2>(*stream, w8, a8.aq, a8.as, dst, Mi, Ni, Ki, epi)
+                        : (void) gemm_i8_q8_0<8, 4, 1, 1, 8>(*stream, w8, a8.aq, a8.as, dst, Mi, Ni, Ki, epi);
+            }
+            break;
+        case GGML_TYPE_Q4_K:
+            if (pfa) {
+                grp ? (void) gemm_i8_q4_K<4, 4, 2, 2, 4, true, 1, 1>(*stream, w8, a8.aq, a8.as, a8.xs, dst, Mi, Ni, Ki, epi, GROUP)
+                    : (void) gemm_i8_q4_K<4, 4, 1, 2, 4, true, 1, 1>(*stream, w8, a8.aq, a8.as, a8.xs, dst, Mi, Ni, Ki, epi);
+            } else if (grp) {
+                ks == 2 ? (void) gemm_i8_q4_K<4, 4, 2, 2, 4, false, 2>(*stream, w8, a8.aq, a8.as, a8.xs, dst, Mi, Ni, Ki, epi, GROUP)
+                        : (void) gemm_i8_q4_K<4, 4, 2, 2, 4>(*stream, w8, a8.aq, a8.as, a8.xs, dst, Mi, Ni, Ki, epi, GROUP);
+            } else {
+                ks == 2 ? (void) gemm_i8_q4_K<4, 4, 1, 2, 4, false, 2>(*stream, w8, a8.aq, a8.as, a8.xs, dst, Mi, Ni, Ki, epi)
+                        : (void) gemm_i8_q4_K<4, 4, 1, 2, 4>(*stream, w8, a8.aq, a8.as, a8.xs, dst, Mi, Ni, Ki, epi);
+            }
+            break;
+        case GGML_TYPE_Q5_K:   // the Q4_K kernel with the qh bits; its heavier decode wants 8 token tiles on long K
+            if (pfa) {
+                grp ? (void) gemm_i8_q4_K<8, 4, 2, 1, 8, true, 1, 1, true>(*stream, w8, a8.aq, a8.as, a8.xs, dst, Mi, Ni, Ki, epi, GROUP)
+                    : (void) gemm_i8_q4_K<8, 4, 1, 1, 8, true, 1, 1, true>(*stream, w8, a8.aq, a8.as, a8.xs, dst, Mi, Ni, Ki, epi);
+            } else if (grp) {
+                ks == 2 ? (void) gemm_i8_q4_K<4, 4, 2, 2, 4, false, 2, 0, true>(*stream, w8, a8.aq, a8.as, a8.xs, dst, Mi, Ni, Ki, epi, GROUP)
+                        : (void) gemm_i8_q4_K<4, 4, 2, 2, 4, true, 1, 0, true>(*stream, w8, a8.aq, a8.as, a8.xs, dst, Mi, Ni, Ki, epi, GROUP);
+            } else {
+                ks == 2 ? (void) gemm_i8_q4_K<4, 4, 1, 2, 4, false, 2, 0, true>(*stream, w8, a8.aq, a8.as, a8.xs, dst, Mi, Ni, Ki, epi)
+                        : (void) gemm_i8_q4_K<4, 4, 1, 2, 4, true, 1, 0, true>(*stream, w8, a8.aq, a8.as, a8.xs, dst, Mi, Ni, Ki, epi);
+            }
+            break;
+        case GGML_TYPE_IQ4_XS:
+        case GGML_TYPE_IQ4_NL:   // the codebook lookups want 8 token tiles per B operand
+            if (type == GGML_TYPE_IQ4_NL) {
+                iq4_i8<true>(*stream, w8, a8, dst, Mi, Ni, Ki, epi, ks, grp, pfa, GROUP);
+            } else {
+                iq4_i8<false>(*stream, w8, a8, dst, Mi, Ni, Ki, epi, ks, grp, pfa, GROUP);
+            }
+            break;
+        case GGML_TYPE_Q3_K:   // gemm_i8_q6_K's form: two half-zero dpas per 32 k
+            if (pfa) {
+                grp ? (void) gemm_i8_q3_K<8, 4, 2, 1, 8, 1, 1>(*stream, w8, a8.aq, a8.as, dst, Mi, Ni, Ki, epi, GROUP)
+                    : (void) gemm_i8_q3_K<8, 4, 1, 1, 8, 1, 1>(*stream, w8, a8.aq, a8.as, dst, Mi, Ni, Ki, epi);
+            } else if (grp) {
+                ks == 2 ? (void) gemm_i8_q3_K<8, 4, 2, 1, 8, 2>(*stream, w8, a8.aq, a8.as, dst, Mi, Ni, Ki, epi, GROUP)
+                        : (void) gemm_i8_q3_K<8, 4, 2, 1, 8>(*stream, w8, a8.aq, a8.as, dst, Mi, Ni, Ki, epi, GROUP);
+            } else {
+                ks == 2 ? (void) gemm_i8_q3_K<8, 4, 1, 1, 8, 2>(*stream, w8, a8.aq, a8.as, dst, Mi, Ni, Ki, epi)
+                        : (void) gemm_i8_q3_K<8, 4, 1, 1, 8>(*stream, w8, a8.aq, a8.as, dst, Mi, Ni, Ki, epi);
+            }
+            break;
+        case GGML_TYPE_Q6_K:
+            if (pfa) {
+                grp ? (void) gemm_i8_q6_K<8, 4, 2, 1, 8, 1, 1>(*stream, w8, a8.aq, a8.as, dst, Mi, Ni, Ki, epi, GROUP)
+                    : (void) gemm_i8_q6_K<8, 4, 1, 1, 8, 1, 1>(*stream, w8, a8.aq, a8.as, dst, Mi, Ni, Ki, epi);
+            } else if (grp) {
+                ks == 2 ? (void) gemm_i8_q6_K<8, 4, 2, 1, 8, 2>(*stream, w8, a8.aq, a8.as, dst, Mi, Ni, Ki, epi, GROUP)
+                        : (void) gemm_i8_q6_K<8, 4, 2, 1, 8>(*stream, w8, a8.aq, a8.as, dst, Mi, Ni, Ki, epi, GROUP);
+            } else {
+                ks == 2 ? (void) gemm_i8_q6_K<8, 4, 1, 1, 8, 2>(*stream, w8, a8.aq, a8.as, dst, Mi, Ni, Ki, epi)
+                        : (void) gemm_i8_q6_K<8, 4, 1, 1, 8>(*stream, w8, a8.aq, a8.as, dst, Mi, Ni, Ki, epi);
+            }
+            break;
+        default:
+            GGML_ABORT("gguf int8 gemm: unsupported type %s", ggml_type_name(type));
+    }
+    if (ks > 1) {
+        splitk_reduce(*stream, dst, epi, ks, Mi, Ni);
+    }
+}
+
+static bool gguf_i8_kq(ggml_type t) {
+    return t == GGML_TYPE_Q4_K || t == GGML_TYPE_Q5_K;
+}
+
+bool ggml_sycl_gguf_glu_i8_ok(ggml_type tg, ggml_type tu, int64_t N, int64_t K) {
+    // any two of Q4_K / Q5_K, or both IQ4_XS or both IQ4_NL
+    const bool t = (gguf_i8_kq(tg) && gguf_i8_kq(tu)) || (tg == tu && (tg == GGML_TYPE_IQ4_XS || tg == GGML_TYPE_IQ4_NL));
+    return t && N % 64 == 0 && K % 512 == 0 && (double) N * K <= 4.0e9;
+}
+
+template <bool Q5G, bool Q5U>
+static void glu_kq_i8(sycl::queue & q, const uint8_t * g8, const uint8_t * u8, const ggml_sycl_gguf_a8 & a8, sycl::half * out,
+                      int M, int N, int K, bool grp, int group) {
+    using namespace gguf_xmx;
+    grp ? (void) gemm_i8_glu_q4_K<4, 4, 2, 4, Q5G, Q5U>(q, g8, u8, a8.aq, a8.as, a8.xs, out, M, N, K, group)
+        : (void) gemm_i8_glu_q4_K<4, 4, 1, 4, Q5G, Q5U>(q, g8, u8, a8.aq, a8.as, a8.xs, out, M, N, K);
+}
+
+void ggml_sycl_gguf_glu_i8(ggml_type tg, ggml_type tu, const void * wg, const void * wu, const ggml_sycl_gguf_a8 & a8,
+                           sycl::half * out, int64_t M, int64_t N, int64_t K, queue_ptr stream) {
+    GGML_ASSERT(ggml_sycl_gguf_glu_i8_ok(tg, tu, N, K));
+    using namespace gguf_xmx;
+    constexpr int GROUP = I8_GROUP;
+    const uint8_t * g8 = (const uint8_t *) wg;
+    const uint8_t * u8 = (const uint8_t *) wu;
+    const bool grp = M > GROUP && M * K > (int64_t) 12 * 1024 * 1024;
+    const int  Mi = (int) M, Ni = (int) N, Ki = (int) K;
+    if (tg == GGML_TYPE_IQ4_XS || tg == GGML_TYPE_IQ4_NL) {   // 167 TOPS against 141 for the two gemms apart
+        if (tg == GGML_TYPE_IQ4_NL) {
+            grp ? (void) gemm_i8_iq4<4, 4, 2, true, 8, 1, 0, true>(*stream, g8, a8.aq, a8.as, nullptr, Mi, Ni, Ki, {}, GROUP, u8, out)
+                : (void) gemm_i8_iq4<4, 4, 1, true, 8, 1, 0, true>(*stream, g8, a8.aq, a8.as, nullptr, Mi, Ni, Ki, {}, 0, u8, out);
+        } else {
+            grp ? (void) gemm_i8_iq4<4, 4, 2, false, 8, 1, 0, true>(*stream, g8, a8.aq, a8.as, nullptr, Mi, Ni, Ki, {}, GROUP, u8, out)
+                : (void) gemm_i8_iq4<4, 4, 1, false, 8, 1, 0, true>(*stream, g8, a8.aq, a8.as, nullptr, Mi, Ni, Ki, {}, 0, u8, out);
+        }
+    } else if (tg == GGML_TYPE_Q5_K) {
+        tu == GGML_TYPE_Q5_K ? glu_kq_i8<true, true>(*stream, g8, u8, a8, out, Mi, Ni, Ki, grp, GROUP)
+                             : glu_kq_i8<true, false>(*stream, g8, u8, a8, out, Mi, Ni, Ki, grp, GROUP);
+    } else {
+        tu == GGML_TYPE_Q5_K ? glu_kq_i8<false, true>(*stream, g8, u8, a8, out, Mi, Ni, Ki, grp, GROUP)
+                             : glu_kq_i8<false, false>(*stream, g8, u8, a8, out, Mi, Ni, Ki, grp, GROUP);
+    }
+}
