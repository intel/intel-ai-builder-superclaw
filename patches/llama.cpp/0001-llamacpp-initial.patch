+                const char * yc = (const char *) vy + c * stride_col_y_bytes;
+                const auto   u  = *(const sycl::vec<int, 8> *) (yc + (size_t) i * QK_K + 32 * ib);
+                const float  d8 = (*(const sycl::half2 *) (yc + ncols + (i * (QK_K / QK8_1) + ib) * sizeof(sycl::half2)))[0];
+                int          sp = 0, sn = 0;
+#pragma unroll
+                for (int j = 0; j < 8; ++j) {
+                    sp = dpct::dp4a(g[j], u[j], sp);
+                    sn = dpct::dp4a(g[j] & m[j], u[j], sn);
+                }
+                sum[c] += db * d8 * (sp - 2 * sn);
+            }
+        }
+    }
+#pragma unroll
+    for (int c = 0; c < ncols_dst; ++c) {
+        float t = sycl::reduce_over_group(sg, sum[c], std::plus<>());
+        if constexpr (nsg > 1) {
+            if (sg.leader()) {
+                part[sgi] = t;
+            }
+            sycl::group_barrier(nd_item.get_group());
+            t = 0.0f;
+            for (int k = 0; k < nsg; ++k) {
+                t += part[sgi - sgi % nsg + k];
+            }
+            sycl::group_barrier(nd_item.get_group());   // part is reused by the next column
+        }
+        if (sgi % nsg == 0 && sg.leader() && row < nrows) {
+            dst[c * stride_col_dst + row] = t;
+        }
+    }
+}
+
+template <int ncols_dst>
+static void reorder_mul_mat_vec_iq3_s_q8_1_sycl(const void * vx, const void * vy, float * dst, const int ncols,
+                                                const int nrows, const int stride_col_y_bytes, const int stride_col_dst,
+                                                dpct::queue_ptr stream) {
+    GGML_ASSERT(ncols % QK_K == 0);
+    constexpr int num_subgroups = WARP_SIZE;
+    // two sub-groups per row for rows of at least 12288 on fewer than 4 waves of the device's hardware threads (the FFN
+    // down projection: 76 vs 81 us on B70), as for IQ4
+    const int  threads = ggml_sycl_info().devices[get_current_device_id()].nsm * 16 * 8;
+    const bool split   = ncols_dst == 1 && ncols >= 12288 && nrows < 4 * threads;
+    const int  rpw     = split ? num_subgroups / 2 : num_subgroups;   // rows per work-group
+    const sycl::range<3> block_nums(1, 1, ceil_div(nrows, rpw));
+    const sycl::range<3> block_dims(1, 1, num_subgroups * WARP_SIZE);
+    stream->submit([&](sycl::handler & cgh) {
+        sycl::local_accessor<uint32_t, 1> grid(sycl::range<1>(512), cgh);
+        sycl::local_accessor<float, 1>    part(sycl::range<1>(num_subgroups), cgh);
+        if constexpr (ncols_dst == 1) {
+            if (split) {
+                cgh.parallel_for(sycl::nd_range<3>(block_nums * block_dims, block_dims),
+                                 [=](sycl::nd_item<3> nd_item) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+                                     mul_mat_vec_q_iq3_s_reorder<1, 2>(vx, vy, dst, ncols, nrows, stride_col_y_bytes,
+                                                                       stride_col_dst, grid, part, nd_item);
+                                 });
+                return;
+            }
+        }
+        cgh.parallel_for(sycl::nd_range<3>(block_nums * block_dims, block_dims),
+                         [=](sycl::nd_item<3> nd_item) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+                             mul_mat_vec_q_iq3_s_reorder<ncols_dst, 1>(vx, vy, dst, ncols, nrows, stride_col_y_bytes,
+                                                                       stride_col_dst, grid, part, nd_item);
+                         });
+    });
+}
