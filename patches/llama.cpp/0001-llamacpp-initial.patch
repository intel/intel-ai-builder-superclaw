+template <typename S>
+static void ggml_sycl_swiglu_quant_s8(const sycl::half * gate, const sycl::half * up,
+                                      int8_t * q, S * scales,
+                                      const int64_t n_ff, const int64_t n_rows, const int64_t group,
+                                      const bool transposed, queue_ptr stream,
+                                      int32_t * sums = nullptr) {
+    const int64_t ngroups = n_ff / group;
+    switch (group / WARP_SIZE) {
+        case 8: return swiglu_quant_s8_sg<8>(gate, up, q, scales, n_ff, n_rows, group, ngroups, transposed, sums, stream);
+        case 4: return swiglu_quant_s8_sg<4>(gate, up, q, scales, n_ff, n_rows, group, ngroups, transposed, sums, stream);
+        case 2: return swiglu_quant_s8_sg<2>(gate, up, q, scales, n_ff, n_rows, group, ngroups, transposed, sums, stream);
+        default: break;
+    }
+    stream->parallel_for(
+        sycl::nd_range<1>(sycl::range<1>(n_rows * ngroups * group), sycl::range<1>(group)),
+        [=](sycl::nd_item<1> it) {
+            const int64_t wg  = it.get_group(0);
+            const int64_t row = wg / ngroups;
+            const int64_t g   = wg % ngroups;
+            const int64_t idx = row * n_ff + g * group + it.get_local_id(0);
+            const float x = (float) gate[idx];
+            const float v = x / (1.0f + sycl::exp(-x)) * (float) up[idx];
+            const float amax = sycl::reduce_over_group(it.get_group(), sycl::fabs(v), sycl::maximum<float>());
+            const float inv = amax > 0.0f ? 127.0f / amax : 0.0f;
+            const int8_t qv = (int8_t) sycl::clamp(sycl::round(v * inv), -127.0f, 127.0f);
+            q[idx] = qv;
+            int32_t gsum = 0;
+            if (sums != nullptr) {
+                gsum = sycl::reduce_over_group(it.get_group(), (int32_t) qv, sycl::plus<int32_t>());
+            }
+            if (it.get_local_id(0) == 0) {
+                scales[transposed ? g * n_rows + row : row * ngroups + g] = (S) (amax / 127.0f);
+                if (sums != nullptr) {
+                    sums[row * ngroups + g] = gsum;
+                }
