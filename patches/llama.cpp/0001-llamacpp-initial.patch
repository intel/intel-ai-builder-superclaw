+// with the dense_u4 plane helpers below)
+static void dense_u4_dequant_rows(const ggml_tensor * src0, float * out,
+                                  int64_t r0, int64_t nr, queue_ptr stream);
+
+static const ggml_backend_sycl_context::dnn_int8_weights * dnn_int8_ensure_weights(
+        ggml_backend_sycl_context & ctx, const ggml_tensor * src0, const char * src0_dd,
+        ggml_tensor * dst, const int64_t row_diff, const int64_t ne00,
+        const int group, queue_ptr stream) {
+    // converted in place to u4: the bytes are no longer Q*_K, but the s8 copy can be
+    // rebuilt from the u4 planes (prefill-size gemms prefer the tuned s8 x s8 kernel
+    // over the w4a8 jit:gemm:any config; the u4 planes stay for the small-batch paths)
+    const bool from_u4 = src0->extra != nullptr &&
+        ((const ggml_tensor_extra_gpu *) src0->extra)->optimized_feature.u4_dense;
+    auto it = ctx.dnn_int8_wcache.find(src0_dd);
+    if (it != ctx.dnn_int8_wcache.end()) return &it->second;
+
+    // the mmvq/dmmv optimization may have rewritten the weights in place into the
+    // planar reorder layout; the row-offset staging below would misread it, so
+    // reordered tensors need the plane-aware window dequant (or are skipped)
+    const bool src0_reordered = !from_u4 && src0->extra &&
+        ((ggml_tensor_extra_gpu *) src0->extra)->optimized_feature.reorder;
+    const to_fp32_reorder_window_sycl_t to_fp32_window =
+        src0_reordered ? ggml_get_to_fp32_reorder_window_sycl(src0->type) : nullptr;
+    if (src0_reordered && to_fp32_window == nullptr) return nullptr;
+
+    const int64_t ngroups_k = ne00 / group;
+    int8_t * w_s8 = (int8_t *) sycl::malloc_device(row_diff * ne00, *stream);
+    float *  w_sc = (float *)  sycl::malloc_device(row_diff * ngroups_k * sizeof(float), *stream);
+    ggml_sycl_alloc_trace_note("wcache", w_s8, row_diff * ne00, +1);
+    ggml_sycl_alloc_trace_note("wcache", w_sc, row_diff * ngroups_k * sizeof(float), +1);
+    if (w_s8 == nullptr || w_sc == nullptr) {
+        if (w_s8 != nullptr) sycl::free(w_s8, *stream);
+        if (w_sc != nullptr) sycl::free(w_sc, *stream);
+        return nullptr;
+    }
+    // convert row blocks through a bounded f32 staging buffer so huge tensors
+    // (e.g. the output head) don't need a full-size dequantized copy
