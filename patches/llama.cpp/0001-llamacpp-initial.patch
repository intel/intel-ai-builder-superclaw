+    if (slot.cap < bytes) {
+        if (slot.buf != nullptr) {
+            stream->wait();   // pending matvecs may still read the old buffer
+            sycl::free(slot.buf, *stream);
+        }
+        slot.buf = (char *) sycl::malloc_device(bytes, *stream);
+        slot.cap = slot.buf != nullptr ? bytes : 0;
+        if (slot.buf == nullptr) {
+            return nullptr;
+        }
+    }
+    ctx.q8_cache_queue = stream;
+    quantize_row_q8_1_sycl<quantize_and_reorder_q8_1_soa>((const float *) src1->data, slot.buf, (int) ne10,
