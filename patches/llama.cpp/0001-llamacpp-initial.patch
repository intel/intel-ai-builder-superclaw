+struct view_info {
+    int32_t n_tokens;
+    llama_pos pos_t;
+    bool is_pinned_image;
+};
+
+static std::vector<view_info> collect_views(decode_embd_batch & batch, int32_t n_batch, bool is_image) {
+    std::vector<view_info> views;
+    batch.decode_views(n_batch, is_image, [&](llama_batch view, bool is_pinned_image) -> int32_t {
+        views.push_back({ view.n_tokens, view.pos[0], is_pinned_image });
+        return 0;
+    });
+    return views;
+}
+
+MAKE_TEST(test_pinned_image_batches) {
+    const int32_t n_tokens = 952;
+    std::vector<float> embeddings(n_tokens);
+    decode_embd_batch image(embeddings.data(), n_tokens, 4, 1);
+    std::vector<mtmd_decoder_pos> positions(n_tokens);
+
+    for (const llama_pos start_pos : { 0, 3488 }) {
+        for (int32_t row = 0; row < n_tokens; ++row) {
+            positions[row] = { start_pos, start_pos + row % 28, start_pos + row / 28, 0 };
+        }
+        image.set_position_mrope_2d(positions, 0);
+
+        for (const int32_t n_batch : { 1, 317, 951, 1280 }) {
+            const std::string name = "start " + std::to_string(start_pos) + " n_batch " + std::to_string(n_batch);
+            const auto views = collect_views(image, n_batch, true);
+            int32_t n_rows = 0;
+            bool all_pinned = true;
+            for (const auto & v : views) {
+                n_rows += v.n_tokens;
+                all_pinned = all_pinned && v.is_pinned_image && v.pos_t == start_pos;
+            }
+            t.assert_equal(name + ": views", (n_tokens + n_batch - 1) / n_batch, (int32_t) views.size());
+            t.assert_equal(name + ": rows", n_tokens, n_rows);
+            t.assert_equal(name + ": every view pinned", true, all_pinned);
+        }
+    }
+
+    // 952 = 951 + 1: the last view has a single row and must stay pinned
+    const auto views = collect_views(image, 951, true);
+    t.assert_equal("one-row remainder size", 1, views.back().n_tokens);
+    t.assert_equal("one-row remainder pinned", true, views.back().is_pinned_image);
+
+    t.assert_equal("not an image chunk", false, collect_views(image, 1, false)[0].is_pinned_image);
+
+    positions[n_tokens / 2].t += 1;
+    image.set_position_mrope_2d(positions, 0);
+    t.assert_equal("one row off: first view", false, collect_views(image, 1, true).front().is_pinned_image);
+    t.assert_equal("one row off: last view", false, collect_views(image, 951, true).back().is_pinned_image);
+
+    int32_t n_calls = 0;
+    const int32_t ret = image.decode_views(317, true, [&](llama_batch, bool) -> int32_t { return ++n_calls == 2 ? 7 : 0; });
+    t.assert_equal("error stops the split", 7, ret);
+    t.assert_equal("no view after error", 2, n_calls);
+}
+
+MAKE_TEST(test_non_pinned_embedding_batches) {
+    const int32_t n_tokens = 8;
+    std::vector<float> embeddings(n_tokens);
+    decode_embd_batch normal(embeddings.data(), n_tokens, 1, 1);
+    decode_embd_batch audio(embeddings.data(), n_tokens, 4, 1);
+    normal.set_position_normal(3488, 0);
+    audio.set_position_mrope_1d(3488, 0);
+
+    for (const int32_t n_batch : { 1, 3, 8 }) {
+        for (const bool is_image : { false, true }) {
+            for (const auto & v : collect_views(normal, n_batch, is_image)) {
+                t.assert_equal("normal view not pinned", false, v.is_pinned_image);
+            }
+            for (const auto & v : collect_views(audio, n_batch, is_image)) {
+                t.assert_equal("audio view not pinned", false, v.is_pinned_image);
+            }
+        }
+    }
+
+    decode_embd_batch single(embeddings.data(), 1, 4, 1);
+    single.set_position_mrope_2d({ { 3488, 3488, 3488, 0 } }, 0);
+    t.assert_equal("single-token image not pinned", false, collect_views(single, 1, true)[0].is_pinned_image);
+}
+
+struct counting_speculative_impl : common_speculative_impl {
+    int32_t calls = 0;
+    int32_t rows = 0;
+    bool succeed = true;
+
+    explicit counting_speculative_impl(common_speculative_type type)
+        : common_speculative_impl(type, 1, 7) {}
+
+    void begin(llama_seq_id, const llama_tokens &) override {}
+    void draft(common_speculative_draft_params_vec &) override {}
+    void accept(llama_seq_id, uint16_t, bool) override {}
+
+    bool process(const llama_batch & batch) override {
+        ++calls;
+        rows += batch.n_tokens;
+        return succeed;
+    }
+};
+
+MAKE_TEST(test_pinned_image_speculative_dispatch) {
+    const int32_t n_tokens = 952;
+    std::vector<float> embeddings(n_tokens);
+    decode_embd_batch image(embeddings.data(), n_tokens, 4, 1);
+    std::vector<mtmd_decoder_pos> positions(n_tokens, { 3488, 3488, 3488, 0 });
+    image.set_position_mrope_2d(positions, 0);
+
+    for (const int32_t n_batch : { 1, 317, 951, 1280 }) {
+        common_speculative spec;
+        auto dflash = std::make_unique<counting_speculative_impl>(COMMON_SPECULATIVE_TYPE_DRAFT_DFLASH);
+        auto dspark = std::make_unique<counting_speculative_impl>(COMMON_SPECULATIVE_TYPE_DRAFT_DSPARK);
+        auto mtp = std::make_unique<counting_speculative_impl>(COMMON_SPECULATIVE_TYPE_DRAFT_MTP);
+        auto * dflash_counter = dflash.get();
+        auto * dspark_counter = dspark.get();
+        auto * mtp_counter = mtp.get();
+        spec.impls.push_back(std::move(dflash));
+        spec.impls.push_back(std::move(dspark));
+        spec.impls.push_back(std::move(mtp));
+
+        const std::string name = "batch " + std::to_string(n_batch);
+        const int32_t ret = image.decode_views(n_batch, true, [&](llama_batch view, bool is_pinned_image) -> int32_t {
+            return common_speculative_process(&spec, view, is_pinned_image) ? 0 : 1;
+        });
+        t.assert_equal(name + ": pinned dispatch succeeds", 0, ret);
+        t.assert_equal(name + ": DFlash skipped", 0, dflash_counter->calls);
+        t.assert_equal(name + ": DSpark skipped", 0, dspark_counter->calls);
+        t.assert_equal(name + ": MTP receives every view", (n_tokens + n_batch - 1) / n_batch, mtp_counter->calls);
+        t.assert_equal(name + ": MTP receives every row", n_tokens, mtp_counter->rows);
+
+        llama_batch ordinary = image.get_view(0, 1);
+        t.assert_equal(name + ": non-pinned embedding succeeds", true, common_speculative_process(&spec, ordinary, false));
+        llama_token token = 1;
+        ordinary.embd = nullptr;
+        ordinary.token = &token;
+        t.assert_equal(name + ": default text dispatch succeeds", true, common_speculative_process(&spec, ordinary));
+        t.assert_equal(name + ": DFlash receives ordinary batches", 2, dflash_counter->calls);
+        t.assert_equal(name + ": DSpark receives ordinary batches", 2, dspark_counter->calls);
+        t.assert_equal(name + ": MTP receives ordinary batches", (n_tokens + n_batch - 1) / n_batch + 2, mtp_counter->calls);
+
+        mtp_counter->succeed = false;
+        t.assert_equal(name + ": unskipped failure propagates", false,
+                       common_speculative_process(&spec, image.get_view(0, 1), true));
+        t.assert_equal(name + ": failure still skips DFlash", 2, dflash_counter->calls);
+        t.assert_equal(name + ": failure still skips DSpark", 2, dspark_counter->calls);
+    }
+}
