+template<typename T>
+struct dense_u4_temp {
+    ggml_sycl_pool_alloc<T> pooled;
+    std::unique_ptr<sycl_reorder_temp_buffer> direct;
+
+    dense_u4_temp(ggml_sycl_pool * pool, queue_ptr stream, size_t count) {
+        if (pool != nullptr) {
+            pooled.alloc(*pool, count);
+        } else {
+            direct = std::make_unique<sycl_reorder_temp_buffer>(stream, count * sizeof(T));
+        }
+    }
+
+    T * get() {
+        return pool_ptr() != nullptr ? pool_ptr() : direct_ptr();
+    }
+
+    explicit operator bool() {
+        return pool_ptr() != nullptr || direct_ptr() != nullptr;
+    }
+
+private:
+    T * pool_ptr() {
+        return pooled.get();
+    }
+
+    T * direct_ptr() {
+        return direct != nullptr ? static_cast<T *>(direct->ptr) : nullptr;
+    }
+};
+
+static bool dense_u4_convert(queue_ptr stream, ggml_sycl_pool * pool, ggml_tensor * t,
+                             const void * source, size_t source_size) {
+    ggml_tensor_extra_gpu * extra = (ggml_tensor_extra_gpu *) t->extra;
+    if (extra == nullptr || source == nullptr || source_size != ggml_nbytes(t)) return false;
+    const int     group = dense_u4_group(t);
+    const int64_t ne00 = t->ne[0];
+    const int64_t ne01 = t->ne[1];
+    const int64_t kg   = ne00 / group;
+
+    const size_t tot_bytes = ggml_nbytes(t);
+    std::unique_ptr<sycl_reorder_temp_buffer> tmp;
+    if (pool != nullptr) {
+        tmp = std::make_unique<sycl_reorder_temp_buffer>(stream, tot_bytes);
+        if (!tmp || !*tmp) return false;
+        SYCL_CHECK(CHECK_TRY_ERROR(stream->memcpy(tmp->ptr, source, tot_bytes).wait()));
+    }
+
+    // the f32 staging is 4 bytes per weight, so converting a whole tensor at once costs
+    // 4.8 GiB on a 5120x248320 lm_head - and ggml_sycl_pool_leg::free() parks it for the
+    // life of the context instead of returning it. convert in row blocks so the peak is
+    // bounded; every (row, group) is quantized independently, so the planes come out the
+    // same. zp8 stays whole: it is 4-bit packed at the end and is kg bytes per row.
+    static const int64_t chunk_mb = []{
+        const char * e = getenv("GGML_SYCL_U4_CHUNK_MB");   // 0 converts the whole tensor at once
+        return (int64_t) (e != nullptr ? atoll(e) : 64);
+    }();
+    const int64_t rows_chunk = chunk_mb <= 0 ? ne01 : std::min(ne01,
+        std::max<int64_t>(8, ((chunk_mb << 20) / (ne00 * (int64_t) sizeof(float))) & ~(int64_t) 7));
+    dense_u4_temp<float>   stg(pool, stream, rows_chunk * ne00);
+    dense_u4_temp<uint8_t> q8 (pool, stream, rows_chunk * ne00);
+    dense_u4_temp<uint8_t> zp8(pool, stream, ne01 * kg);
+    std::unique_ptr<sycl_reorder_temp_buffer> source_chunk;
+    if (pool == nullptr) {
+        source_chunk = std::make_unique<sycl_reorder_temp_buffer>(
+            stream, rows_chunk * (size_t) ggml_row_size(t->type, ne00));
+    }
+    if (!stg || !q8 || !zp8 || (pool == nullptr && (!source_chunk || !*source_chunk))) return false;
+    const to_fp32_sycl_t to_fp32 = ggml_get_to_fp32_sycl(t->type, nullptr);
+    GGML_ASSERT(to_fp32 != nullptr);
+
+    const dense_u4_planes p = dense_u4_get_planes(t);
+    // the ALS refit only pays off on the outlier-heavy 8-bit GDN projections
+    // (-0.09 PPL on Qwen3.6-35B U4_ALL); everywhere else the plain refit is safer
+    const bool als = t->type == GGML_TYPE_Q8_0 &&
+        (strstr(t->name, "attn_qkv") != nullptr || strstr(t->name, "ssm_out") != nullptr);
+    const int64_t row_bytes = ggml_row_size(t->type, ne00);
+    for (int64_t r0 = 0; r0 < ne01; r0 += rows_chunk) {
+        const int64_t nr = std::min(rows_chunk, ne01 - r0);
+        const char * input = nullptr;
+        if (tmp) {
+            input = (const char *) tmp->ptr + r0 * row_bytes;
+        } else {
+            input = (const char *) source_chunk->ptr;
+            SYCL_CHECK(CHECK_TRY_ERROR(stream->memcpy(
+                source_chunk->ptr, (const char *) source + r0 * row_bytes, nr * row_bytes).wait()));
+        }
+        to_fp32(input, stg.get(), nr * ne00, stream);
+        ggml_sycl_quantize_groups_u4(stg.get(), q8.get(), p.sc, zp8.get(), ne00, nr, group, stream,
+                                     /*als_refit=*/als, /*row0=*/r0, /*ld_rows=*/ne01);
+        ggml_sycl_pack_u4(q8.get(), p.w + r0 * ne00 / 2, nr * ne00, stream);
+    }
+    ggml_sycl_pack_u4(zp8.get(), p.zp, ne01 * kg, stream);
+    SYCL_CHECK(CHECK_TRY_ERROR(stream->wait()));
+
+    extra->optimized_feature.u4_dense = true;
+    GGML_SYCL_DEBUG("[SYCL] dense u4: %s [%d x %d] %s converted in place\n",
+                    t->name, (int) ne00, (int) ne01, ggml_type_name(t->type));
+    return true;
+}
+
+// one-time in-place conversion; idempotent, false = tensor untouched (caller falls back)
+static bool dense_u4_ensure(ggml_backend_sycl_context & ctx, const ggml_tensor * src0, ggml_tensor * dst) {
+    GGML_UNUSED(dst);
+    ggml_tensor_extra_gpu * extra = (ggml_tensor_extra_gpu *) src0->extra;
+    if (extra != nullptr && extra->optimized_feature.u4_dense) return true;
+    if (!dense_u4_eligible(src0)) return false;
+    if (extra == nullptr || extra->optimized_feature.reorder) return false;   // mmvq rewrote it first
+    return dense_u4_convert(ctx.stream(), &ctx.pool(), const_cast<ggml_tensor *>(src0),
+                            src0->data, ggml_nbytes(src0));
+}
