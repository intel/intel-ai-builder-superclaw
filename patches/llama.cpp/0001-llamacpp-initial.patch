+// quantize rows of f32 data into symmetric int8 with one f32 scale per `group`
+// contiguous elements. rows are contiguous of length k. scale layout:
+//   transposed=false -> [n_rows, k/group] (weights / oneDNN SRC argument)
+//   transposed=true  -> [k/group, n_rows] (activations / oneDNN WEIGHTS argument)
+// `sums` (optional, [n_rows, k/group]) receives the plain sum of the quantized
+// values per group - oneDNN's precomputed reductions for the SRC argument
+// one subgroup per quantization group: the group max is a subgroup reduction (no SLM,
+// no barrier) and each lane keeps its elements in registers between the max and the
+// quantize pass. EPL elements per lane, strided by the subgroup size so every
+// iteration is one coalesced access.
+template <int EPL, typename X, typename S>
+static void quantize_groups_s8_sg(const X * x, int8_t * q, S * scales, const int64_t k,
+                                  const int64_t n_rows, const int64_t group, const int64_t ngroups,
+                                  const bool transposed, int32_t * sums, queue_ptr stream) {
+    constexpr int wg   = 256;
+    const int64_t total = n_rows * ngroups;                 // one subgroup per group
+    const int64_t n_wg  = (total + wg / WARP_SIZE - 1) / (wg / WARP_SIZE);
+    stream->parallel_for(
+        sycl::nd_range<1>(sycl::range<1>(n_wg * wg), sycl::range<1>(wg)),
+        [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+            auto sg = it.get_sub_group();
+            const int64_t gid = it.get_group(0) * (wg / WARP_SIZE) + sg.get_group_id()[0];
+            if (gid >= total) {
+                return;
+            }
+            const int64_t row  = gid / ngroups;
+            const int64_t g    = gid - row * ngroups;
+            const int     lane = sg.get_local_id()[0];
+            const int64_t base = row * k + g * group;
+
+            float v[EPL];
+            float amax = 0.0f;
+            for (int i = 0; i < EPL; ++i) {
+                v[i] = (float) x[base + i * WARP_SIZE + lane];
+                amax = sycl::fmax(amax, sycl::fabs(v[i]));
+            }
+            amax = sycl::reduce_over_group(sg, amax, sycl::maximum<float>());
+            const float inv = amax > 0.0f ? 127.0f / amax : 0.0f;
+            int32_t lsum = 0;
+            for (int i = 0; i < EPL; ++i) {
+                const int8_t qv = (int8_t) sycl::clamp(sycl::round(v[i] * inv), -127.0f, 127.0f);
+                q[base + i * WARP_SIZE + lane] = qv;
+                lsum += qv;
+            }
+            if (sums != nullptr) {
+                lsum = sycl::reduce_over_group(sg, lsum, sycl::plus<int32_t>());
+            }
+            if (lane == 0) {
+                scales[transposed ? g * n_rows + row : row * ngroups + g] = (S) (amax / 127.0f);
+                if (sums != nullptr) {
+                    sums[row * ngroups + g] = lsum;
+                }
+            }
+        });
+}
+
+template <typename S>
+static void ggml_sycl_quantize_groups_s8(const float * x, int8_t * q, S * scales,
+                                         const int64_t k, const int64_t n_rows, const int64_t group,
+                                         const bool transposed, queue_ptr stream,
+                                         int32_t * sums = nullptr) {
+    const int64_t ngroups = k / group;
+    switch (group / WARP_SIZE) {
+        case 8: return quantize_groups_s8_sg<8>(x, q, scales, k, n_rows, group, ngroups, transposed, sums, stream);
+        case 4: return quantize_groups_s8_sg<4>(x, q, scales, k, n_rows, group, ngroups, transposed, sums, stream);
+        case 2: return quantize_groups_s8_sg<2>(x, q, scales, k, n_rows, group, ngroups, transposed, sums, stream);
+        default: break;
+    }
+    // one work-group per quantization group: loads and stores are coalesced,
+    // each element is read once, and the group max is a work-group reduction
+    stream->parallel_for(
+        sycl::nd_range<1>(sycl::range<1>(n_rows * ngroups * group), sycl::range<1>(group)),
+        [=](sycl::nd_item<1> it) {
+            const int64_t wg  = it.get_group(0);
+            const int64_t row = wg / ngroups;
+            const int64_t g   = wg % ngroups;
+            const int64_t idx = row * k + g * group + it.get_local_id(0);
+            const float v = (float) x[idx];
+            const float amax = sycl::reduce_over_group(it.get_group(), sycl::fabs(v), sycl::maximum<float>());
+            const float inv = amax > 0.0f ? 127.0f / amax : 0.0f;
+            const int8_t qv = (int8_t) sycl::clamp(sycl::round(v * inv), -127.0f, 127.0f);
+            q[idx] = qv;
+            int32_t gsum = 0;
+            if (sums != nullptr) {
+                gsum = sycl::reduce_over_group(it.get_group(), (int32_t) qv, sycl::plus<int32_t>());
+            }
+            if (it.get_local_id(0) == 0) {
+                scales[transposed ? g * n_rows + row : row * ngroups + g] = (S) (amax / 127.0f);
+                if (sums != nullptr) {
+                    sums[row * ngroups + g] = gsum;
+                }
+            }
+        });
+}
