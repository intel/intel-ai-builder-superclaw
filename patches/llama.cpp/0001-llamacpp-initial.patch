+// asymmetric u4 group quant (W4A16 weights): per group of `group` elements along k,
+// value ~= scale * (q - zp), q in [0,15]. Emits unpacked q (u8) and zp (u8) plus f16 scale;
+// pack them to u4 with ggml_sycl_pack_u4. Layout [n_rows, k] with scale/zp [n_rows, k/group].
+// The scale is grid-searched around the min/max estimate and refined by least squares
+// (one-time conversion cost, so precision is worth more than speed here).
+// row0/ld_rows let a caller quantize a row block at a time while still writing the
+// [ngroups, ld_rows] scale/zp layout of the whole tensor
+static void ggml_sycl_quantize_groups_u4(const float * x, uint8_t * q, sycl::half * scales, uint8_t * zp,
+                                         const int64_t k, const int64_t n_rows, const int64_t group,
+                                         queue_ptr stream, const bool als_refit = true,
+                                         const int64_t row0 = 0, const int64_t ld_rows = 0) {
+    const int64_t ngroups = k / group;
+    const int64_t ldr     = ld_rows > 0 ? ld_rows : n_rows;
+    stream->parallel_for(
+        sycl::nd_range<1>(sycl::range<1>(n_rows * ngroups * group), sycl::range<1>(group)),
+        [=](sycl::nd_item<1> it) {
+            const int64_t wg  = it.get_group(0);
+            const int64_t row = wg / ngroups;
+            const int64_t g   = wg % ngroups;
+            const int64_t idx = row * k + g * group + it.get_local_id(0);
+            const float v   = x[idx];
+            const float mn  = sycl::reduce_over_group(it.get_group(), v, sycl::minimum<float>());
+            const float mx  = sycl::reduce_over_group(it.get_group(), v, sycl::maximum<float>());
+            const float s0  = (mx - mn) / 15.0f;
+
+            float best_s   = s0;
+            float best_zp  = 0.0f;
+            float best_err = 3.4e38f;
+            if (s0 > 0.0f) {
+                for (int t = 0; t < 33; ++t) {
+                    const float s   = s0 * (0.70f + 0.05f * (t / 3));
+                    const float inv = 1.0f / s;
+                    const float zpf = sycl::clamp(sycl::round(-mn * inv) + (float) (t % 3 - 1), 0.0f, 15.0f);
+                    const float qf  = sycl::clamp(sycl::round(v * inv + zpf), 0.0f, 15.0f);
+                    const float d   = v - s * (qf - zpf);
+                    const float err = sycl::reduce_over_group(it.get_group(), d * d, sycl::plus<float>());
+                    if (err < best_err) {
+                        best_err = err;
+                        best_s   = s;
+                        best_zp  = zpf;
+                    }
+                }
+                if (!als_refit) {
+                    // small outlier-heavy tensors: the tight ALS fit clips outliers and
+                    // costs perplexity, keep the single legacy scale refit
+                    const float inv = 1.0f / best_s;
+                    const float qf  = sycl::clamp(sycl::round(v * inv + best_zp), 0.0f, 15.0f);
+                    const float w   = qf - best_zp;
+                    const float num = sycl::reduce_over_group(it.get_group(), v * w, sycl::plus<float>());
+                    const float den = sycl::reduce_over_group(it.get_group(), w * w, sycl::plus<float>());
+                    if (den > 0.0f && num > 0.0f) {
+                        best_s = num / den;
+                    }
+                } else {
+                // alternate least-squares refit of the scale and integer zero-point
+                // for the current assignment, re-rounding between iterations; keep
+                // the refit result only when it beats the grid-search error
+                const float grid_s = best_s, grid_zp = best_zp;
+                for (int it2 = 0; it2 < 3; ++it2) {
+                    const float inv = 1.0f / best_s;
+                    const float qf  = sycl::clamp(sycl::round(v * inv + best_zp), 0.0f, 15.0f);
+                    const float w   = qf - best_zp;
+                    const float num = sycl::reduce_over_group(it.get_group(), v * w, sycl::plus<float>());
+                    const float den = sycl::reduce_over_group(it.get_group(), w * w, sycl::plus<float>());
+                    if (den > 0.0f && num > 0.0f) {
+                        const float s_new = num / den;
+                        const float zsum = sycl::reduce_over_group(it.get_group(),
+                            qf - v / s_new, sycl::plus<float>());
+                        best_s  = s_new;
+                        best_zp = sycl::clamp(sycl::round(zsum / (float) group), 0.0f, 15.0f);
+                    }
+                }
+                const float inv2 = 1.0f / best_s;
+                const float qf2  = sycl::clamp(sycl::round(v * inv2 + best_zp), 0.0f, 15.0f);
+                const float d2   = v - best_s * (qf2 - best_zp);
+                const float err2 = sycl::reduce_over_group(it.get_group(), d2 * d2, sycl::plus<float>());
+                if (err2 > best_err) {
+                    best_s  = grid_s;
+                    best_zp = grid_zp;
+                }
+                }
+            }
+
+            const float inv = best_s > 0.0f ? 1.0f / best_s : 0.0f;
+            const float qf  = best_s > 0.0f ? sycl::clamp(sycl::round(v * inv + best_zp), 0.0f, 15.0f) : 0.0f;
+            q[idx] = (uint8_t) qf;
+            if (it.get_local_id(0) == 0) {
+                // transposed [ngroups, n_rows] layout so it maps to oneDNN WEIGHTS scales [k/group, N]
+                scales[g * ldr + row0 + row] = (sycl::half) best_s;
+                zp[g * ldr + row0 + row]     = (uint8_t) best_zp;
+            }
+        });
+}
