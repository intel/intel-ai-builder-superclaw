+    dst_t * y = yy + b * 32 + 8 * il;
+#pragma unroll
+    for (int j = 0; j < 4; ++j) {
+        y[2 * j + 0] = d * kvalues_iq4nl[q[j] & 0xf];
+        y[2 * j + 1] = d * kvalues_iq4nl[q[j] >> 4];
+    }
