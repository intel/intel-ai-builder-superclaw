+// ---- Q3_K --------------------------------------------------------------------------------
+// w in the Q3_K SoA of reorder_qw: qs[nblk][64] | hmask[nblk][32] | scales[nblk][12] | d[nblk] (f16). Weight 16 s + l
+// of a block, s = 8 hf + 2 j + t, is d * (sc_s - 32) * (q3 - 4), q3 = bits 2j..2j+1 of qs[32 hf + 16 t + l] | bit
+// 4 hf + j of hmask[16 t + l] << 2 (see gemm_q3_K). A 32-k group is (hf, j), both t: its s8 B operand is 4 (q3 - 4)
+// per byte, ((4 q3 | 0x80) - 0x10) ^ 0x80 on whole dwords, and its two 16-k scale groups take a dpas each on half-zero
+// B operands, as in gemm_i8_q6_K. Blocks go in pairs, as the d plane holds two per dword. PFA as in gemm_i8_q4_K.
+// K % (512 * KS) == 0, N % (16 * NB * TW) == 0
+template <int TW, int TT, int RAST, int NB = 1, int MT = 8, int KS = 1, int PFA = 0>
+sycl::event gemm_i8_q3_K(sycl::queue & q, const uint8_t * w, const int8_t * aq, const float * as, float * dst, int M, int N,
+                         int K, const gemm_epi epi = {}, int gt = 0) {
+    static_assert(I8_MP % (8 * MT * TT) == 0, "a token panel must tile the rows the s8 activations are padded to");
+    const int      nsb  = K / 256;
+    const int      nss  = nsb / KS;   // blocks per k slice, even
+    const uint32_t nblk = (uint32_t) N * nsb;
+    const int      nkg  = K / 32;
+    const int      gn   = N / (16 * NB * TW);
+    const int      gm   = (M + 8 * MT * TT - 1) / (8 * MT * TT);
+    const int      gs   = gt >= 16 * MT * TT ? gt / (8 * MT * TT) : gt > 0 ? 1 : gm;
+    namespace sx = sycl::ext::oneapi::experimental;
+    sx::properties props{ sycl::ext::intel::experimental::grf_size<GRF> };
+
+    return q.parallel_for(sycl::nd_range<1>(sycl::range<1>((size_t) gn * gm * KS * TW * TT), sycl::range<1>(TW * TT)), props,
+        [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL {
+            const int lid = (int) it.get_local_id(0);
+            int wgk, gni, gmi;
+            i8_panels<RAST, KS>((int) it.get_group(0), gn, gm, gs, wgk, gni, gmi);
+            const int n0  = (gni * TW + lid % TW) * 16 * NB;
+            const int mt0 = (gmi * TT + lid / TW) * MT;
+            if (mt0 * 8 >= M) {
+                return;
+            }
+            const int sb0 = wgk * nss;
+
+            simd<float, 128> acc[NB * MT];
+            simd<float, 16>  sumS[NB * MT];   // the scales behind acc's bias
+#pragma unroll
+            for (int i = 0; i < NB * MT; ++i) {
+                acc[i]  = 0.0f;
+                sumS[i] = 0.0f;
+            }
+            const simd<int32_t, 128> magic = I8_MAGIC;
+            const uint32_t * w32 = (const uint32_t *) w;
+            simd<uint32_t, 16> oq[NB], oh[NB], os[NB], od[NB];
+#pragma unroll
+            for (int g = 0; g < NB; ++g) {
+                const simd<uint32_t, 16> blk = lane_rows(n0, g) * (uint32_t) nsb + (uint32_t) sb0;
+                oq[g] = blk * 64;
+                oh[g] = nblk * 64 + blk * 32;
+                os[g] = nblk * 96 + blk * 12;
+                od[g] = nblk * 108 + blk * 2;
+            }
+            const uint32_t * pa[MT];
+            const float *    ps[MT];
+#pragma unroll
+            for (int t = 0; t < MT; ++t) {
+                pa[t] = (const uint32_t *) (aq + ((size_t) (mt0 + t) * nkg + sb0 * 8) * 256);
+                ps[t] = as + (size_t) (mt0 + t) * nkg + sb0 * 8;
+            }
+            // the zero halves of the two B operands of a 32-k group never change
+            simd<uint32_t, 128> blo[NB], bhi[NB];
+#pragma unroll
+            for (int g = 0; g < NB; ++g) {
+                blo[g] = 0;
+                bhi[g] = 0;
+            }
+
+            for (int sp = 0; sp < nss; sp += 2) {
+                simd<uint32_t, 16> dd[NB];   // d of blocks sp, sp + 1
+#pragma unroll
+                for (int g = 0; g < NB; ++g) {
+                    dd[g] = gather<uint32_t, 16, 1>(w32, od[g]);
+                    od[g] += 4;
+                }
+#pragma unroll
+                for (int e = 0; e < 2; ++e) {
+                    if constexpr (PFA > 0) {   // the A tiles of the super-block PFA ahead into L1, a token tile per thread
+                        const int sbn = sp + e + PFA;
+                        if (sbn < nss) {
+                            namespace esx = sycl::ext::intel::esimd;
+#pragma unroll
+                            for (int t = 0; t < MT; ++t) {
+                                if (t % TW == lid % TW) {
+                                    const uint64_t * pf = (const uint64_t *) (aq + ((size_t) (mt0 + t) * nkg + (sb0 + sbn) * 8) * 256);
+#pragma unroll
+                                    for (int i = 0; i < 4; ++i) {
+                                        esx::prefetch<uint64_t, 64>(pf + 64 * i, sycl::ext::oneapi::experimental::properties{
+                                            esx::cache_hint_L1<esx::cache_hint::cached>, esx::cache_hint_L2<esx::cache_hint::cached> });
+                                    }
+                                }
+                            }
+                        }
+                    }
+                    simd<float, 16>     sc[NB][16];   // d (sc - 32) / 4 of the 16 scale groups
+                    simd<uint32_t, 256> rq[NB];       // qs, [dword][lane]
+                    simd<uint32_t, 128> rm[NB];       // hmask
+#pragma unroll
+                    for (int g = 0; g < NB; ++g) {
+                        simd<uint32_t, 48> rs = gather<uint32_t, 48, 3>(w32, os[g]);
+                        rq[g].template select<128, 1>(0)   = gather<uint32_t, 128, 8>(w32, oq[g]);
+                        rq[g].template select<128, 1>(128) = gather<uint32_t, 128, 8>(w32, oq[g] + 32);
+                        rm[g] = gather<uint32_t, 128, 8>(w32, oh[g]);
+                        os[g] += 12;
+                        oq[g] += 64;
+                        oh[g] += 32;
+                        const simd<sycl::half, 16> dh = dd[g].template bit_cast_view<sycl::half>().template select<16, 2>(e);
+                        const simd<float, 16>      d  = dh;
+                        // the 16 6-bit scales: low nibble from byte 4 (c % 2) + i (>> 4 for c >= 2), 2 bits from byte 8 + i
+                        auto s8 = rs.template bit_cast_view<uint8_t>();
+                        simd<uint16_t, 16> b8[12];
+#pragma unroll
+                        for (int b = 0; b < 12; ++b) {
+                            b8[b] = s8.template replicate_vs_w_hs<16, 4, 1, 0>((b / 4) * 64 + b % 4);
+                        }
+#pragma unroll
+                        for (int is = 0; is < 16; ++is) {
+                            const int c = is / 4, i = is % 4;
+                            const simd<uint16_t, 16> scv =
+                                ((b8[4 * (c % 2) + i] >> (4 * (c / 2))) & 0xF) | (((b8[8 + i] >> (2 * c)) & 3) << 4);
+                            sc[g][is] = d * (convert<float>(scv) - 32.0f) * 0.25f;   // the B operand is 4 (q3 - 4)
+                        }
+                    }
+                    simd<float, 8> sa[MT];
+#pragma unroll
+                    for (int t = 0; t < MT; ++t) {
+                        sa[t] = block_load<float, 8>(ps[t]);
+                        ps[t] += 8;
+                    }
+#pragma unroll
+                    for (int hf = 0; hf < 2; ++hf) {
+#pragma unroll
+                        for (int j = 0; j < 4; ++j) {
+                            const int hb = 4 * hf + j;
+#pragma unroll
+                            for (int g = 0; g < NB; ++g) {
+                                simd<uint32_t, 128> qsl = rq[g].template select<128, 1>(128 * hf);
+                                const int sq = 2 - 2 * j, sh = 4 - hb;   // bits 2j.. of qs -> bits 2, 3; hmask bit hb -> bit 4
+                                const simd<uint32_t, 128> q2s = sq >= 0 ? simd<uint32_t, 128>((qsl << sq) & 0x0C0C0C0Cu)
+                                                                        : simd<uint32_t, 128>((qsl >> -sq) & 0x0C0C0C0Cu);
+                                const simd<uint32_t, 128> h4  = sh >= 0 ? simd<uint32_t, 128>((rm[g] << sh) & 0x10101010u)
+                                                                        : simd<uint32_t, 128>((rm[g] >> -sh) & 0x10101010u);
+                                simd<uint32_t, 128> b = ((q2s | h4 | 0x80808080u) - 0x10101010u) ^ 0x80808080u;   // 4 q3 - 16
+                                blo[g].template select<64, 1>(0)  = b.template select<64, 1>(0);
+                                bhi[g].template select<64, 1>(64) = b.template select<64, 1>(64);
+                            }
+                            simd<uint32_t, 64> a[MT];
+#pragma unroll
+                            for (int t = 0; t < MT; ++t) {
+                                a[t] = block_load<uint32_t, 64>(pa[t]);
+                                pa[t] += 64;
+                            }
+                            const int js = 8 * hf + 2 * j;   // the scale group of the group's first 16 k
+#pragma unroll
+                            for (int t = 0; t < MT; ++t) {
+                                const float sv = sa[t][hb];
+#pragma unroll
+                                for (int g = 0; g < NB; ++g) {
+                                    simd<int32_t, 128> I0 = xmx::dpas<8, 8, int32_t, int32_t, uint32_t, uint32_t,
+                                                                      xmx::dpas_argument_type::s8, xmx::dpas_argument_type::s8>(
+                                        magic, blo[g], a[t]);
+                                    simd<int32_t, 128> I1 = xmx::dpas<8, 8, int32_t, int32_t, uint32_t, uint32_t,
+                                                                      xmx::dpas_argument_type::s8, xmx::dpas_argument_type::s8>(
+                                        magic, bhi[g], a[t]);
+                                    const simd<float, 16> S0 = sc[g][js] * sv;
+                                    const simd<float, 16> S1 = sc[g][js + 1] * sv;
+                                    i8_acc(acc[g * MT + t], I0, S0);
+                                    i8_acc(acc[g * MT + t], I1, S1);
+                                    sumS[g * MT + t] += S0 + S1;
+                                }
+                            }
+                        }
+                    }
+#pragma unroll
+                    for (int i = 0; i < NB * MT; ++i) {
+                        i8_unbias(acc[i], sumS[i]);
+                    }
+                }
+            }
+            store_split<NB, MT, KS>(acc, dst, epi, wgk, mt0, M, N, n0);
+        });
+}
+
+// ---- Q6_K --------------------------------------------------------------------------------
+// w in the Q6_K SoA of reorder_qw: ql[nblk][128] | qh[nblk][64] | scales[nblk][16] (s8) | d[nblk] (f16). Weight
+// 128 n + 32 r + l of a block is d * sc[8 n + 2 r + l / 16] * (q6 - 32), q6 = nibble (r >= 2) of ql[64 n + 32 (r & 1) + l]
+// | bits 2r..2r+1 of qh[32 n + l] << 4, so a 32-k group is (n, r) and its s8 B operand is 4 (q6 - 32) per byte,
+// (4 q6) ^ 0x80 on whole dwords: 4x the units of I for the epilogue's rounding (see i8_acc), in fewer instructions than
+// q6 - 32. Its two 16-k scale groups take a dpas each, on B operands whose other half is zero. Blocks go in pairs, as
+// the d plane holds two per dword. PFA as in gemm_i8_q4_K. K % (512 * KS) == 0, N % (16 * NB * TW) == 0
+template <int TW, int TT, int RAST, int NB = 1, int MT = 8, int KS = 1, int PFA = 0>
+sycl::event gemm_i8_q6_K(sycl::queue & q, const uint8_t * w, const int8_t * aq, const float * as, float * dst, int M, int N,
+                         int K, const gemm_epi epi = {}, int gt = 0) {
+    static_assert(I8_MP % (8 * MT * TT) == 0, "a token panel must tile the rows the s8 activations are padded to");
+    const int      nsb  = K / 256;
+    const int      nss  = nsb / KS;   // blocks per k slice, even
+    const uint32_t nblk = (uint32_t) N * nsb;
+    const int      nkg  = K / 32;
+    const int      gn   = N / (16 * NB * TW);
+    const int      gm   = (M + 8 * MT * TT - 1) / (8 * MT * TT);
+    const int      gs   = gt >= 16 * MT * TT ? gt / (8 * MT * TT) : gt > 0 ? 1 : gm;
+    namespace sx = sycl::ext::oneapi::experimental;
+    sx::properties props{ sycl::ext::intel::experimental::grf_size<GRF> };
+
+    return q.parallel_for(sycl::nd_range<1>(sycl::range<1>((size_t) gn * gm * KS * TW * TT), sycl::range<1>(TW * TT)), props,
+        [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL {
+            const int lid = (int) it.get_local_id(0);
+            int wgk, gni, gmi;
+            i8_panels<RAST, KS>((int) it.get_group(0), gn, gm, gs, wgk, gni, gmi);
+            const int n0  = (gni * TW + lid % TW) * 16 * NB;
+            const int mt0 = (gmi * TT + lid / TW) * MT;
+            if (mt0 * 8 >= M) {
+                return;
+            }
+            const int sb0 = wgk * nss;
+
+            simd<float, 128> acc[NB * MT];
+            simd<float, 16>  sumS[NB * MT];   // the scales behind acc's bias
+#pragma unroll
+            for (int i = 0; i < NB * MT; ++i) {
+                acc[i]  = 0.0f;
+                sumS[i] = 0.0f;
+            }
+            const simd<int32_t, 128> magic = I8_MAGIC;
+            const uint32_t * w32 = (const uint32_t *) w;
+            simd<uint32_t, 16> ol[NB], oh[NB], os[NB], od[NB];
+#pragma unroll
+            for (int g = 0; g < NB; ++g) {
+                const simd<uint32_t, 16> blk = lane_rows(n0, g) * (uint32_t) nsb + (uint32_t) sb0;
+                ol[g] = blk * 128;
+                oh[g] = nblk * 128 + blk * 64;
+                os[g] = nblk * 192 + blk * 16;
+                od[g] = nblk * 208 + blk * 2;
+            }
+            const uint32_t * pa[MT];
+            const float *    ps[MT];
+#pragma unroll
+            for (int t = 0; t < MT; ++t) {
+                pa[t] = (const uint32_t *) (aq + ((size_t) (mt0 + t) * nkg + sb0 * 8) * 256);
+                ps[t] = as + (size_t) (mt0 + t) * nkg + sb0 * 8;
+            }
+            // the zero halves of the two B operands of a 32-k group never change
+            simd<uint32_t, 128> blo[NB], bhi[NB];
+#pragma unroll
+            for (int g = 0; g < NB; ++g) {
+                blo[g] = 0;
+                bhi[g] = 0;
+            }
+
+            for (int sp = 0; sp < nss; sp += 2) {
+                simd<uint32_t, 16> dd[NB];   // d of blocks sp, sp + 1
+#pragma unroll
+                for (int g = 0; g < NB; ++g) {
+                    dd[g] = gather<uint32_t, 16, 1>(w32, od[g]);
+                    od[g] += 4;
+                }
+#pragma unroll
+                for (int e = 0; e < 2; ++e) {
+                    if constexpr (PFA > 0) {   // the A tiles of the super-block PFA ahead into L1, a token tile per thread
+                        const int sbn = sp + e + PFA;
+                        if (sbn < nss) {
+                            namespace esx = sycl::ext::intel::esimd;
+#pragma unroll
+                            for (int t = 0; t < MT; ++t) {
+                                if (t % TW == lid % TW) {
+                                    const uint64_t * pf = (const uint64_t *) (aq + ((size_t) (mt0 + t) * nkg + (sb0 + sbn) * 8) * 256);
+#pragma unroll
+                                    for (int i = 0; i < 4; ++i) {
+                                        esx::prefetch<uint64_t, 64>(pf + 64 * i, sycl::ext::oneapi::experimental::properties{
+                                            esx::cache_hint_L1<esx::cache_hint::cached>, esx::cache_hint_L2<esx::cache_hint::cached> });
+                                    }
+                                }
+                            }
+                        }
+                    }
+                    simd<float, 16> sc[NB][16];   // d * the 16 scales
+#pragma unroll
+                    for (int g = 0; g < NB; ++g) {
+                        simd<uint32_t, 64> st = gather<uint32_t, 64, 4>(w32, os[g]);
+                        os[g] += 16;
+                        auto s8 = st.template bit_cast_view<int8_t>();
+                        const simd<sycl::half, 16> dh = dd[g].template bit_cast_view<sycl::half>().template select<16, 2>(e);
+                        const simd<float, 16> d = dh;
+#pragma unroll
+                        for (int j = 0; j < 16; ++j) {
+                            const simd<int16_t, 16> sj = s8.template replicate_vs_w_hs<16, 4, 1, 0>((j / 4) * 64 + j % 4);
+                            sc[g][j] = d * convert<float>(sj) * 0.25f;   // the B operand is 4 (q6 - 32)
+                        }
+                    }
+                    simd<float, 8> sa[MT];
+#pragma unroll
+                    for (int t = 0; t < MT; ++t) {
+                        sa[t] = block_load<float, 8>(ps[t]);
+                        ps[t] += 8;
+                    }
+#pragma unroll
+                    for (int n = 0; n < 2; ++n) {
+                        simd<uint32_t, 256> ql[NB];   // ql[64 n ..] as [dword][lane]
+                        simd<uint32_t, 128> qh[NB];   // qh[32 n ..]
+#pragma unroll
+                        for (int g = 0; g < NB; ++g) {
+                            ql[g].template select<128, 1>(0)   = gather<uint32_t, 128, 8>(w32, ol[g] + 64 * n);
+                            ql[g].template select<128, 1>(128) = gather<uint32_t, 128, 8>(w32, ol[g] + 64 * n + 32);
+                            qh[g] = gather<uint32_t, 128, 8>(w32, oh[g] + 32 * n);
+                        }
+#pragma unroll
+                        for (int r = 0; r < 4; ++r) {
+#pragma unroll
+                            for (int g = 0; g < NB; ++g) {
+                                simd<uint32_t, 128> lo = ql[g].template select<128, 1>(128 * (r & 1));
+                                const simd<uint32_t, 128> nib4 = r < 2 ? simd<uint32_t, 128>((lo << 2) & 0x3C3C3C3Cu)
+                                                                       : simd<uint32_t, 128>((lo >> 2) & 0x3C3C3C3Cu);
+                                const simd<uint32_t, 128> hb4 = ((qh[g] >> (2 * r)) & 0x03030303u) << 6;
+                                simd<uint32_t, 128>       b   = (nib4 | hb4) ^ 0x80808080u;   // 4 q6 - 128
+                                blo[g].template select<64, 1>(0)  = b.template select<64, 1>(0);
+                                bhi[g].template select<64, 1>(64) = b.template select<64, 1>(64);
+                            }
+                            simd<uint32_t, 64> a[MT];
+#pragma unroll
+                            for (int t = 0; t < MT; ++t) {
+                                a[t] = block_load<uint32_t, 64>(pa[t]);
+                                pa[t] += 64;
+                            }
+                            const int j = 8 * n + 2 * r;   // the scale of the group's first 16 k
+#pragma unroll
+                            for (int t = 0; t < MT; ++t) {
+                                const float sv = sa[t][4 * n + r];
+#pragma unroll
+                                for (int g = 0; g < NB; ++g) {
+                                    simd<int32_t, 128> I0 = xmx::dpas<8, 8, int32_t, int32_t, uint32_t, uint32_t,
+                                                                      xmx::dpas_argument_type::s8, xmx::dpas_argument_type::s8>(
+                                        magic, blo[g], a[t]);
+                                    simd<int32_t, 128> I1 = xmx::dpas<8, 8, int32_t, int32_t, uint32_t, uint32_t,
+                                                                      xmx::dpas_argument_type::s8, xmx::dpas_argument_type::s8>(
+                                        magic, bhi[g], a[t]);
+                                    const simd<float, 16> S0 = sc[g][j] * sv;
+                                    const simd<float, 16> S1 = sc[g][j + 1] * sv;
+                                    i8_acc(acc[g * MT + t], I0, S0);
+                                    i8_acc(acc[g * MT + t], I1, S1);
+                                    sumS[g * MT + t] += S0 + S1;
+                                }
+                            }
+                        }
+                    }
+#pragma unroll
+                    for (int g = 0; g < NB; ++g) {
+                        ol[g] += 128;
+                        oh[g] += 64;
+                    }
+#pragma unroll
+                    for (int i = 0; i < NB * MT; ++i) {
+                        i8_unbias(acc[i], sumS[i]);
+                    }
+                }
+            }
+            store_split<NB, MT, KS>(acc, dst, epi, wgk, mt0, M, N, n0);
+        });
+}
+
