+// Direct I/O reader for the PLE n-gram table: fetches and dequantizes single rows straight from the
+// GGUF split on demand, so the ~27GB table is never resident in RAM. On Windows it uses
+// FILE_FLAG_NO_BUFFERING to bypass the page cache (keeping RAM free for the MoE expert streaming);
+// elsewhere it falls back to a plain per-row read, which still avoids loading the whole table.
+struct llama_ple_reader {
+    llama_ple_disk_source     src;
+    const ggml_type_traits *  traits = nullptr;
+#ifdef _WIN32
+    HANDLE    fh     = INVALID_HANDLE_VALUE;
+    uint8_t * abuf   = nullptr;   // sector-aligned scratch (up to two sectors)
+    uint32_t  sector = 4096;
+#else
+    FILE *               fp = nullptr;
+    std::vector<uint8_t> buf;
+#endif
+
+    explicit llama_ple_reader(const llama_ple_disk_source & s) : src(s) {
+        traits = ggml_get_type_traits(src.type);
+        open();
+    }
+    ~llama_ple_reader() { close(); }
+    llama_ple_reader(const llama_ple_reader &) = delete;
+    llama_ple_reader & operator=(const llama_ple_reader &) = delete;
+
+    bool ok() const {
+        if (!traits || !traits->to_float) return false;
+#ifdef _WIN32
+        return fh != INVALID_HANDLE_VALUE && abuf != nullptr;
+#else
+        return fp != nullptr;
+#endif
+    }
+
+    void open() {
+#ifdef _WIN32
+        fh = CreateFileA(src.file_path.c_str(), GENERIC_READ, FILE_SHARE_READ, nullptr,
+                         OPEN_EXISTING, FILE_FLAG_NO_BUFFERING | FILE_FLAG_RANDOM_ACCESS, nullptr);
+        if (fh == INVALID_HANDLE_VALUE) return;
+        char root[4] = { src.file_path[0], ':', '\\', 0 };
+        DWORD spc = 0, bps = 0, fc = 0, tc = 0;
+        if (GetDiskFreeSpaceA(root, &spc, &bps, &fc, &tc) && bps != 0) sector = bps;
+        abuf = (uint8_t *) _aligned_malloc((size_t) sector * 2, sector);
+#else
+        fp = fopen(src.file_path.c_str(), "rb");
+        buf.resize(src.row_size);
+#endif
+    }
+
+    void close() {
+#ifdef _WIN32
+        if (abuf) { _aligned_free(abuf); abuf = nullptr; }
+        if (fh != INVALID_HANDLE_VALUE) { CloseHandle(fh); fh = INVALID_HANDLE_VALUE; }
+#else
+        if (fp) { fclose(fp); fp = nullptr; }
