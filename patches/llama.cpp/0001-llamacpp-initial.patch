+// mul_mat_vec_q_reorder for a few rows: a row per work-group, split over its nsg sub-groups and reduced in SLM. With a
+// row per sub-group a small matrix leaves the GPU nearly idle and each sub-group walks its row in serial load -> dot
+// rounds nothing hides; on B70 a 48 x 5120 Q8_0 gemv (the delta-net alpha/beta projections) cost 9.1 us inside a
+// decode stream and 2.7 us split over 16 sub-groups
+// the dot product of row `row`, valid in sub-group 0 of the work-group
+template <typename reorder_vec_dot_q_sycl>
+static float mul_mat_vec_q_reorder_ksplit_row(const void * __restrict__ vx, const void * __restrict__ vy,
+                                              const int ncols, const int nrows, const int row, const int nsg,
+                                              float * part, const sycl::nd_item<3> & nd_item) {
+    using block_type   = ggml_sycl_reordered::block_q_t<reorder_vec_dot_q_sycl::gtype>;
+    using block_traits = typename block_type::traits;
+
+    const auto sg = nd_item.get_sub_group();
+    const int  s  = sg.get_group_linear_id();
+
+    const int     blocks_per_row              = ncols / block_traits::qk;
+    constexpr int blocks_per_subgroup         = ceil_div(block_traits::vdr_mmvq * WARP_SIZE, block_traits::qi);
+    constexpr int block_elements_per_subgroup = block_traits::qi / block_traits::vdr_mmvq;
+    const int     nblocks                     = nrows * (ncols / block_traits::qk);
+
+    float partial_sum = 0.0f;
+    for (int i = s * blocks_per_subgroup + sg.get_local_linear_id() / block_elements_per_subgroup; i < blocks_per_row;
+         i += nsg * blocks_per_subgroup) {
+        const int ibx = row * blocks_per_row + i;
+
+        const auto         bx_offset      = block_type::get_block_offset(ibx, nblocks);
+        const auto         d_offset       = block_type::get_d_offset(nrows, ncols, ibx);
+        const int          iby            = i * block_type::block_to_q8_1_ratio();
+        const int8_t *     q8_1_quant_ptr = (const int8_t *) vy + iby * QK8_1;
+        const sycl::half2 * q8_1_ds_ptr   = (const sycl::half2 *) ((const char *) vy + ncols + iby * sizeof(sycl::half2));
+
+#pragma unroll
+        for (int elem = 0; elem < block_elements_per_subgroup; elem += WARP_SIZE) {
+            const int iqs = elem + block_traits::vdr_mmvq * (sg.get_local_linear_id() % block_elements_per_subgroup);
+            partial_sum += reorder_vec_dot_q_sycl()(vx, bx_offset, d_offset, q8_1_quant_ptr, q8_1_ds_ptr, iqs);
+        }
+    }
+
+    partial_sum = sycl::reduce_over_group(sg, partial_sum, std::plus<>());
+    if (sg.leader()) {
+        part[s] = partial_sum;
+    }
+    sycl::group_barrier(nd_item.get_group());
+    const int l = sg.get_local_linear_id();
+    return sycl::reduce_over_group(sg, s == 0 && l < nsg ? part[l] : 0.0f, std::plus<>());
+}
+
+template <typename reorder_vec_dot_q_sycl>
+static void mul_mat_vec_q_reorder_ksplit(const void * __restrict__ vx, const void * __restrict__ vy,
+                                         float * __restrict__ dst, const int ncols, const int nrows, const int nsg,
+                                         float * part, const sycl::nd_item<3> & nd_item) {
+    const int   row = nd_item.get_group_linear_id();
+    const float t   = mul_mat_vec_q_reorder_ksplit_row<reorder_vec_dot_q_sycl>(vx, vy, ncols, nrows, row, nsg, part,
+                                                                              nd_item);
+    const auto  sg  = nd_item.get_sub_group();
+    if (sg.get_group_linear_id() == 0 && sg.leader()) {
+        dst[row] = t;
+    }
+}
+
+// the delta-net gate and beta of one token: work-groups [0, nrows) take the rows of wa (ssm_alpha) and write
+// gate = softplus(alpha + dt) * a, work-groups [nrows, 2 nrows) those of wb (ssm_beta) and write beta = sigmoid(beta).
+// The partial sums and the formulas are those of the unfused gemvs and ADD + SOFTPLUS + MUL / SIGMOID
+template <typename reorder_vec_dot_q_sycl>
+static void mul_mat_vec_q_reorder_gdn_gate_beta(const void * __restrict__ wa, const void * __restrict__ wb,
+                                                const void * __restrict__ vy, const float * __restrict__ dt,
+                                                const float * __restrict__ a, float * __restrict__ gate,
+                                                float * __restrict__ beta, const int ncols, const int nrows,
+                                                const int stride_col_y_bytes, const int nsg, float * part,
+                                                const sycl::nd_item<3> & nd_item) {
+    const int   g   = nd_item.get_group_linear_id();
+    const int   c   = g / (2 * nrows);   // the token
+    const int   r   = g % (2 * nrows);
+    const bool  isb = r >= nrows;
+    const int   row = isb ? r - nrows : r;
+    const float t   = mul_mat_vec_q_reorder_ksplit_row<reorder_vec_dot_q_sycl>(
+        isb ? wb : wa, (const char *) vy + (size_t) c * stride_col_y_bytes, ncols, nrows, row, nsg, part, nd_item);
+    const auto  sg  = nd_item.get_sub_group();
+    if (sg.get_group_linear_id() == 0 && sg.leader()) {
+        if (isb) {
+            beta[c * nrows + row] = op_sigmoid(t);
+        } else {
+            gate[c * nrows + row] = op_softplus(t + dt[row]) * a[row];
+        }
+    }
+}
+
+// sub-groups per row for a single-column reorder gemv: enough to give the device's hardware threads (8 per EU) a
+// sub-group each, at most WARP_SIZE; 1 keeps mul_mat_vec_q_reorder. Measured on B70 (2048 threads) with Q8_0 at
+// K = 5120, the best split was 16 at 48 rows, 8 at 192, 4 at 384 and 2 at 768, with no gain from 1536 rows on
+static int mmvq_reorder_nsg(const int nrows) {
+    const int threads = ggml_sycl_info().devices[get_current_device_id()].nsm * 16 * 8;
+    int       nsg     = 1;
+    while (nsg < WARP_SIZE && 2 * nsg * nrows <= threads) {
+        nsg *= 2;
+    }
+    return nsg;
+}
+
+template <typename reorder_vec_dot_q_sycl>
+static void launch_mul_mat_vec_q_reorder_ksplit(const void * vx, const void * vy, float * dst, const int ncols,
+                                                const int nrows, const int nsg, dpct::queue_ptr stream) {
+    const sycl::range<3> block_nums(1, 1, nrows);
+    const sycl::range<3> block_dims(1, 1, nsg * WARP_SIZE);
+    stream->submit([&](sycl::handler & cgh) {
+        sycl::local_accessor<float, 1> part(sycl::range<1>(nsg), cgh);
+        cgh.parallel_for(sycl::nd_range<3>(block_nums * block_dims, block_dims),
+                         [=](sycl::nd_item<3> nd_item) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+                             mul_mat_vec_q_reorder_ksplit<reorder_vec_dot_q_sycl>(vx, vy, dst, ncols, nrows, nsg,
+                                                                                  get_pointer(part), nd_item);
+                         });
+    });
+}
