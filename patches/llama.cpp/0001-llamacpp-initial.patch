+// Fused MoE block. The gemms run on the native dpas kernels; the oneDNN grouped
+// matmul is only a fallback and needs DNNL_EXPERIMENTAL_GROUPED_MEMORY.
+// silu(gate) * up over the fused gate_up gemm output (rows x 2*n_ff f16, halves [gate|up]),
+// emitted as f16 so it feeds the down gemm directly
+static void k_moe_swiglu_to_f16(const sycl::half * gu, sycl::half * out,
+                                const int64_t n_ff, const int64_t n_rows, queue_ptr stream) {
+    constexpr int wg = 256;
+    stream->parallel_for(
+        sycl::nd_range<1>(sycl::range<1>(n_rows * wg), sycl::range<1>(wg)),
+        [=](sycl::nd_item<1> it) {
+            const int64_t row = it.get_group(0);
+            const sycl::half * g = gu + row * 2 * n_ff;
+            sycl::half       * o = out + row * n_ff;
+            for (int64_t j = it.get_local_id(0); j < n_ff; j += wg) {
+                const float x = (float) g[j];
+                o[j] = (sycl::half) (x / (1.0f + sycl::exp(-x)) * (float) g[n_ff + j]);
+            }
+        });
+}
