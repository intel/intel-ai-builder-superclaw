+// ---- default-path MoE weighted-reduce fusion (no DNNL required) -------------
+// The non-DNN MoE tail emitted by build_moe_ffn is:
+//   down = MUL_MAT_ID(...)            [d, topk, n_tok]   (f32, natural token order)
+//   mul  = MUL(down, weights)         weights [1, topk, n_tok]
+//   VIEW x topk  (slice each expert slot of mul) -> ADD x (topk-1) -> acc [d, n_tok]
+//   [optional trailing residual ADD]
+// That is 1 MUL + (topk-1) ADD launches per MoE layer (~8/layer, ~320/token for
+// 40 layers top-8) plus the elementwise GPU cost. Collapse it into ONE kernel that
+// reads the mmvq down output straight from its natural [d, topk, n_tok] layout
+// (no gather / no inv-permute; unlike the DNN block the rows are not expert-sorted).
+struct moe_reduce_nodes {
+    ggml_tensor * down;       // MUL_MAT_ID output, [d, topk, n_tok] f32
+    ggml_tensor * weights;    // [1, topk, n_tok] f32 contiguous
+    ggml_tensor * residual;   // folded trailing residual add src, or null
+    ggml_tensor * out;        // final tensor to write, [d, n_tok]
+    int           count;      // graph nodes consumed starting at the MUL
+};
+
+// out[j,t] = [residual[j,t] +] sum_s weights[s,t] * down[j,s,t]
+// One work-item per output element (grid = n_tokens*ne0) so decode (n_tokens==1)
+// still fills many work-groups instead of one; consecutive lanes read consecutive
+// j within an expert slot -> coalesced.
+static void k_moe_reduce_natural(const float * down, const float * weights,
+                                 const float * residual, float * out,
+                                 const int64_t ne0, const int64_t topk, const int64_t n_tokens,
+                                 const int64_t down_s1, const int64_t down_s2,
+                                 const int64_t w_s1, const int64_t w_s2, queue_ptr stream) {
+    constexpr int wg = 256;
+    const int64_t total = n_tokens * ne0;
+    const int64_t groups = (total + wg - 1) / wg;
+    stream->parallel_for(
+        sycl::nd_range<1>(sycl::range<1>(groups * wg), sycl::range<1>(wg)),
+        [=](sycl::nd_item<1> it) {
+            const int64_t idx = it.get_global_id(0);
+            if (idx >= total) return;
+            const int64_t t = idx / ne0;
+            const int64_t j = idx % ne0;
+            const float * d = down + t * down_s2 + j;
+            const float * ws = weights + t * w_s2;
+            float acc = residual ? residual[t * ne0 + j] : 0.0f;
+            for (int64_t s = 0; s < topk; ++s) acc += ws[s * w_s1] * d[s * down_s1];
+            out[t * ne0 + j] = acc;
+        });
+}
+
+// Matches the MUL(weights)->VIEW x topk->ADD x(topk-1)[->residual ADD] tail starting
+// at node[i] (a MUL whose src[0] is a MUL_MAT_ID). Mirrors the tail checks in
+// ggml_sycl_moe_fused_match so both fusions agree on the graph shape.
+static bool ggml_sycl_moe_reduce_match(const ggml_cgraph * g, int i, moe_reduce_nodes & m) {
+    ggml_tensor * mul = g->nodes[i];
+    if (mul->op != GGML_OP_MUL) return false;
+    ggml_tensor * down = mul->src[0];
+    ggml_tensor * w    = mul->src[1];
+    if (!down || !w || down->op != GGML_OP_MUL_MAT_ID) return false;
+    if (down->type != GGML_TYPE_F32 || !ggml_is_contiguous(down)) return false;
+    if (w->type != GGML_TYPE_F32 || !ggml_is_contiguous(w)) return false;
+
+    const int64_t topk = down->ne[1];
+    if (topk < 2 || topk > 16) return false;
+    const int64_t n_tok = down->ne[2];
+    if (w->ne[0] != 1 || w->ne[1] != topk || w->ne[2] != n_tok) return false;
+    if (mul->type != GGML_TYPE_F32) return false;
+
+    int count = (int) (1 + topk + (topk - 1));   // MUL + VIEWs + ADDs
+    if (i + count > g->n_nodes) return false;
+
+    ggml_op ops[38];
+    int n_ops = 0;
+    ops[n_ops++] = GGML_OP_MUL;
+    for (int64_t k = 0; k < topk; ++k)     ops[n_ops++] = GGML_OP_VIEW;
+    for (int64_t k = 0; k < topk - 1; ++k) ops[n_ops++] = GGML_OP_ADD;
+    int out_idx = i + count - 1;
+    if (!ggml_can_fuse_subgraph(g, i, count, ops, &out_idx, 1)) return false;
+
+    const int64_t d = down->ne[0];
+    for (int64_t k = 0; k < topk; ++k) {
+        ggml_tensor * v = g->nodes[i + 1 + k];
+        if (v->src[0] != mul) return false;
+        if (v->ne[0] != d || v->ne[1] != n_tok) return false;
+        if (v->view_offs != (size_t) (k * mul->nb[1])) return false;
+        if (v->nb[1] != mul->nb[2]) return false;
+    }
+    ggml_tensor * acc = g->nodes[i + 1 + topk];
+    if (acc->src[0] != g->nodes[i + 1] || acc->src[1] != g->nodes[i + 2]) return false;
+    for (int64_t k = 1; k < topk - 1; ++k) {
+        ggml_tensor * a = g->nodes[i + 1 + topk + k];
+        if (a->src[0] != g->nodes[i + 1 + topk + k - 1]) return false;
+        if (a->src[1] != g->nodes[i + 2 + k]) return false;
+        acc = a;
+    }
+    if (acc->type != GGML_TYPE_F32 || !ggml_is_contiguous(acc)) return false;
+
+    // fold a directly following residual add into the reduce when possible
+    ggml_tensor * residual = nullptr;
+    ggml_tensor * out = acc;
+    if (i + count < g->n_nodes) {
+        ggml_tensor * res_add = g->nodes[i + count];
+        ggml_tensor * other = res_add->src[0] == acc ? res_add->src[1]
+                            : res_add->src[1] == acc ? res_add->src[0] : nullptr;
+        if (res_add->op == GGML_OP_ADD && other && other->type == GGML_TYPE_F32 &&
+            res_add->type == GGML_TYPE_F32 && ggml_are_same_shape(res_add, acc) &&
+            ggml_are_same_shape(other, acc) && ggml_is_contiguous(other) &&
+            ggml_is_contiguous(res_add)) {
+            ops[n_ops++] = GGML_OP_ADD;
+            int out_idx2 = i + count;
+            if (ggml_can_fuse_subgraph(g, i, count + 1, ops, &out_idx2, 1)) {
+                residual = other;
+                out = res_add;
+                count += 1;
+            }
+        }
+    }
+
+    m = { down, w, residual, out, count };
+    return true;
+}
+
+// Runs the matched reduce. Reads down + weights (both dead after this block, so the
+// graph allocator may alias m.out onto either) and writes m.out. Weights are tiny
+// -> always copied. For down, write direct when m.out is disjoint, else stage through
+// a temp buffer so the aliased down stays intact during the reduce.
+static bool ggml_sycl_moe_reduce_exec(ggml_backend_sycl_context & ctx, const moe_reduce_nodes & m) try {
+    ggml_tensor * down = m.down;
+    ggml_tensor * w    = m.weights;
+    const queue_ptr stream = ctx.stream();
+
+    const int64_t d     = down->ne[0];
+    const int64_t topk  = down->ne[1];
+    const int64_t n_tok = down->ne[2];
+    const int64_t down_s1 = down->nb[1] / sizeof(float);
+    const int64_t down_s2 = down->nb[2] / sizeof(float);
+    const int64_t w_s1    = w->nb[1] / sizeof(float);
+    const int64_t w_s2    = w->nb[2] / sizeof(float);
+
+    // copy weights out of harm's way (m.out may alias them)
+    ggml_sycl_pool_alloc<float> w_copy(ctx.pool(), (size_t) topk * n_tok);
+    SYCL_CHECK(CHECK_TRY_ERROR(stream->memcpy(w_copy.get(), w->data, (size_t) topk * n_tok * sizeof(float))));
+    // weights are now contiguous [topk, n_tok]
+    const int64_t wc_s1 = 1, wc_s2 = topk;
+
+    const float * residual = m.residual ? (const float *) m.residual->data : nullptr;
+
+    const char * db = (const char *) down->data;
+    const char * ob = (const char *) m.out->data;
+    const bool out_disjoint_down = ob + ggml_nbytes(m.out) <= db || db + ggml_nbytes(down) <= ob;
+    // residual folded in the reduce must not alias down either (it is read per token)
+    bool res_ok = true;
+    if (residual) {
+        const char * rb = (const char *) m.residual->data;
+        res_ok = rb + ggml_nbytes(m.residual) <= db || db + ggml_nbytes(down) <= rb
+                 || rb == ob;   // residual==out (in-place add) is fine: read then overwrite
+    }
+
+    if (out_disjoint_down && res_ok) {
+        k_moe_reduce_natural((const float *) down->data, w_copy.get(), residual,
+                             (float *) m.out->data, d, topk, n_tok,
+                             down_s1, down_s2, wc_s1, wc_s2, stream);
+    } else {
+        ggml_sycl_pool_alloc<float> tmp(ctx.pool(), (size_t) d * n_tok);
+        k_moe_reduce_natural((const float *) down->data, w_copy.get(), residual,
+                             tmp.get(), d, topk, n_tok,
+                             down_s1, down_s2, wc_s1, wc_s2, stream);
+        SYCL_CHECK(CHECK_TRY_ERROR(stream->memcpy(m.out->data, tmp.get(), (size_t) d * n_tok * sizeof(float))));
+        SYCL_CHECK(CHECK_TRY_ERROR(stream->wait()));   // tmp freed on return
+    }
+    return true;
+} catch (const sycl::exception & e) {
+    fprintf(stderr, "[MOE_REDUCE] sycl error, falling back: %s\n", e.what());
+    return false;
+}
+
+// GDN state round-trip elision: the graph gathers each sequence's recurrent state
+// with GET_ROWS, runs GATED_DELTA_NET on the copy and CPYs the new state back into
+// the cache (a contiguous same-type copy = one device memcpy per layer per token).
+// The kernel can read the cache rows directly (ids indexed on the device) and write
+// the final state straight to the CPY destination, so both nodes are skipped.
+// entries cache TENSOR OBJECT pointers, never data pointers: rebuilt graphs reuse the
+// same tensor objects (arena) but gallocr moves ->data as the kv views grow with n_past
+struct gdn_state_fuse {
+    const ggml_tensor * get_rows;
+    const ggml_tensor * cpy;
+    const ggml_tensor * rows_src;   // recurrent cache rows (data/strides read fresh per call)
+    const ggml_tensor * ids;
+    const ggml_tensor * dst_view;   // cpy destination view into the cache
+    int64_t             ids_offset; // element offset of the staged copy in gdn_ids_buf
+};
+
+static const ggml_tensor * gdn_unwrap_views(const ggml_tensor * t) {
+    while (t != nullptr && (t->op == GGML_OP_RESHAPE || t->op == GGML_OP_VIEW ||
+                            t->op == GGML_OP_PERMUTE || t->op == GGML_OP_TRANSPOSE)) {
+        t = t->src[0];
+    }
+    return t;
+}
+
+static bool ggml_sycl_gdn_state_match(const ggml_cgraph * g, int i, gdn_state_fuse & f) {
+    const ggml_tensor * gdn = g->nodes[i];
+    if (gdn->type != GGML_TYPE_F32) return false;
+    const int K = ggml_get_op_params_i32(gdn, 0);
+    if (K < 1) return false;
+
+    const ggml_tensor * src_state = gdn->src[5];
+    if (src_state->op != GGML_OP_RESHAPE && src_state->op != GGML_OP_VIEW) return false;
+    const ggml_tensor * gr = src_state->src[0];
+    if (gr == nullptr || gr->op != GGML_OP_GET_ROWS || gr->type != GGML_TYPE_F32) return false;
+    if (src_state->data != gr->data || ggml_nelements(src_state) != ggml_nelements(gr)) return false;
+    if (!ggml_is_contiguous(gr)) return false;
+
+    const ggml_tensor * rows_src = gr->src[0];
+    const ggml_tensor * ids      = gr->src[1];
+    if (rows_src->type != GGML_TYPE_F32 || ids->type != GGML_TYPE_I32) return false;
+    if (!ggml_is_contiguous(ids) || rows_src->nb[0] != sizeof(float)) return false;
+
+    const ggml_tensor * v = gdn->src[2];
+    const int64_t S_v = v->ne[0], H = v->ne[1], n_tokens = v->ne[2], n_seqs = v->ne[3];
+    const int64_t D = S_v * S_v * H;
+    if (rows_src->ne[0] != D) return false;   // one cache row = one sequence's state
+    if (ids->ne[0] != n_seqs || gr->ne[1] != n_seqs) return false;
+    const size_t attn_bytes = (size_t) (S_v * H * n_tokens * n_seqs) * sizeof(float);
+
+    // keep mode writes the last min(n_tokens, K) snapshots, one cache group per slot
+    const int64_t n_written = std::min<int64_t>(n_tokens, K);
+
+    // the writeback CPY must be the first compute node after the gdn
+    const ggml_tensor * cpy = nullptr;
+    const ggml_tensor * sv  = nullptr;
+    for (int j = i + 1; j < std::min(i + 8, g->n_nodes); ++j) {
+        const ggml_tensor * n = g->nodes[j];
+        if (n->op == GGML_OP_VIEW || n->op == GGML_OP_RESHAPE || n->op == GGML_OP_NONE ||
+            n->op == GGML_OP_PERMUTE || n->op == GGML_OP_TRANSPOSE) {
+            continue;
+        }
+        if (n->op == GGML_OP_CPY) {
+            const ggml_tensor * s = n->src[0];
+            const ggml_tensor * d = n->src[1];
+            // the kernel addresses the cache as row (slot * slot_stride + seq): rows of one
+            // slot must be D floats apart, snapshot groups d->nb[2] apart
+            if (s != nullptr && d != nullptr && s->view_src == gdn &&
+                (const char *) s->data == (const char *) gdn->data + attn_bytes &&
+                ggml_nelements(s) == D * n_seqs * n_written && ggml_is_contiguous(s) &&
+                d->type == GGML_TYPE_F32 &&
+                d->ne[0] == D && d->ne[1] == n_seqs && (K == 1 || d->ne[2] == n_written) &&
+                d->nb[0] == sizeof(float) && d->nb[1] == (size_t) D * sizeof(float) &&
+                d->nb[2] % sizeof(float) == 0) {
+                cpy = n;
+                sv  = s;
+            }
+        }
+        break;
+    }
+    if (cpy == nullptr) return false;
+
+    // the cache must not alias the gdn result buffer
+    const char * gb = (const char *) gdn->data;
+    const char * db = (const char *) cpy->src[1]->data;
+    if (!(db + ggml_nbytes(cpy->src[1]) <= gb || gb + ggml_nbytes(gdn) <= db)) return false;
+
+    // the gather feeds only the gdn state input, the state region of the result
+    // feeds only the writeback, and nothing consumes the cpy node itself
+    for (int k = 0; k < g->n_nodes; ++k) {
+        const ggml_tensor * n = g->nodes[k];
+        if (n == src_state) continue;
+        for (int s = 0; s < GGML_MAX_SRC; ++s) {
+            const ggml_tensor * src = n->src[s];
+            if (src == nullptr) continue;
+            if (src == cpy) return false;
+            if (src == gr) return false;
+            if (src == gdn) {
+                // direct reference: only views over the output region may read the result
+                if (n->view_src != gdn) return false;
+                if (n != sv) {
+                    const size_t offs = (size_t) ((const char *) n->data - (const char *) gdn->data);
+                    if (offs + ggml_nbytes(n) > attn_bytes) return false;
+                }
+                continue;
+            }
+            if (src->view_src == gdn) {
+                if (src == sv) {
+                    if (n != cpy) return false;
+                    continue;
+                }
+                const size_t offs = (size_t) ((const char *) src->data - (const char *) gdn->data);
+                if (offs + ggml_nbytes(src) > attn_bytes) return false;
+            }
+        }
+    }
+
+    f.get_rows = gr;
+    f.cpy      = cpy;
+    f.rows_src = rows_src;
+    f.ids      = ids;
+    f.dst_view = cpy->src[1];
+    return true;
+}
+
+// Fused decode conv chain: GET_ROWS(conv cache) -> CONCAT(state, x^T) -> SSM_CONV plus the
+// shifted-state CPY back into the cache collapse into one kernel per layer. The x operand
+// (qkv_mixed) is gallocr memory recycled after the CONCAT, so a small D2D staged at the
+// CONCAT's node position keeps it alive for the fused kernel at the SSM_CONV's position.
+struct conv_state_fuse {
+    const ggml_tensor * get_rows;
+    const ggml_tensor * concat;
+    const ggml_tensor * cpy;
+    const ggml_tensor * rows_src;   // conv cache rows
+    const ggml_tensor * ids;
+    const ggml_tensor * dst_view;   // shifted-state destination view
+    const ggml_tensor * w;          // conv kernel [taps, channels]
+    const ggml_tensor * x;          // qkv_mixed (staged at the concat position)
+    int64_t             ids_offset;
+    size_t              x_bytes;
+    int                 channels;
+    int                 taps;
+    int                 n_seqs;
+};
+
+// Keep-mode conv snapshots: the rollback graph writes K tiny per-slot windows of the
+// conv input into the recurrent cache, one CPY per rollback group; a single kernel
+// writes them all (the windows slide over the same concat output).
+struct conv_snap_fuse {
+    const ggml_tensor *              concat;    // conv_input [W, channels, n_seqs]
+    std::vector<const ggml_tensor *> cpys;      // group in node order; first one executes
+    std::vector<const ggml_tensor *> dsts;      // per-slot cache views (data re-read per call)
+    std::vector<int64_t>             src_offs;  // per-slot dim0 element offset in the concat
+    int64_t                          rows;      // taps - 1
+    int64_t                          channels;
+    int64_t                          n_seqs;
+    int64_t                          W;         // concat->ne[0]
+};
+
+struct topk_fuse {
+    int                              k;
+    std::vector<const ggml_tensor *> views;   // the ARGSORT readers, each [k, ...] at offset 0
+};
+
+// what k_moe_topk needs from the ARGSORT itself; its readers are checked apart
+static bool ggml_sycl_topk_sort_ok(const ggml_tensor * srt) {
+    const ggml_tensor * probs = srt->src[0];
+    return srt->op == GGML_OP_ARGSORT && ggml_get_op_params_i32(srt, 0) == GGML_SORT_ORDER_DESC &&
+           probs->type == GGML_TYPE_F32 && ggml_is_contiguous(probs) && probs->ne[0] <= 1024 &&
+           probs->ne[2] == 1 && probs->ne[3] == 1;
+}
+
+// top-k extraction replacing the full expert argsort: the router only reads the
+// first k sorted indices, so k rounds of a work-group argmax beat a 256-wide
+// bitonic sort. Each value is packed with its index into a u64 key that orders like
+// the float, negative values included (raw logits, biased scores, -inf masks); ties
+// pick the smaller index like a stable descending sort.
+static void k_moe_topk(const float * probs, int32_t * dst, const int n_as, const int k,
+                       const int n_tok, queue_ptr stream) {
+    stream->submit([&](sycl::handler & cgh) {
+        sycl::local_accessor<uint64_t, 1> slm(sycl::range<1>(256), cgh);
+        cgh.parallel_for(sycl::nd_range<1>(sycl::range<1>((size_t) n_tok * 256), sycl::range<1>(256)),
+            [=](sycl::nd_item<1> it) {
+                const int t   = (int) it.get_group(0);
+                const int lid = (int) it.get_local_id(0);
+                // the low word n_as - idx is never 0, so key 0 can mark a taken expert
+                uint64_t own[4];
+                const int n_own = (n_as - lid + 255) / 256;
+                for (int j = 0; j < n_own; ++j) {
+                    const int      e = lid + j * 256;
+                    const uint32_t b = sycl::bit_cast<uint32_t>(probs[(int64_t) t * n_as + e]);
+                    const uint32_t o = (b & 0x80000000u) ? ~b : (b | 0x80000000u);
+                    own[j] = ((uint64_t) o << 32) | (uint32_t) (n_as - e);
+                }
+                for (int round = 0; round < k; ++round) {
+                    uint64_t best = 0;
+                    for (int j = 0; j < n_own; ++j) {
