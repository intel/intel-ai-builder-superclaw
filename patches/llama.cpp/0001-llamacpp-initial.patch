+// pack n unpacked 4-bit values (u8, low nibble used) into n/2 bytes (lo | hi<<4).
+static void ggml_sycl_pack_u4(const uint8_t * src, uint8_t * dst, const int64_t n, queue_ptr stream) {
+    const int64_t nb = (n + 1) / 2;
+    stream->parallel_for(sycl::range<1>(nb), [=](sycl::id<1> i) {
+        const int64_t b = i[0];
+        const uint8_t lo = src[2 * b];
+        const uint8_t hi = (2 * b + 1 < n) ? src[2 * b + 1] : 0;
+        dst[b] = (uint8_t) (lo | (hi << 4));
+    });
+}
