diff --git a/ggml/src/ggml-sycl/moe_grouped.cpp b/ggml/src/ggml-sycl/moe_grouped.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..b76b3bbeeb44c6ed922d63e50c583c5444a2a218
--- /dev/null
+++ b/ggml/src/ggml-sycl/moe_grouped.cpp
@@ -0,0 +1,87 @@
+#include "moe_grouped.hpp"
+#include "dequantize.hpp"
+
+// One work-group per output tile. Threads (TM*TN of them) each own one output element; every
+// thread also helps cooperatively stage the activation tile and the dequantized weight tile into
+// local memory each K-step, so the weight is fetched once per token-tile instead of once per token.
+void ggml_sycl_moe_grouped_q4_K(
+    ggml_backend_sycl_context & ctx,
+    const void * src0, const float * src1_contiguous, float * dst_contiguous,
+    const int32_t * tiles, int num_tiles, int K, int N) {
+
+    constexpr int TM = MOE_GROUPED_TM;
+    constexpr int TN = MOE_GROUPED_TN;
+    constexpr int TK = MOE_GROUPED_TK;
+    constexpr int WG = TM * TN;                 // 256 work-items per tile
+
+    const int blocks_per_row = K / QK_K;        // Q4_K super-blocks per weight row
+
+    const sycl::range<1> global(static_cast<size_t>(num_tiles) * WG);
+    const sycl::range<1> local(WG);
+
+    ctx.stream()->submit([&](sycl::handler & cgh) {
+        sycl::local_accessor<float, 1> act_tile(sycl::range<1>(TM * TK), cgh);
+        sycl::local_accessor<float, 1> wei_tile(sycl::range<1>(TN * TK), cgh);
+
+        cgh.parallel_for(sycl::nd_range<1>(global, local), [=](sycl::nd_item<1> item) {
+            const int tile = static_cast<int>(item.get_group(0));
+            const int lid  = static_cast<int>(item.get_local_id(0));
+
+            const int r0    = tiles[tile * 4 + 0];
+            const int n0    = tiles[tile * 4 + 1];
+            const int e     = tiles[tile * 4 + 2];
+            const int r_cnt = tiles[tile * 4 + 3];
+
+            // this thread's output element within the tile
+            const int tm = lid / TN;   // token row
+            const int tn = lid % TN;   // column
+
+            float acc = 0.0f;
+
+            for (int kt = 0; kt < K; kt += TK) {
+                // stage activations: TM*TK values, 2 per thread
+                for (int i = 0; i < 2; ++i) {
+                    const int idx = lid * 2 + i;
+                    const int am  = idx / TK;
+                    const int ak  = idx % TK;
+                    float v = 0.0f;
+                    if (am < r_cnt) {
+                        v = src1_contiguous[(size_t)(r0 + am) * K + kt + ak];
+                    }
+                    act_tile[am * TK + ak] = v;
+                }
+                // stage dequantized weights: TN*TK values = TN*TK/2 pairs, 1 pair per thread
+                {
+                    const int p  = lid;                 // pair index in [0, TN*TK/2)
+                    const int wn = p / (TK / 2);        // column within tile
+                    const int wk = (p % (TK / 2)) * 2;  // even k within the step
+                    float w0 = 0.0f, w1 = 0.0f;
+                    const int col = n0 + wn;
+                    if (col < N) {
+                        const int64_t ib = (int64_t)(e * N + col) * blocks_per_row + (kt + wk) / QK_K;
+                        const int     iqs = (kt + wk) % QK_K;
+                        dfloat2 dv;
+                        dequantize_q4_K(src0, ib, iqs, dv);
+                        w0 = (float) dv.x();
+                        w1 = (float) dv.y();
+                    }
+                    wei_tile[wn * TK + wk + 0] = w0;
+                    wei_tile[wn * TK + wk + 1] = w1;
+                }
+
+                item.barrier(sycl::access::fence_space::local_space);
+
+                for (int k = 0; k < TK; ++k) {
+                    acc += wei_tile[tn * TK + k] * act_tile[tm * TK + k];
+                }
+
+                item.barrier(sycl::access::fence_space::local_space);
+            }
+
+            const int col = n0 + tn;
+            if (tm < r_cnt && col < N) {
+                dst_contiguous[(size_t)(r0 + tm) * N + col] = acc;
+            }
+        });
+    });
+}
