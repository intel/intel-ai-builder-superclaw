+// one work-group per row: the row and its index are resolved once, the columns are read and written contiguously
+template<typename TIn, typename TIdx, typename TOut>
+static void k_set_rows_by_row(
+        const char * __restrict__ src0, const TIdx * __restrict__ src1, char * __restrict__ dst,
+        const int64_t ne00, const int64_t ne01, const int64_t ne02,
+        const int64_t ne11, const int64_t ne12,
+        const size_t nb01, const size_t nb02, const size_t nb03,
+        const size_t nb10, const size_t nb11, const size_t nb12,
+        const size_t nb1, const size_t nb2, const size_t nb3,
+        const sycl::nd_item<1> & item_ct1) {
+    const int64_t r   = item_ct1.get_group(0);
+    const int64_t i01 = r % ne01;
+    const int64_t i02 = (r / ne01) % ne02;
+    const int64_t i03 = r / (ne01 * ne02);
+
+    const int64_t i12 = i03 % ne12;
+    const int64_t i11 = i02 % ne11;
+    const int64_t i10 = i01;
+
+    const int64_t dst_row = *(const TIdx *) ((const char *) src1 + i10*nb10 + i11*nb11 + i12*nb12);
+
+    const TIn * src_row = (const TIn *) (src0 + i01*nb01 + i02*nb02 + i03*nb03);
+    TOut *      dst_row_ptr = (TOut *) (dst + dst_row*nb1 + i02*nb2 + i03*nb3);
+
+    for (int64_t i00 = item_ct1.get_local_id(0); i00 < ne00; i00 += item_ct1.get_local_range(0)) {
+        convert<TIn, TOut>((const char *) (src_row + i00), (char *) (dst_row_ptr + i00));
+    }
+}
