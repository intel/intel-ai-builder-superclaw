+
+    std::string vars() override {
+        return VARS_TO_STR3(ne, swap, reuse);
+    }
+
+    test_cont_unary_mul(ggml_unary_op op, std::array<int64_t, 3> ne = {128, 4, 5}, bool swap = false, bool reuse = false)
+        : op(op), ne(ne), swap(swap), reuse(reuse) {}
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * qg = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, 2*ne[0], ne[1], ne[2]);
+        ggml_set_name(qg, "qg");
+        ggml_tensor * gate = ggml_view_3d(ctx, qg, ne[0], ne[1], ne[2], qg->nb[1], qg->nb[2], ne[0]*qg->nb[0]);
+        ggml_tensor * c = ggml_cont_2d(ctx, gate, ne[0]*ne[1], ne[2]);
+        ggml_set_name(c, "gate");
+        ggml_tensor * b = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, ne[0]*ne[1], ne[2]);
+        ggml_set_name(b, "b");
+
+        ggml_tensor * u = ggml_unary(ctx, c, op);
+        ggml_set_name(u, "unary");
+        ggml_tensor * out = swap ? ggml_mul(ctx, b, u) : ggml_mul(ctx, u, b);
+        if (reuse) {
+            ggml_set_name(out, "mul");
+            out = ggml_add(ctx, out, c);
+        }
+        ggml_set_name(out, "out");
+
+        return out;
+    }
+};
