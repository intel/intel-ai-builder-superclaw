+# Default ON for Windows SYCL builds since that is the streaming fast-path; the
+# SDK is fetched automatically below, so no manual download is required.
+if (WIN32 AND GGML_SYCL)
+    set(LLAMA_MOE_DIRECTSTORAGE_DEFAULT ON)
+else()
+    set(LLAMA_MOE_DIRECTSTORAGE_DEFAULT OFF)
+endif()
+option(LLAMA_MOE_DIRECTSTORAGE "llama: NVMe expert streaming via DirectStorage (Windows)" ${LLAMA_MOE_DIRECTSTORAGE_DEFAULT})
+set(LLAMA_DIRECTSTORAGE_VERSION "1.3.0" CACHE STRING "DirectStorage SDK NuGet version")
+
+if (LLAMA_MOE_DIRECTSTORAGE AND WIN32)
+    # Fetch the DirectStorage SDK (headers + import lib + redist DLLs) unless the
+    # caller already pointed LLAMA_DIRECTSTORAGE_DIR at a local copy. The NuGet
+    # package is a plain zip; nothing is committed to the tree.
+    if (NOT LLAMA_DIRECTSTORAGE_DIR)
+        include(FetchContent)
+        if (CMAKE_VERSION VERSION_GREATER_EQUAL 3.24)
+            set(LLAMA_DS_EXTRACT_TS DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
+        endif()
+        FetchContent_Declare(directstorage
+            URL "https://www.nuget.org/api/v2/package/Microsoft.Direct3D.DirectStorage/${LLAMA_DIRECTSTORAGE_VERSION}"
+            ${LLAMA_DS_EXTRACT_TS})
+        FetchContent_MakeAvailable(directstorage)
+        set(LLAMA_DIRECTSTORAGE_DIR "${directstorage_SOURCE_DIR}/native")
+    endif()
+
+    if (NOT EXISTS "${LLAMA_DIRECTSTORAGE_DIR}/lib/x64/dstorage.lib")
+        message(FATAL_ERROR "LLAMA_MOE_DIRECTSTORAGE=ON but DirectStorage SDK not found at ${LLAMA_DIRECTSTORAGE_DIR}")
+    endif()
+
+    target_sources(llama PRIVATE llama-moe-directstorage.cpp)
+    target_compile_definitions(llama PRIVATE LLAMA_MOE_DIRECTSTORAGE)
+    target_include_directories(llama PRIVATE "${LLAMA_DIRECTSTORAGE_DIR}/include")
+    target_link_libraries(llama PRIVATE "${LLAMA_DIRECTSTORAGE_DIR}/lib/x64/dstorage.lib")
+
+    # Copy the redistributable runtime DLLs next to llama.dll / the exes so a
+    # fresh build runs without manual steps (the SDK license permits this).
+    add_custom_command(TARGET llama POST_BUILD
+        COMMAND ${CMAKE_COMMAND} -E copy_if_different
+            "${LLAMA_DIRECTSTORAGE_DIR}/bin/x64/dstorage.dll"
+            "${LLAMA_DIRECTSTORAGE_DIR}/bin/x64/dstoragecore.dll"
+            "$<TARGET_FILE_DIR:llama>"
+        COMMENT "Copying DirectStorage runtime DLLs")
+endif()
+
