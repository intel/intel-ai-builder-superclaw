+//
+// MIT license
+// Copyright (C) 2024 Intel Corporation
+// SPDX-License-Identifier: MIT
+//
+
+// the exact gemm launches by rasterization mode; gguf_gemm.cpp instantiates modes 0 and 1, gguf_gemm_grouped.cpp
+// mode 2. With the grouped kernels in gguf_gemm.cpp's device image the others ran 0.6% slower on B70
+
+#pragma once
+
+#include "gguf_gemm.hpp"
+#include "gguf_gemm_kernels.hpp"
+
+// tokens per rasterization group (wg_panels mode 2)
+static constexpr int GGUF_GROUP_TOKENS = 1024;
+
+// R: the wg_panels mode. A K-quant or IQ4 file layout only serves until the first reorder, so it takes mode 2 as 1
+template <bool SOA, int R>
+void gguf_gemm_launch(ggml_type type, const uint8_t * w, const sycl::half * act, float * dst, int M, int N, int K, int ks,
+                      const gguf_xmx::gemm_epi & epi, sycl::queue & q) {
+    using namespace gguf_xmx;
+    constexpr int RK = !SOA && R == 2 ? 1 : R;
+    const int     gt = R == 2 ? GGUF_GROUP_TOKENS : 0;
+    if constexpr (!SOA && R == 2) {   // IQ3_S's file layout, tuned for the prefill ahead of the reorder (no other comes here)
+        GGML_ASSERT(type == GGML_TYPE_IQ3_S);
+        ks == 2 ? (void) gemm_iq3_s<4, 2, 2, iq3s_grid, 2>(q, w, act, dst, M, N, K, epi, gt)
+                : (void) gemm_iq3_s<4, 2, 2, iq3s_grid>(q, w, act, dst, M, N, K, epi, gt);
+        if (ks > 1) {
+            splitk_reduce(q, dst, epi, ks, M, N);
+        }
+    } else {
+        switch (type) {
+            case GGML_TYPE_Q8_0:
+                if (N % 128 != 0) {
+                    if constexpr (R != 2) {   // the dispatch sends the narrow shapes to mode 1
+                        (void) gemm_q8_0_narrow<SOA>(q, w, act, dst, M, N, K, epi);
+                    }
+                } else {
+                    (void) gemm_q8_0<4, 4, RK, SOA>(q, w, act, dst, M, N, K, epi, gt);
+                }
+                break;
+            // split-K takes Q3_K / Q5_K / IQ4 / IQ3_S only on a discrete GPU (R 1, 2) and Q4_K's 32 x 32 only on an integrated one
+            case GGML_TYPE_Q3_K:
+                if constexpr (!SOA) {
+                    GGML_ABORT("gguf gemm: Q3_K needs the reordered layout");
+                } else if constexpr (R != 0) {
+                    ks == 2 ? (void) gemm_q3_K<4, 2, R, 2>(q, w, act, dst, M, N, K, epi, gt)
+                            : (void) gemm_q3_K<4, 2, R>(q, w, act, dst, M, N, K, epi, gt);
+                } else {
+                    (void) gemm_q3_K<4, 2, R>(q, w, act, dst, M, N, K, epi, gt);
+                }
+                break;
+            case GGML_TYPE_Q4_K:
+                if constexpr (RK != 0) {   // B70's large-K shapes: 16 x 64 tiles with the two-k-step A loads
+                    ks == 2 ? (void) gemm_q4_K<4, 2, RK, SOA, 2, 1, 8, true>(q, w, act, dst, M, N, K, epi, gt)
+                            : (void) gemm_q4_K<4, 4, RK, SOA>(q, w, act, dst, M, N, K, epi, gt);
+                } else {
+                    ks == 2 ? (void) gemm_q4_K<4, 4, RK, SOA, 2>(q, w, act, dst, M, N, K, epi, gt)
+                            : (void) gemm_q4_K<4, 4, RK, SOA>(q, w, act, dst, M, N, K, epi, gt);
+                }
+                break;
+            case GGML_TYPE_Q5_K:
+                if constexpr (RK != 0) {
+                    ks == 2 ? (void) gemm_q5_K<4, 2, RK, SOA, 2>(q, w, act, dst, M, N, K, epi, nullptr, nullptr, gt)
+                            : (void) gemm_q5_K<4, 2, RK, SOA>(q, w, act, dst, M, N, K, epi, nullptr, nullptr, gt);
+                } else {
+                    (void) gemm_q5_K<4, 2, RK, SOA>(q, w, act, dst, M, N, K, epi, nullptr, nullptr, gt);
+                }
+                break;
+            case GGML_TYPE_Q6_K: {   // weight-outer in every mode but the groups
+                constexpr int R6 = RK == 2 ? 2 : 1;
+                if (ks == 3) {
+                    (void) gemm_q6_K<4, 2, R6, SOA, 1, 8, 3>(q, w, act, dst, M, N, K, epi, gt);
+                } else if (ks == 2) {
+                    (void) gemm_q6_K<4, 2, R6, SOA, 1, 8, 2>(q, w, act, dst, M, N, K, epi, gt);
+                } else {
+                    (void) gemm_q6_K<4, 2, R6, SOA>(q, w, act, dst, M, N, K, epi, gt);
+                }
+                break;
+            }
+            case GGML_TYPE_IQ4_XS:
+            case GGML_TYPE_IQ4_NL:
+                if constexpr (SOA) {   // the pair order of reorder_qw_iq4
+                    const bool nl = type == GGML_TYPE_IQ4_NL;
+                    if constexpr (R != 0) {
+                        if (ks == 2) {
+                            nl ? (void) gemm_iq4_pair<4, 2, R, true, 2>(q, w, act, dst, M, N, K, epi, gt)
+                               : (void) gemm_iq4_pair<4, 2, R, false, 2>(q, w, act, dst, M, N, K, epi, gt);
+                            break;
+                        }
+                    }
+                    nl ? (void) gemm_iq4_pair<4, 2, R, true>(q, w, act, dst, M, N, K, epi, gt)
+                       : (void) gemm_iq4_pair<4, 2, R, false>(q, w, act, dst, M, N, K, epi, gt);
+                } else {
+                    const bool nl = type == GGML_TYPE_IQ4_NL;
+                    if constexpr (RK != 0) {
+                        if (ks == 2) {
+                            nl ? (void) gemm_iq4<4, 4, RK, true, 2>(q, w, act, dst, M, N, K, epi)
+                               : (void) gemm_iq4<4, 4, RK, false, 2>(q, w, act, dst, M, N, K, epi);
+                            break;
+                        }
+                    }
+                    nl ? (void) gemm_iq4<4, 4, RK, true>(q, w, act, dst, M, N, K, epi)
+                       : (void) gemm_iq4<4, 4, RK, false>(q, w, act, dst, M, N, K, epi);
+                }
+                break;
+            case GGML_TYPE_IQ3_S:   // the planes of reorder_qw_iq3_s (SOA) or the file layout (see gguf_file_layout_tuned)
+                if constexpr (R != 0) {
+                    ks == 2 ? (void) gemm_iq3_s<4, 2, R, iq3s_grid, 2, 1, 8, SOA>(q, w, act, dst, M, N, K, epi, gt)
+                            : (void) gemm_iq3_s<4, 2, R, iq3s_grid, 1, 1, 8, SOA>(q, w, act, dst, M, N, K, epi, gt);
+                } else {
+                    (void) gemm_iq3_s<4, 2, R, iq3s_grid, 1, 1, 8, SOA>(q, w, act, dst, M, N, K, epi, gt);
+                }
+                break;
+            default:
+                GGML_ABORT("gguf gemm: unsupported type %s", ggml_type_name(type));
+        }
+        if (ks > 1) {
+            splitk_reduce(q, dst, epi, ks, M, N);
+        }
+    }
+}
+
+// RAST: the wg_panels mode (see gguf_gemm_launch)
+template <int RAST, bool SOA>
+void gguf_glu_launch(ggml_type type, const uint8_t * g, const uint8_t * u, const sycl::half * act, sycl::half * out,
+                     int M, int N, int K, sycl::queue & q, bool geglu) {
+    using namespace gguf_xmx;
+    const int gt = RAST == 2 ? GGUF_GROUP_TOKENS : 0;
+    switch (type) {
+        case GGML_TYPE_Q8_0:
+            geglu ? (void) gemm_glu_q8_0<4, 4, RAST, SOA, true>(q, g, u, act, out, M, N, K, gt)
+                  : (void) gemm_glu_q8_0<4, 4, RAST, SOA, false>(q, g, u, act, out, M, N, K, gt);
+            break;
+        case GGML_TYPE_Q5_K:   (void) gemm_q5_K<4, 2, RAST, SOA, 1, true>(q, g, act, nullptr, M, N, K, {}, u, out, gt); break;
+        case GGML_TYPE_IQ4_XS:   // the file layout only: a reordered IQ4 runs the split gemms (ggml_sycl_gguf_glu_layout_ok)
+        case GGML_TYPE_IQ4_NL:
+            if constexpr (RAST != 2) {
+                type == GGML_TYPE_IQ4_NL ? (void) gemm_iq4<4, 4, RAST, true, 1, true>(q, g, act, nullptr, M, N, K, {}, u, out, gt)
+                                         : (void) gemm_iq4<4, 4, RAST, false, 1, true>(q, g, act, nullptr, M, N, K, {}, u, out, gt);
+            }
+            break;
+        default:               (void) gemm_glu_q4_K<4, 4, RAST, SOA>(q, g, u, act, out, M, N, K, gt); break;
+    }
+}
+
+// the mode 2 instances (gguf_gemm_grouped.cpp)
+void gguf_gemm_launch_grouped(bool soa, ggml_type type, const uint8_t * w, const sycl::half * act, float * dst, int M,
+                              int N, int K, int ks, const gguf_xmx::gemm_epi & epi, sycl::queue & q);
+void gguf_glu_launch_grouped(ggml_type type, const uint8_t * g, const uint8_t * u, const sycl::half * act,
+                             sycl::half * out, int M, int N, int K, sycl::queue & q, bool geglu);
+
+// the narrow instances (gguf_gemm_narrow.cpp): M <= GGML_SYCL_GGUF_NW_MAX_M, weights in the reorder layout
+void gguf_gemm_launch_narrow(ggml_type type, const uint8_t * w, const sycl::half * act, float * dst, int M, int N, int K,
+                             const gguf_xmx::gemm_epi & epi, sycl::queue & q);
