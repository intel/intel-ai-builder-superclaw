+            }
+        }
+#endif
+#if GGML_SYCL_DNNL
+        if (node->op == GGML_OP_MUL_MAT && ((g_ggml_sycl_dnn_int8 && g_ggml_sycl_enable_dnn) || g_ggml_sycl_gguf_gemm) &&
+            !getenv("GGML_SYCL_FFN_NOFUSE")) {
+            ffn_fused_nodes f;
+            if (ggml_sycl_ffn_fused_match(cgraph, i, f) && ggml_sycl_ffn_fused_exec(*sycl_ctx, f)) {
