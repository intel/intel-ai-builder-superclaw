+
+// Chunked form of the gated delta rule for prefill.
+//
+// The per-token scan in gated_delta_net.cpp is not short of arithmetic - it is
+// stalled: a token's kv reduction cannot start until the previous token's state
+// update has retired, so the sub-group reductions serialize (VTune: ALU0 35%,
+// SBID stalls 42.6%). Over a chunk of C tokens the recurrence closes into a form
+// where every reduction reads only the chunk-entry state S_0, so the reductions
+// of a phase are independent and pipeline.
+//
+// With g_t = exp(gr_t), L_t = sum_{u<=t} gr_u (chunk-local) and S_0 the state at
+// chunk entry, every decay factor takes the shape exp(L_a - L_b) with a >= b, so
+// they stay in [0,1] and 1/A_j is never formed:
+//
+//   M[t][j] = exp(L_t - L_j) (k_t . k_j)                  j <  t
+//   P[t][j] = exp(L_t - L_j) (q_t . k_j)                  j <= t
+//   B[t]    = beta_t (v_t - exp(L_t) S_0^T k_t)
+//   Delta   = B - diag(beta) M Delta                      (forward substitution)
+//   O[t]    = exp(L_t) S_0^T q_t + sum_{j<=t} P[t][j] Delta[j]
+//   S_C     = exp(L_C) S_0 + sum_j exp(L_C - L_j) k_j (Delta[j])^T
+//
+// The layout follows the scan kernel so that the state stays in registers: the
+// lanes of a sub-group shard the S_v state rows and each sub-group owns
+// GDN_CH_VB value columns. k/q/v for the chunk live in SLM, where a lane's row
+// slice is reused by all of its columns. M and P are shared by every column of a
+// head, so they are computed once per work-group.
+//
+// The chunk operands are staged through registers into SLM. Issuing them a whole
+// chunk ahead to hide the global latency was tried and lost ~3%: ten loads left in
+// flight across the chunk body hold scoreboard IDs that the rest of the code needs.
+
+#include "gated_delta_net.hpp"
+
+#include "common.hpp"
+
+#include <type_traits>
+
+namespace {
+
+constexpr int GDN_CH_C     = 8;    // tokens per chunk
+constexpr int GDN_CH_VB    = 4;    // value columns per sub-group
+constexpr int GDN_CH_WARPS = 16;   // sub-groups per work-group
+constexpr int GDN_CH_WG    = GDN_CH_WARPS * WARP_SIZE;
+constexpr int GDN_CH_COLS  = GDN_CH_WARPS * GDN_CH_VB;   // value columns per work-group
+
+template <int S_v> struct gdn_ch_slm {
+    float k[GDN_CH_C * S_v];
+    float q[GDN_CH_C * S_v];
+    float v[GDN_CH_C * GDN_CH_COLS];
+    float m[GDN_CH_C * GDN_CH_C];
+    float p[GDN_CH_C * GDN_CH_C];
+    float gr[GDN_CH_C];
+    float beta[GDN_CH_C];
+};
+
+template <int S_v, bool WITH_TAIL>
+void gdn_chunked_kernel(const float * __restrict__ q_g,
+                        const float * __restrict__ k_g,
+                        const float * __restrict__ v_g,
+                        const float * __restrict__ g_g,
+                        const float * __restrict__ beta_g,
+                        const float * __restrict__ state_in,
+                        float * __restrict__ attn_out,
+                        float * __restrict__ state_out,
+                        int64_t H, int64_t n_tokens,
+                        int64_t sq1, int64_t sq2, int64_t sq3,
+                        int64_t sv1, int64_t sv2, int64_t sv3,
+                        int64_t sb1, int64_t sb2, int64_t sb3,
+                        int64_t neqk1, int64_t rq3, float scale,
+                        const int32_t * __restrict__ s_rows, int64_t s_row_stride,
+                        gdn_ch_slm<S_v> * slm) {
+    auto          it       = sycl::ext::oneapi::this_work_item::get_nd_item<2>();
+    auto          sg       = it.get_sub_group();
+    const int64_t h_idx    = it.get_group(0);
+    const int64_t col_blk  = it.get_group(1);
+    const int     tid      = (int) it.get_local_id(1);   // local range is (1, GDN_CH_WG)
+    const int     warp     = tid / WARP_SIZE;
+    const int     lane     = tid % WARP_SIZE;
+    const int64_t sequence = 0;                          // n_seqs == 1
+
+    constexpr int rows_per_lane = S_v / WARP_SIZE;
+    constexpr int ct            = GDN_CH_C;
+    constexpr int NK            = ct * S_v / GDN_CH_WG;          // k/q loads per lane
+    constexpr int NV            = ct * GDN_CH_COLS / GDN_CH_WG;  // v loads per lane
+
+    const int cl0  = warp * GDN_CH_VB;                        // columns inside the v tile
+    const int col0 = (int) (col_blk * GDN_CH_COLS) + cl0;     // columns in the state
+
+    const int64_t iq1 = h_idx % neqk1;                   // GQA fan-out, as in the scan
+    const int64_t iq3 = sequence / rq3;
+
+    const float * q_p = q_g + iq3 * sq3 + iq1 * sq1;
+    const float * k_p = k_g + iq3 * sq3 + iq1 * sq1;
+    const float * v_p = v_g + sequence * sv3 + h_idx * sv1 + col_blk * GDN_CH_COLS;
+    const float * g_p = g_g + sequence * sb3 + h_idx * sb1;
+    const float * b_p = beta_g + sequence * sb3 + h_idx * sb1;
+    float *       o_p = attn_out + (sequence * n_tokens * H + h_idx) * S_v + col0;
+
+    const int qk_str = (int) sq2;            // token stride of k/q, in floats
+    const int v_str  = (int) sv2;
+    const int gb_str = (int) sb2;
+    const int o_str  = (int) (H * S_v);
+
+    const float * st_in = state_in;
+    if (s_rows != nullptr) {
+        st_in += (int64_t) s_rows[sequence] * s_row_stride + h_idx * S_v * S_v;
+    } else {
+        st_in += sequence * H * S_v * S_v + h_idx * S_v * S_v;
+    }
+    float * st_out = state_out + (sequence * H + h_idx) * S_v * S_v;
+
+    float s_reg[GDN_CH_VB][rows_per_lane];
+#pragma unroll
+    for (int c = 0; c < GDN_CH_VB; c++) {
+#pragma unroll
+        for (int r = 0; r < rows_per_lane; r++) {
+            s_reg[c][r] = st_in[(int64_t) (col0 + c) * S_v + r * WARP_SIZE + lane];
+        }
+    }
+
+    // ---- operand prefetch ---------------------------------------------------
+    // Issued a chunk ahead and consumed by commit() at the top of the next
+    // iteration, so nothing waits on global memory at the first barrier.
+    float rk[NK], rq[NK], rv[NV], rg = 0.0f, rb = 0.0f;
+
+    // MASKED pads a short last chunk: gr = 0 keeps the running sum put and
+    // beta = 0 makes Delta vanish, so the padded tokens leave the state untouched
+    // and only their output stores need masking.
+    auto issue = [&](auto mask_tag, const int valid) {
+        constexpr bool MASKED = decltype(mask_tag)::value;
+#pragma unroll
+        for (int u = 0; u < NK; u++) {
+            const int idx = tid + u * GDN_CH_WG;
+            const int t   = idx / S_v;
+            const int i   = idx - t * S_v;
+            if constexpr (MASKED) {
+                rk[u] = t < valid ? k_p[t * qk_str + i] : 0.0f;
+                rq[u] = t < valid ? q_p[t * qk_str + i] : 0.0f;
+            } else {
+                rk[u] = k_p[t * qk_str + i];
+                rq[u] = q_p[t * qk_str + i];
+            }
+        }
+#pragma unroll
+        for (int u = 0; u < NV; u++) {
+            const int idx = tid + u * GDN_CH_WG;
+            const int t   = idx / GDN_CH_COLS;
+            const int c   = idx - t * GDN_CH_COLS;
+            rv[u] = (!MASKED || t < valid) ? v_p[t * v_str + c] : 0.0f;
+        }
+        if (tid < ct) {
+            const bool ok = !MASKED || tid < valid;
+            rg = ok ? g_p[tid * gb_str] : 0.0f;
+            rb = ok ? b_p[tid * gb_str] : 0.0f;
+        }
+    };
+
+    auto commit = [&]() {
+#pragma unroll
+        for (int u = 0; u < NK; u++) {
+            const int idx = tid + u * GDN_CH_WG;
+            slm->k[idx] = rk[u];
+            slm->q[idx] = rq[u];
+        }
+#pragma unroll
+        for (int u = 0; u < NV; u++) {
+            slm->v[tid + u * GDN_CH_WG] = rv[u];
+        }
+        if (tid < ct) {
+            slm->gr[tid]   = rg;
+            slm->beta[tid] = rb;
+        }
+    };
+
+    auto advance = [&]() {
+        k_p += ct * qk_str;
+        q_p += ct * qk_str;
+        v_p += ct * v_str;
+        g_p += ct * gb_str;
+        b_p += ct * gb_str;
+    };
+
+    // ---- one chunk of the recurrence ---------------------------------------
+    auto step = [&](auto mask_tag, const int valid) {
+        constexpr bool MASKED = decltype(mask_tag)::value;
+
+        // Every phase reads the chunk-local cumulative gate, so build it in
+        // registers once instead of paying an SLM load per use (~27 per lane).
+        float lam[ct];
+        {
+            float acc = 0.0f;
+#pragma unroll
+            for (int t = 0; t < ct; t++) {
+                acc    = acc + slm->gr[t];
+                lam[t] = acc;
+            }
+        }
+
+        // ---- M / P: one (t,j) pair per sub-group, shared by all columns -----
+#pragma unroll
+        for (int pair = warp; pair < ct * ct; pair += GDN_CH_WARPS) {
+            const int t = pair / ct;
+            const int j = pair - t * ct;
+            if (j > t) {
+                continue;
+            }
+            float pkk = 0.0f, pqk = 0.0f;
+#pragma unroll
+            for (int r = 0; r < rows_per_lane; r++) {
+                const int   i  = r * WARP_SIZE + lane;
+                const float kj = slm->k[j * S_v + i];
+                pkk += slm->k[t * S_v + i] * kj;
+                pqk += slm->q[t * S_v + i] * kj;
+            }
+            pkk = sycl::reduce_over_group(sg, pkk, sycl::plus<float>());
+            pqk = sycl::reduce_over_group(sg, pqk, sycl::plus<float>());
+            if (lane == 0) {
+                const float d = sycl::native::exp(lam[t] - lam[j]);
+                slm->m[t * GDN_CH_C + j] = (j < t) ? d * pkk : 0.0f;
+                slm->p[t * GDN_CH_C + j] = d * pqk;
+            }
+        }
+        it.barrier(sycl::access::fence_space::local_space);
+
+        // ---- kv and qs against S_0: 2 * ct * VB reductions, all independent -
+        float kv[ct][GDN_CH_VB];
+        float qs[ct][GDN_CH_VB];
+#pragma unroll
+        for (int t = 0; t < ct; t++) {
+            float kr[rows_per_lane], qr[rows_per_lane];
+#pragma unroll
+            for (int r = 0; r < rows_per_lane; r++) {
+                const int i = r * WARP_SIZE + lane;
+                kr[r] = slm->k[t * S_v + i];
+                qr[r] = slm->q[t * S_v + i];
+            }
+#pragma unroll
+            for (int c = 0; c < GDN_CH_VB; c++) {
+                float a = 0.0f, b = 0.0f;
+#pragma unroll
+                for (int r = 0; r < rows_per_lane; r++) {
+                    a += s_reg[c][r] * kr[r];
+                    b += s_reg[c][r] * qr[r];
+                }
+                kv[t][c] = a;
+                qs[t][c] = b;
+            }
+        }
+        // reduce_over_group, not a hand-rolled xor butterfly: the equivalent
+        // permute_group_by_xor chain measured 3% of whole-prefill slower here, which
+        // also rules out re-sharding the state to make the reductions span 8 lanes
+        // instead of 16 - that design only pays if masked xor shuffles are cheap.
+#pragma unroll
+        for (int t = 0; t < ct; t++) {
+#pragma unroll
+            for (int c = 0; c < GDN_CH_VB; c++) {
+                kv[t][c] = sycl::reduce_over_group(sg, kv[t][c], sycl::plus<float>());
+                qs[t][c] = sycl::reduce_over_group(sg, qs[t][c], sycl::plus<float>());
+            }
+        }
+
+        // ---- Delta by forward substitution, in place over kv -----------------
+        // (each lane keeps the same copy)
+        float (&dl)[ct][GDN_CH_VB] = kv;
+#pragma unroll
+        for (int t = 0; t < ct; t++) {
+            const float bt = slm->beta[t];
+            const float at = sycl::native::exp(lam[t]);
+#pragma unroll
+            for (int c = 0; c < GDN_CH_VB; c++) {
+                float sub = 0.0f;
+#pragma unroll
+                for (int j = 0; j < t; j++) {
+                    sub += slm->m[t * GDN_CH_C + j] * dl[j][c];
+                }
+                dl[t][c] = bt * (slm->v[t * GDN_CH_COLS + cl0 + c] - at * kv[t][c] - sub);
+            }
+        }
+
+        // ---- O = exp(L) S_0^T q + P Delta ----------------------------------
+        if (lane == 0) {
+#pragma unroll
+            for (int t = 0; t < ct; t++) {
+                const float at = sycl::native::exp(lam[t]);
+                // scalar stores on purpose: a single-lane 16-byte vector store measured
+                // ~1% of prefill slower than four 4-byte ones here
+#pragma unroll
+                for (int c = 0; c < GDN_CH_VB; c++) {
+                    float pd = 0.0f;
+#pragma unroll
+                    for (int j = 0; j <= t; j++) {
+                        pd += slm->p[t * GDN_CH_C + j] * dl[j][c];
+                    }
+                    if (!MASKED || t < valid) {
+                        o_p[t * o_str + c] = (at * qs[t][c] + pd) * scale;
+                    }
+                }
+            }
+        }
+
+        // ---- S_C = exp(L_C) S_0 + sum_j exp(L_C - L_j) k_j Delta[j]^T -------
+        {
+            const float ac = sycl::native::exp(lam[ct - 1]);
+            float dec[ct];
+#pragma unroll
+            for (int j = 0; j < ct; j++) {
+                dec[j] = sycl::native::exp(lam[ct - 1] - lam[j]);
+            }
+#pragma unroll
+            for (int r = 0; r < rows_per_lane; r++) {
+                const int i = r * WARP_SIZE + lane;
+                float kj[ct];
+#pragma unroll
+                for (int j = 0; j < ct; j++) {
+                    kj[j] = dec[j] * slm->k[j * S_v + i];
+                }
+#pragma unroll
+                for (int c = 0; c < GDN_CH_VB; c++) {
+                    float upd = 0.0f;
+#pragma unroll
+                    for (int j = 0; j < ct; j++) {
+                        upd += kj[j] * dl[j][c];
+                    }
+                    s_reg[c][r] = ac * s_reg[c][r] + upd;
+                }
+            }
+        }
+    };
+
+    const int64_t n_chunks = n_tokens / ct;
+    const int     tail     = (int) (n_tokens - n_chunks * ct);
+
+    for (int64_t i = 0; i < n_chunks; i++) {
+        issue(std::false_type{}, ct);
+        commit();
+        it.barrier(sycl::access::fence_space::local_space);
+        step(std::false_type{}, ct);
+        it.barrier(sycl::access::fence_space::local_space);
+        advance();
+        o_p += ct * o_str;
+    }
+    if constexpr (WITH_TAIL) {
+        if (tail > 0) {
+            issue(std::true_type{}, tail);
+            commit();
+            it.barrier(sycl::access::fence_space::local_space);
+            step(std::true_type{}, tail);
+        }
+    }
+
+#pragma unroll
+    for (int c = 0; c < GDN_CH_VB; c++) {
+#pragma unroll
+        for (int r = 0; r < rows_per_lane; r++) {
+            st_out[(int64_t) (col0 + c) * S_v + r * WARP_SIZE + lane] = s_reg[c][r];
+        }
+    }
+}
+
+template <int S_v, bool WITH_TAIL>
+void launch_one(const float * q_d, const float * k_d, const float * v_d, const float * g_d,
+                const float * b_d, const float * s_d, float * dst_d, int64_t H,
+                int64_t n_tokens, int64_t sq1, int64_t sq2, int64_t sq3, int64_t sv1,
+                int64_t sv2, int64_t sv3, int64_t sb1, int64_t sb2, int64_t sb3,
+                int64_t neqk1, int64_t rq3, float scale, const int32_t * s_rows,
+                int64_t s_row_stride, float * state_dst, dpct::queue_ptr stream) {
+    const int64_t col_blocks = S_v / GDN_CH_COLS;
+    stream->submit([&](sycl::handler & cgh) {
+        sycl::local_accessor<gdn_ch_slm<S_v>, 0> slm(cgh);
+        cgh.parallel_for(
+            sycl::nd_range<2>(sycl::range<2>(H, col_blocks * GDN_CH_WG),
+                              sycl::range<2>(1, GDN_CH_WG)),
+            [=](sycl::nd_item<2>) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+                gdn_chunked_kernel<S_v, WITH_TAIL>(q_d, k_d, v_d, g_d, b_d, s_d, dst_d,
+                                                   state_dst, H, n_tokens, sq1, sq2, sq3,
+                                                   sv1, sv2, sv3, sb1, sb2, sb3, neqk1, rq3,
+                                                   scale, s_rows, s_row_stride,
+                                                   slm.get_pointer());
+            });
+    });
+}
+
+// A short last chunk needs a second, masked copy of the fully unrolled chunk body.
+// Keeping both in one kernel costs ~1.3% of prefill through instruction cache
+// pressure even when the tail never runs, so give it its own kernel.
+template <int S_v>
+void launch_chunked(const float * q_d, const float * k_d, const float * v_d, const float * g_d,
+                    const float * b_d, const float * s_d, float * dst_d, int64_t H,
+                    int64_t n_tokens, int64_t sq1, int64_t sq2, int64_t sq3, int64_t sv1,
+                    int64_t sv2, int64_t sv3, int64_t sb1, int64_t sb2, int64_t sb3,
+                    int64_t neqk1, int64_t rq3, float scale, const int32_t * s_rows,
+                    int64_t s_row_stride, float * state_dst, dpct::queue_ptr stream) {
+    if ((n_tokens % GDN_CH_C) == 0) {
+        launch_one<S_v, false>(q_d, k_d, v_d, g_d, b_d, s_d, dst_d, H, n_tokens, sq1, sq2, sq3,
+                               sv1, sv2, sv3, sb1, sb2, sb3, neqk1, rq3, scale, s_rows,
+                               s_row_stride, state_dst, stream);
+    } else {
+        launch_one<S_v, true>(q_d, k_d, v_d, g_d, b_d, s_d, dst_d, H, n_tokens, sq1, sq2, sq3,
+                              sv1, sv2, sv3, sb1, sb2, sb3, neqk1, rq3, scale, s_rows,
+                              s_row_stride, state_dst, stream);
+    }
+}
+
+}  // namespace
+
+bool ggml_sycl_gated_delta_net_chunked(const float * q_d, const float * k_d, const float * v_d,
+                                       const float * g_d, const float * b_d, const float * s_d,
+                                       float * dst_d, int64_t S_v, int64_t H, int64_t n_tokens,
+                                       int64_t n_seqs, int64_t sq1, int64_t sq2, int64_t sq3,
+                                       int64_t sv1, int64_t sv2, int64_t sv3, int64_t sb1,
+                                       int64_t sb2, int64_t sb3, int64_t neqk1, int64_t rq3,
+                                       float scale, int K, const int32_t * s_rows,
+                                       int64_t s_row_stride, float * state_dst,
+                                       dpct::queue_ptr stream) {
+    static const bool enabled = ggml_sycl_get_env("GGML_SYCL_GDN_CHUNKED", 1) != 0;
+    // prefill only, single sequence, no rollback snapshots, and a state whose
+    // columns split evenly across work-groups
+    if (!enabled || n_seqs != 1 || K > 1 || n_tokens < 4 * GDN_CH_C || S_v != 128 ||
+        (S_v % GDN_CH_COLS) != 0) {
+        return false;
+    }
+    // without the fused writeback the final state goes to the op's own output, after the attention rows
+    if (state_dst == nullptr) {
+        state_dst = dst_d + S_v * H * n_tokens * n_seqs;
+    }
+    launch_chunked<128>(q_d, k_d, v_d, g_d, b_d, s_d, dst_d, H, n_tokens, sq1, sq2, sq3,
+                        sv1, sv2, sv3, sb1, sb2, sb3, neqk1, rq3, scale, s_rows,
+                        s_row_stride, state_dst, stream);
+    return true;
+}
