+#ifndef GGML_SYCL_GGUF_GEMM_KERNELS_HPP
+#define GGML_SYCL_GGUF_GEMM_KERNELS_HPP
+
+// Exact prefill GEMM on GGUF weight blocks with f16 dpas: dst[m][n] = sum_k x[m][k] * w[n][k], f32 accumulation.
+// Weights are the dpas B operand: a 16-lane gather puts one weight row in each lane, and its [dword][lane] result is the VNNI layout.
+// A quant becomes an exact f16 by OR-ing it into the mantissa of 1024 (1152 for Q8_0), so the only rounding is the scale multiply.
+// IQ4_XS / IQ4_NL / IQ3_S take their codebook values from SLM instead.
+// Activations are the A operand, pre-packed as row-major f16 tiles [Mp/8][K/16][8][16].
+// SOA reads the layout of reorder_qw (one array per block field); it builds the same register image as the GGUF layout.
+
+#include <sycl/sycl.hpp>
+#include <sycl/ext/intel/esimd.hpp>
+#include <sycl/ext/intel/experimental/grf_size_properties.hpp>
+
+#include <cstdint>
+#include <functional>
+
+namespace gguf_xmx {
+
+using namespace sycl::ext::intel::esimd;
+namespace xmx = sycl::ext::intel::esimd::xmx;
+
+constexpr int GRF = 256;
+
+// ---- activations -------------------------------------------------------------------------
+
+// f32 [M][K] (row stride ldx) -> f16 tiles [Mp/8][K/16][8][16], 8 rows x 64 k per work-item; K % 64 == 0
+// tiles past M are not written, their outputs are never stored
+inline sycl::event pack_act(sycl::queue & q, const float * x, int64_t ldx, sycl::half * out, int M, int K) {
+    const int nks = K / 16;
+    const int nk4 = K / 64;
+    const int nmt = (M + 7) / 8;
+    constexpr int WG = 32;
+    const size_t n = ((size_t) nmt * nk4 + WG - 1) / WG * WG;
+    return q.parallel_for(sycl::nd_range<1>(sycl::range<1>(n), sycl::range<1>(WG)),
+        [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL {
+            const int id = (int) it.get_global_id(0);
+            if (id >= nmt * nk4) {
+                return;
+            }
+            const int mt = id / nk4;
+            const int k4 = id % nk4;
+            simd<sycl::half, 512> t = 0;   // [4 tiles][8 rows][16 k]
+#pragma unroll
+            for (int r = 0; r < 8; ++r) {
+                if (mt * 8 + r < M) {
+                    const simd<float, 64> v = block_load<float, 64>(x + (size_t) (mt * 8 + r) * ldx + k4 * 64);
+                    simd<sycl::half, 64> h = v;
+#pragma unroll
+                    for (int s = 0; s < 4; ++s) {
+                        t.template select<16, 1>(s * 128 + r * 16) = h.template select<16, 1>(s * 16);
+                    }
+                }
+            }
+            block_store<sycl::half, 512>(out + ((size_t) mt * nks + k4 * 4) * 128, t);
+        });
+}
+
+// y = a * silu(z) over [M][K] (row strides lda, ldz, ldd) as the tiles of pack_act, and as f32 rows into dst unless it is null
+// silu as in ggml_sycl_op_silu_mul, so the rows match the unfused op; K % 64 == 0
+inline sycl::event silu_mul_pack(sycl::queue & q, const float * z, int64_t ldz, const float * a, int64_t lda, float * dst,
+                                 int64_t ldd, sycl::half * out, int M, int K) {
+    const int nks = K / 16;
+    const int nk4 = K / 64;
+    const int nmt = (M + 7) / 8;
+    constexpr int WG = 32;
+    const size_t n = ((size_t) nmt * nk4 + WG - 1) / WG * WG;
+    return q.parallel_for(sycl::nd_range<1>(sycl::range<1>(n), sycl::range<1>(WG)),
+        [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL {
+            const int id = (int) it.get_global_id(0);
+            if (id >= nmt * nk4) {
+                return;
+            }
+            const int mt = id / nk4;
+            const int k4 = id % nk4;
+            simd<sycl::half, 512> t = 0;   // [4 tiles][8 rows][16 k]
+#pragma unroll
+            for (int r = 0; r < 8; ++r) {
+                const int m = mt * 8 + r;
+                if (m < M) {
+                    const simd<float, 64> zv = block_load<float, 64>(z + (size_t) m * ldz + k4 * 64);
+                    const simd<float, 64> av = block_load<float, 64>(a + (size_t) m * lda + k4 * 64);
+                    const simd<float, 64> y  = av * (zv / (1.0f + exp(-zv)));
+                    if (dst != nullptr) {
+                        block_store<float, 64>(dst + (size_t) m * ldd + k4 * 64, y);
+                    }
+                    simd<sycl::half, 64> h = y;
+#pragma unroll
+                    for (int s = 0; s < 4; ++s) {
+                        t.template select<16, 1>(s * 128 + r * 16) = h.template select<16, 1>(s * 16);
+                    }
+                }
+            }
+            block_store<sycl::half, 512>(out + ((size_t) mt * nks + k4 * 4) * 128, t);
+        });
+}
+
+constexpr int RMS_WGT_MAX = 32;
+
+// {RMS_NORM, MUL}: y = x * rsqrt(mean(x^2) + eps) * w as the tiles of pack_act, and as f32 rows into dst unless it is null
+// one work-group per 8-row panel, wgt threads of K / 128 / wgt 128-column spans; the row sums of squares meet in SLM
+inline sycl::event rms_pack_act(sycl::queue & q, const float * x, int64_t ldx, const float * w, float * dst, int64_t ldd,
+                                sycl::half * out, int M, int K, float eps, int wgt) {
+    const int   nks = K / 16;
+    const int   kpt = K / 128 / wgt;
+    const int   nmt = (M + 7) / 8;
+    const float fk  = (float) K;
+    return q.parallel_for(sycl::nd_range<1>(sycl::range<1>((size_t) nmt * wgt), sycl::range<1>(wgt)),
+        [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL {
+            slm_init<RMS_WGT_MAX * 8 * sizeof(float)>();
+            const int     t  = (int) it.get_local_id(0);
+            const int     mt = (int) it.get_group(0);
+            const int     nr = M - mt * 8 < 8 ? M - mt * 8 : 8;
+            const float * xm = x + (size_t) mt * 8 * ldx;
+            simd<float, 8> ssq = 0.0f;
+            for (int j = 0; j < kpt; ++j) {
+                const int k0 = (t * kpt + j) * 128;
+#pragma unroll
+                for (int r = 0; r < 8; ++r) {
+                    if (r < nr) {
+                        const simd<float, 128> xr = block_load<float, 128>(xm + (size_t) r * ldx + k0);
+                        ssq[r] = ssq[r] + reduce<float>(xr * xr, std::plus<>());
+                    }
+                }
+            }
+            slm_block_store<float, 8>(t * 8 * sizeof(float), ssq);
+            barrier();
+            simd<float, 8> tot = 0.0f;
+            for (int i = 0; i < wgt; ++i) {
+                tot += slm_block_load<float, 8>(i * 8 * sizeof(float));
+            }
+            const simd<float, 8> sc = rsqrt(tot / fk + eps);
+            // the second read of the rows hits cache
+            for (int j = 0; j < kpt; ++j) {
+                const int              k0 = (t * kpt + j) * 128;
+                const simd<float, 128> wv = block_load<float, 128>(w + k0);
+                simd<sycl::half, 1024> tl = 0;   // [8 tiles][8 rows][16 k]
+#pragma unroll
+                for (int r = 0; r < 8; ++r) {
+                    if (r < nr) {
+                        const simd<float, 128> y = block_load<float, 128>(xm + (size_t) r * ldx + k0) * sc[r] * wv;
+                        if (dst != nullptr) {
+                            block_store<float, 128>(dst + (size_t) (mt * 8 + r) * ldd + k0, y);
+                        }
+                        simd<sycl::half, 128> h = y;
+#pragma unroll
+                        for (int s = 0; s < 8; ++s) {
+                            tl.template select<16, 1>(s * 128 + r * 16) = h.template select<16, 1>(s * 16);
+                        }
+                    }
+                }
+                sycl::half *                o  = out + ((size_t) mt * nks + k0 / 16) * 128;
+                const simd<sycl::half, 512> t0 = tl.template select<512, 1>(0);
+                const simd<sycl::half, 512> t1 = tl.template select<512, 1>(512);
+                block_store<sycl::half, 512>(o, t0);
+                block_store<sycl::half, 512>(o + 512, t1);
+            }
+        });
+}
+
+// rms_pack_act for M <= 8, where one work-group per panel is one work-group on the whole device: one per row of the
+// panel instead (rows M..7 write the zero rows of the tiles), with rms_pack_act's threads and sums, so the same bits
+inline sycl::event rms_pack_act_rows(sycl::queue & q, const float * x, int64_t ldx, const float * w, float * dst,
+                                     int64_t ldd, sycl::half * out, int M, int K, float eps, int wgt) {
+    const int   kpt = K / 128 / wgt;
+    const float fk  = (float) K;
+    return q.parallel_for(sycl::nd_range<1>(sycl::range<1>((size_t) 8 * wgt), sycl::range<1>(wgt)),
+        [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL {
+            slm_init<RMS_WGT_MAX * sizeof(float)>();
+            const int     t    = (int) it.get_local_id(0);
+            const int     r    = (int) it.get_group(0);
+            const bool    live = r < M;
+            const float * xr   = x + (size_t) r * ldx;
+            float         ssq  = 0.0f;
+            if (live) {
+                for (int j = 0; j < kpt; ++j) {
+                    const simd<float, 128> v = block_load<float, 128>(xr + (t * kpt + j) * 128);
+                    ssq = ssq + reduce<float>(v * v, std::plus<>());
+                }
+            }
+            slm_scalar_store<float>((uint32_t) (t * sizeof(float)), ssq);
+            barrier();
+            float tot = 0.0f;
+            for (int i = 0; i < wgt; ++i) {
+                tot += slm_scalar_load<float>((uint32_t) (i * sizeof(float)));
+            }
+            const simd<float, 1> sc = rsqrt(simd<float, 1>(tot / fk + eps));
+            // the second read of the row hits cache
+            for (int j = 0; j < kpt; ++j) {
+                const int             k0 = (t * kpt + j) * 128;
+                simd<sycl::half, 128> h  = 0;
+                if (live) {
+                    const simd<float, 128> y = block_load<float, 128>(xr + k0) * sc[0] * block_load<float, 128>(w + k0);
+                    if (dst != nullptr) {
+                        block_store<float, 128>(dst + (size_t) r * ldd + k0, y);
+                    }
+                    h = y;
+                }
+                sycl::half * o = out + (size_t) (k0 / 16) * 128 + r * 16;
+#pragma unroll
+                for (int s = 0; s < 8; ++s) {
+                    block_store<sycl::half, 16>(o + s * 128, h.template select<16, 1>(s * 16));
+                }
+            }
+        });
+}
+
+// ---- shared pieces -----------------------------------------------------------------------
+
+// the folded post-ops of a gemm store: dst = acc * rs[m] + res2 + res, each term only when given
+// tiles / pack replace the row store with the [Mp/8][N/16][8][16] tile layout of a following gemm's activation
+struct gemm_epi {
+    const float * res   = nullptr;   // residual add
+    const float * res2  = nullptr;   // a second add, before res
+    const float * rs    = nullptr;   // per-row scale, before both adds
+    float *       part  = nullptr;   // split-K: k slice s > 0 stores its raw partial at part + (s - 1) * M * N
+    float *       tiles = nullptr;   // acc as f32 tiles (the gate of a split swiglu)
+    const float * glu   = nullptr;   // with pack: silu of these f32 tiles times acc
+    sycl::half *  pack  = nullptr;   // acc (or the swiglu) as f16 tiles, the packed input of the next gemm
+};
+
+// stores the [8 tokens][16 rows] accumulator tiles of rows < M with the post-ops of epi
+// in the tile layouts, tiles past M are written too; the buffers cover Mp rows and nothing reads those
+template <int NB, int MT>
+ESIMD_INLINE void store_tiles(simd<float, 128> (&acc)[NB * MT], float * dst, const gemm_epi & epi, int mt0, int M, int N, int n0) {
+    if (epi.tiles != nullptr || epi.pack != nullptr) {
+#pragma unroll
+        for (int t = 0; t < MT; ++t) {
+#pragma unroll
+            for (int g = 0; g < NB; ++g) {
+                const size_t o = ((size_t) (mt0 + t) * (N / 16) + n0 / 16 + g) * 128;
+                if (epi.pack != nullptr) {
+                    simd<float, 128> y = acc[g * MT + t];
+                    if (epi.glu != nullptr) {
+                        const simd<float, 128> gt = block_load<float, 128>(epi.glu + o);
+                        y = y * (gt / (1.0f + exp(-gt)));   // as ggml_sycl_op_swiglu
+                    }
+                    block_store<sycl::half, 128>(epi.pack + o, simd<sycl::half, 128>(y));
+                } else {
+                    block_store<float, 128>(epi.tiles + o, acc[g * MT + t]);
+                }
+            }
+        }
+        return;
+    }
+#pragma unroll
+    for (int t = 0; t < MT; ++t) {
+#pragma unroll
+        for (int r = 0; r < 8; ++r) {
+            const int m = (mt0 + t) * 8 + r;
+            if (m < M) {
+                simd<float, 16 * NB> o;
+#pragma unroll
+                for (int g = 0; g < NB; ++g) {
+                    o.template select<16, 1>(16 * g) = acc[g * MT + t].template select<16, 1>(16 * r);
+                }
+                if (epi.rs != nullptr) {
+                    o *= epi.rs[m];
+                }
+                if (epi.res2 != nullptr) {
+                    o += block_load<float, 16 * NB>(epi.res2 + (size_t) m * N + n0);
+                }
+                if (epi.res != nullptr) {
+                    o += block_load<float, 16 * NB>(epi.res + (size_t) m * N + n0);
+                }
+                block_store<float, 16 * NB>(dst + (size_t) m * N + n0, o);
+            }
+        }
+    }
+}
+
+// the store of k slice `slice` of KS: with KS > 1 slice 0 writes dst, the others their partial, all without post-ops
+template <int NB, int MT, int KS>
+ESIMD_INLINE void store_split(simd<float, 128> (&acc)[NB * MT], float * dst, const gemm_epi & epi, int slice, int mt0, int M,
+                              int N, int n0) {
+    if constexpr (KS == 1) {
+        store_tiles<NB, MT>(acc, dst, epi, mt0, M, N, n0);
+    } else {
+        store_tiles<NB, MT>(acc, slice == 0 ? dst : epi.part + (size_t) (slice - 1) * M * N, gemm_epi{}, mt0, M, N, n0);
+    }
+}
+
+// dst = (dst + part[0] + ... + part[ks - 2]) * rs[m] + res2 + res, the post-ops of a split-K gemm; N % 4 == 0
+inline sycl::event splitk_reduce(sycl::queue & q, float * dst, const gemm_epi epi, int ks, int M, int N) {
+    const size_t mn = (size_t) M * N;
+    return q.parallel_for(sycl::range<1>(mn / 4), [=](sycl::id<1> id) {
+        const size_t i = id[0] * 4;
+        using f4 = sycl::vec<float, 4>;
+        f4 o = *(const f4 *) (dst + i);
+        for (int s = 0; s < ks - 1; ++s) {
+            o += *(const f4 *) (epi.part + s * mn + i);
+        }
+        if (epi.rs != nullptr) {
+            o *= epi.rs[i / N];
+        }
+        if (epi.res2 != nullptr) {
+            o += *(const f4 *) (epi.res2 + i);
+        }
+        if (epi.res != nullptr) {
+            o += *(const f4 *) (epi.res + i);
+        }
+        *(f4 *) (dst + i) = o;
+    });
+}
+
+// get_scale_min_k4 for 16 rows from the header image [d | dmin][scales x 3 dwords] into sc/mn[16 j + lane]
+// the odd (high nibble) sub-blocks get scale / 16, as their nibble sits at x16
+ESIMD_INLINE void kquant_scale_min(simd<uint32_t, 4 * 16> hdr, simd<sycl::half, 128> & sc, simd<sycl::half, 128> & mn) {
+    auto r8 = hdr.template bit_cast_view<uint8_t>();
+    auto rh = hdr.template bit_cast_view<sycl::half>();
+    const simd<float, 16> d    = rh.template replicate_vs_w_hs<16, 2, 1, 0>(0);
+    const simd<float, 16> dmin = rh.template replicate_vs_w_hs<16, 2, 1, 0>(1);
+    simd<uint16_t, 16> s[12];
+#pragma unroll
+    for (int b = 0; b < 12; ++b) {
+        s[b] = r8.template replicate_vs_w_hs<16, 4, 1, 0>((1 + b / 4) * 64 + b % 4);
+    }
+#pragma unroll
+    for (int j = 0; j < 8; ++j) {
+        simd<uint16_t, 16> scj, mj;
+        if (j < 4) {
+            scj = s[j] & 63;
+            mj  = s[j + 4] & 63;
+        } else {
+            scj = (s[j + 4] & 0xF) | ((s[j - 4] >> 6) << 4);
+            mj  = (s[j + 4] >> 4) | ((s[j] >> 6) << 4);
+        }
+        const float hs = (j & 1) ? 1.0f / 16 : 1.0f;
+        sc.template select<16, 1>(16 * j) = d * convert<float>(scj) * hs;
+        mn.template select<16, 1>(16 * j) = dmin * convert<float>(mj);
+    }
+}
+
+// lane l of row group g reads weight row n0 + 16 g + l
+ESIMD_INLINE simd<uint32_t, 16> lane_rows(int n0, int g) {
+    return simd<uint32_t, 16>(0, 1) + (uint32_t) (n0 + 16 * g);
+}
+
+// the weight panel gni and token panel gmi of work-group wg in a gn x gm grid. RAST 0: token-outer. 1: weight-outer, the
+// token panels of one weight panel back to back. 2: weight-outer over groups of gs token panels, so the work-groups in
+// flight share the activations of one group in L2 where all of M does not fit (gs >= gm is mode 1). The dense gemms
+// below take the group size in tokens as their last argument gt, which only mode 2 reads
+template <int RAST>
+ESIMD_INLINE void wg_panels(int wg, int gn, int gm, int gs, int & gni, int & gmi) {
+    if constexpr (RAST == 0) {
+        gni = wg % gn;
+        gmi = wg / gn;
+    } else if constexpr (RAST == 1) {
+        gni = wg / gm;
+        gmi = wg % gm;
+    } else {
+        const int grp  = wg / (gs * gn);
+        const int base = grp * gs;
+        const int gsz  = gm - base < gs ? gm - base : gs;
+        const int r    = wg - grp * gs * gn;
+        gni = r / gsz;
+        gmi = base + r % gsz;
+    }
+}
+
+// ---- Q8_0 --------------------------------------------------------------------------------
+// thread tile 32 rows x 32 tokens, a block pair (68 B, or 64 B qs + 4 B d in SoA) is 17 dwords per row; q = (b ^ 0x6480) - 1152
+// K % 64 == 0, N % (32 * TW) == 0
+template <int TW, int TT, int RAST, bool SOA>
+sycl::event gemm_q8_0(sycl::queue & q, const uint8_t * w, const sycl::half * act, float * dst, int M, int N, int K,
+                      const gemm_epi epi = {}, int gt = 0) {
+    constexpr int NB = 2, MT = 4;
+    const int      nb    = K / 32;
+    const uint32_t rowb  = (uint32_t) nb * (SOA ? 32 : 34);
+    const uint32_t dbase = (uint32_t) N * nb * 32;
+    const int      nks   = K / 16;
+    const int      gn    = N / (16 * NB * TW);
+    const int      gm    = (M + 8 * MT * TT - 1) / (8 * MT * TT);
+    const int      gs   = gt >= 16 * MT * TT ? gt / (8 * MT * TT) : gt > 0 ? 1 : gm;   // token panels per group
+    namespace sx = sycl::ext::oneapi::experimental;
+    sx::properties props{ sycl::ext::intel::experimental::grf_size<GRF> };
+
+    return q.parallel_for(sycl::nd_range<1>(sycl::range<1>((size_t) gn * gm * TW * TT), sycl::range<1>(TW * TT)), props,
+        [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL {
+            const int wg  = (int) it.get_group(0);
+            const int lid = (int) it.get_local_id(0);
+            int gni, gmi;
+            if constexpr (RAST == 2) {   // only the grouped kernels take gs as an argument
+                wg_panels<2>(wg, gn, gm, gs, gni, gmi);
+            } else {
+                wg_panels<RAST>(wg, gn, gm, 0, gni, gmi);
+            }
+            const int n0  = (gni * TW + lid % TW) * 16 * NB;
+            const int mt0 = (gmi * TT + lid / TW) * MT;
+            if (mt0 * 8 >= M) {
+                return;
+            }
+
+            simd<float, 128> acc[NB * MT];
+#pragma unroll
+            for (int i = 0; i < NB * MT; ++i) {
+                acc[i] = 0.0f;
+            }
+            const uint32_t * w32 = (const uint32_t *) w;
+            simd<uint32_t, 16> oq[NB], od[NB];
+#pragma unroll
+            for (int g = 0; g < NB; ++g) {
+                const simd<uint32_t, 16> rows = lane_rows(n0, g);
+                oq[g] = rows * rowb;
+                od[g] = dbase + rows * (uint32_t) (nb * 2);
+            }
+            const sycl::half * pa[MT];
+#pragma unroll
+            for (int t = 0; t < MT; ++t) {
+                pa[t] = act + (size_t) (mt0 + t) * nks * 128;
+            }
+
+            for (int kp = 0; kp < nb / 2; ++kp) {
+                simd<uint32_t, 17 * 16> raw[NB];   // [dword][lane]
+#pragma unroll
+                for (int g = 0; g < NB; ++g) {
+                    raw[g].template select<128, 1>(0)   = gather<uint32_t, 128, 8>(w32, oq[g]);
+                    raw[g].template select<128, 1>(128) = gather<uint32_t, 128, 8>(w32, oq[g] + 32);
+                    raw[g].template select<16, 1>(256)  = gather<uint32_t, 16, 1>(w32, SOA ? od[g] : oq[g] + 64);
+                    oq[g] += SOA ? 64 : 68;
+                    od[g] += 4;
+                }
+#pragma unroll
+                for (int j = 0; j < 2; ++j) {
+#pragma unroll
+                    for (int c = 0; c < 2; ++c) {
+                        simd<sycl::half, 256> b[NB];
+#pragma unroll
+                        for (int g = 0; g < NB; ++g) {
+                            auto r8 = raw[g].template bit_cast_view<uint8_t>();
+                            auto rh = raw[g].template bit_cast_view<sycl::half>();
+                            const int odj = SOA ? 64 + 2 * j : 34 * j;   // byte of block j's d
+                            const simd<sycl::half, 32> dv =
+                                rh.template replicate_vs_w_hs<16, 2, 2, 0>((odj / 4) * 32 + (odj % 4) / 2);
+#pragma unroll
+                            for (int p = 0; p < 8; ++p) {
+                                const int o = (SOA ? 32 * j : 34 * j + 2) + 16 * c + 2 * p;   // byte of this k pair
+                                simd<uint16_t, 32> u = r8.template replicate_vs_w_hs<16, 4, 2, 1>((o / 4) * 64 + o % 4);
+                                u ^= (uint16_t) 0x6480;
+                                b[g].template select<32, 1>(p * 32) =
+                                    (u.template bit_cast_view<sycl::half>() - (sycl::half) 1152.0f) * dv;
+                            }
+                        }
+#pragma unroll
+                        for (int t = 0; t < MT; ++t) {
+                            const simd<sycl::half, 128> a = block_load<sycl::half, 128>(pa[t]);
+                            pa[t] += 128;
+#pragma unroll
+                            for (int g = 0; g < NB; ++g) {
+                                acc[g * MT + t] = xmx::dpas<8, 8, float, float, sycl::half, sycl::half>(acc[g * MT + t], b[g], a);
+                            }
+                        }
+                    }
+                }
+            }
+            store_tiles<NB, MT>(acc, dst, epi, mt0, M, N, n0);
+        });
+}
+
+// gemm_q8_0 with its two row groups taken from the same rows of the gate and the up weight, writing silu(gate) * up
+// as the packed input of the down gemm (see gemm_glu_q4_K); K % 64 == 0, N % (16 * TW) == 0
+template <int TW, int TT, int RAST, bool SOA, bool GEGLU>
+sycl::event gemm_glu_q8_0(sycl::queue & q, const uint8_t * wg, const uint8_t * wu, const sycl::half * act,
+                          sycl::half * out, int M, int N, int K, int gt = 0) {
+    constexpr int NB = 2, MT = 4;
+    const int      nb    = K / 32;
+    const uint32_t rowb  = (uint32_t) nb * (SOA ? 32 : 34);
+    const uint32_t dbase = (uint32_t) N * nb * 32;
+    const int      nks   = K / 16;
+    const int      gn    = N / (16 * TW);
+    const int      gm    = (M + 8 * MT * TT - 1) / (8 * MT * TT);
+    const int      gs   = gt >= 16 * MT * TT ? gt / (8 * MT * TT) : gt > 0 ? 1 : gm;   // token panels per group
+    namespace sx = sycl::ext::oneapi::experimental;
+    sx::properties props{ sycl::ext::intel::experimental::grf_size<GRF> };
+
+    return q.parallel_for(sycl::nd_range<1>(sycl::range<1>((size_t) gn * gm * TW * TT), sycl::range<1>(TW * TT)), props,
+        [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL {
+            const int wgi = (int) it.get_group(0);
+            const int lid = (int) it.get_local_id(0);
+            int gni, gmi;
+            if constexpr (RAST == 2) {   // only the grouped kernels take gs as an argument
+                wg_panels<2>(wgi, gn, gm, gs, gni, gmi);
+            } else {
+                wg_panels<RAST>(wgi, gn, gm, 0, gni, gmi);
+            }
+            const int n0  = (gni * TW + lid % TW) * 16;
+            const int mt0 = (gmi * TT + lid / TW) * MT;
+            if (mt0 * 8 >= M) {
+                return;
+            }
+
+            simd<float, 128> acc[NB * MT];
+#pragma unroll
+            for (int i = 0; i < NB * MT; ++i) {
+                acc[i] = 0.0f;
+            }
+            const uint32_t * w32[NB] = { (const uint32_t *) wg, (const uint32_t *) wu };
+            simd<uint32_t, 16> oq, od;
+            {
+                const simd<uint32_t, 16> rows = lane_rows(n0, 0);
+                oq = rows * rowb;
+                od = dbase + rows * (uint32_t) (nb * 2);
+            }
+            const sycl::half * pa[MT];
+#pragma unroll
+            for (int t = 0; t < MT; ++t) {
+                pa[t] = act + (size_t) (mt0 + t) * nks * 128;
+            }
+
+            for (int kp = 0; kp < nb / 2; ++kp) {
+                simd<uint32_t, 17 * 16> raw[NB];   // [dword][lane]
+#pragma unroll
+                for (int g = 0; g < NB; ++g) {
+                    raw[g].template select<128, 1>(0)   = gather<uint32_t, 128, 8>(w32[g], oq);
+                    raw[g].template select<128, 1>(128) = gather<uint32_t, 128, 8>(w32[g], oq + 32);
+                    raw[g].template select<16, 1>(256)  = gather<uint32_t, 16, 1>(w32[g], SOA ? od : oq + 64);
+                }
+                oq += SOA ? 64 : 68;
+                od += 4;
+#pragma unroll
+                for (int j = 0; j < 2; ++j) {
+#pragma unroll
+                    for (int c = 0; c < 2; ++c) {
+                        simd<sycl::half, 256> b[NB];
+#pragma unroll
+                        for (int g = 0; g < NB; ++g) {
+                            auto r8 = raw[g].template bit_cast_view<uint8_t>();
+                            auto rh = raw[g].template bit_cast_view<sycl::half>();
+                            const int odj = SOA ? 64 + 2 * j : 34 * j;
+                            const simd<sycl::half, 32> dv =
+                                rh.template replicate_vs_w_hs<16, 2, 2, 0>((odj / 4) * 32 + (odj % 4) / 2);
+#pragma unroll
+                            for (int p = 0; p < 8; ++p) {
+                                const int o = (SOA ? 32 * j : 34 * j + 2) + 16 * c + 2 * p;
+                                simd<uint16_t, 32> u = r8.template replicate_vs_w_hs<16, 4, 2, 1>((o / 4) * 64 + o % 4);
+                                u ^= (uint16_t) 0x6480;
+                                b[g].template select<32, 1>(p * 32) =
+                                    (u.template bit_cast_view<sycl::half>() - (sycl::half) 1152.0f) * dv;
+                            }
+                        }
+#pragma unroll
+                        for (int t = 0; t < MT; ++t) {
+                            const simd<sycl::half, 128> a = block_load<sycl::half, 128>(pa[t]);
+                            pa[t] += 128;
+#pragma unroll
+                            for (int g = 0; g < NB; ++g) {
+                                acc[g * MT + t] = xmx::dpas<8, 8, float, float, sycl::half, sycl::half>(acc[g * MT + t], b[g], a);
+                            }
+                        }
+                    }
+                }
+            }
+#pragma unroll
+            for (int t = 0; t < MT; ++t) {
+                const simd<float, 128> gt = acc[t];
+                const simd<float, 128> gelu_arg =
+                    0.7978845608f * (gt + 0.044715f * gt * gt * gt);
+                const simd<float, 128> tanh_gelu_arg =
+                    2.0f / (1.0f + sycl::ext::intel::esimd::exp(-2.0f * gelu_arg)) - 1.0f;
+
+                const simd<float, 128> h = GEGLU
+                    ? 0.5f * gt * (1.0f + tanh_gelu_arg) * acc[MT + t]
+                    : gt * acc[MT + t] / (1.0f + sycl::ext::intel::esimd::exp(-gt));
+                block_store<sycl::half, 128>(out + ((size_t) (mt0 + t) * (N / 16) + n0 / 16) * 128, simd<sycl::half, 128>(h));
+            }
+        });
+}
+
+// gemm_q8_0 for narrow N (the delta-net alpha / beta projections): one 32-row x 8-token tile per work-group, whose
+// NARROW_KT threads each take a slice of K and meet in SLM, so a few dozen output tiles still fill the device
+constexpr int NARROW_KT = 8;
+
+template <bool SOA>
+sycl::event gemm_q8_0_narrow(sycl::queue & q, const uint8_t * w, const sycl::half * act, float * dst, int M, int N, int K,
+                             const gemm_epi epi = {}) {
+    constexpr int NB = 2;
+    const int      nb    = K / 32;
+    const uint32_t rowb  = (uint32_t) nb * (SOA ? 32 : 34);
+    const uint32_t dbase = (uint32_t) N * nb * 32;
+    const int      nks   = K / 16;
+    const int      nkp   = nb / 2;
+    const int      kpt   = (nkp + NARROW_KT - 1) / NARROW_KT;   // block pairs per thread
+    const int      gn    = N / (16 * NB);
+    const int      nmt   = (M + 7) / 8;
+    namespace sx = sycl::ext::oneapi::experimental;
+    sx::properties props{ sycl::ext::intel::experimental::grf_size<GRF> };   // as its neighbours: no GRF mode switch
+
+    return q.parallel_for(sycl::nd_range<1>(sycl::range<1>((size_t) gn * nmt * NARROW_KT), sycl::range<1>(NARROW_KT)), props,
+        [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL {
+            slm_init<NARROW_KT * NB * 128 * sizeof(float)>();
+            const int t   = (int) it.get_local_id(0);
+            const int wg  = (int) it.get_group(0);
+            const int mt  = wg / gn;
+            const int n0  = (wg % gn) * 16 * NB;
+            const int kp0 = t * kpt;
+            const int kp1 = kp0 + kpt < nkp ? kp0 + kpt : nkp;
+
+            simd<float, 128> acc[NB];
+            acc[0] = 0.0f;
+            acc[1] = 0.0f;
+            const uint32_t * w32 = (const uint32_t *) w;
+            simd<uint32_t, 16> oq[NB], od[NB];
+#pragma unroll
+            for (int g = 0; g < NB; ++g) {
+                const simd<uint32_t, 16> rows = lane_rows(n0, g);
+                oq[g] = rows * rowb + (uint32_t) kp0 * (SOA ? 64 : 68);
+                od[g] = dbase + rows * (uint32_t) (nb * 2) + (uint32_t) kp0 * 4;
+            }
+            const sycl::half * pa = act + ((size_t) mt * nks + (size_t) kp0 * 4) * 128;
+
+            for (int kp = kp0; kp < kp1; ++kp) {
+                simd<uint32_t, 17 * 16> raw[NB];   // [dword][lane]
+#pragma unroll
+                for (int g = 0; g < NB; ++g) {
+                    raw[g].template select<128, 1>(0)   = gather<uint32_t, 128, 8>(w32, oq[g]);
+                    raw[g].template select<128, 1>(128) = gather<uint32_t, 128, 8>(w32, oq[g] + 32);
+                    raw[g].template select<16, 1>(256)  = gather<uint32_t, 16, 1>(w32, SOA ? od[g] : oq[g] + 64);
+                    oq[g] += SOA ? 64 : 68;
+                    od[g] += 4;
+                }
+#pragma unroll
+                for (int j = 0; j < 2; ++j) {
+#pragma unroll
+                    for (int c = 0; c < 2; ++c) {
+                        const simd<sycl::half, 128> a = block_load<sycl::half, 128>(pa);
+                        pa += 128;
+#pragma unroll
+                        for (int g = 0; g < NB; ++g) {
+                            auto r8 = raw[g].template bit_cast_view<uint8_t>();
+                            auto rh = raw[g].template bit_cast_view<sycl::half>();
+                            const int odj = SOA ? 64 + 2 * j : 34 * j;
+                            const simd<sycl::half, 32> dv =
+                                rh.template replicate_vs_w_hs<16, 2, 2, 0>((odj / 4) * 32 + (odj % 4) / 2);
+                            simd<sycl::half, 256> b;
+#pragma unroll
+                            for (int p = 0; p < 8; ++p) {
+                                const int o = (SOA ? 32 * j : 34 * j + 2) + 16 * c + 2 * p;
+                                simd<uint16_t, 32> u = r8.template replicate_vs_w_hs<16, 4, 2, 1>((o / 4) * 64 + o % 4);
+                                u ^= (uint16_t) 0x6480;
+                                b.template select<32, 1>(p * 32) = (u.template bit_cast_view<sycl::half>() - (sycl::half) 1152.0f) * dv;
+                            }
+                            acc[g] = xmx::dpas<8, 8, float, float, sycl::half, sycl::half>(acc[g], b, a);
+                        }
+                    }
+                }
+            }
+            // the K slices meet in SLM in a fixed order
+            slm_block_store<float, 128>((uint32_t) (t * NB * 128 * sizeof(float)), acc[0]);
+            slm_block_store<float, 128>((uint32_t) ((t * NB + 1) * 128 * sizeof(float)), acc[1]);
+            barrier();
+            if (t == 0) {
+                simd<float, 128> sum[NB];
+                sum[0] = slm_block_load<float, 128>(0);
+                sum[1] = slm_block_load<float, 128>(128 * sizeof(float));
+                for (int i = 1; i < NARROW_KT; ++i) {
+                    sum[0] += slm_block_load<float, 128>((uint32_t) (i * NB * 128 * sizeof(float)));
+                    sum[1] += slm_block_load<float, 128>((uint32_t) ((i * NB + 1) * 128 * sizeof(float)));
+                }
+                store_tiles<NB, 1>(sum, dst, epi, mt, M, N, n0);
+            }
+        });
+}
+
+// ---- Q4_K --------------------------------------------------------------------------------
+// thread tile 32 rows x 32 tokens, one super-block of 16 rows gathered at once as the image [dm][scales x 3][qs x 32 dwords]
+// (b & 0x0F) | 0x6400 = 1024 + q, (b & 0xF0) | 0x6400 = 1024 + 16 q; K % 256 == 0, N % (32 * TW) == 0
+// NB / MT / A2: other tiles, A2 = the A tiles of k-steps s, s + 1 in one 512 B load; 16 x 64 with A2 is +4-10% on the
+// large-K split-K shapes of B70 (and -4% on the others)
+template <int TW, int TT, int RAST, bool SOA, int KS = 1, int NB = 2, int MT = 4, bool A2 = false>
+sycl::event gemm_q4_K(sycl::queue & q, const uint8_t * w, const sycl::half * act, float * dst, int M, int N, int K,
+                      const gemm_epi epi = {}, int gt = 0) {
+    const int      nsb  = K / 256;
+    const uint32_t nblk = (uint32_t) N * nsb;
+    const int      nks  = K / 16;
+    const int      gn   = N / (16 * NB * TW);
+    const int      gm   = (M + 8 * MT * TT - 1) / (8 * MT * TT);
+    const int      gs   = gt >= 16 * MT * TT ? gt / (8 * MT * TT) : gt > 0 ? 1 : gm;   // token panels per group
+    const int      nss  = nsb / KS;   // super-blocks per k slice
+    namespace sx = sycl::ext::oneapi::experimental;
+    sx::properties props{ sycl::ext::intel::experimental::grf_size<GRF> };
+
+    return q.parallel_for(sycl::nd_range<1>(sycl::range<1>((size_t) gn * gm * KS * TW * TT), sycl::range<1>(TW * TT)), props,
+        [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL {
+            const int wgk = KS == 1 ? 0 : (int) it.get_group(0) / (gn * gm);   // k slice
+            const int wg  = KS == 1 ? (int) it.get_group(0) : (int) it.get_group(0) % (gn * gm);
+            const int lid = (int) it.get_local_id(0);
+            int gni, gmi;
+            if constexpr (RAST == 2) {   // only the grouped kernels take gs as an argument
+                wg_panels<2>(wg, gn, gm, gs, gni, gmi);
+            } else {
+                wg_panels<RAST>(wg, gn, gm, 0, gni, gmi);
+            }
+            const int n0  = (gni * TW + lid % TW) * 16 * NB;
+            const int mt0 = (gmi * TT + lid / TW) * MT;
+            if (mt0 * 8 >= M) {
+                return;
+            }
+
+            simd<float, 128> acc[NB * MT];
+#pragma unroll
+            for (int i = 0; i < NB * MT; ++i) {
+                acc[i] = 0.0f;
+            }
+            const uint32_t * w32 = (const uint32_t *) w;
+            // GGUF: oq = the block; SoA: oq = qs, os = scales, om = dm
+            simd<uint32_t, 16> oq[NB], os[NB], om[NB];
+#pragma unroll
+            for (int g = 0; g < NB; ++g) {
+                const simd<uint32_t, 16> blk = lane_rows(n0, g) * (uint32_t) nsb + (uint32_t) (wgk * nss);
+                oq[g] = blk * (uint32_t) (SOA ? 128 : 144);
+                os[g] = nblk * 128 + blk * 12;
+                om[g] = nblk * 140 + blk * 4;
+            }
+            const sycl::half * pa[MT];
+#pragma unroll
+            for (int t = 0; t < MT; ++t) {
+                pa[t] = act + (size_t) (mt0 + t) * nks * 128 + (size_t) wgk * nss * 2048;
+            }
+
+            for (int sb = 0; sb < nss; ++sb) {
+                simd<uint32_t, 36 * 16> raw[NB];   // [dword][lane]
+                simd<uint64_t, 64>      a2[A2 ? MT : 1];
+                simd<sycl::half, 16> sc[NB][8], mn[NB][8];
+#pragma unroll
+                for (int g = 0; g < NB; ++g) {
+                    if constexpr (SOA) {
+                        raw[g].template select<16, 1>(0) = gather<uint32_t, 16, 1>(w32, om[g]);
+                        raw[g].template select<48, 1>(16) = gather<uint32_t, 48, 3>(w32, os[g]);
+#pragma unroll
+                        for (int i = 0; i < 4; ++i) {
+                            raw[g].template select<128, 1>(64 + i * 128) = gather<uint32_t, 128, 8>(w32, oq[g] + 32 * i);
+                        }
+                        oq[g] += 128;
+                        os[g] += 12;
+                        om[g] += 4;
+                    } else {
+#pragma unroll
+                        for (int i = 0; i < 4; ++i) {
+                            raw[g].template select<128, 1>(i * 128) = gather<uint32_t, 128, 8>(w32, oq[g] + 32 * i);
+                        }
+                        raw[g].template select<64, 1>(512) = gather<uint32_t, 64, 4>(w32, oq[g] + 128);
+                        oq[g] += 144;
+                    }
+                    // get_scale_min_k4 inline: packed scales (kquant_scale_min) make IGC serialize this kernel's loads
+                    auto r8 = raw[g].template bit_cast_view<uint8_t>();
+                    auto rh = raw[g].template bit_cast_view<sycl::half>();
+                    const simd<float, 16> d    = rh.template replicate_vs_w_hs<16, 2, 1, 0>(0);
+                    const simd<float, 16> dmin = rh.template replicate_vs_w_hs<16, 2, 1, 0>(1);
+                    simd<uint16_t, 16> s[12];
+#pragma unroll
+                    for (int b = 0; b < 12; ++b) {
+                        s[b] = r8.template replicate_vs_w_hs<16, 4, 1, 0>((1 + b / 4) * 64 + b % 4);
+                    }
+#pragma unroll
+                    for (int j = 0; j < 8; ++j) {
+                        simd<uint16_t, 16> scj, mj;
+                        if (j < 4) {
+                            scj = s[j] & 63;
+                            mj  = s[j + 4] & 63;
+                        } else {
+                            scj = (s[j + 4] & 0xF) | ((s[j - 4] >> 6) << 4);
+                            mj  = (s[j + 4] >> 4) | ((s[j] >> 6) << 4);
+                        }
+                        const float hs = (j & 1) ? 1.0f / 16 : 1.0f;
+                        sc[g][j] = d * convert<float>(scj) * hs;
+                        mn[g][j] = dmin * convert<float>(mj);
+                    }
+                }
+#pragma unroll
+                for (int s = 0; s < 16; ++s) {
+                    const int j = s / 2, h = s % 2, c = j / 2;
+                    simd<sycl::half, 256> b[NB];
+#pragma unroll
+                    for (int g = 0; g < NB; ++g) {
+                        auto r8 = raw[g].template bit_cast_view<uint8_t>();
+                        const simd<sycl::half, 32> dv = sc[g][j].template replicate_vs_w_hs<16, 1, 2, 0>(0);
+                        const simd<sycl::half, 32> mv = mn[g][j].template replicate_vs_w_hs<16, 1, 2, 0>(0);
+#pragma unroll
+                        for (int p = 0; p < 8; ++p) {
+                            const int o = 16 + 32 * c + 16 * h + 2 * p;   // byte of this k pair in the image
+                            simd<uint16_t, 32> u = r8.template replicate_vs_w_hs<16, 4, 2, 1>((o / 4) * 64 + o % 4);
+                            u = (u & (uint16_t) ((j & 1) ? 0xF0 : 0x0F)) | (uint16_t) 0x6400;
+                            const simd<sycl::half, 32> qh = u.template bit_cast_view<sycl::half>() - (sycl::half) 1024.0f;
+                            b[g].template select<32, 1>(p * 32) = qh * dv - mv;
+                        }
+                    }
+                    if constexpr (A2) {
+                        if (s % 2 == 0) {
+#pragma unroll
+                            for (int t = 0; t < MT; ++t) {
+                                a2[t] = block_load<uint64_t, 64>((const uint64_t *) pa[t]);
+                                pa[t] += 256;
+                            }
+                        }
+                    }
+#pragma unroll
+                    for (int t = 0; t < MT; ++t) {
+                        simd<sycl::half, 128> a;
+                        if constexpr (A2) {
+                            a = a2[t].template bit_cast_view<sycl::half>().template select<128, 1>((s % 2) * 128);
+                        } else {
+                            a = block_load<sycl::half, 128>(pa[t]);
+                            pa[t] += 128;
+                        }
+#pragma unroll
+                        for (int g = 0; g < NB; ++g) {
+                            acc[g * MT + t] = xmx::dpas<8, 8, float, float, sycl::half, sycl::half>(acc[g * MT + t], b[g], a);
+                        }
+                    }
+                }
+            }
+            store_split<NB, MT, KS>(acc, dst, epi, wgk, mt0, M, N, n0);
+        });
+}
+
+// ---- Q4_K gate + up with swiglu ------------------------------------------------------------
+// gemm_q4_K with its two row groups taken from the same rows of the gate and the up weight
+// the epilogue writes silu(gate) * up as f16 tiles [Mp/8][N/16][8][16], the packed input of the down gemm; K % 256 == 0, N % (16 * TW) == 0
+template <int TW, int TT, int RAST, bool SOA>
+sycl::event gemm_glu_q4_K(sycl::queue & q, const uint8_t * wg, const uint8_t * wu, const sycl::half * act,
+                          sycl::half * out, int M, int N, int K, int gt = 0) {
+    constexpr int NB = 2, MT = 4;
+    const int      nsb  = K / 256;
+    const uint32_t nblk = (uint32_t) N * nsb;
+    const int      nks  = K / 16;
+    const int      gn   = N / (16 * TW);
+    const int      gm   = (M + 8 * MT * TT - 1) / (8 * MT * TT);
+    const int      gs   = gt >= 16 * MT * TT ? gt / (8 * MT * TT) : gt > 0 ? 1 : gm;   // token panels per group
+    namespace sx = sycl::ext::oneapi::experimental;
+    sx::properties props{ sycl::ext::intel::experimental::grf_size<GRF> };
+
+    return q.parallel_for(sycl::nd_range<1>(sycl::range<1>((size_t) gn * gm * TW * TT), sycl::range<1>(TW * TT)), props,
+        [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL {
+            const int wgi = (int) it.get_group(0);
+            const int lid = (int) it.get_local_id(0);
+            int gni, gmi;
+            if constexpr (RAST == 2) {   // only the grouped kernels take gs as an argument
+                wg_panels<2>(wgi, gn, gm, gs, gni, gmi);
+            } else {
+                wg_panels<RAST>(wgi, gn, gm, 0, gni, gmi);
+            }
+            const int n0  = (gni * TW + lid % TW) * 16;
+            const int mt0 = (gmi * TT + lid / TW) * MT;
+            if (mt0 * 8 >= M) {
+                return;
+            }
+
+            simd<float, 128> acc[NB * MT];
+#pragma unroll
+            for (int i = 0; i < NB * MT; ++i) {
+                acc[i] = 0.0f;
+            }
+            const uint32_t * w32[NB] = { (const uint32_t *) wg, (const uint32_t *) wu };
+            simd<uint32_t, 16> oq, os, om;
+            {
+                const simd<uint32_t, 16> blk = lane_rows(n0, 0) * (uint32_t) nsb;
+                oq = blk * (uint32_t) (SOA ? 128 : 144);
+                os = nblk * 128 + blk * 12;
+                om = nblk * 140 + blk * 4;
+            }
+            const sycl::half * pa[MT];
+#pragma unroll
+            for (int t = 0; t < MT; ++t) {
+                pa[t] = act + (size_t) (mt0 + t) * nks * 128;
+            }
+
+            for (int sb = 0; sb < nsb; ++sb) {
+                simd<uint32_t, 36 * 16> raw[NB];   // [dword][lane]
+                simd<sycl::half, 16> sc[NB][8], mn[NB][8];
+#pragma unroll
+                for (int g = 0; g < NB; ++g) {
+                    if constexpr (SOA) {
+                        raw[g].template select<16, 1>(0) = gather<uint32_t, 16, 1>(w32[g], om);
+                        raw[g].template select<48, 1>(16) = gather<uint32_t, 48, 3>(w32[g], os);
+#pragma unroll
+                        for (int i = 0; i < 4; ++i) {
+                            raw[g].template select<128, 1>(64 + i * 128) = gather<uint32_t, 128, 8>(w32[g], oq + 32 * i);
+                        }
+                    } else {
+#pragma unroll
+                        for (int i = 0; i < 4; ++i) {
+                            raw[g].template select<128, 1>(i * 128) = gather<uint32_t, 128, 8>(w32[g], oq + 32 * i);
+                        }
+                        raw[g].template select<64, 1>(512) = gather<uint32_t, 64, 4>(w32[g], oq + 128);
+                    }
+                    auto r8 = raw[g].template bit_cast_view<uint8_t>();
+                    auto rh = raw[g].template bit_cast_view<sycl::half>();
+                    const simd<float, 16> d    = rh.template replicate_vs_w_hs<16, 2, 1, 0>(0);
+                    const simd<float, 16> dmin = rh.template replicate_vs_w_hs<16, 2, 1, 0>(1);
+                    simd<uint16_t, 16> s[12];
+#pragma unroll
+                    for (int b = 0; b < 12; ++b) {
+                        s[b] = r8.template replicate_vs_w_hs<16, 4, 1, 0>((1 + b / 4) * 64 + b % 4);
+                    }
+#pragma unroll
+                    for (int j = 0; j < 8; ++j) {
+                        simd<uint16_t, 16> scj, mj;
+                        if (j < 4) {
+                            scj = s[j] & 63;
+                            mj  = s[j + 4] & 63;
+                        } else {
+                            scj = (s[j + 4] & 0xF) | ((s[j - 4] >> 6) << 4);
+                            mj  = (s[j + 4] >> 4) | ((s[j] >> 6) << 4);
+                        }
+                        const float hs = (j & 1) ? 1.0f / 16 : 1.0f;
+                        sc[g][j] = d * convert<float>(scj) * hs;
+                        mn[g][j] = dmin * convert<float>(mj);
+                    }
+                }
+                if constexpr (SOA) {
+                    oq += 128;
+                    os += 12;
+                    om += 4;
+                } else {
+                    oq += 144;
+                }
+#pragma unroll
+                for (int s = 0; s < 16; ++s) {
+                    const int j = s / 2, h = s % 2, c = j / 2;
+                    simd<sycl::half, 256> b[NB];
+#pragma unroll
+                    for (int g = 0; g < NB; ++g) {
+                        auto r8 = raw[g].template bit_cast_view<uint8_t>();
+                        const simd<sycl::half, 32> dv = sc[g][j].template replicate_vs_w_hs<16, 1, 2, 0>(0);
+                        const simd<sycl::half, 32> mv = mn[g][j].template replicate_vs_w_hs<16, 1, 2, 0>(0);
+#pragma unroll
+                        for (int p = 0; p < 8; ++p) {
+                            const int o = 16 + 32 * c + 16 * h + 2 * p;
+                            simd<uint16_t, 32> u = r8.template replicate_vs_w_hs<16, 4, 2, 1>((o / 4) * 64 + o % 4);
+                            u = (u & (uint16_t) ((j & 1) ? 0xF0 : 0x0F)) | (uint16_t) 0x6400;
+                            const simd<sycl::half, 32> qh = u.template bit_cast_view<sycl::half>() - (sycl::half) 1024.0f;
+                            b[g].template select<32, 1>(p * 32) = qh * dv - mv;
+                        }
+                    }
+#pragma unroll
+                    for (int t = 0; t < MT; ++t) {
+                        const simd<sycl::half, 128> a = block_load<sycl::half, 128>(pa[t]);
+                        pa[t] += 128;
+#pragma unroll
+                        for (int g = 0; g < NB; ++g) {
+                            acc[g * MT + t] = xmx::dpas<8, 8, float, float, sycl::half, sycl::half>(acc[g * MT + t], b[g], a);
+                        }
+                    }
+                }
+            }
+            // [8 tokens][16 columns] of silu(gate) * up is one tile of the down gemm's input
+#pragma unroll
+            for (int t = 0; t < MT; ++t) {
+                const simd<float, 128> gt = acc[t];
+                const simd<float, 128> h  = gt * acc[MT + t] / (1.0f + exp(-gt));
+                block_store<sycl::half, 128>(out + ((size_t) (mt0 + t) * (N / 16) + n0 / 16) * 128, simd<sycl::half, 128>(h));
+            }
+        });
+}
+
+// ---- Q5_K --------------------------------------------------------------------------------
+// Q4_K plus bit 2c (2c+1) of qh[l] above the low (high) nibble of qs[32c + l], OR-ed in at bit 4 (bit 8)
+// gathered in pieces: header, qh, then one 32 B qs chunk at a time; K % 256 == 0, N % (32 * TW) == 0
+// GLU as in gemm_iq4: the two row groups are the same rows of the gate (w) and the up (w2) weight
+template <int TW, int TT, int RAST, bool SOA, int KS = 1, bool GLU = false>
+sycl::event gemm_q5_K(sycl::queue & q, const uint8_t * w, const sycl::half * act, float * dst, int M, int N, int K,
+                      const gemm_epi epi = {}, const uint8_t * w2 = nullptr, sycl::half * gout = nullptr, int gt = 0) {
+    static_assert(!GLU || KS == 1, "the swiglu store needs whole k");
+    constexpr int NB = 2, MT = 4;
+    const int      nsb  = K / 256;
+    const uint32_t nblk = (uint32_t) N * nsb;
+    const int      nks  = K / 16;
+    const int      gn   = N / (16 * (GLU ? 1 : NB) * TW);
+    const int      gm   = (M + 8 * MT * TT - 1) / (8 * MT * TT);
+    const int      gs   = gt >= 16 * MT * TT ? gt / (8 * MT * TT) : gt > 0 ? 1 : gm;   // token panels per group
+    const int      nss  = nsb / KS;   // super-blocks per k slice
+    namespace sx = sycl::ext::oneapi::experimental;
+    sx::properties props{ sycl::ext::intel::experimental::grf_size<GRF> };
+
+    return q.parallel_for(sycl::nd_range<1>(sycl::range<1>((size_t) gn * gm * KS * TW * TT), sycl::range<1>(TW * TT)), props,
+        [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL {
+            const int wgk = KS == 1 ? 0 : (int) it.get_group(0) / (gn * gm);   // k slice
+            const int wg  = KS == 1 ? (int) it.get_group(0) : (int) it.get_group(0) % (gn * gm);
+            const int lid = (int) it.get_local_id(0);
+            int gni, gmi;
+            if constexpr (RAST == 2) {   // only the grouped kernels take gs as an argument
+                wg_panels<2>(wg, gn, gm, gs, gni, gmi);
+            } else {
+                wg_panels<RAST>(wg, gn, gm, 0, gni, gmi);
+            }
+            const int n0  = (gni * TW + lid % TW) * 16 * (GLU ? 1 : NB);
+            const int mt0 = (gmi * TT + lid / TW) * MT;
+            if (mt0 * 8 >= M) {
+                return;
+            }
+
+            simd<float, 128> acc[NB * MT];
+#pragma unroll
+            for (int i = 0; i < NB * MT; ++i) {
+                acc[i] = 0.0f;
+            }
+            const uint32_t * w32g[NB] = { (const uint32_t *) w, (const uint32_t *) (GLU ? w2 : w) };
+            // GGUF: oq = the block; SoA: oq = qs, oh = qh, os = scales, om = dm
+            simd<uint32_t, 16> oq[NB], oh[NB], os[NB], om[NB];
+#pragma unroll
+            for (int g = 0; g < NB; ++g) {
+                const simd<uint32_t, 16> blk = lane_rows(n0, GLU ? 0 : g) * (uint32_t) nsb + (uint32_t) (wgk * nss);
+                oq[g] = blk * (uint32_t) (SOA ? 128 : 176);
+                oh[g] = nblk * 128 + blk * 32;
+                os[g] = nblk * 160 + blk * 12;
+                om[g] = nblk * 172 + blk * 4;
+            }
+            const sycl::half * pa[MT];
+#pragma unroll
+            for (int t = 0; t < MT; ++t) {
+                pa[t] = act + (size_t) (mt0 + t) * nks * 128 + (size_t) wgk * nss * 2048;
+            }
+
+            for (int sb = 0; sb < nss; ++sb) {
+                simd<sycl::half, 128> sc[NB], mn[NB];
+                simd<uint32_t, 8 * 16> qh[NB];   // qh[32] of 16 rows, [dword][lane]
+#pragma unroll
+                for (int g = 0; g < NB; ++g) {
+                    simd<uint32_t, 4 * 16> hdr;
+                    if constexpr (SOA) {
+                        hdr.template select<16, 1>(0)  = gather<uint32_t, 16, 1>(w32g[g], om[g]);
+                        hdr.template select<48, 1>(16) = gather<uint32_t, 48, 3>(w32g[g], os[g]);
+                        qh[g] = gather<uint32_t, 128, 8>(w32g[g], oh[g]);
+                    } else {
+                        hdr   = gather<uint32_t, 64, 4>(w32g[g], oq[g]);
+                        qh[g] = gather<uint32_t, 128, 8>(w32g[g], oq[g] + 16);
+                    }
+                    kquant_scale_min(hdr, sc[g], mn[g]);
+                }
+#pragma unroll
+                for (int c = 0; c < 4; ++c) {
+                    simd<uint32_t, 8 * 16> raw[NB];
+                    simd<uint64_t, 64>     a2[MT];
+#pragma unroll
+                    for (int g = 0; g < NB; ++g) {
+                        raw[g] = gather<uint32_t, 128, 8>(w32g[g], oq[g] + (uint32_t) ((SOA ? 0 : 48) + 32 * c));
+                    }
+#pragma unroll
+                    for (int s = 0; s < 4; ++s) {
+                        const int j = 2 * c + s / 2, h = s % 2;
+                        simd<sycl::half, 256> b[NB];
+#pragma unroll
+                        for (int g = 0; g < NB; ++g) {
+                            auto r8 = raw[g].template bit_cast_view<uint8_t>();
+                            auto h8 = qh[g].template bit_cast_view<uint8_t>();
+                            const simd<sycl::half, 32> dv = sc[g].template replicate_vs_w_hs<16, 1, 2, 0>(16 * j);
+                            const simd<sycl::half, 32> mv = mn[g].template replicate_vs_w_hs<16, 1, 2, 0>(16 * j);
+#pragma unroll
+                            for (int p = 0; p < 8; ++p) {
+                                const int o = 16 * h + 2 * p;   // byte of this k pair in the chunk and in qh
+                                const simd<uint16_t, 32> lo = r8.template replicate_vs_w_hs<16, 4, 2, 1>((o / 4) * 64 + o % 4);
+                                const simd<uint16_t, 32> hb = h8.template replicate_vs_w_hs<16, 4, 2, 1>((o / 4) * 64 + o % 4);
+                                simd<uint16_t, 32> u;
+                                if (j % 2 == 0) {
+                                    const int shl = 4 - 2 * c;   // qh bit 2c -> bit 4
+                                    const simd<uint16_t, 32> hs = shl >= 0 ? simd<uint16_t, 32>(hb << shl) : simd<uint16_t, 32>(hb >> -shl);
+                                    u = (lo & 0x0F) | (hs & 0x10) | 0x6400;
+                                } else {
+                                    u = (lo & 0xF0) | ((hb << (7 - 2 * c)) & 0x100) | 0x6400;   // qh bit 2c+1 -> bit 8
+                                }
+                                const simd<sycl::half, 32> qv = u.template bit_cast_view<sycl::half>() - (sycl::half) 1024.0f;
+                                b[g].template select<32, 1>(p * 32) = qv * dv - mv;
+                            }
+                        }
+                        // the A tiles of k-steps s, s + 1 in one 512 B load: +8-30% here, where the dequant is heavy
+                        if (s % 2 == 0) {
+#pragma unroll
+                            for (int t = 0; t < MT; ++t) {
+                                a2[t] = block_load<uint64_t, 64>((const uint64_t *) pa[t]);
+                                pa[t] += 256;
+                            }
+                        }
+#pragma unroll
+                        for (int t = 0; t < MT; ++t) {
+                            const simd<sycl::half, 128> a = a2[t].template bit_cast_view<sycl::half>().template select<128, 1>((s % 2) * 128);
+#pragma unroll
+                            for (int g = 0; g < NB; ++g) {
+                                acc[g * MT + t] = xmx::dpas<8, 8, float, float, sycl::half, sycl::half>(acc[g * MT + t], b[g], a);
+                            }
+                        }
+                    }
+                }
+#pragma unroll
+                for (int g = 0; g < NB; ++g) {
+                    oq[g] += SOA ? 128 : 176;
+                    oh[g] += 32;
+                    os[g] += 12;
+                    om[g] += 4;
+                }
+            }
+            if constexpr (GLU) {
+                // [8 tokens][16 columns] of silu(gate) * up is one tile of the down gemm's input
+#pragma unroll
+                for (int t = 0; t < MT; ++t) {
+                    const simd<float, 128> gt = acc[t];
+                    const simd<float, 128> h  = gt * acc[MT + t] / (1.0f + exp(-gt));
+                    block_store<sycl::half, 128>(gout + ((size_t) (mt0 + t) * (N / 16) + n0 / 16) * 128, simd<sycl::half, 128>(h));
+                }
+            } else {
+                store_split<NB, MT, KS>(acc, dst, epi, wgk, mt0, M, N, n0);
+            }
+        });
+}
+
+// ---- Q6_K --------------------------------------------------------------------------------
+// weight 128 n + 32 r + l = nibble (r >= 2) of ql[64 n + 32 (r & 1) + l] | bits 2r..2r+1 of qh[32 n + l] << 4, minus 32
+// thread tile 16 rows x 64 tokens; blocks go in pairs as an odd block is only 2-byte aligned (its offsets shift by 2)
+// K % 512 == 0, N % (16 * TW) == 0
+template <int TW, int TT, int RAST, bool SOA, int NB = 1, int MT = 8, int KS = 1>
+sycl::event gemm_q6_K(sycl::queue & q, const uint8_t * w, const sycl::half * act, float * dst, int M, int N, int K,
+                      const gemm_epi epi = {}, int gt = 0) {
+    const int      nsb  = K / 256;
+    const uint32_t nblk = (uint32_t) N * nsb;
+    const int      nks  = K / 16;
+    const int      gn   = N / (16 * NB * TW);
+    const int      gm   = (M + 8 * MT * TT - 1) / (8 * MT * TT);
+    const int      gs   = gt >= 16 * MT * TT ? gt / (8 * MT * TT) : gt > 0 ? 1 : gm;   // token panels per group
+    const int      nps  = nsb / 2 / KS;   // block pairs per k slice
+    namespace sx = sycl::ext::oneapi::experimental;
+    sx::properties props{ sycl::ext::intel::experimental::grf_size<GRF> };
+
+    return q.parallel_for(sycl::nd_range<1>(sycl::range<1>((size_t) gn * gm * KS * TW * TT), sycl::range<1>(TW * TT)), props,
+        [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL {
+            const int wgk = KS == 1 ? 0 : (int) it.get_group(0) / (gn * gm);   // k slice
+            const int wg  = KS == 1 ? (int) it.get_group(0) : (int) it.get_group(0) % (gn * gm);
+            const int lid = (int) it.get_local_id(0);
+            int gni, gmi;
+            if constexpr (RAST == 2) {   // only the grouped kernels take gs as an argument
+                wg_panels<2>(wg, gn, gm, gs, gni, gmi);
+            } else {
+                wg_panels<RAST>(wg, gn, gm, 0, gni, gmi);
+            }
+            const int n0  = (gni * TW + lid % TW) * 16 * NB;
+            const int mt0 = (gmi * TT + lid / TW) * MT;
+            if (mt0 * 8 >= M) {
+                return;
+            }
+
+            simd<float, 128> acc[NB * MT];
+#pragma unroll
+            for (int i = 0; i < NB * MT; ++i) {
+                acc[i] = 0.0f;
+            }
+            const uint32_t * w32 = (const uint32_t *) w;
+            // GGUF: ol = the block pair; SoA: ol = ql, oh = qh, os = scales, od = d (of the pair)
+            simd<uint32_t, 16> ol[NB], oh[NB], os[NB], od[NB];
+#pragma unroll
+            for (int g = 0; g < NB; ++g) {
+                const simd<uint32_t, 16> blk = lane_rows(n0, g) * (uint32_t) nsb + (uint32_t) (2 * wgk * nps);
+                ol[g] = blk * (uint32_t) (SOA ? 128 : 210);
+                oh[g] = nblk * 128 + blk * 64;
+                os[g] = nblk * 192 + blk * 16;
+                od[g] = nblk * 208 + blk * 2;
+            }
+            const sycl::half * pa[MT];
+#pragma unroll
+            for (int t = 0; t < MT; ++t) {
+                pa[t] = act + (size_t) (mt0 + t) * nks * 128 + (size_t) wgk * nps * 4096;
+            }
+
+            for (int sp = 0; sp < nps; ++sp) {
+#pragma unroll
+                for (int e = 0; e < 2; ++e) {
+                    const int sh = 2 * e;   // byte shift of block e in the GGUF pair, of its d in SoA
+                    // tail image: [scales 16 B][d dword]; scale j at byte j (+sh GGUF), d at 16 + sh
+                    simd<sycl::half, 256> dv[NB];   // [sub-block][lane] d * scale
+#pragma unroll
+                    for (int g = 0; g < NB; ++g) {
+                        simd<uint32_t, 5 * 16> tl;
+                        if constexpr (SOA) {
+                            tl.template select<64, 1>(0)  = gather<uint32_t, 64, 4>(w32, os[g] + 16 * e);
+                            tl.template select<16, 1>(64) = gather<uint32_t, 16, 1>(w32, od[g]);
+                        } else {
+                            tl.template select<64, 1>(0)  = gather<uint32_t, 64, 4>(w32, ol[g] + (uint32_t) (208 * e + 192));
+                            tl.template select<16, 1>(64) = gather<uint32_t, 16, 1>(w32, ol[g] + (uint32_t) (208 * e + 208));
+                        }
+                        auto t8 = tl.template bit_cast_view<int8_t>();
+                        auto th = tl.template bit_cast_view<sycl::half>();
+                        const int odd = 16 + sh;
+                        const simd<float, 16> d = th.template replicate_vs_w_hs<16, 2, 1, 0>((odd / 4) * 32 + (odd % 4) / 2);
+#pragma unroll
+                        for (int j = 0; j < 16; ++j) {
+                            const int osj = j + (SOA ? 0 : sh);
+                            const simd<int16_t, 16> scj = t8.template replicate_vs_w_hs<16, 4, 1, 0>((osj / 4) * 64 + osj % 4);
+                            dv[g].template select<16, 1>(16 * j) = d * convert<float>(scj);
+                        }
+                    }
+                    const int shq = SOA ? 0 : sh;   // shift of the ql / qh bytes
+#pragma unroll
+                    for (int n = 0; n < 2; ++n) {
+                        simd<uint32_t, 17 * 16> ql[NB];   // ql[64 n ..] (+4 B of shift room)
+                        simd<uint32_t, 9 * 16>  qh[NB];   // qh[32 n ..]
+#pragma unroll
+                        for (int g = 0; g < NB; ++g) {
+                            const simd<uint32_t, 16> o0 = SOA ? simd<uint32_t, 16>(ol[g] + (uint32_t) (128 * e + 64 * n))
+                                                              : simd<uint32_t, 16>(ol[g] + (uint32_t) (208 * e + 64 * n));
+                            ql[g].template select<128, 1>(0)   = gather<uint32_t, 128, 8>(w32, o0);
+                            ql[g].template select<128, 1>(128) = gather<uint32_t, 128, 8>(w32, o0 + 32);
+                            ql[g].template select<16, 1>(256)  = gather<uint32_t, 16, 1>(w32, o0 + 64);
+                            const simd<uint32_t, 16> o1 = SOA ? simd<uint32_t, 16>(oh[g] + (uint32_t) (64 * e + 32 * n))
+                                                              : simd<uint32_t, 16>(ol[g] + (uint32_t) (208 * e + 128 + 32 * n));
+                            qh[g].template select<128, 1>(0)  = gather<uint32_t, 128, 8>(w32, o1);
+                            qh[g].template select<16, 1>(128) = gather<uint32_t, 16, 1>(w32, o1 + 32);
+                        }
+#pragma unroll
+                        // k-steps 2r and 2r+1 (h = 0, 1) share one 512 B activation load per token tile
+                        for (int r = 0; r < 4; ++r) {
+                            simd<sycl::half, 256> b[2][NB];
+#pragma unroll
+                            for (int h = 0; h < 2; ++h) {
+                                const int j = 8 * n + 2 * r + h;
+#pragma unroll
+                                for (int g = 0; g < NB; ++g) {
+                                    auto l8 = ql[g].template bit_cast_view<uint8_t>();
+                                    auto h8 = qh[g].template bit_cast_view<uint8_t>();
+                                    const simd<sycl::half, 32> sv = dv[g].template replicate_vs_w_hs<16, 1, 2, 0>(16 * j);
+#pragma unroll
+                                    for (int p = 0; p < 8; ++p) {
+                                        const int bl = 32 * (r & 1) + 16 * h + 2 * p + shq;
+                                        const int bh = 16 * h + 2 * p + shq;
+                                        const simd<uint16_t, 32> lo = l8.template replicate_vs_w_hs<16, 4, 2, 1>((bl / 4) * 64 + bl % 4);
+                                        const simd<uint16_t, 32> hb = h8.template replicate_vs_w_hs<16, 4, 2, 1>((bh / 4) * 64 + bh % 4);
+                                        const simd<uint16_t, 32> nib = r < 2 ? simd<uint16_t, 32>(lo & 0x0F) : simd<uint16_t, 32>(lo >> 4);
+                                        const int hs = 4 - 2 * r;   // qh bits 2r, 2r+1 -> bits 4, 5
+                                        const simd<uint16_t, 32> hv = hs >= 0 ? simd<uint16_t, 32>(hb << hs) : simd<uint16_t, 32>(hb >> -hs);
+                                        simd<uint16_t, 32> u = nib | (hv & 0x30) | 0x6400;
+                                        const simd<sycl::half, 32> qv = u.template bit_cast_view<sycl::half>() - (sycl::half) 1056.0f;
+                                        b[h][g].template select<32, 1>(p * 32) = qv * sv;
+                                    }
+                                }
+                            }
+#pragma unroll
+                            for (int t = 0; t < MT; ++t) {
+                                simd<sycl::half, 256> a2 = block_load<sycl::half, 256>(pa[t]);
+                                pa[t] += 256;
+#pragma unroll
+                                for (int h = 0; h < 2; ++h) {
+                                    const simd<sycl::half, 128> a = a2.template select<128, 1>(128 * h);
+#pragma unroll
+                                    for (int g = 0; g < NB; ++g) {
+                                        acc[g * MT + t] = xmx::dpas<8, 8, float, float, sycl::half, sycl::half>(acc[g * MT + t], b[h][g], a);
+                                    }
+                                }
+                            }
+                        }
+                    }
+                }
+#pragma unroll
+                for (int g = 0; g < NB; ++g) {
+                    ol[g] += SOA ? 256 : 420;
+                    oh[g] += 128;
+                    os[g] += 32;
+                    od[g] += 4;
+                }
+            }
+            store_split<NB, MT, KS>(acc, dst, epi, wgk, mt0, M, N, n0);
+        });
+}
+
+// ---- Q3_K --------------------------------------------------------------------------------
+// the SoA of reorder_qw only (a 110 B file block is not dword aligned): qs[nblk][64] | hmask[nblk][32] | scales[nblk][12]
+// | d[nblk]. Weight 16 s + l of a block, s = 8 hf + 2 j + t, is d * (sc_s - 32) * (q3 - 4) with q3 = bits 2j..2j+1 of
+// qs[32 hf + 16 t + l] | bit 4 hf + j of hmask[16 t + l] << 2, made exact as 1024 + q3. Thread tile NB x 16 rows x MT x 8
+// tokens: 16 x 64 halves the dequant per dpas of 32 x 32, which left this kernel issue bound (+40-58% on B70)
+// K % 256 == 0, N % (16 * NB * TW) == 0
+template <int TW, int TT, int RAST, int KS = 1, int NB = 1, int MT = 8>
+sycl::event gemm_q3_K(sycl::queue & q, const uint8_t * w, const sycl::half * act, float * dst, int M, int N, int K,
+                      const gemm_epi epi = {}, int gt = 0) {
+    const int      nsb  = K / 256;
+    const uint32_t nblk = (uint32_t) N * nsb;
+    const int      nks  = K / 16;
+    const int      gn   = N / (16 * NB * TW);
+    const int      gm   = (M + 8 * MT * TT - 1) / (8 * MT * TT);
+    const int      gs   = gt >= 16 * MT * TT ? gt / (8 * MT * TT) : gt > 0 ? 1 : gm;   // token panels per group
+    const int      nss  = nsb / KS;   // super-blocks per k slice
+    namespace sx = sycl::ext::oneapi::experimental;
+    sx::properties props{ sycl::ext::intel::experimental::grf_size<GRF> };
+
+    return q.parallel_for(sycl::nd_range<1>(sycl::range<1>((size_t) gn * gm * KS * TW * TT), sycl::range<1>(TW * TT)), props,
+        [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL {
+            const int wgk = KS == 1 ? 0 : (int) it.get_group(0) / (gn * gm);   // k slice
+            const int wg  = KS == 1 ? (int) it.get_group(0) : (int) it.get_group(0) % (gn * gm);
+            const int lid = (int) it.get_local_id(0);
+            int gni, gmi;
+            if constexpr (RAST == 2) {   // only the grouped kernels take gs as an argument
+                wg_panels<2>(wg, gn, gm, gs, gni, gmi);
+            } else {
+                wg_panels<RAST>(wg, gn, gm, 0, gni, gmi);
+            }
+            const int n0  = (gni * TW + lid % TW) * 16 * NB;
+            const int mt0 = (gmi * TT + lid / TW) * MT;
+            if (mt0 * 8 >= M) {
+                return;
+            }
+
+            simd<float, 128> acc[NB * MT];
+#pragma unroll
+            for (int i = 0; i < NB * MT; ++i) {
+                acc[i] = 0.0f;
+            }
+            const uint32_t * w32 = (const uint32_t *) w;
+            const uint16_t * w16 = (const uint16_t *) w;
+            simd<uint32_t, 16> oq[NB], oh[NB], os[NB], od[NB];
+#pragma unroll
+            for (int g = 0; g < NB; ++g) {
+                const simd<uint32_t, 16> blk = lane_rows(n0, g) * (uint32_t) nsb + (uint32_t) (wgk * nss);
+                oq[g] = blk * 64;
+                oh[g] = nblk * 64 + blk * 32;
+                os[g] = nblk * 96 + blk * 12;
+                od[g] = nblk * 108 + blk * 2;
+            }
+            const sycl::half * pa[MT];
+#pragma unroll
+            for (int t = 0; t < MT; ++t) {
+                pa[t] = act + (size_t) (mt0 + t) * nks * 128 + (size_t) wgk * nss * 2048;
+            }
+
+            for (int sb = 0; sb < nss; ++sb) {
+                simd<uint32_t, 16 * 16> rq[NB];   // qs [dword][lane]
+                simd<uint32_t, 8 * 16>  rm[NB];   // hmask
+                simd<sycl::half, 16>    dv[NB][16];
+#pragma unroll
+                for (int g = 0; g < NB; ++g) {
+                    rq[g].template select<128, 1>(0)   = gather<uint32_t, 128, 8>(w32, oq[g]);
+                    rq[g].template select<128, 1>(128) = gather<uint32_t, 128, 8>(w32, oq[g] + 32);
+                    rm[g] = gather<uint32_t, 128, 8>(w32, oh[g]);
+                    simd<uint32_t, 48>       rs = gather<uint32_t, 48, 3>(w32, os[g]);
+                    simd<uint16_t, 16>       dh = gather<uint16_t, 16>(w16, od[g]);
+                    const simd<float, 16>    d  = dh.template bit_cast_view<sycl::half>();
+                    oq[g] += 64;
+                    oh[g] += 32;
+                    os[g] += 12;
+                    od[g] += 2;
+                    // the 16 6-bit scales: low nibble from byte 4 (c % 2) + i (>> 4 for c >= 2), 2 bits from byte 8 + i
+                    auto s8 = rs.template bit_cast_view<uint8_t>();
+                    simd<uint16_t, 16> b8[12];
+#pragma unroll
+                    for (int b = 0; b < 12; ++b) {
+                        b8[b] = s8.template replicate_vs_w_hs<16, 4, 1, 0>((b / 4) * 64 + b % 4);
+                    }
+#pragma unroll
+                    for (int is = 0; is < 16; ++is) {
+                        const int c = is / 4, i = is % 4;
+                        const simd<uint16_t, 16> sc =
+                            ((b8[4 * (c % 2) + i] >> (4 * (c / 2))) & 0xF) | (((b8[8 + i] >> (2 * c)) & 3) << 4);
+                        dv[g][is] = d * (convert<float>(sc) - 32.0f);
+                    }
+                }
+                simd<uint64_t, 64> a2[MT];
+#pragma unroll
+                for (int s = 0; s < 16; ++s) {
+                    const int hf = s / 8, j = (s % 8) / 2, t = s % 2, hb = 4 * hf + j;
+                    simd<sycl::half, 256> b[NB];
+#pragma unroll
+                    for (int g = 0; g < NB; ++g) {
+                        auto q8 = rq[g].template bit_cast_view<uint8_t>();
+                        auto m8 = rm[g].template bit_cast_view<uint8_t>();
+                        const simd<sycl::half, 32> dv2 = dv[g][s].template replicate_vs_w_hs<16, 1, 2, 0>(0);
+#pragma unroll
+                        for (int p = 0; p < 8; ++p) {
+                            const int oqb = 32 * hf + 16 * t + 2 * p, omb = 16 * t + 2 * p;   // bytes of this k pair
+                            const simd<uint16_t, 32> uq = q8.template replicate_vs_w_hs<16, 4, 2, 1>((oqb / 4) * 64 + oqb % 4);
+                            const simd<uint16_t, 32> um = m8.template replicate_vs_w_hs<16, 4, 2, 1>((omb / 4) * 64 + omb % 4);
+                            const simd<uint16_t, 32> hi = hb >= 2 ? simd<uint16_t, 32>(um >> (hb - 2)) : simd<uint16_t, 32>(um << (2 - hb));
+                            simd<uint16_t, 32> u = ((uq >> (2 * j)) & (uint16_t) 3) | (hi & (uint16_t) 4) | (uint16_t) 0x6400;
+                            b[g].template select<32, 1>(p * 32) = (u.template bit_cast_view<sycl::half>() - (sycl::half) 1028.0f) * dv2;
+                        }
+                    }
+                    // the A tiles of k-steps s, s + 1 in one 512 B load, as in gemm_q5_K
+                    if (s % 2 == 0) {
+#pragma unroll
+                        for (int t2 = 0; t2 < MT; ++t2) {
+                            a2[t2] = block_load<uint64_t, 64>((const uint64_t *) pa[t2]);
+                            pa[t2] += 256;
+                        }
+                    }
+#pragma unroll
+                    for (int t2 = 0; t2 < MT; ++t2) {
+                        const simd<sycl::half, 128> a = a2[t2].template bit_cast_view<sycl::half>().template select<128, 1>((s % 2) * 128);
+#pragma unroll
+                        for (int g = 0; g < NB; ++g) {
+                            acc[g * MT + t2] = xmx::dpas<8, 8, float, float, sycl::half, sycl::half>(acc[g * MT + t2], b[g], a);
+                        }
+                    }
+                }
+            }
+            store_split<NB, MT, KS>(acc, dst, epi, wgk, mt0, M, N, n0);
+        });
+}
+
+// ---- IQ3_S -------------------------------------------------------------------------------
+// block = d | qs x 64 | qh x 8 | signs x 32 | scales x 4 = 110 B in the file layout, read in pairs so every gather is
+// dword aligned: the odd block's image starts 2 B early. SOA: the planes of reorder_qw_iq3_s (block_q_t<GGML_TYPE_IQ3_S>),
+// each field its own gather. Weight 4 gi + c of a block is d * (1 + 2 sc_{gi / 8}) * byte c of
+// iq3s_grid[qs[gi] | bit gi of qh << 8], negated by bit 4 (gi % 2) + c of signs[gi / 2].
+// The 2 KB grid (GRID = ggml-common.h's iq3s_grid) is copied into SLM by each work-group
+// thread tile NB x 16 rows x MT x 8 tokens, 16 x 64 by default (half the grid lookups per dpas of 32 x 32: +10-25% on B70)
+// K % 512 == 0, N % (16 * NB * TW) == 0
+template <int TW, int TT, int RAST, const uint32_t * GRID, int KS = 1, int NB = 1, int MT = 8, bool SOA = false>
+sycl::event gemm_iq3_s(sycl::queue & q, const uint8_t * w, const sycl::half * act, float * dst, int M, int N, int K,
+                       const gemm_epi epi = {}, int gt = 0) {
+    const int      nsb  = K / 256;
+    const uint32_t rowb = (uint32_t) nsb * 110;
+    const uint32_t nblk = (uint32_t) N * nsb;   // the planes of SOA
+    constexpr int  RQ   = SOA ? 16 : 28;        // dwords of raw per block: the qs plane or the file block image
+    const int      nks  = K / 16;
+    const int      gn   = N / (16 * NB * TW);
+    const int      gm   = (M + 8 * MT * TT - 1) / (8 * MT * TT);
+    const int      gs   = gt >= 16 * MT * TT ? gt / (8 * MT * TT) : gt > 0 ? 1 : gm;   // token panels per group
+    const int      nps  = nsb / 2 / KS;   // block pairs per k slice
+    namespace sx = sycl::ext::oneapi::experimental;
+    sx::properties props{ sycl::ext::intel::experimental::grf_size<GRF> };
+
+    return q.parallel_for(sycl::nd_range<1>(sycl::range<1>((size_t) gn * gm * KS * TW * TT), sycl::range<1>(TW * TT)), props,
+        [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL {
+            slm_init<512 * 4>();
+            {
+                for (int e = (int) it.get_local_id(0) * 32; e < 512; e += TW * TT * 32) {
+                    slm_block_store<uint32_t, 32>(e * 4, block_load<uint32_t, 32>(GRID + e));
+                }
+            }
+            barrier();
+            const int wgk = KS == 1 ? 0 : (int) it.get_group(0) / (gn * gm);   // k slice
+            const int wg  = KS == 1 ? (int) it.get_group(0) : (int) it.get_group(0) % (gn * gm);
+            const int lid = (int) it.get_local_id(0);
+            int gni, gmi;
+            if constexpr (RAST == 2) {   // only the grouped kernels take gs as an argument
+                wg_panels<2>(wg, gn, gm, gs, gni, gmi);
+            } else {
+                wg_panels<RAST>(wg, gn, gm, 0, gni, gmi);
+            }
+            const int n0  = (gni * TW + lid % TW) * 16 * NB;
+            const int mt0 = (gmi * TT + lid / TW) * MT;
+            if (mt0 * 8 >= M) {
+                return;
+            }
+
+            simd<float, 128> acc[NB * MT];
+#pragma unroll
+            for (int i = 0; i < NB * MT; ++i) {
+                acc[i] = 0.0f;
+            }
+            const uint32_t * w32 = (const uint32_t *) w;
+            // byte offsets of the row's first block of the k slice: the file block image or, SOA, the qs plane, with
+            // the signs, qh | scales and d planes in pg, pm, pd
+            simd<uint32_t, 16> ob[NB], pg[NB], pm[NB], pd[NB];
+#pragma unroll
+            for (int g = 0; g < NB; ++g) {
+                if constexpr (SOA) {
+                    const simd<uint32_t, 16> bi = lane_rows(n0, g) * (uint32_t) nsb + (uint32_t) (wgk * nps * 2);
+                    ob[g]                       = bi * 64;
+                    pg[g]                       = nblk * 64 + bi * 32;
+                    pm[g]                       = nblk * 96 + bi * 12;
+                    pd[g]                       = nblk * 108 + bi * 2;
+                } else {
+                    ob[g] = lane_rows(n0, g) * rowb + (uint32_t) (wgk * nps * 220);
+                }
+            }
+            const sycl::half * pa[MT];
+#pragma unroll
+            for (int t = 0; t < MT; ++t) {
+                pa[t] = act + (size_t) (mt0 + t) * nks * 128 + (size_t) wgk * nps * 4096;
+            }
+            // shifts that bring the sign bit of k 2e, 2e + 1 of an odd (x = 1) or even grid entry to bit 15
+            simd<uint16_t, 32> shv[4];
+#pragma unroll
+            for (int x = 0; x < 2; ++x) {
+#pragma unroll
+                for (int e = 0; e < 2; ++e) {
+                    shv[2 * x + e].template select<16, 2>(0) = (uint16_t) (15 - 4 * x - 2 * e);
+                    shv[2 * x + e].template select<16, 2>(1) = (uint16_t) (14 - 4 * x - 2 * e);
+                }
+            }
+
+            for (int sp = 0; sp < nps; ++sp) {
+                simd<uint32_t, 16> rd[NB];   // SOA: the d of the pair, a half each
+                if constexpr (SOA) {
+#pragma unroll
+                    for (int g = 0; g < NB; ++g) {
+                        rd[g] = gather<uint32_t, 16>(w32, pd[g]);
+                    }
+                }
+#pragma unroll
+                for (int e2 = 0; e2 < 2; ++e2) {
+                    const int sh = SOA ? 0 : 2 * e2;   // image byte of the block's first byte
+                    simd<uint32_t, RQ * 16>             raw[NB];   // [dword][lane]
+                    simd<uint32_t, (SOA ? 8 : 1) * 16> rsg[NB];   // SOA: signs
+                    simd<uint32_t, (SOA ? 3 : 1) * 16> rmt[NB];   // SOA: qh | scales
+                    simd<sycl::half, 16>               db[NB][8];
+#pragma unroll
+                    for (int g = 0; g < NB; ++g) {
+                        if constexpr (SOA) {
+                            const simd<uint32_t, 16> o = ob[g] + (uint32_t) (64 * e2);
+                            raw[g].template select<128, 1>(0)   = gather<uint32_t, 128, 8>(w32, o);
+                            raw[g].template select<128, 1>(128) = gather<uint32_t, 128, 8>(w32, o + 32);
+                            rsg[g] = gather<uint32_t, 128, 8>(w32, pg[g] + (uint32_t) (32 * e2));
+                            rmt[g] = gather<uint32_t, 48, 3>(w32, pm[g] + (uint32_t) (12 * e2));
+                            const simd<float, 16> d =
+                                rd[g].template bit_cast_view<sycl::half>().template replicate_vs_w_hs<16, 2, 1, 0>(e2);
+                            auto m8 = rmt[g].template bit_cast_view<uint8_t>();
+#pragma unroll
+                            for (int ib = 0; ib < 8; ++ib) {   // scales: bytes 8 .. 11 of the qh | scales plane
+                                const simd<uint16_t, 16> sc = m8.template replicate_vs_w_hs<16, 4, 1, 0>(2 * 64 + ib / 2);
+                                db[g][ib] = d * (1.0f + 2.0f * convert<float>(simd<uint16_t, 16>((sc >> (4 * (ib % 2))) & 0xF)));
+                            }
+                        } else {
+                            const simd<uint32_t, 16> o = ob[g] + (uint32_t) (110 * e2 - sh);
+#pragma unroll
+                            for (int i = 0; i < 3; ++i) {
+                                raw[g].template select<128, 1>(i * 128) = gather<uint32_t, 128, 8>(w32, o + 32 * i);
+                            }
+                            raw[g].template select<64, 1>(384) = gather<uint32_t, 64, 4>(w32, o + 96);
+                            auto r8 = raw[g].template bit_cast_view<uint8_t>();
+                            auto rh = raw[g].template bit_cast_view<sycl::half>();
+                            const simd<float, 16> d = rh.template replicate_vs_w_hs<16, 2, 1, 0>(sh / 2);
+#pragma unroll
+                            for (int ib = 0; ib < 8; ++ib) {
+                                const int os = sh + 106 + ib / 2;
+                                const simd<uint16_t, 16> sc = r8.template replicate_vs_w_hs<16, 4, 1, 0>((os / 4) * 64 + os % 4);
+                                db[g][ib] = d * (1.0f + 2.0f * convert<float>(simd<uint16_t, 16>((sc >> (4 * (ib % 2))) & 0xF)));
+                            }
+                        }
+                    }
+                    simd<uint64_t, 64> a2[MT];
+#pragma unroll
+                    for (int s = 0; s < 16; ++s) {
+                        simd<sycl::half, 256> b[NB];
+#pragma unroll
+                        for (int g = 0; g < NB; ++g) {
+                            auto r8 = raw[g].template bit_cast_view<uint8_t>();
+                            const simd<sycl::half, 32> db2 = db[g][s / 2].template replicate_vs_w_hs<16, 1, 2, 0>(0);
+#pragma unroll
+                            for (int i = 0; i < 4; ++i) {
+                                const int gi = 4 * s + i;
+                                // bytes of qs[gi], qh[gi / 8], signs[gi / 2]: in the block image or, SOA, their planes
+                                const int oq = SOA ? gi : sh + 2 + gi, oh = SOA ? gi / 8 : sh + 66 + gi / 8,
+                                          og = SOA ? gi / 2 : sh + 74 + gi / 2;
+                                simd<uint16_t, 16> qv, hv;
+                                simd<uint16_t, 32> sv;
+                                qv = r8.template replicate_vs_w_hs<16, 4, 1, 0>((oq / 4) * 64 + oq % 4);
+                                if constexpr (SOA) {
+                                    auto m8 = rmt[g].template bit_cast_view<uint8_t>();
+                                    auto s8 = rsg[g].template bit_cast_view<uint8_t>();
+                                    hv      = m8.template replicate_vs_w_hs<16, 4, 1, 0>((oh / 4) * 64 + oh % 4);
+                                    sv      = s8.template replicate_vs_w_hs<16, 4, 2, 0>((og / 4) * 64 + og % 4);
+                                } else {
+                                    hv = r8.template replicate_vs_w_hs<16, 4, 1, 0>((oh / 4) * 64 + oh % 4);
+                                    sv = r8.template replicate_vs_w_hs<16, 4, 2, 0>((og / 4) * 64 + og % 4);
+                                }
+                                const simd<uint16_t, 16> idx = qv | (((hv >> (gi % 8)) & 1) << 8);
+                                simd<uint32_t, 16>       gr  = slm_gather<uint32_t, 16>(convert<uint32_t>(idx) * 4);
+                                auto                     g8  = gr.template bit_cast_view<uint8_t>();
+#pragma unroll
+                                for (int e = 0; e < 2; ++e) {
+                                    simd<uint16_t, 32> u = g8.template replicate_vs_w_hs<16, 4, 2, 1>(2 * e);
+                                    u |= (uint16_t) 0x6400;
+                                    simd<sycl::half, 32> v = (u.template bit_cast_view<sycl::half>() - (sycl::half) 1024.0f) * db2;
+                                    v.template bit_cast_view<uint16_t>() ^= simd<uint16_t, 32>((sv << shv[2 * (gi % 2) + e]) & 0x8000);
+                                    b[g].template select<32, 1>((2 * i + e) * 32) = v;
+                                }
+                            }
+                        }
+                        // the A tiles of k-steps s, s + 1 in one 512 B load, as in gemm_q5_K
+                        if (s % 2 == 0) {
+#pragma unroll
+                            for (int t = 0; t < MT; ++t) {
+                                a2[t] = block_load<uint64_t, 64>((const uint64_t *) pa[t]);
+                                pa[t] += 256;
+                            }
+                        }
+#pragma unroll
+                        for (int t = 0; t < MT; ++t) {
+                            const simd<sycl::half, 128> a = a2[t].template bit_cast_view<sycl::half>().template select<128, 1>((s % 2) * 128);
+#pragma unroll
+                            for (int g = 0; g < NB; ++g) {
+                                acc[g * MT + t] = xmx::dpas<8, 8, float, float, sycl::half, sycl::half>(acc[g * MT + t], b[g], a);
+                            }
+                        }
+                    }
+                }
+#pragma unroll
+                for (int g = 0; g < NB; ++g) {
+                    if constexpr (SOA) {
+                        ob[g] += 128;
+                        pg[g] += 64;
+                        pm[g] += 24;
+                        pd[g] += 4;
+                    } else {
+                        ob[g] += 220;
+                    }
+                }
+            }
+            store_split<NB, MT, KS>(acc, dst, epi, wgk, mt0, M, N, n0);
+        });
+}
+
+// ---- IQ4_XS / IQ4_NL ---------------------------------------------------------------------
+// weight 32 ib + 16 h + l of 256 is kvalues_iq4nl[nibble h of byte l of the qs of sub-block ib] * that sub-block's scale,
+// the codebook read by an SLM gather of 16 halves; 256 weights are gathered at once, in the file layout (reorder_qw
+// takes neither type). IQ4_XS: d | scales_h | scales_l x 4 | qs x 128 = 34 dwords, scale d * (ls_ib - 32).
+// IQ4_NL: 8 blocks d | qs x 16 = 36 dwords, scale = the block's d.
+// thread tile 32 rows x 32 tokens; K % 256 == 0, N % (32 * TW) == 0
+// GLU: the two row groups are the same rows of the gate (w) and the up (w2) weight, 16 columns per thread, and the store
+// writes silu(gate) * up into gout as the down gemm's packed input (see gemm_glu_q4_K)
+template <int TW, int TT, int RAST, bool NL, int KS = 1, bool GLU = false, int NB = 2, int MT = 4>
+sycl::event gemm_iq4(sycl::queue & q, const uint8_t * w, const sycl::half * act, float * dst, int M, int N, int K,
+                     const gemm_epi epi = {}, const uint8_t * w2 = nullptr, sycl::half * gout = nullptr, int gt = 0) {
+    static_assert(!GLU || KS == 1, "the swiglu store needs whole k");
+    static_assert(!GLU || NB == 2, "the swiglu pairs the two row groups");
+    constexpr int ND = NL ? 36 : 34;   // dwords per 256 weights
+    const int      nsb  = K / 256;
+    const uint32_t rowb = (uint32_t) nsb * ND * 4;
+    const int      nks  = K / 16;
+    const int      gn   = N / (16 * (GLU ? 1 : NB) * TW);
+    const int      gm   = (M + 8 * MT * TT - 1) / (8 * MT * TT);
+    const int      gs   = gt >= 16 * MT * TT ? gt / (8 * MT * TT) : gt > 0 ? 1 : gm;   // token panels per group
+    const int      nss  = nsb / KS;   // super-blocks per k slice
+    namespace sx = sycl::ext::oneapi::experimental;
+    sx::properties props{ sycl::ext::intel::experimental::grf_size<GRF> };
+
+    return q.parallel_for(sycl::nd_range<1>(sycl::range<1>((size_t) gn * gm * KS * TW * TT), sycl::range<1>(TW * TT)), props,
+        [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL {
+            // kvalues_iq4nl (ggml-common.h) as halves at SLM byte 0, stored before any thread of the group leaves
+            slm_init<32>();
+            if (it.get_local_id(0) == 0) {
+                const simd<float, 16> kv({ -127.f, -104.f, -83.f, -65.f, -49.f, -35.f, -22.f, -10.f,
+                                           1.f, 13.f, 25.f, 38.f, 53.f, 69.f, 89.f, 113.f });
+                slm_block_store<sycl::half, 16>(0, simd<sycl::half, 16>(kv));
+            }
+            barrier();
+            const int wgk = KS == 1 ? 0 : (int) it.get_group(0) / (gn * gm);   // k slice
+            const int wg  = KS == 1 ? (int) it.get_group(0) : (int) it.get_group(0) % (gn * gm);
+            const int lid = (int) it.get_local_id(0);
+            int gni, gmi;
+            if constexpr (RAST == 2) {   // only the grouped kernels take gs as an argument
+                wg_panels<2>(wg, gn, gm, gs, gni, gmi);
+            } else {
+                wg_panels<RAST>(wg, gn, gm, 0, gni, gmi);
+            }
+            const int n0  = (gni * TW + lid % TW) * 16 * (GLU ? 1 : NB);
+            const int mt0 = (gmi * TT + lid / TW) * MT;
+            if (mt0 * 8 >= M) {
+                return;
+            }
+
+            simd<float, 128> acc[NB * MT];
+#pragma unroll
+            for (int i = 0; i < NB * MT; ++i) {
+                acc[i] = 0.0f;
+            }
+            const uint32_t * w32[NB];
+            simd<uint32_t, 16> ob[NB];
+#pragma unroll
+            for (int g = 0; g < NB; ++g) {
+                w32[g] = (const uint32_t *) (GLU && g == 1 ? w2 : w);
+                ob[g]  = lane_rows(n0, GLU ? 0 : g) * rowb + (uint32_t) (wgk * nss * ND * 4);
+            }
+            const sycl::half * pa[MT];
+#pragma unroll
+            for (int t = 0; t < MT; ++t) {
+                pa[t] = act + (size_t) (mt0 + t) * nks * 128 + (size_t) wgk * nss * 2048;
+            }
+
+            for (int sb = 0; sb < nss; ++sb) {
+                simd<uint32_t, ND * 16> raw[NB];   // [dword][lane]
+                simd<sycl::half, 16>    dv[NB][8];
+#pragma unroll
+                for (int g = 0; g < NB; ++g) {
+#pragma unroll
+                    for (int i = 0; i < 4; ++i) {
+                        raw[g].template select<128, 1>(i * 128) = gather<uint32_t, 128, 8>(w32[g], ob[g] + 32 * i);
+                    }
+                    raw[g].template select<(ND - 32) * 16, 1>(512) = gather<uint32_t, (ND - 32) * 16, ND - 32>(w32[g], ob[g] + 128);
+                    ob[g] += ND * 4;
+                    auto rh = raw[g].template bit_cast_view<sycl::half>();
+                    if constexpr (NL) {
+#pragma unroll
+                        for (int ib = 0; ib < 8; ++ib) {
+                            const int bo = 18 * ib;   // byte of block ib's d
+                            dv[g][ib] = rh.template replicate_vs_w_hs<16, 2, 1, 0>((bo / 4) * 32 + (bo % 4) / 2);
+                        }
+                    } else {
+                        auto r8  = raw[g].template bit_cast_view<uint8_t>();
+                        auto r16 = raw[g].template bit_cast_view<uint16_t>();
+                        const simd<float, 16>    d  = rh.template replicate_vs_w_hs<16, 2, 1, 0>(0);
+                        const simd<uint16_t, 16> sh = r16.template replicate_vs_w_hs<16, 2, 1, 0>(1);
+#pragma unroll
+                        for (int ib = 0; ib < 8; ++ib) {
+                            const simd<uint16_t, 16> sl = r8.template replicate_vs_w_hs<16, 4, 1, 0>(64 + ib / 2);
+                            const simd<uint16_t, 16> ls = ((sl >> (4 * (ib % 2))) & 0xF) | (((sh >> (2 * ib)) & 3) << 4);
+                            dv[g][ib] = d * (convert<float>(ls) - 32.0f);
+                        }
+                    }
+                }
+#pragma unroll
+                for (int s = 0; s < 16; ++s) {
+                    const int ib = s / 2, h = s % 2;
+                    simd<sycl::half, 256> b[NB];
+#pragma unroll
+                    for (int g = 0; g < NB; ++g) {
+                        auto r8 = raw[g].template bit_cast_view<uint8_t>();
+                        const simd<sycl::half, 32> dv2 = dv[g][ib].template replicate_vs_w_hs<16, 1, 2, 0>(0);
+#pragma unroll
+                        for (int p = 0; p < 8; ++p) {
+                            const int o = (NL ? 18 * ib + 2 : 8 + 16 * ib) + 2 * p;   // byte of this k pair in the image
+                            const simd<uint16_t, 32> u = r8.template replicate_vs_w_hs<16, 4, 2, 1>((o / 4) * 64 + o % 4);
+                            const simd<uint16_t, 32> q4 = h ? simd<uint16_t, 32>(u >> 4) : simd<uint16_t, 32>(u & (uint16_t) 0xF);
+                            b[g].template select<32, 1>(p * 32) = slm_gather<sycl::half, 32>(convert<uint32_t>(q4) * 2) * dv2;
+                        }
+                    }
+#pragma unroll
+                    for (int t = 0; t < MT; ++t) {
+                        const simd<sycl::half, 128> a = block_load<sycl::half, 128>(pa[t]);
+                        pa[t] += 128;
+#pragma unroll
+                        for (int g = 0; g < NB; ++g) {
+                            acc[g * MT + t] = xmx::dpas<8, 8, float, float, sycl::half, sycl::half>(acc[g * MT + t], b[g], a);
+                        }
+                    }
+                }
+            }
+            if constexpr (GLU) {
+                // [8 tokens][16 columns] of silu(gate) * up is one tile of the down gemm's input
+#pragma unroll
+                for (int t = 0; t < MT; ++t) {
+                    const simd<float, 128> gt = acc[t];
+                    const simd<float, 128> h  = gt * acc[MT + t] / (1.0f + exp(-gt));
+                    block_store<sycl::half, 128>(gout + ((size_t) (mt0 + t) * (N / 16) + n0 / 16) * 128, simd<sycl::half, 128>(h));
+                }
+            } else {
+                store_split<NB, MT, KS>(acc, dst, epi, wgk, mt0, M, N, n0);
+            }
+        });
+}
+
+// ---- IQ4_XS / IQ4_NL in the reorder layout ------------------------------------------------
+// the qs plane holds the 128 B of 256 weights of a row in the pair order (byte 16 ib + p = weights 2 p, 2 p + 1 of
+// 32-weight block ib, reorder_qw_iq4), so a byte is a whole dpas VNNI pair, read from a 256-entry SLM table of
+// (kv[lo], kv[hi]) halves: 4 gathers of 32 lanes per k-step and row group, where gemm_iq4 needs 8 of the halves.
+// the header plane follows: IQ4_XS d | scales_h | scales_l x 4, IQ4_NL the 8 blocks' d, per 256 weights.
+// On the lookups this kernel is send bound, so its tile is 16 rows x 64 tokens (twice the dpas per lookup of 32 x 32),
+// and the A tiles of two k-steps come in one 512 B load. K % 256 == 0, N % (16 * TW) == 0
+// the four 32-lane pair lookups of k-step s from a super-block image with an HB byte header: k pairs 2 j, 2 j + 1 are
+// its bytes o, o + 1
+template <int HB, int N>
+ESIMD_INLINE void iq4_pair_lookup(simd<uint32_t, N> & raw, int s, simd<uint32_t, 32> (&pr)[4]) {
+    auto r8 = raw.template bit_cast_view<uint8_t>();
+#pragma unroll
+    for (int j = 0; j < 4; ++j) {
+        const int          o = HB + 16 * (s / 2) + 8 * (s % 2) + 2 * j;
+        simd<uint16_t, 32> e;
+        e.template select<16, 1>(0)  = r8.template replicate_vs_w_hs<16, 4, 1, 0>((o / 4) * 64 + o % 4);
+        e.template select<16, 1>(16) = r8.template replicate_vs_w_hs<16, 4, 1, 0>(((o + 1) / 4) * 64 + (o + 1) % 4);
+        pr[j] = slm_gather<uint32_t, 32>(convert<uint32_t>(e) << 2);
+    }
+}
+
+template <int TW, int TT, int RAST, bool NL, int KS = 1>
+sycl::event gemm_iq4_pair(sycl::queue & q, const uint8_t * w, const sycl::half * act, float * dst, int M, int N, int K,
+                          const gemm_epi epi = {}, int gt = 0) {
+    constexpr int  NB = 1, MT = 8;
+    constexpr int  HB   = NL ? 16 : 8;        // header bytes per 256 weights
+    constexpr int  ND   = (HB + 128) / 4;     // image dwords: the header, then the qs
+    const int      nsb  = K / 256;
+    const uint32_t nblk = (uint32_t) N * nsb;
+    const int      nks  = K / 16;
+    const int      gn   = N / (16 * NB * TW);
+    const int      gm   = (M + 8 * MT * TT - 1) / (8 * MT * TT);
+    const int      gs   = gt >= 16 * MT * TT ? gt / (8 * MT * TT) : gt > 0 ? 1 : gm;   // token panels per group
+    const int      nss  = nsb / KS;   // super-blocks per k slice
+    namespace sx = sycl::ext::oneapi::experimental;
+    sx::properties props{ sycl::ext::intel::experimental::grf_size<GRF> };
+
+    return q.parallel_for(sycl::nd_range<1>(sycl::range<1>((size_t) gn * gm * KS * TW * TT), sycl::range<1>(TW * TT)), props,
+        [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL {
+            // pair e = (kvalues_iq4nl[e & 15], kvalues_iq4nl[e >> 4]) at SLM dword e, stored before any thread leaves
+            slm_init<1024>();
+            {
+                simd<sycl::half, 16> kv = simd<float, 16>({ -127.f, -104.f, -83.f, -65.f, -49.f, -35.f, -22.f, -10.f,
+                                                            1.f, 13.f, 25.f, 38.f, 53.f, 69.f, 89.f, 113.f });   // iselect is not const
+                for (int e = (int) it.get_local_id(0) * 16; e < 256; e += TW * TT * 16) {
+                    const simd<uint16_t, 16> i = simd<uint16_t, 16>(0, 1) + (uint16_t) e;
+                    simd<sycl::half, 32>     pr;
+                    pr.template select<16, 2>(0) = kv.iselect(simd<uint16_t, 16>(i & (uint16_t) 15));
+                    pr.template select<16, 2>(1) = kv.iselect(simd<uint16_t, 16>(i >> 4));
+                    slm_block_store<uint32_t, 16>(e * 4, pr.template bit_cast_view<uint32_t>());
+                }
+            }
+            barrier();
+            const int wgk = KS == 1 ? 0 : (int) it.get_group(0) / (gn * gm);   // k slice
+            const int wg  = KS == 1 ? (int) it.get_group(0) : (int) it.get_group(0) % (gn * gm);
+            const int lid = (int) it.get_local_id(0);
+            int gni, gmi;
+            if constexpr (RAST == 2) {   // only the grouped kernels take gs as an argument
+                wg_panels<2>(wg, gn, gm, gs, gni, gmi);
+            } else {
+                wg_panels<RAST>(wg, gn, gm, 0, gni, gmi);
+            }
+            const int n0  = (gni * TW + lid % TW) * 16 * NB;
+            const int mt0 = (gmi * TT + lid / TW) * MT;
+            if (mt0 * 8 >= M) {
+                return;
+            }
+
+            simd<float, 128> acc[NB * MT];
+#pragma unroll
+            for (int i = 0; i < NB * MT; ++i) {
+                acc[i] = 0.0f;
+            }
+            const uint32_t *   w32 = (const uint32_t *) w;
+            simd<uint32_t, 16> ob  = lane_rows(n0, 0) * (uint32_t) nsb + (uint32_t) (wgk * nss);   // super-block index
+            const sycl::half * pa[MT];
+#pragma unroll
+            for (int t = 0; t < MT; ++t) {
+                pa[t] = act + (size_t) (mt0 + t) * nks * 128 + (size_t) wgk * nss * 2048;
+            }
+
+            for (int sb = 0; sb < nss; ++sb) {
+                simd<uint32_t, ND * 16> raw;   // [dword][lane]
+                raw.template select<HB * 4, 1>(0) = gather<uint32_t, HB * 4, HB / 4>(w32, nblk * 128 + ob * HB);
+#pragma unroll
+                for (int i = 0; i < 4; ++i) {
+                    raw.template select<128, 1>(HB * 4 + i * 128) = gather<uint32_t, 128, 8>(w32, ob * 128 + 32 * i);
+                }
+                ob += 1;
+                auto                 r8 = raw.template bit_cast_view<uint8_t>();
+                auto                 rh = raw.template bit_cast_view<sycl::half>();
+                simd<sycl::half, 16> dv[8];
+                if constexpr (NL) {
+#pragma unroll
+                    for (int ib = 0; ib < 8; ++ib) {
+                        dv[ib] = rh.template replicate_vs_w_hs<16, 2, 1, 0>((ib / 2) * 32 + ib % 2);
+                    }
+                } else {
+                    auto                     r16 = raw.template bit_cast_view<uint16_t>();
+                    const simd<float, 16>    d   = rh.template replicate_vs_w_hs<16, 2, 1, 0>(0);
+                    const simd<uint16_t, 16> sh  = r16.template replicate_vs_w_hs<16, 2, 1, 0>(1);
+#pragma unroll
+                    for (int ib = 0; ib < 8; ++ib) {
+                        const simd<uint16_t, 16> sl = r8.template replicate_vs_w_hs<16, 4, 1, 0>(64 + ib / 2);
+                        const simd<uint16_t, 16> ls = ((sl >> (4 * (ib % 2))) & 0xF) | (((sh >> (2 * ib)) & 3) << 4);
+                        dv[ib] = d * (convert<float>(ls) - 32.0f);
+                    }
+                }
+                // the lookups run one k-step ahead of their dpas
+                simd<uint32_t, 32> pr[2][4];
+                simd<uint64_t, 64> a2[MT];
+                iq4_pair_lookup<HB>(raw, 0, pr[0]);
+#pragma unroll
+                for (int s = 0; s < 16; ++s) {
+                    if (s + 1 < 16) {
+                        iq4_pair_lookup<HB>(raw, s + 1, pr[(s + 1) % 2]);
+                    }
+                    simd<sycl::half, 256>      b;
+                    const simd<sycl::half, 32> dv2 = dv[s / 2].template replicate_vs_w_hs<16, 1, 2, 0>(0);
+                    const simd<sycl::half, 64> dv4 = dv2.template replicate<2>();
+#pragma unroll
+                    for (int j = 0; j < 4; ++j) {
+                        b.template select<64, 1>(j * 64) = pr[s % 2][j].template bit_cast_view<sycl::half>() * dv4;
+                    }
+                    if (s % 2 == 0) {
+#pragma unroll
+                        for (int t = 0; t < MT; ++t) {
+                            a2[t] = block_load<uint64_t, 64>((const uint64_t *) pa[t]);
+                            pa[t] += 256;
+                        }
+                    }
+#pragma unroll
+                    for (int t = 0; t < MT; ++t) {
+                        const simd<sycl::half, 128> a = a2[t].template bit_cast_view<sycl::half>().template select<128, 1>((s % 2) * 128);
+                        acc[t] = xmx::dpas<8, 8, float, float, sycl::half, sycl::half>(acc[t], b, a);
+                    }
+                }
+            }
+            store_split<NB, MT, KS>(acc, dst, epi, wgk, mt0, M, N, n0);
+        });
+}
+
+// ---- MoE (Q4_K experts) ------------------------------------------------------------------
+// rows are expert-sorted: offs[e] = exclusive end of expert e, whose activation tiles start at padded row pbeg[e]
+// work = flat list of row groups rg[i] = (e << 16) | (r0 / 8), so small experts leave no thread idle
+
+constexpr int MOE_MT = 4;   // row tiles per row group
+constexpr int MOE_TW = 4;   // threads (32 columns each) per work-group
+
+template <bool GEGLU>
+ESIMD_INLINE simd<float, 128> moe_glu(const simd<float, 128> & gate, const simd<float, 128> & up) {
+    if constexpr (GEGLU) {
+        const simd<float, 128> x = 0.7978845608028654f * gate * (1.0f + 0.044715f * gate * gate);
+        const simd<float, 128> t = 2.0f / (1.0f + exp(-2.0f * x)) - 1.0f;
+        return (0.5f * gate * (1.0f + t)) * up;
+    } else {
+        return gate * up / (1.0f + exp(-gate));
+    }
+}
+
+// rg = the row groups of every expert in order, n_rg[0] = their count
+inline sycl::event moe_row_groups(sycl::queue & q, const int32_t * offs, int n_as, int32_t * rg, int32_t * n_rg) {
+    return q.single_task([=]() {
+        int32_t k = 0, beg = 0;
+        for (int e = 0; e < n_as; ++e) {
+            const int32_t R = offs[e] - beg;
+            for (int32_t r0 = 0; r0 < R; r0 += 8 * MOE_MT) {
+                rg[k++] = (e << 16) | (r0 / 8);
+            }
+            beg = offs[e];
+        }
+        n_rg[0] = k;
+    });
+}
+
+// upper bound of the row-group count, for sizing rg and the gemm grid
+inline int64_t moe_max_row_groups(int64_t n_rows, int64_t n_as) {
+    return n_rows / (8 * MOE_MT) + n_as;
+}
+
+// routed rows -> activation tiles; x is converted to f16 (xh) once per token row, then each row tile of the row groups
+// is gathered from xh by one work-item per 64 k, a full 1 KB tile store (rows past the expert's end are zero)
+// map = ggml's mmid_row_mapping (slot, token) pairs, the source row is token * ne11 + slot % ne11
+// with act null only xh is written, for the gate_up gemm that reads its rows directly
+inline sycl::event moe_pack_rows(sycl::queue & q, const float * x, int64_t ldx, int64_t nx, int64_t ne11,
+                                 const int32_t * map, const int32_t * offs, const int32_t * pbeg, const int32_t * rg,
+                                 const int32_t * n_rg, int max_rg, sycl::half * xh, sycl::half * act, int K) {
+    const int nks = K / 16;
+    const int nk4 = K / 64;
+    sycl::event ev = q.parallel_for(sycl::range<1>((size_t) nx * nks), [=](sycl::id<1> id) {
+        const int64_t r  = id[0] / nks;
+        const int64_t ks = id[0] % nks;
+        const sycl::vec<float, 16> v = *(const sycl::vec<float, 16> *) (x + (size_t) r * ldx + ks * 16);
+        *(sycl::vec<sycl::half, 16> *) (xh + (size_t) r * K + ks * 16) = v.template convert<sycl::half, sycl::rounding_mode::rte>();
+    });
+    if (act == nullptr) {
+        return ev;
+    }
+    // each work-item gathers its source rows once for KC chunks of 64 k
+    constexpr int KC = 4;
+    const int     nkc = (nk4 + KC - 1) / KC;
+    constexpr int WG  = 32;
+    const size_t  n   = ((size_t) max_rg * MOE_MT * nkc + WG - 1) / WG * WG;
+    return q.parallel_for(sycl::nd_range<1>(sycl::range<1>(n), sycl::range<1>(WG)),
+        [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL {
+            const int id = (int) it.get_global_id(0);
+            const int kc = id % nkc;
+            const int t  = (id / nkc) % MOE_MT;
+            const int gi = id / nkc / MOE_MT;
+            if (gi >= n_rg[0]) {
+                return;
+            }
+            const int ge  = rg[gi];
+            const int e   = ge >> 16;
+            const int r0  = (ge & 0xffff) * 8 + t * 8;   // first expert row of this tile
+            const int beg = e > 0 ? offs[e - 1] : 0;
+            const int R   = offs[e] - beg;
+            if (r0 >= R) {
+                return;
+            }
+            // one gather for the tile's source rows, rows past the expert's end repeat its last row and are zeroed below
+            const int         nv = R - r0 < 8 ? R - r0 : 8;
+            simd<int32_t, 8>  sr(0, 1);
+            sr.merge(simd<int32_t, 8>(nv - 1), sr >= nv);
+            const simd<uint32_t, 8> mo   = simd<uint32_t, 8>(beg + r0 + sr) * 8u;
+            const simd<int32_t, 8>  tok  = gather<int32_t, 8>(map, mo + 4u);
+            const simd<int32_t, 8>  slot = gather<int32_t, 8>(map, mo);
+            const simd<int32_t, 8>  src  = tok * (int32_t) ne11 + slot % (int32_t) ne11;
+            sycl::half * o = act + (size_t) ((pbeg[e] + r0) / 8) * nks * 128;
+            for (int k4 = kc * KC; k4 < nk4 && k4 < kc * KC + KC; ++k4) {
+                simd<sycl::half, 512> tl;   // [4 tiles][8 rows][16 k]
+#pragma unroll
+                for (int r = 0; r < 8; ++r) {
+                    simd<sycl::half, 64> v = block_load<sycl::half, 64>(xh + (size_t) src[r] * K + k4 * 64);
+                    if (r >= nv) {
+                        v = 0;
+                    }
+#pragma unroll
+                    for (int j = 0; j < 4; ++j) {
+                        tl.template select<16, 1>(j * 128 + r * 16) = v.template select<16, 1>(j * 16);
+                    }
+                }
+                block_store<sycl::half, 512>(o + (size_t) k4 * 4 * 128, tl);
+            }
+        });
+}
+
+// silu(gate) * up of the gate_up output (f16 [n_rows][2 n_ff]) -> the down gemm's activation tiles
+inline sycl::event moe_swiglu_pack(sycl::queue & q, const sycl::half * gu, const int32_t * prow,
+                                   sycl::half * act, int n_rows, int n_ff) {
+    const int nks = n_ff / 16;
+    return q.parallel_for(sycl::range<1>((size_t) n_rows * nks), [=](sycl::id<1> id) {
+        const int64_t i  = id[0];
+        const int64_t s  = i / nks;
+        const int64_t ks = i % nks;
+        const int64_t pr = prow[s];
+        const sycl::vec<sycl::half, 16> g = *(const sycl::vec<sycl::half, 16> *) (gu + (size_t) s * 2 * n_ff + ks * 16);
+        const sycl::vec<sycl::half, 16> u = *(const sycl::vec<sycl::half, 16> *) (gu + (size_t) s * 2 * n_ff + n_ff + ks * 16);
+        sycl::vec<sycl::half, 16> o;
+#pragma unroll
+        for (int j = 0; j < 16; ++j) {
+            const float xg = (float) g[j];
+            o[j] = (sycl::half) (xg / (1.0f + sycl::exp(-xg)) * (float) u[j]);
+        }
+        *(sycl::vec<sycl::half, 16> *) (act + ((size_t) (pr / 8) * nks + ks) * 128 + (pr % 8) * 16) = o;
+    });
+}
+
+// one row group of NT valid row tiles, K loop without per-tile branches
+// DIRECT: a0 = the f16 token rows and ro[t] the row offsets of tile t, loaded DIRECT k16 steps (64 B for 2) at a time
+template <int NT, bool SOA, bool GLU = false, int DIRECT = 0, bool GEGLU = false>
+ESIMD_INLINE void moe_q4_K_rows(const uint32_t * w32, const simd<uint32_t, 16> (&oq0)[2],
+                                const simd<uint32_t, 16> (&os0)[2], const simd<uint32_t, 16> (&om0)[2],
+                                const sycl::half * a0, int nsb, int nks, int R, int r0, sycl::half * dst0, int N,
+                                const simd<uint32_t, 8> * ro = nullptr) {
+    constexpr int NB = 2;
+    simd<float, 128> acc[NB * NT];
+#pragma unroll
+    for (int i = 0; i < NB * NT; ++i) {
+        acc[i] = 0.0f;
+    }
+    simd<uint32_t, 16> oq[NB], os[NB], om[NB];
+#pragma unroll
+    for (int g = 0; g < NB; ++g) {
+        oq[g] = oq0[g];
+        os[g] = os0[g];
+        om[g] = om0[g];
+    }
+    const sycl::half * pa[NT];
+#pragma unroll
+    for (int t = 0; t < NT; ++t) {
+        pa[t] = a0 + (size_t) t * nks * 128;
+    }
+    simd<sycl::half, 128 * (DIRECT > 0 ? DIRECT : 1)> xv[NT];   // DIRECT: [8 rows][16 DIRECT] of tile t
+    for (int sb = 0; sb < nsb; ++sb) {
+        simd<uint32_t, 36 * 16> raw[NB];
+        simd<sycl::half, 128> sc[NB], mn[NB];
+#pragma unroll
+        for (int g = 0; g < NB; ++g) {
+            if constexpr (SOA) {
+                raw[g].template select<16, 1>(0)  = gather<uint32_t, 16, 1>(w32, om[g]);
+                raw[g].template select<48, 1>(16) = gather<uint32_t, 48, 3>(w32, os[g]);
+#pragma unroll
+                for (int i = 0; i < 4; ++i) {
+                    raw[g].template select<128, 1>(64 + i * 128) = gather<uint32_t, 128, 8>(w32, oq[g] + 32 * i);
+                }
+                oq[g] += 128;
+                os[g] += 12;
+                om[g] += 4;
+            } else {
+#pragma unroll
+                for (int i = 0; i < 4; ++i) {
+                    raw[g].template select<128, 1>(i * 128) = gather<uint32_t, 128, 8>(w32, oq[g] + 32 * i);
+                }
+                raw[g].template select<64, 1>(512) = gather<uint32_t, 64, 4>(w32, oq[g] + 128);
+                oq[g] += 144;
+            }
+            kquant_scale_min(raw[g].template select<64, 1>(0), sc[g], mn[g]);
+        }
+#pragma unroll
+        for (int s = 0; s < 16; ++s) {
+            const int j = s / 2, h = s % 2, c = j / 2;
+            simd<sycl::half, 256> b[NB];
+#pragma unroll
+            for (int g = 0; g < NB; ++g) {
+                auto r8 = raw[g].template bit_cast_view<uint8_t>();
+                const simd<sycl::half, 32> dv = sc[g].template replicate_vs_w_hs<16, 1, 2, 0>(16 * j);
+                const simd<sycl::half, 32> mv = mn[g].template replicate_vs_w_hs<16, 1, 2, 0>(16 * j);
+#pragma unroll
+                for (int p = 0; p < 8; ++p) {
+                    const int o = 16 + 32 * c + 16 * h + 2 * p;
+                    simd<uint16_t, 32> u = r8.template replicate_vs_w_hs<16, 4, 2, 1>((o / 4) * 64 + o % 4);
+                    u = (u & (uint16_t) ((j & 1) ? 0xF0 : 0x0F)) | (uint16_t) 0x6400;
+                    const simd<sycl::half, 32> qh = u.template bit_cast_view<sycl::half>() - (sycl::half) 1024.0f;
+                    b[g].template select<32, 1>(p * 32) = qh * dv - mv;
+                }
+            }
+#pragma unroll
+            for (int t = 0; t < NT; ++t) {
+                simd<sycl::half, 128> a;
+                if constexpr (DIRECT > 0) {
+                    constexpr int L = 16 * DIRECT;
+                    if (s % DIRECT == 0) {
+#pragma unroll
+                        for (int r = 0; r < 8; ++r) {
+                            xv[t].template select<L, 1>(L * r) = block_load<sycl::half, L>(a0 + ro[t][r] + (sb * 16 + s) * 16);
+                        }
+                    }
+#pragma unroll
+                    for (int r = 0; r < 8; ++r) {
+                        a.template select<16, 1>(16 * r) = xv[t].template select<16, 1>(L * r + 16 * (s % DIRECT));
+                    }
+                } else {
+                    a = block_load<sycl::half, 128>(pa[t]);
+                    pa[t] += 128;
+                }
+#pragma unroll
+                for (int g = 0; g < NB; ++g) {
+                    acc[g * NT + t] = xmx::dpas<8, 8, float, float, sycl::half, sycl::half>(acc[g * NT + t], b[g], a);
+                }
+            }
+        }
+    }
+    if constexpr (GLU) {
+        // dst0 = the down gemm's input tile of row tile 0, N = the stride between row tiles
+#pragma unroll
+        for (int t = 0; t < NT; ++t) {
+            const simd<float, 128> gt = acc[t];
+            const simd<float, 128> h  = moe_glu<GEGLU>(gt, acc[NT + t]);
+            block_store<sycl::half, 128>(dst0 + (size_t) t * N, simd<sycl::half, 128>(h));
+        }
+    } else {
+#pragma unroll
+        for (int t = 0; t < NT; ++t) {
+#pragma unroll
+            for (int i = 0; i < 8; ++i) {
+                const int r = r0 + t * 8 + i;
+                if (r < R) {
+                    simd<sycl::half, 16 * NB> o;
+#pragma unroll
+                    for (int g = 0; g < NB; ++g) {
+                        o.template select<16, 1>(16 * g) = acc[g * NT + t].template select<16, 1>(16 * i);
+                    }
+                    block_store<sycl::half, 16 * NB>(dst0 + (size_t) r * N, o);
+                }
+            }
+        }
+    }
+}
+
+// w: [E][N][K/256] Q4_K blocks (GGUF or per-expert SoA), dst: f16 [n_rows][N] sorted; K % 256 == 0, N % (32 * MOE_TW) == 0
+// the grid covers max_rg row groups, the ones past n_rg[0] exit
+template <bool SOA>
+sycl::event moe_gemm_q4_K(sycl::queue & q, const uint8_t * w, const sycl::half * act, const int32_t * offs,
+                          const int32_t * pbeg, const int32_t * rg, const int32_t * n_rg, int max_rg,
+                          sycl::half * dst, int N, int K) {
+    constexpr int NB = 2;
+    const int      nsb   = K / 256;
+    const uint32_t nblk  = (uint32_t) N * nsb;   // blocks per expert
+    const size_t   ebyte = (size_t) nblk * 144;
+    const int      nks   = K / 16;
+    const int      nwn   = N / (16 * NB * MOE_TW);
+    namespace sx = sycl::ext::oneapi::experimental;
+    sx::properties props{ sycl::ext::intel::experimental::grf_size<GRF> };
+
+    return q.parallel_for(sycl::nd_range<1>(sycl::range<1>((size_t) max_rg * nwn * MOE_TW), sycl::range<1>(MOE_TW)), props,
+        [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL {
+            const int wg  = (int) it.get_group(0);
+            const int lid = (int) it.get_local_id(0);
+            const int gi  = wg / nwn;   // consecutive work-groups share a row group
+            if (gi >= n_rg[0]) {
+                return;
+            }
+            const int nbk     = wg % nwn;
+            const int ge      = rg[gi];
+            const int e       = ge >> 16;
+            const int r0      = (ge & 0xffff) * 8;
+            const int row_beg = e > 0 ? offs[e - 1] : 0;
+            const int R       = offs[e] - row_beg;
+            const int nt      = (R - r0 + 7) / 8;
+            const int n0      = (nbk * MOE_TW + lid) * 16 * NB;
+
+            const uint32_t * w32 = (const uint32_t *) (w + (size_t) e * ebyte);
+            simd<uint32_t, 16> oq[NB], os[NB], om[NB];
+#pragma unroll
+            for (int g = 0; g < NB; ++g) {
+                const simd<uint32_t, 16> blk = lane_rows(n0, g) * (uint32_t) nsb;
+                oq[g] = blk * (uint32_t) (SOA ? 128 : 144);
+                os[g] = nblk * 128 + blk * 12;
+                om[g] = nblk * 140 + blk * 4;
+            }
+            const sycl::half * a0   = act + (size_t) ((pbeg[e] + r0) / 8) * nks * 128;
+            sycl::half *       dst0 = dst + (size_t) row_beg * N + n0;
+            if (nt >= 4) {
+                moe_q4_K_rows<4, SOA>(w32, oq, os, om, a0, nsb, nks, R, r0, dst0, N);
+            } else if (nt == 3) {
+                moe_q4_K_rows<3, SOA>(w32, oq, os, om, a0, nsb, nks, R, r0, dst0, N);
+            } else if (nt == 2) {
+                moe_q4_K_rows<2, SOA>(w32, oq, os, om, a0, nsb, nks, R, r0, dst0, N);
+            } else {
+                moe_q4_K_rows<1, SOA>(w32, oq, os, om, a0, nsb, nks, R, r0, dst0, N);
+            }
+        });
+}
+
+// stores NT row tiles of an expert's rows (< R) into its f16 output rows, NB x 16 columns
+template <int NB, int NT>
+ESIMD_INLINE void moe_store_rows(simd<float, 128> (&acc)[NB * NT], int R, int r0, sycl::half * dst0, int N) {
+#pragma unroll
+    for (int t = 0; t < NT; ++t) {
+#pragma unroll
+        for (int i = 0; i < 8; ++i) {
+            const int r = r0 + t * 8 + i;
+            if (r < R) {
+                simd<sycl::half, 16 * NB> o;
+#pragma unroll
+                for (int g = 0; g < NB; ++g) {
+                    o.template select<16, 1>(16 * g) = acc[g * NT + t].template select<16, 1>(16 * i);
+                }
+                block_store<sycl::half, 16 * NB>(dst0 + (size_t) r * N, o);
+            }
+        }
+    }
+}
+
+template <int NT>
+ESIMD_INLINE SYCL_ESIMD_FUNCTION void moe_q5_1_rows(const uint32_t * w32, const simd<uint32_t, 16> & oq0,
+                                const sycl::half * a0, int nsb, int nks, int R, int r0, sycl::half * dst0, int N) {
+    simd<float, 128> acc[NT];
+#pragma unroll
+    for (int i = 0; i < NT; ++i) {
+        acc[i] = 0.0f;
+    }
+    simd<uint32_t, 16> oq = oq0;
+    const sycl::half * pa[NT];
+#pragma unroll
+    for (int t = 0; t < NT; ++t) {
+        pa[t] = a0 + (size_t) t * nks * 128;
+    }
+    for (int sb = 0; sb < nsb; ++sb) {
+        simd<uint32_t, 64> ql = gather<uint32_t, 64, 4>(w32, oq + 8);
+        simd<uint32_t, 16> qh = gather<uint32_t, 16, 1>(w32, oq + 4);
+        simd<uint32_t, 16> dm = gather<uint32_t, 16, 1>(w32, oq);
+        auto q8  = ql.template bit_cast_view<uint8_t>();
+        auto dm2 = dm.template bit_cast_view<sycl::half>();
+        const simd<sycl::half, 16> d = dm2.template select<16, 2>(0);
+        const simd<sycl::half, 16> m = dm2.template select<16, 2>(1);
+        simd<sycl::half, 32> dv, mv;
+        dv.template select<16, 2>(0) = d;
+        dv.template select<16, 2>(1) = d;
+        mv.template select<16, 2>(0) = m;
+        mv.template select<16, 2>(1) = m;
+#pragma unroll
+        for (int c = 0; c < 2; ++c) {
+            simd<sycl::half, 256> b;
+#pragma unroll
+            for (int p = 0; p < 8; ++p) {
+                const int o = 2 * p;
+                const simd<uint16_t, 32> lo = q8.template replicate_vs_w_hs<16, 4, 2, 1>((o / 4) * 64 + o % 4);
+                simd<uint16_t, 32> hb;
+                const int bit0 = c * 16 + 2 * p;
+                hb.template select<16, 2>(0) = simd<uint16_t, 16>((qh >> bit0) & 1u);
+                hb.template select<16, 2>(1) = simd<uint16_t, 16>((qh >> (bit0 + 1)) & 1u);
+                const simd<uint16_t, 32> nib = c == 0 ? simd<uint16_t, 32>(lo & 0x0F) : simd<uint16_t, 32>(lo >> 4);
+                simd<uint16_t, 32> u = nib | (hb << 4) | (uint16_t) 0x6400;
+                const simd<sycl::half, 32> qv = u.template bit_cast_view<sycl::half>() - (sycl::half) 1024.0f;
+                b.template select<32, 1>(p * 32) = qv * dv + mv;
+            }
+#pragma unroll
+            for (int t = 0; t < NT; ++t) {
+                const simd<sycl::half, 128> a = block_load<sycl::half, 128>(pa[t]);
+                pa[t] += 128;
+                acc[t] = xmx::dpas<8, 8, float, float, sycl::half, sycl::half>(acc[t], b, a);
+            }
+        }
+        oq += 24;
+    }
+    moe_store_rows<1, NT>(acc, R, r0, dst0, N);
+}
+
+template <bool SOA>
+sycl::event moe_gemm_q5_1(sycl::queue & q, const uint8_t * w, const sycl::half * act, const int32_t * offs,
+                          const int32_t * pbeg, const int32_t * rg, const int32_t * n_rg, int max_rg,
+                          sycl::half * dst, int N, int K) {
+    static_assert(!SOA, "Q5_1 MoE uses the GGUF file layout");
+    const int      nsb   = K / 32;
+    const uint32_t nblk  = (uint32_t) N * nsb;
+    const size_t   ebyte = (size_t) nblk * 24;
+    const int      nks   = K / 16;
+    const int      nwn   = N / (16 * MOE_TW);
+    namespace sx = sycl::ext::oneapi::experimental;
+    sx::properties props{ sycl::ext::intel::experimental::grf_size<GRF> };
+
+    return q.parallel_for(sycl::nd_range<1>(sycl::range<1>((size_t) max_rg * nwn * MOE_TW), sycl::range<1>(MOE_TW)), props,
+        [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL {
+            const int wg  = (int) it.get_group(0);
+            const int lid = (int) it.get_local_id(0);
+            const int gi  = wg / nwn;
+            if (gi >= n_rg[0]) {
+                return;
+            }
+            const int nbk     = wg % nwn;
+            const int ge      = rg[gi];
+            const int e       = ge >> 16;
+            const int r0      = (ge & 0xffff) * 8;
+            const int row_beg = e > 0 ? offs[e - 1] : 0;
+            const int R       = offs[e] - row_beg;
+            const int nt      = (R - r0 + 7) / 8;
+            const int n0      = (nbk * MOE_TW + lid) * 16;
+            const uint32_t * w32 = (const uint32_t *) (w + (size_t) e * ebyte);
+            const simd<uint32_t, 16> blk = lane_rows(n0, 0) * (uint32_t) nsb;
+            const simd<uint32_t, 16> oq  = blk * 24;
+            const sycl::half * a0 = act + (size_t) ((pbeg[e] + r0) / 8) * nks * 128;
+            sycl::half * dst0 = dst + (size_t) row_beg * N + n0;
+            if (nt >= 4) {
+                moe_q5_1_rows<4>(w32, oq, a0, nsb, nks, R, r0, dst0, N);
+            } else if (nt == 3) {
+                moe_q5_1_rows<3>(w32, oq, a0, nsb, nks, R, r0, dst0, N);
+            } else if (nt == 2) {
+                moe_q5_1_rows<2>(w32, oq, a0, nsb, nks, R, r0, dst0, N);
+            } else {
+                moe_q5_1_rows<1>(w32, oq, a0, nsb, nks, R, r0, dst0, N);
+            }
+        });
+}
+
+// the gemm_q5_K k loop on NT row tiles of one row group (see moe_q4_K_rows)
+template <int NT, bool SOA>
+ESIMD_INLINE void moe_q5_K_rows(const uint32_t * w32, const simd<uint32_t, 16> (&oq0)[2], const simd<uint32_t, 16> (&oh0)[2],
+                                const simd<uint32_t, 16> (&os0)[2], const simd<uint32_t, 16> (&om0)[2],
+                                const sycl::half * a0, int nsb, int nks, int R, int r0, sycl::half * dst0, int N) {
+    constexpr int NB = 2;
+    simd<float, 128> acc[NB * NT];
+#pragma unroll
+    for (int i = 0; i < NB * NT; ++i) {
+        acc[i] = 0.0f;
+    }
+    simd<uint32_t, 16> oq[NB], oh[NB], os[NB], om[NB];
+#pragma unroll
+    for (int g = 0; g < NB; ++g) {
+        oq[g] = oq0[g];
+        oh[g] = oh0[g];
+        os[g] = os0[g];
+        om[g] = om0[g];
+    }
+    const sycl::half * pa[NT];
+#pragma unroll
+    for (int t = 0; t < NT; ++t) {
+        pa[t] = a0 + (size_t) t * nks * 128;
+    }
+    for (int sb = 0; sb < nsb; ++sb) {
+        simd<sycl::half, 128> sc[NB], mn[NB];
+        simd<uint32_t, 8 * 16> qh[NB];
+#pragma unroll
+        for (int g = 0; g < NB; ++g) {
+            simd<uint32_t, 4 * 16> hdr;
+            if constexpr (SOA) {
+                hdr.template select<16, 1>(0)  = gather<uint32_t, 16, 1>(w32, om[g]);
+                hdr.template select<48, 1>(16) = gather<uint32_t, 48, 3>(w32, os[g]);
+                qh[g] = gather<uint32_t, 128, 8>(w32, oh[g]);
+            } else {
+                hdr   = gather<uint32_t, 64, 4>(w32, oq[g]);
+                qh[g] = gather<uint32_t, 128, 8>(w32, oq[g] + 16);
+            }
+            kquant_scale_min(hdr, sc[g], mn[g]);
+        }
+#pragma unroll
+        for (int c = 0; c < 4; ++c) {
+            simd<uint32_t, 8 * 16> raw[NB];
+#pragma unroll
+            for (int g = 0; g < NB; ++g) {
+                raw[g] = gather<uint32_t, 128, 8>(w32, oq[g] + (uint32_t) ((SOA ? 0 : 48) + 32 * c));
+            }
+#pragma unroll
+            for (int s = 0; s < 4; ++s) {
+                const int j = 2 * c + s / 2, h = s % 2;
+                simd<sycl::half, 256> b[NB];
+#pragma unroll
+                for (int g = 0; g < NB; ++g) {
+                    auto r8 = raw[g].template bit_cast_view<uint8_t>();
+                    auto h8 = qh[g].template bit_cast_view<uint8_t>();
+                    const simd<sycl::half, 32> dv = sc[g].template replicate_vs_w_hs<16, 1, 2, 0>(16 * j);
+                    const simd<sycl::half, 32> mv = mn[g].template replicate_vs_w_hs<16, 1, 2, 0>(16 * j);
+#pragma unroll
+                    for (int p = 0; p < 8; ++p) {
+                        const int o = 16 * h + 2 * p;
+                        const simd<uint16_t, 32> lo = r8.template replicate_vs_w_hs<16, 4, 2, 1>((o / 4) * 64 + o % 4);
+                        const simd<uint16_t, 32> hb = h8.template replicate_vs_w_hs<16, 4, 2, 1>((o / 4) * 64 + o % 4);
+                        simd<uint16_t, 32> u;
+                        if (j % 2 == 0) {
+                            const int shl = 4 - 2 * c;
+                            const simd<uint16_t, 32> hs = shl >= 0 ? simd<uint16_t, 32>(hb << shl) : simd<uint16_t, 32>(hb >> -shl);
+                            u = (lo & 0x0F) | (hs & 0x10) | 0x6400;
+                        } else {
+                            u = (lo & 0xF0) | ((hb << (7 - 2 * c)) & 0x100) | 0x6400;
+                        }
+                        const simd<sycl::half, 32> qv = u.template bit_cast_view<sycl::half>() - (sycl::half) 1024.0f;
+                        b[g].template select<32, 1>(p * 32) = qv * dv - mv;
+                    }
+                }
+#pragma unroll
+                for (int t = 0; t < NT; ++t) {
+                    const simd<sycl::half, 128> a = block_load<sycl::half, 128>(pa[t]);
+                    pa[t] += 128;
+#pragma unroll
+                    for (int g = 0; g < NB; ++g) {
+                        acc[g * NT + t] = xmx::dpas<8, 8, float, float, sycl::half, sycl::half>(acc[g * NT + t], b[g], a);
+                    }
+                }
+            }
+        }
+#pragma unroll
+        for (int g = 0; g < NB; ++g) {
+            oq[g] += SOA ? 128 : 176;
+            oh[g] += 32;
+            os[g] += 12;
+            om[g] += 4;
+        }
+    }
+    moe_store_rows<NB, NT>(acc, R, r0, dst0, N);
+}
+
+// the gemm_q6_K k loop on NT row tiles of one row group, 16 columns per thread; K % 512 == 0
+template <int NT, bool SOA>
+ESIMD_INLINE void moe_q6_K_rows(const uint32_t * w32, simd<uint32_t, 16> ol, simd<uint32_t, 16> oh, simd<uint32_t, 16> os,
+                                simd<uint32_t, 16> od, const sycl::half * a0, int nsb, int nks, int R, int r0,
+                                sycl::half * dst0, int N) {
+    simd<float, 128> acc[NT];
+#pragma unroll
+    for (int i = 0; i < NT; ++i) {
+        acc[i] = 0.0f;
+    }
+    const sycl::half * pa[NT];
+#pragma unroll
+    for (int t = 0; t < NT; ++t) {
+        pa[t] = a0 + (size_t) t * nks * 128;
+    }
+    for (int sp = 0; sp < nsb / 2; ++sp) {
+#pragma unroll
+        for (int e = 0; e < 2; ++e) {
+            const int sh = 2 * e;
+            simd<sycl::half, 256> dv;
+            {
+                simd<uint32_t, 5 * 16> tl;
+                if constexpr (SOA) {
+                    tl.template select<64, 1>(0)  = gather<uint32_t, 64, 4>(w32, os + 16 * e);
+                    tl.template select<16, 1>(64) = gather<uint32_t, 16, 1>(w32, od);
+                } else {
+                    tl.template select<64, 1>(0)  = gather<uint32_t, 64, 4>(w32, ol + (uint32_t) (208 * e + 192));
+                    tl.template select<16, 1>(64) = gather<uint32_t, 16, 1>(w32, ol + (uint32_t) (208 * e + 208));
+                }
+                auto t8 = tl.template bit_cast_view<int8_t>();
+                auto th = tl.template bit_cast_view<sycl::half>();
+                const int odd = 16 + sh;
+                const simd<float, 16> d = th.template replicate_vs_w_hs<16, 2, 1, 0>((odd / 4) * 32 + (odd % 4) / 2);
+#pragma unroll
+                for (int j = 0; j < 16; ++j) {
+                    const int osj = j + (SOA ? 0 : sh);
+                    const simd<int16_t, 16> scj = t8.template replicate_vs_w_hs<16, 4, 1, 0>((osj / 4) * 64 + osj % 4);
+                    dv.template select<16, 1>(16 * j) = d * convert<float>(scj);
+                }
+            }
+            const int shq = SOA ? 0 : sh;
+#pragma unroll
+            for (int n = 0; n < 2; ++n) {
+                simd<uint32_t, 17 * 16> ql;
+                simd<uint32_t, 9 * 16>  qh;
+                {
+                    const simd<uint32_t, 16> o0 = SOA ? simd<uint32_t, 16>(ol + (uint32_t) (128 * e + 64 * n))
+                                                      : simd<uint32_t, 16>(ol + (uint32_t) (208 * e + 64 * n));
+                    ql.template select<128, 1>(0)   = gather<uint32_t, 128, 8>(w32, o0);
+                    ql.template select<128, 1>(128) = gather<uint32_t, 128, 8>(w32, o0 + 32);
+                    ql.template select<16, 1>(256)  = gather<uint32_t, 16, 1>(w32, o0 + 64);
+                    const simd<uint32_t, 16> o1 = SOA ? simd<uint32_t, 16>(oh + (uint32_t) (64 * e + 32 * n))
+                                                      : simd<uint32_t, 16>(ol + (uint32_t) (208 * e + 128 + 32 * n));
+                    qh.template select<128, 1>(0)  = gather<uint32_t, 128, 8>(w32, o1);
+                    qh.template select<16, 1>(128) = gather<uint32_t, 16, 1>(w32, o1 + 32);
+                }
+#pragma unroll
+                for (int r = 0; r < 4; ++r) {
+                    simd<sycl::half, 256> b[2];
+#pragma unroll
+                    for (int h = 0; h < 2; ++h) {
+                        const int j = 8 * n + 2 * r + h;
+                        auto l8 = ql.template bit_cast_view<uint8_t>();
+                        auto h8 = qh.template bit_cast_view<uint8_t>();
+                        const simd<sycl::half, 32> sv = dv.template replicate_vs_w_hs<16, 1, 2, 0>(16 * j);
+#pragma unroll
+                        for (int p = 0; p < 8; ++p) {
+                            const int bl = 32 * (r & 1) + 16 * h + 2 * p + shq;
+                            const int bh = 16 * h + 2 * p + shq;
+                            const simd<uint16_t, 32> lo = l8.template replicate_vs_w_hs<16, 4, 2, 1>((bl / 4) * 64 + bl % 4);
+                            const simd<uint16_t, 32> hb = h8.template replicate_vs_w_hs<16, 4, 2, 1>((bh / 4) * 64 + bh % 4);
+                            const simd<uint16_t, 32> nib = r < 2 ? simd<uint16_t, 32>(lo & 0x0F) : simd<uint16_t, 32>(lo >> 4);
+                            const int hs = 4 - 2 * r;
+                            const simd<uint16_t, 32> hv = hs >= 0 ? simd<uint16_t, 32>(hb << hs) : simd<uint16_t, 32>(hb >> -hs);
+                            simd<uint16_t, 32> u = nib | (hv & 0x30) | 0x6400;
+                            const simd<sycl::half, 32> qv = u.template bit_cast_view<sycl::half>() - (sycl::half) 1056.0f;
+                            b[h].template select<32, 1>(p * 32) = qv * sv;
+                        }
+                    }
+#pragma unroll
+                    for (int t = 0; t < NT; ++t) {
+                        simd<sycl::half, 256> a2 = block_load<sycl::half, 256>(pa[t]);
+                        pa[t] += 256;
+#pragma unroll
+                        for (int h = 0; h < 2; ++h) {
+                            const simd<sycl::half, 128> a = a2.template select<128, 1>(128 * h);
+                            acc[t] = xmx::dpas<8, 8, float, float, sycl::half, sycl::half>(acc[t], b[h], a);
+                        }
+                    }
+                }
+            }
+        }
+        ol += SOA ? 256 : 420;
+        oh += 128;
+        os += 32;
+        od += 4;
+    }
+    moe_store_rows<1, NT>(acc, R, r0, dst0, N);
+}
+
+// moe_gemm_q4_K for Q5_K / Q6_K experts (the down projection of the unsloth UD quants); the per-expert SoA of reorder_qw
+// Q5_K: 32 columns per thread, K % 256 == 0, N % (32 * MOE_TW) == 0; Q6_K: 16 columns per thread, K % 512 == 0
+template <int QT, bool SOA>
+sycl::event moe_gemm_q56_K(sycl::queue & q, const uint8_t * w, const sycl::half * act, const int32_t * offs,
+                           const int32_t * pbeg, const int32_t * rg, const int32_t * n_rg, int max_rg,
+                           sycl::half * dst, int N, int K) {
+    constexpr int  NB    = QT == 5 ? 2 : 1;
+    constexpr int  BS    = QT == 5 ? 176 : 210;   // bytes per block
+    const int      nsb   = K / 256;
+    const uint32_t nblk  = (uint32_t) N * nsb;   // blocks per expert
+    const size_t   ebyte = (size_t) nblk * BS;
+    const int      nks   = K / 16;
+    const int      nwn   = N / (16 * NB * MOE_TW);
+    namespace sx = sycl::ext::oneapi::experimental;
+    sx::properties props{ sycl::ext::intel::experimental::grf_size<GRF> };
+
+    return q.parallel_for(sycl::nd_range<1>(sycl::range<1>((size_t) max_rg * nwn * MOE_TW), sycl::range<1>(MOE_TW)), props,
+        [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL {
+            const int wg  = (int) it.get_group(0);
+            const int lid = (int) it.get_local_id(0);
+            const int gi  = wg / nwn;
+            if (gi >= n_rg[0]) {
+                return;
+            }
+            const int nbk     = wg % nwn;
+            const int ge      = rg[gi];
+            const int e       = ge >> 16;
+            const int r0      = (ge & 0xffff) * 8;
+            const int row_beg = e > 0 ? offs[e - 1] : 0;
+            const int R       = offs[e] - row_beg;
+            const int nt      = (R - r0 + 7) / 8;
+            const int n0      = (nbk * MOE_TW + lid) * 16 * NB;
+
+            const uint32_t *   w32  = (const uint32_t *) (w + (size_t) e * ebyte);
+            const sycl::half * a0   = act + (size_t) ((pbeg[e] + r0) / 8) * nks * 128;
+            sycl::half *       dst0 = dst + (size_t) row_beg * N + n0;
+            if constexpr (QT == 5) {
+                simd<uint32_t, 16> oq[NB], oh[NB], os[NB], om[NB];
+#pragma unroll
+                for (int g = 0; g < NB; ++g) {
+                    const simd<uint32_t, 16> blk = lane_rows(n0, g) * (uint32_t) nsb;
+                    oq[g] = blk * (uint32_t) (SOA ? 128 : 176);
+                    oh[g] = nblk * 128 + blk * 32;
+                    os[g] = nblk * 160 + blk * 12;
+                    om[g] = nblk * 172 + blk * 4;
+                }
+                if (nt >= 4) {
+                    moe_q5_K_rows<4, SOA>(w32, oq, oh, os, om, a0, nsb, nks, R, r0, dst0, N);
+                } else if (nt == 3) {
+                    moe_q5_K_rows<3, SOA>(w32, oq, oh, os, om, a0, nsb, nks, R, r0, dst0, N);
+                } else if (nt == 2) {
+                    moe_q5_K_rows<2, SOA>(w32, oq, oh, os, om, a0, nsb, nks, R, r0, dst0, N);
+                } else {
+                    moe_q5_K_rows<1, SOA>(w32, oq, oh, os, om, a0, nsb, nks, R, r0, dst0, N);
+                }
+            } else {
+                const simd<uint32_t, 16> blk = lane_rows(n0, 0) * (uint32_t) nsb;
+                const simd<uint32_t, 16> ol  = blk * (uint32_t) (SOA ? 128 : 210);
+                const simd<uint32_t, 16> oh  = nblk * 128 + blk * 64;
+                const simd<uint32_t, 16> os  = nblk * 192 + blk * 16;
+                const simd<uint32_t, 16> od  = nblk * 208 + blk * 2;
+                if (nt >= 4) {
+                    moe_q6_K_rows<4, SOA>(w32, ol, oh, os, od, a0, nsb, nks, R, r0, dst0, N);
+                } else if (nt == 3) {
+                    moe_q6_K_rows<3, SOA>(w32, ol, oh, os, od, a0, nsb, nks, R, r0, dst0, N);
+                } else if (nt == 2) {
+                    moe_q6_K_rows<2, SOA>(w32, ol, oh, os, od, a0, nsb, nks, R, r0, dst0, N);
+                } else {
+                    moe_q6_K_rows<1, SOA>(w32, ol, oh, os, od, a0, nsb, nks, R, r0, dst0, N);
+                }
+            }
+        });
+}
+
+// gate_up with swiglu on the merged [E][2 n_ff][K/256] tensor: rows n0.. and n_ff + n0.. give 16 columns of silu(gate) * up
+// the result is written as the down gemm's input tiles, in the layout of moe_pack_rows
+// with map set, act is the f16 token rows xh of moe_pack_rows, read directly instead of the expanded tiles
+template <bool SOA, int DIRECT = 0, bool GEGLU = false>
+sycl::event moe_gemm_glu_q4_K(sycl::queue & q, const uint8_t * w, const sycl::half * act, const int32_t * offs,
+                              const int32_t * pbeg, const int32_t * rg, const int32_t * n_rg, int max_rg,
+                              sycl::half * act2, int n_ff, int K, const int32_t * map = nullptr, int ne11 = 1) {
+    constexpr int NB = 2;
+    const int      nsb   = K / 256;
+    const uint32_t nblk  = (uint32_t) 2 * n_ff * nsb;   // blocks per expert
+    const size_t   ebyte = (size_t) nblk * 144;
+    const int      nks   = K / 16;
+    const int      nks2  = n_ff / 16;
+    const int      nwn   = n_ff / (16 * MOE_TW);
+    namespace sx = sycl::ext::oneapi::experimental;
+    sx::properties props{ sycl::ext::intel::experimental::grf_size<GRF> };
+
+    return q.parallel_for(sycl::nd_range<1>(sycl::range<1>((size_t) max_rg * nwn * MOE_TW), sycl::range<1>(MOE_TW)), props,
+        [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL {
+            const int wg  = (int) it.get_group(0);
+            const int lid = (int) it.get_local_id(0);
+            const int gi  = wg / nwn;
+            if (gi >= n_rg[0]) {
+                return;
+            }
+            const int nbk     = wg % nwn;
+            const int ge      = rg[gi];
+            const int e       = ge >> 16;
+            const int r0      = (ge & 0xffff) * 8;
+            const int row_beg = e > 0 ? offs[e - 1] : 0;
+            const int R       = offs[e] - row_beg;
+            const int nt      = (R - r0 + 7) / 8;
+            const int n0      = (nbk * MOE_TW + lid) * 16;
+
+            const uint32_t * w32 = (const uint32_t *) (w + (size_t) e * ebyte);
+            simd<uint32_t, 16> oq[NB], os[NB], om[NB];
+#pragma unroll
+            for (int g = 0; g < NB; ++g) {
+                const simd<uint32_t, 16> blk = lane_rows(n0 + g * n_ff, 0) * (uint32_t) nsb;
+                oq[g] = blk * (uint32_t) (SOA ? 128 : 144);
+                os[g] = nblk * 128 + blk * 12;
+                om[g] = nblk * 140 + blk * 4;
+            }
+            const int          pt0  = (pbeg[e] + r0) / 8;
+            const sycl::half * a0   = DIRECT > 0 ? act : act + (size_t) pt0 * nks * 128;
+            sycl::half *       dst0 = act2 + ((size_t) pt0 * nks2 + n0 / 16) * 128;
+            const int          ts   = nks2 * 128;
+            // DIRECT: the xh row of every tile row; rows past the expert's end repeat its last row
+            simd<uint32_t, 8> ro[MOE_MT];
+            if constexpr (DIRECT > 0) {
+#pragma unroll
+                for (int t = 0; t < MOE_MT; ++t) {
+                    simd<int32_t, 8> lr = simd<int32_t, 8>(0, 1) + (r0 + 8 * t);
+                    lr.merge(simd<int32_t, 8>(R - 1), lr >= R);
+                    const simd<uint32_t, 8> mo   = simd<uint32_t, 8>(row_beg + lr) * 8u;
+                    const simd<int32_t, 8>  tok  = gather<int32_t, 8>(map, mo + 4u);
+                    const simd<int32_t, 8>  slot = gather<int32_t, 8>(map, mo);
+                    ro[t] = simd<uint32_t, 8>(tok * ne11 + slot % ne11) * (uint32_t) K;
+                }
+            }
+            if (nt >= 4) {
+                moe_q4_K_rows<4, SOA, true, DIRECT, GEGLU>(w32, oq, os, om, a0, nsb, nks, R, r0, dst0, ts, ro);
+            } else if (nt == 3) {
+                moe_q4_K_rows<3, SOA, true, DIRECT, GEGLU>(w32, oq, os, om, a0, nsb, nks, R, r0, dst0, ts, ro);
+            } else if (nt == 2) {
+                moe_q4_K_rows<2, SOA, true, DIRECT, GEGLU>(w32, oq, os, om, a0, nsb, nks, R, r0, dst0, ts, ro);
+            } else {
+                moe_q4_K_rows<1, SOA, true, DIRECT, GEGLU>(w32, oq, os, om, a0, nsb, nks, R, r0, dst0, ts, ro);
+            }
+        });
+}
+
+}   // namespace gguf_xmx
+
+#endif   // GGML_SYCL_GGUF_GEMM_KERNELS_HPP
