+// silu(gate) * up computed from the f16 gemm outputs and quantized straight to
+// grouped s8 activations (scale layout as in ggml_sycl_quantize_groups_s8)
+// subgroup-per-group variant of the swiglu + quantize pass (see quantize_groups_s8_sg)
+template <int EPL, typename S>
+static void swiglu_quant_s8_sg(const sycl::half * gate, const sycl::half * up, int8_t * q, S * scales,
+                               const int64_t n_ff, const int64_t n_rows, const int64_t group,
+                               const int64_t ngroups, const bool transposed, int32_t * sums,
+                               queue_ptr stream) {
+    constexpr int wg    = 256;
+    const int64_t total = n_rows * ngroups;
+    const int64_t n_wg  = (total + wg / WARP_SIZE - 1) / (wg / WARP_SIZE);
+    stream->parallel_for(
+        sycl::nd_range<1>(sycl::range<1>(n_wg * wg), sycl::range<1>(wg)),
+        [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+            auto sg = it.get_sub_group();
+            const int64_t gid = it.get_group(0) * (wg / WARP_SIZE) + sg.get_group_id()[0];
+            if (gid >= total) {
+                return;
+            }
+            const int64_t row  = gid / ngroups;
+            const int64_t g    = gid - row * ngroups;
+            const int     lane = sg.get_local_id()[0];
+            const int64_t base = row * n_ff + g * group;
+
+            float v[EPL];
+            float amax = 0.0f;
+            for (int i = 0; i < EPL; ++i) {
+                const int64_t idx = base + i * WARP_SIZE + lane;
+                const float   xg  = (float) gate[idx];
+                v[i] = xg / (1.0f + sycl::exp(-xg)) * (float) up[idx];
+                amax = sycl::fmax(amax, sycl::fabs(v[i]));
+            }
+            amax = sycl::reduce_over_group(sg, amax, sycl::maximum<float>());
+            const float inv = amax > 0.0f ? 127.0f / amax : 0.0f;
+            int32_t lsum = 0;
+            for (int i = 0; i < EPL; ++i) {
+                const int8_t qv = (int8_t) sycl::clamp(sycl::round(v[i] * inv), -127.0f, 127.0f);
+                q[base + i * WARP_SIZE + lane] = qv;
+                lsum += qv;
+            }
+            if (sums != nullptr) {
+                lsum = sycl::reduce_over_group(sg, lsum, sycl::plus<int32_t>());
+            }
+            if (lane == 0) {
+                scales[transposed ? g * n_rows + row : row * ngroups + g] = (S) (amax / 127.0f);
+                if (sums != nullptr) {
+                    sums[row * ngroups + g] = lsum;
+                }
+            }
+        });
