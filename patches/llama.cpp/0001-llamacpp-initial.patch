+// fused attention output gate: mul_dst[m][j] = att[h][m][d] * sigmoid(gate[m][j])
+// (j = h*D + d) straight from the f16 sdpa staging, skipping the f32 scatter, the
+// sigmoid pass and the elementwise mul. With q_out set it also emits the group-128
+// s8 copy (transposed scales) for the following int8 projection.
+static void ggml_sycl_sdpa_gate(const sycl::half * att, const float * gate, float * dst,
+                                const int64_t D, const int64_t M, const int64_t H,
+                                const int64_t g_s1, const int64_t g_s2,
+                                int8_t * q_out, float * q_sc, queue_ptr stream,
+                                sycl::half * q_sc16 = nullptr) {
+    constexpr int wg  = 256;
+    constexpr int epl = 128 / WARP_SIZE;   // quant-group elements per lane
+    const int64_t HD    = H * D;
+    const int64_t gpr   = HD / 128;
+    const int64_t total = M * gpr;
+    const int64_t n_wg  = (total + wg / WARP_SIZE - 1) / (wg / WARP_SIZE);
+    stream->parallel_for(
+        sycl::nd_range<1>(sycl::range<1>(n_wg * wg), sycl::range<1>(wg)),
+        [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+            auto sg = it.get_sub_group();
+            const int64_t gid = it.get_group(0) * (wg / WARP_SIZE) + sg.get_group_id()[0];
+            if (gid >= total) {
+                return;
+            }
+            const int64_t m  = gid / gpr;
+            const int64_t g  = gid % gpr;
+            const int lane   = sg.get_local_id()[0];
+            const int64_t j0 = g * 128 + lane * epl;
+            float v[epl];
+            float amax = 0.0f;
+            for (int i = 0; i < epl; ++i) {
+                const int64_t j = j0 + i;
+                const int64_t h = j / D;
+                const int64_t d = j % D;
+                const float gv  = gate[m * g_s2 + h * g_s1 + d];
+                v[i] = (float) att[(h * M + m) * D + d] * (1.0f / (1.0f + sycl::native::exp(-gv)));
+                dst[m * HD + j] = v[i];
+                amax = sycl::fmax(amax, sycl::fabs(v[i]));
+            }
+            if (q_out == nullptr) {
+                return;
+            }
+            amax = sycl::reduce_over_group(sg, amax, sycl::maximum<float>());
+            const float inv = amax > 0.0f ? 127.0f / amax : 0.0f;
+            int8_t * qd = q_out + m * HD + j0;
+            for (int i = 0; i < epl; ++i) {
+                qd[i] = (int8_t) sycl::clamp(sycl::round(v[i] * inv), -127.0f, 127.0f);
+            }
+            if (lane == 0) {
+                const float qs = amax / 127.0f;
+                if (q_sc16 != nullptr) {
+                    q_sc16[m * gpr + g] = (sycl::half) qs;
+                } else {
+                    q_sc[g * M + m] = qs;
+                }
+            }
+        });
+}
