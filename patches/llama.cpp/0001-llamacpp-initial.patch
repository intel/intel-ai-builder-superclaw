+    switch (type) {
+        case GGML_TYPE_Q4_K: return N % (32 * gguf_xmx::MOE_TW) == 0 && K % 256 == 0 && eb * 144 < 4.0e9;
+        case GGML_TYPE_Q5_1: return N % (16 * gguf_xmx::MOE_TW) == 0 && K % 32 == 0 && eb * 24 < 4.0e9;
+        case GGML_TYPE_Q5_K: return N % (32 * gguf_xmx::MOE_TW) == 0 && K % 256 == 0 && eb * 176 < 4.0e9;
+        case GGML_TYPE_Q6_K: return N % (16 * gguf_xmx::MOE_TW) == 0 && K % 512 == 0 && eb * 210 < 4.0e9;
+        default:             return false;
+    }
+}
+
+int64_t ggml_sycl_gguf_moe_max_row_groups(int64_t n_rows, int64_t n_as) {
+    return gguf_xmx::moe_max_row_groups(n_rows, n_as);
+}
+
+size_t ggml_sycl_gguf_moe_act_elems(int64_t n_rows, int64_t n_as, int64_t K) {
+    // every expert pads its rows to a multiple of 8
+    const int64_t rows = (n_rows + 7 * std::min(n_as, n_rows) + 7) / 8 * 8;
+    return (size_t) rows * K;
+}
+
+void ggml_sycl_gguf_moe_row_groups(const int32_t * offs, int n_as, int32_t * rg, int32_t * n_rg, queue_ptr stream) {
+    gguf_xmx::moe_row_groups(*stream, offs, n_as, rg, n_rg);
+}
+
+void ggml_sycl_gguf_moe_pack(const float * x, int64_t ldx, int64_t nx, int64_t ne11, const int32_t * map,
+                             const int32_t * offs, const int32_t * pbeg, const int32_t * rg, const int32_t * n_rg,
+                             int64_t max_rg, sycl::half * xh, sycl::half * act, int64_t K, queue_ptr stream) {
+    gguf_xmx::moe_pack_rows(*stream, x, ldx, nx, ne11, map, offs, pbeg, rg, n_rg, (int) max_rg, xh, act, (int) K);
+}
+
+void ggml_sycl_gguf_moe_gemm(ggml_type type, const void * w, bool reordered, const sycl::half * act,
+                             const int32_t * offs, const int32_t * pbeg, const int32_t * rg,
+                             const int32_t * n_rg, int64_t max_rg, sycl::half * dst, int64_t N, int64_t K,
+                             queue_ptr stream) {
+    GGML_ASSERT(ggml_sycl_gguf_moe_ok(type, N, K));
+    using namespace gguf_xmx;
+    const uint8_t * w8 = (const uint8_t *) w;
+    switch (type) {
+        case GGML_TYPE_Q5_1:
+            GGML_ASSERT(!reordered);
+            gguf_xmx::moe_gemm_q5_1<false>(*stream, w8, act, offs, pbeg, rg, n_rg, (int) max_rg, dst, (int) N, (int) K);
+            break;
+        case GGML_TYPE_Q5_K:
+            reordered ? (void) moe_gemm_q56_K<5, true>(*stream, w8, act, offs, pbeg, rg, n_rg, (int) max_rg, dst, (int) N, (int) K)
+                      : (void) moe_gemm_q56_K<5, false>(*stream, w8, act, offs, pbeg, rg, n_rg, (int) max_rg, dst, (int) N, (int) K);
+            break;
+        case GGML_TYPE_Q6_K:
+            reordered ? (void) moe_gemm_q56_K<6, true>(*stream, w8, act, offs, pbeg, rg, n_rg, (int) max_rg, dst, (int) N, (int) K)
+                      : (void) moe_gemm_q56_K<6, false>(*stream, w8, act, offs, pbeg, rg, n_rg, (int) max_rg, dst, (int) N, (int) K);
+            break;
+        case GGML_TYPE_Q4_K:
+            reordered ? (void) moe_gemm_q4_K<true>(*stream, w8, act, offs, pbeg, rg, n_rg, (int) max_rg, dst, (int) N, (int) K)
+                      : (void) moe_gemm_q4_K<false>(*stream, w8, act, offs, pbeg, rg, n_rg, (int) max_rg, dst, (int) N, (int) K);
+            break;
+        default: GGML_ABORT("unsupported MoE GGUF type");
+    }
+}
+
+void ggml_sycl_gguf_moe_gemm_glu(ggml_type type, const void * w, bool reordered, const sycl::half * act,
+                                 const int32_t * offs, const int32_t * pbeg, const int32_t * rg,
+                                 const int32_t * n_rg, int64_t max_rg, sycl::half * act2, int64_t n_ff, int64_t K,
+                                 queue_ptr stream, bool geglu, const int32_t * map, int64_t ne11) {
+    GGML_ASSERT(ggml_sycl_gguf_moe_ok(type, 2 * n_ff, K) && n_ff % (16 * gguf_xmx::MOE_TW) == 0);
+    GGML_ASSERT(type == GGML_TYPE_Q4_K);
+    const uint8_t * w8 = (const uint8_t *) w;
+    if (map != nullptr) {
+        // two k16 steps (64 B) per token row load: 32 B loads cost more than the expansion they save
+        if (reordered) {
+            geglu ? (void) gguf_xmx::moe_gemm_glu_q4_K<true, 2, true>(*stream, w8, act, offs, pbeg, rg, n_rg, (int) max_rg, act2, (int) n_ff, (int) K, map, (int) ne11)
+                  : (void) gguf_xmx::moe_gemm_glu_q4_K<true, 2, false>(*stream, w8, act, offs, pbeg, rg, n_rg, (int) max_rg, act2, (int) n_ff, (int) K, map, (int) ne11);
+        } else {
+            geglu ? (void) gguf_xmx::moe_gemm_glu_q4_K<false, 2, true>(*stream, w8, act, offs, pbeg, rg, n_rg, (int) max_rg, act2, (int) n_ff, (int) K, map, (int) ne11)
+                  : (void) gguf_xmx::moe_gemm_glu_q4_K<false, 2, false>(*stream, w8, act, offs, pbeg, rg, n_rg, (int) max_rg, act2, (int) n_ff, (int) K, map, (int) ne11);
+        }
+    } else if (reordered) {
+        geglu ? (void) gguf_xmx::moe_gemm_glu_q4_K<true, 0, true>(*stream, w8, act, offs, pbeg, rg, n_rg, (int) max_rg, act2, (int) n_ff, (int) K)
+              : (void) gguf_xmx::moe_gemm_glu_q4_K<true, 0, false>(*stream, w8, act, offs, pbeg, rg, n_rg, (int) max_rg, act2, (int) n_ff, (int) K);
+    } else {
+        geglu ? (void) gguf_xmx::moe_gemm_glu_q4_K<false, 0, true>(*stream, w8, act, offs, pbeg, rg, n_rg, (int) max_rg, act2, (int) n_ff, (int) K)
+              : (void) gguf_xmx::moe_gemm_glu_q4_K<false, 0, false>(*stream, w8, act, offs, pbeg, rg, n_rg, (int) max_rg, act2, (int) n_ff, (int) K);
+    }
+}
+
+void ggml_sycl_gguf_moe_swiglu(const sycl::half * gu, const int32_t * prow, sycl::half * act, int64_t n_rows,
+                               int64_t n_ff, queue_ptr stream) {
+    gguf_xmx::moe_swiglu_pack(*stream, gu, prow, act, (int) n_rows, (int) n_ff);
+}
diff --git a/ggml/src/ggml-sycl/gguf_gemm.hpp b/ggml/src/ggml-sycl/gguf_gemm.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..7ac10fa398d5196a30db457f76f68b9f3e1c1d65
--- /dev/null
+++ b/ggml/src/ggml-sycl/gguf_gemm.hpp
@@ -0,0 +1,131 @@
+//
+// MIT license
+// Copyright (C) 2024 Intel Corporation
+// SPDX-License-Identifier: MIT
+//
+
+#ifndef GGML_SYCL_GGUF_GEMM_HPP
+#define GGML_SYCL_GGUF_GEMM_HPP
+
+#include "common.hpp"
+
+// Exact prefill gemm on the GGUF weight blocks (Q8_0, Q3_K, Q4_K, Q5_K, Q6_K, IQ4_XS, IQ4_NL, IQ3_S) with f16 dpas, see
+// gguf_gemm_kernels.hpp. The weights are read in their file layout or after the in-place SoA reorder of the mmvq path
+// (reordered).
+
+bool ggml_sycl_gguf_gemm_ok(ggml_type type, int64_t N, int64_t K);
+
+// batches up to one token tile run the narrow kernels: one 8-token tile per work-group, whose threads split K
+#define GGML_SYCL_GGUF_NW_MAX_M 8
+
+// can the gemm read this type in this layout for M rows (Q3_K, and every narrow gemm, only after the reorder)?
+bool ggml_sycl_gguf_gemm_layout_ok(ggml_type type, bool reordered, int64_t M);
+
+// size in halves of the packed activations for M rows of K
+size_t ggml_sycl_gguf_gemm_act_elems(int64_t M, int64_t K);
+
+// x: M f32 rows of K with row stride ldx
+void ggml_sycl_gguf_pack(const float * x, int64_t ldx, sycl::half * act, int64_t M, int64_t K, queue_ptr stream);
+
+bool ggml_sycl_gguf_rms_pack_ok(int64_t K);
+
+// {RMS_NORM, MUL} of M rows of K (row strides ldx, ldd): writes the packed activations, and the f32 rows unless dst is null
+void ggml_sycl_gguf_rms_pack(const float * x, int64_t ldx, const float * w, float * dst, int64_t ldd, sycl::half * act,
+                             int64_t M, int64_t K, float eps, queue_ptr stream);
+
+// a * silu(z) of M rows of K: writes the packed activations, and the f32 rows unless dst is null; K % 64 == 0
+void ggml_sycl_gguf_silu_mul_pack(const float * z, int64_t ldz, const float * a, int64_t lda, float * dst, int64_t ldd,
+                                  sycl::half * act, int64_t M, int64_t K, queue_ptr stream);
+
+// k slices the gemm runs in (reordered or file-layout-only weights); each slice past the first needs M * N floats of scratch
+int ggml_sycl_gguf_gemm_splits(ggml_type type, int64_t M, int64_t N, int64_t K);
+
+// dst[M][N] (f32, contiguous) = (act * w^T) [* rs[m]] [+ res2] [+ res]; part = the split scratch, or null for no split
+void ggml_sycl_gguf_gemm(ggml_type type, const void * w, bool reordered, const sycl::half * act, float * dst,
+                         int64_t M, int64_t N, int64_t K, queue_ptr stream, const float * res = nullptr,
+                         const float * res2 = nullptr, const float * rs = nullptr, float * part = nullptr);
+
+// the gemm stored in the [Mp/8][N/16][8][16] tile layout of a following gemm's activation (no split-K), either as f32
+// tiles, or, with pack, as silu(glu) * (act * w^T) in f16, glu being the f32 tiles of the gate; N % 128 == 0
+void ggml_sycl_gguf_gemm_packed(ggml_type type, const void * w, bool reordered, const sycl::half * act, int64_t M,
+                                int64_t N, int64_t K, queue_ptr stream, float * tiles, const float * glu = nullptr,
+                                sycl::half * pack = nullptr);
+
+// gate and up [K, N] weights of one type in the same layout (Q8_0, Q4_K, Q5_K, IQ4_XS, IQ4_NL)
+bool ggml_sycl_gguf_glu_ok(ggml_type type, int64_t N, int64_t K);
+// and can the dual gemm read that layout?
+bool ggml_sycl_gguf_glu_layout_ok(ggml_type type, bool reordered);
+
+// out = activation(act * wg^T) * (act * wu^T), packed as the input of a following gemm
+void ggml_sycl_gguf_glu(ggml_type type, const void * wg, const void * wu, bool reordered, const sycl::half * act,
+                        sycl::half * out, int64_t M, int64_t N, int64_t K, queue_ptr stream, bool geglu = false);
+
+// the same gemms with s8 activations (gguf_gemm_i8_kernels.hpp): int8 dpas on the reordered Q8_0 / Q3_K / Q4_K / Q5_K /
+// Q6_K / IQ4_XS / IQ4_NL weights, one activation scale per 8 rows x 32 k
+
+// can the int8 gemm read this (reordered) weight?
+bool ggml_sycl_gguf_i8_ok(ggml_type type, int64_t N, int64_t K);
+
+// the s8 activations of M rows of K: aq s8 tiles, as their scales, xs the rows' 32-k sums (the K-quant min term)
+struct ggml_sycl_gguf_a8 {
+    int8_t *     aq = nullptr;
+    float *      as = nullptr;
+    sycl::half * xs = nullptr;
+};
+
+// bytes of one ggml_sycl_gguf_a8 for M rows of K, and its three arrays carved from such a buffer
+size_t            ggml_sycl_gguf_a8_bytes(int64_t M, int64_t K);
+ggml_sycl_gguf_a8 ggml_sycl_gguf_a8_view(void * buf, int64_t M, int64_t K);
+
+// the packed f16 activations act (M rows of K) -> a8; K % 512 == 0
+void ggml_sycl_gguf_a8_from_act(const sycl::half * act, const ggml_sycl_gguf_a8 & a8, int64_t M, int64_t K,
+                                queue_ptr stream);
+
+// k slices of the int8 gemm; each slice past the first needs M * N floats of scratch
+int ggml_sycl_gguf_i8_splits(ggml_type type, int64_t M, int64_t N, int64_t K);
+
+// ggml_sycl_gguf_gemm (dst rows, part) or ggml_sycl_gguf_gemm_packed (tiles / glu / pack, no split) on a8
+void ggml_sycl_gguf_gemm_i8(ggml_type type, const void * w, const ggml_sycl_gguf_a8 & a8, float * dst, int64_t M,
+                            int64_t N, int64_t K, queue_ptr stream, const float * res = nullptr,
+                            const float * res2 = nullptr, const float * rs = nullptr, float * part = nullptr,
+                            float * tiles = nullptr, const float * glu = nullptr, sycl::half * pack = nullptr);
+
+// gate (type tg) and up (tu) in one int8 kernel, any two of Q4_K / Q5_K or both IQ4_XS or both IQ4_NL:
+// out = silu(a8 * wg^T) * (a8 * wu^T) as the down gemm's packed input
+bool ggml_sycl_gguf_glu_i8_ok(ggml_type tg, ggml_type tu, int64_t N, int64_t K);
+void ggml_sycl_gguf_glu_i8(ggml_type tg, ggml_type tu, const void * wg, const void * wu, const ggml_sycl_gguf_a8 & a8,
+                           sycl::half * out, int64_t M, int64_t N, int64_t K, queue_ptr stream);
+
+// MoE on [K, N, E] expert tensors, rows expert-sorted
+
+bool ggml_sycl_gguf_moe_ok(ggml_type type, int64_t N, int64_t K);
+
+int64_t ggml_sycl_gguf_moe_max_row_groups(int64_t n_rows, int64_t n_as);
+
+size_t ggml_sycl_gguf_moe_act_elems(int64_t n_rows, int64_t n_as, int64_t K);
+
+void ggml_sycl_gguf_moe_row_groups(const int32_t * offs, int n_as, int32_t * rg, int32_t * n_rg, queue_ptr stream);
+
+// map = mmid_row_mapping pairs, xh = nx*K halves of scratch; the tiles are laid out by the row groups rg, act null = xh only
+void ggml_sycl_gguf_moe_pack(const float * x, int64_t ldx, int64_t nx, int64_t ne11, const int32_t * map,
+                             const int32_t * offs, const int32_t * pbeg, const int32_t * rg, const int32_t * n_rg,
+                             int64_t max_rg, sycl::half * xh, sycl::half * act, int64_t K, queue_ptr stream);
+
+// dst: f16 [n_rows][N] in sorted row order
+void ggml_sycl_gguf_moe_gemm(ggml_type type, const void * w, bool reordered, const sycl::half * act,
+                             const int32_t * offs, const int32_t * pbeg, const int32_t * rg,
+                             const int32_t * n_rg, int64_t max_rg, sycl::half * dst, int64_t N, int64_t K,
+                             queue_ptr stream);
+
+// gate_up gemm of a merged [K, 2 n_ff, E] tensor with the swiglu folded in: act2 = the down gemm's activation tiles
+// with map set, act is xh of ggml_sycl_gguf_moe_pack (its rows read directly) instead of the expanded tiles
+void ggml_sycl_gguf_moe_gemm_glu(ggml_type type, const void * w, bool reordered, const sycl::half * act,
+                                 const int32_t * offs, const int32_t * pbeg, const int32_t * rg,
+                                 const int32_t * n_rg, int64_t max_rg, sycl::half * act2, int64_t n_ff, int64_t K,
+                                 queue_ptr stream, bool geglu = false, const int32_t * map = nullptr, int64_t ne11 = 1);
+
+// silu(gate) * up of gu (f16 [n_rows][2 n_ff]) -> activation tiles
+void ggml_sycl_gguf_moe_swiglu(const sycl::half * gu, const int32_t * prow, sycl::half * act, int64_t n_rows,
+                               int64_t n_ff, queue_ptr stream);
+
+#endif // GGML_SYCL_GGUF_GEMM_HPP
