+void llm_graph_context::build_layer_inp_dev() const {
+    ggml_tensor * dev = cparams.embeddings_layer_inp_dev;
+    if (!dev) {
+        return;
+    }
+
+    // the rows of a token hold its extracted layer inputs side by side, in increasing layer order
+    const int64_t n_ext = dev->ne[0] / n_embd;
+    ggml_tensor * dst = ggml_view_2d(ctx0, dev, n_embd, dev->ne[1]*n_ext, n_embd*ggml_element_size(dev), 0);
+
+    auto inp = std::make_unique<llm_graph_input_layer_inp_dev>(cparams.embeddings_layer_inp_dev_row0, n_ext);
+
+    for (size_t il = 0; il < cparams.embeddings_layer_inp.size(); ++il) {
+        if (!cparams.embeddings_layer_inp[il]) {
+            continue;
+        }
+        GGML_ASSERT(res->t_layer_inp[il] != nullptr && "layer input tensor is null");
+        ggml_tensor * rows = ggml_new_tensor_1d(ctx0, GGML_TYPE_I64, n_tokens);
+        ggml_set_input(rows);
+        inp->rows.push_back(rows);
+        ggml_build_forward_expand(gf, ggml_set_rows(ctx0, dst, res->t_layer_inp[il], rows));
+    }
+    GGML_ASSERT((int64_t) inp->rows.size() == n_ext);
+
+    res->add_input(std::move(inp));
+}
