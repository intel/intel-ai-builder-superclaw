+
+// Per-miss IO path tracing, enabled by LLAMA_MOE_IO_DEBUG=1.
+// Writes straight to stderr so it survives quiet log callbacks and can be
+// redirected to a file (2> trace.log) without flooding the terminal.
+static bool llama_moe_io_debug() {
+    static const bool enabled = []() {
+        const char * v = getenv("LLAMA_MOE_IO_DEBUG");
+        return v != nullptr && v[0] != '\0' && v[0] != '0';
+    }();
+    return enabled;
+}
+
+// Prefill data-correctness tracing, enabled by LLAMA_MOE_PREFILL_DEBUG=1.
+// Writes to a file (LLAMA_MOE_PREFILL_DEBUG_FILE, default moe_prefill_debug.log)
+// so it never floods the terminal.
+static FILE * llama_moe_prefill_dbg() {
+    static FILE * f = []() -> FILE * {
+        const char * v = getenv("LLAMA_MOE_PREFILL_DEBUG");
+        if (v == nullptr || v[0] == '\0' || v[0] == '0') {
+            return nullptr;
+        }
+        const char * path = getenv("LLAMA_MOE_PREFILL_DEBUG_FILE");
+        if (path == nullptr || path[0] == '\0') {
+            path = "moe_prefill_debug.log";
+        }
+        return fopen(path, "w");
+    }();
+    return f;
+}
+
+// Per-key-path latency tracing, enabled by LLAMA_MOE_LAT_DEBUG=1. Writes to a
+// file (LLAMA_MOE_LAT_FILE, default moe_latency.log) so it never floods the
+// terminal. Times the decode LRU/fill/upload path and the prefill stream path,
+// so the exposed cost of each stage is visible without a profiler.
