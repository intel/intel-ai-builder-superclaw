+// silu(gate) * up from two separate f16 gemm outputs, emitted as f16 so it can
+// feed a W4A16 down gemm directly
+static void ggml_sycl_swiglu_to_f16(const sycl::half * gate, const sycl::half * up, sycl::half * out,
+                                    const int64_t n, queue_ptr stream) {
+    stream->parallel_for(sycl::range<1>(n), [=](sycl::id<1> i) {
+        const float x = (float) gate[i[0]];
+        out[i[0]] = (sycl::half) (x / (1.0f + sycl::exp(-x)) * (float) up[i[0]]);
+    });
+}
