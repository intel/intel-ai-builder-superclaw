         gemm(ctx, m, n, k, a, at, 1, k, k * m, b, bt, 1, k, n * k, c, ct, q, 1, 1);
     }
+
+    // dst = a x b with symmetric group-quantized s8 operands and one f32 scale
+    // per `group` elements along k:
+    //   a: weights,     s8, [m, k] with rows contiguous, scales [m, k/group]
+    //   b: activations, s8, [k, n] with columns contiguous, scales [k/group, n]
+    //   c: f32, same layout as row_gemm (m contiguous per column)
+    static void row_gemm_int8(ggml_backend_sycl_context & ctx, int m, int n, int k,
+        const int8_t * a, const float * a_scales, const int8_t * b, const float * b_scales,
+        void * c, const queue_ptr & q, int group, dt ct = dt::f32,
+        const float * bin_add = nullptr) {
+
+        auto stream = ctx.stream_dnnl(q);
+        auto eng = ctx.engine_dnnl(q);
+
+        const dnnl_dim_t kg = k / group;
+        const auto a_md = dnnl::memory::desc({1, m, k}, dt::s8, dnnl::memory::dims{(dnnl_dim_t) m * k, k, 1});
+        const auto b_md = dnnl::memory::desc({1, k, n}, dt::s8, dnnl::memory::dims{(dnnl_dim_t) k * n, 1, k});
+        const auto c_md = dnnl::memory::desc({1, m, n}, ct, dnnl::memory::dims{(dnnl_dim_t) m * n, 1, m});
+        const auto a_sc_md = dnnl::memory::desc({1, m, kg}, dt::f32, tag::abc);
+        const auto b_sc_md = dnnl::memory::desc({1, kg, n}, dt::f32, tag::abc);
+
+        dnnl::primitive_attr attr;
+        attr.set_scratchpad_mode(dnnl::scratchpad_mode::user);
+        attr.set_scales(DNNL_ARG_SRC,     (1 << 1) | (1 << 2), {1, group}, dt::f32);
+        attr.set_scales(DNNL_ARG_WEIGHTS, (1 << 1) | (1 << 2), {group, 1}, dt::f32);
+        // residual add folded in as a binary post-op (same layout as dst)
+        const auto r_md = dnnl::memory::desc({1, m, n}, dt::f32, dnnl::memory::dims{(dnnl_dim_t) m * n, 1, m});
+        if (bin_add != nullptr) {
+            dnnl::post_ops po;
+            po.append_binary(dnnl::algorithm::binary_add, r_md);
+            attr.set_post_ops(po);
+        }
+
+        auto a_mem    = dnnl::memory(a_md, eng, const_cast<int8_t *>(a));
+        auto b_mem    = dnnl::memory(b_md, eng, const_cast<int8_t *>(b));
+        auto a_sc_mem = dnnl::memory(a_sc_md, eng, const_cast<float *>(a_scales));
+        auto b_sc_mem = dnnl::memory(b_sc_md, eng, const_cast<float *>(b_scales));
+
+        auto matmul_pd = dnnl::matmul::primitive_desc(eng, a_md, b_md, c_md, attr);
+        auto c_mem = dnnl::memory(matmul_pd.dst_desc(), eng, c);
+        auto scratchpad_mem = ctx.get_scratchpad_mem(matmul_pd.scratchpad_desc(), eng, q);
+        auto matmul_prim = dnnl::matmul(matmul_pd);
+
+        std::unordered_map<int, dnnl::memory> matmul_args;
+        matmul_args.insert({ DNNL_ARG_SRC, a_mem });
+        matmul_args.insert({ DNNL_ARG_WEIGHTS, b_mem });
+        matmul_args.insert({ DNNL_ARG_DST, c_mem });
+        matmul_args.insert({ DNNL_ARG_SCRATCHPAD, scratchpad_mem });
+        matmul_args.insert({ DNNL_ARG_ATTR_SCALES | DNNL_ARG_SRC, a_sc_mem });
+        matmul_args.insert({ DNNL_ARG_ATTR_SCALES | DNNL_ARG_WEIGHTS, b_sc_mem });
+        if (bin_add != nullptr) {
+            auto r_mem = dnnl::memory(r_md, eng, const_cast<float *>(bin_add));
+            matmul_args.insert({ DNNL_ARG_ATTR_MULTIPLE_POST_OP(0) | DNNL_ARG_SRC_1, r_mem });
+        }
+
+        matmul_prim.execute(stream, matmul_args);
+    }
+
+    // dst[M,N] = act_f16[M,K] (SRC) x weights_u4[K,N] (WEIGHTS, asym per-group scale+zp along K).
+    //   M = tokens, K = n_embd, N = n_ff.  oneDNN decompresses the WEIGHTS operand (the standard
+    //   weight-decompression path), so u4/scales/zp attach to DNNL_ARG_WEIGHTS.
+    //   act : f16 [M,K] row-major (each token's K contiguous)
+    //   w   : u4  logical [K,N] but STORED as llama's [N,K] (n_ff rows, k packed) -> strided desc
+    //   w_sc/w_zp : [k/group, N] (transposed layout emitted by ggml_sycl_quantize_groups_u4)
+    //   c   : f32 [M,N] row-major (each token's N contiguous) == dst_contiguous slice
+    static void row_gemm_int4(ggml_backend_sycl_context & ctx, int M, int N, int K,
+        const sycl::half * act, const uint8_t * w, const sycl::half * w_sc, const uint8_t * w_zp,
+        void * c, const queue_ptr & q, int group, dt ct = dt::f32,
+        const float * bin_add = nullptr) {
+
+        auto stream = ctx.stream_dnnl(q);
+        auto eng = ctx.engine_dnnl(q);
+
+        const dnnl_dim_t kg = K / group;
+        const auto src_md = dnnl::memory::desc({1, M, K}, dt::f16, dnnl::memory::dims{(dnnl_dim_t) M * K, K, 1});
+        // weights logical [K,N] stored as [N,K] (k innermost/packed, n strides by K)
+        const auto wei_md = dnnl::memory::desc({1, K, N}, dt::u4,  dnnl::memory::dims{(dnnl_dim_t) K * N, 1, K});
+        const auto dst_md = dnnl::memory::desc({1, M, N}, ct, dnnl::memory::dims{(dnnl_dim_t) M * N, N, 1});
+        const auto sc_md  = dnnl::memory::desc({1, kg, N}, dt::f16, tag::abc);
+        const auto zp_md  = dnnl::memory::desc({1, kg, N}, dt::u4,  tag::abc);
+
+        dnnl::primitive_attr attr;
+        attr.set_scratchpad_mode(dnnl::scratchpad_mode::user);
+        // group along K (dim 1 of the {1,K,N} weights): {group, 1}
+        attr.set_scales(DNNL_ARG_WEIGHTS,      (1 << 1) | (1 << 2), {group, 1}, dt::f16);
+        attr.set_zero_points(DNNL_ARG_WEIGHTS, (1 << 1) | (1 << 2), {group, 1}, dt::u4);
+        attr.set_fpmath_mode(dnnl::fpmath_mode::f16, true);
+        // residual add folded in as a binary post-op (same layout as dst)
+        const auto r_md = dnnl::memory::desc({1, M, N}, dt::f32, dnnl::memory::dims{(dnnl_dim_t) M * N, N, 1});
+        if (bin_add != nullptr) {
+            dnnl::post_ops po;
+            po.append_binary(dnnl::algorithm::binary_add, r_md);
+            attr.set_post_ops(po);
+        }
+
+        auto s_mem  = dnnl::memory(src_md, eng, const_cast<sycl::half *>(act));
+        auto w_mem  = dnnl::memory(wei_md, eng, const_cast<uint8_t *>(w));
+        auto sc_mem = dnnl::memory(sc_md,  eng, const_cast<sycl::half *>(w_sc));
+        auto zp_mem = dnnl::memory(zp_md,  eng, const_cast<uint8_t *>(w_zp));
+
+        auto matmul_pd = dnnl::matmul::primitive_desc(eng, src_md, wei_md, dst_md, attr);
+        auto c_mem = dnnl::memory(matmul_pd.dst_desc(), eng, c);
+        auto scratchpad_mem = ctx.get_scratchpad_mem(matmul_pd.scratchpad_desc(), eng, q);
+        auto matmul_prim = dnnl::matmul(matmul_pd);
+
+        std::unordered_map<int, dnnl::memory> matmul_args;
+        matmul_args.insert({ DNNL_ARG_SRC, s_mem });
+        matmul_args.insert({ DNNL_ARG_WEIGHTS, w_mem });
+        matmul_args.insert({ DNNL_ARG_DST, c_mem });
+        matmul_args.insert({ DNNL_ARG_SCRATCHPAD, scratchpad_mem });
+        matmul_args.insert({ DNNL_ARG_ATTR_SCALES | DNNL_ARG_WEIGHTS, sc_mem });
+        matmul_args.insert({ DNNL_ARG_ATTR_ZERO_POINTS | DNNL_ARG_WEIGHTS, zp_mem });
+        if (bin_add != nullptr) {
+            auto r_mem = dnnl::memory(r_md, eng, const_cast<float *>(bin_add));
+            matmul_args.insert({ DNNL_ARG_ATTR_MULTIPLE_POST_OP(0) | DNNL_ARG_SRC_1, r_mem });
+        }
+
+        matmul_prim.execute(stream, matmul_args);
+    }
+
+    // dst[M,N] = act_s8[M,K] (SRC, per-group f32 scales along K) x weights_u4[K,N]
+    // (WEIGHTS, asym f16 scale + u4 zp per group along K). Same operand layouts as
+    // row_gemm_int4 with the src quantized: the int8 pipeline at half the weight bytes.
+    // act_sums (optional, [M, K/group_a] s32): per-group sums of the quantized
+    // activations, passed as oneDNN precomputed reductions so the weight
+    // zero-point compensation is not recomputed inside the gemm
+    static void row_gemm_w4a8(ggml_backend_sycl_context & ctx, int M, int N, int K,
+        const int8_t * act, const sycl::half * act_sc, const uint8_t * w, const sycl::half * w_sc,
+        const uint8_t * w_zp, void * c, const queue_ptr & q, int group_a, int group_w,
+        dt ct = dt::f32, const float * bin_add = nullptr, const int32_t * act_sums = nullptr) {
+
+        auto stream = ctx.stream_dnnl(q);
+        auto eng = ctx.engine_dnnl(q);
+
+        const dnnl_dim_t kg = K / group_w;
+        const auto src_md = dnnl::memory::desc({1, M, K}, dt::s8, dnnl::memory::dims{(dnnl_dim_t) M * K, K, 1});
+        const auto wei_md = dnnl::memory::desc({1, K, N}, dt::u4,  dnnl::memory::dims{(dnnl_dim_t) K * N, 1, K});
+        const auto dst_md = dnnl::memory::desc({1, M, N}, ct, dnnl::memory::dims{(dnnl_dim_t) M * N, N, 1});
+        const auto a_sc_md = dnnl::memory::desc({1, M, K / group_a}, dt::f16, tag::abc);
+        const auto sc_md  = dnnl::memory::desc({1, kg, N}, dt::f16, tag::abc);
+        const auto zp_md  = dnnl::memory::desc({1, kg, N}, dt::u4,  tag::abc);
+        const auto red_md = dnnl::memory::desc({1, M, K / group_a}, dt::s32, tag::abc);
+
+        dnnl::primitive_attr attr;
+        attr.set_scratchpad_mode(dnnl::scratchpad_mode::user);
+        attr.set_scales(DNNL_ARG_SRC,          (1 << 1) | (1 << 2), {1, group_a}, dt::f16);
+        attr.set_scales(DNNL_ARG_WEIGHTS,      (1 << 1) | (1 << 2), {group_w, 1}, dt::f16);
+        attr.set_zero_points(DNNL_ARG_WEIGHTS, (1 << 1) | (1 << 2), {group_w, 1}, dt::u4);
+        if (act_sums != nullptr) {
+            // reductions require the full-tensor mask ((1 << ndims_src) - 1), unlike scales
+            attr.set_precomputed_reductions(DNNL_ARG_SRC, (1 << 0) | (1 << 1) | (1 << 2),
+                                            {1, group_a}, dt::s32);
+        }
+        const auto r_md = dnnl::memory::desc({1, M, N}, dt::f32, dnnl::memory::dims{(dnnl_dim_t) M * N, N, 1});
+        if (bin_add != nullptr) {
+            dnnl::post_ops po;
+            po.append_binary(dnnl::algorithm::binary_add, r_md);
+            attr.set_post_ops(po);
+        }
+
+        auto s_mem   = dnnl::memory(src_md, eng, const_cast<int8_t *>(act));
+        auto ssc_mem = dnnl::memory(a_sc_md, eng, const_cast<sycl::half *>(act_sc));
+        auto w_mem   = dnnl::memory(wei_md, eng, const_cast<uint8_t *>(w));
+        auto sc_mem  = dnnl::memory(sc_md,  eng, const_cast<sycl::half *>(w_sc));
+        auto zp_mem  = dnnl::memory(zp_md,  eng, const_cast<uint8_t *>(w_zp));
+
+        auto matmul_pd = dnnl::matmul::primitive_desc(eng, src_md, wei_md, dst_md, attr);
+        auto c_mem = dnnl::memory(matmul_pd.dst_desc(), eng, c);
+        auto scratchpad_mem = ctx.get_scratchpad_mem(matmul_pd.scratchpad_desc(), eng, q);
+        auto matmul_prim = dnnl::matmul(matmul_pd);
+
+        std::unordered_map<int, dnnl::memory> matmul_args;
+        matmul_args.insert({ DNNL_ARG_SRC, s_mem });
+        matmul_args.insert({ DNNL_ARG_WEIGHTS, w_mem });
+        matmul_args.insert({ DNNL_ARG_DST, c_mem });
+        matmul_args.insert({ DNNL_ARG_SCRATCHPAD, scratchpad_mem });
+        matmul_args.insert({ DNNL_ARG_ATTR_SCALES | DNNL_ARG_SRC, ssc_mem });
+        matmul_args.insert({ DNNL_ARG_ATTR_SCALES | DNNL_ARG_WEIGHTS, sc_mem });
+        matmul_args.insert({ DNNL_ARG_ATTR_ZERO_POINTS | DNNL_ARG_WEIGHTS, zp_mem });
+        if (act_sums != nullptr) {
+            auto red_mem = dnnl::memory(red_md, eng, const_cast<int32_t *>(act_sums));
+            matmul_args.insert({ DNNL_ARG_ATTR_PRECOMPUTED_REDUCTIONS | DNNL_ARG_SRC, red_mem });
+        }
+        if (bin_add != nullptr) {
+            auto r_mem = dnnl::memory(r_md, eng, const_cast<float *>(bin_add));
+            matmul_args.insert({ DNNL_ARG_ATTR_MULTIPLE_POST_OP(0) | DNNL_ARG_SRC_1, r_mem });
+        }
+
+        matmul_prim.execute(stream, matmul_args);
+    }
+
+    // probe: can this oneDNN build create the (s8 src x u4 wei) matmul at all?
+    static bool w4a8_supported(ggml_backend_sycl_context & ctx, const queue_ptr & q) {
+        static int ok = -1;
+        if (ok < 0) {
+            try {
+                auto eng = ctx.engine_dnnl(q);
+                const int M = 32, N = 256, K = 256, group = 64;
+                const dnnl_dim_t kg = K / group;
+                const auto src_md = dnnl::memory::desc({1, M, K}, dt::s8, dnnl::memory::dims{(dnnl_dim_t) M * K, K, 1});
+                const auto wei_md = dnnl::memory::desc({1, K, N}, dt::u4, dnnl::memory::dims{(dnnl_dim_t) K * N, 1, K});
+                const auto dst_md = dnnl::memory::desc({1, M, N}, dt::f32, dnnl::memory::dims{(dnnl_dim_t) M * N, N, 1});
+                dnnl::primitive_attr attr;
+                attr.set_scratchpad_mode(dnnl::scratchpad_mode::user);
+                attr.set_scales(DNNL_ARG_SRC,          (1 << 1) | (1 << 2), {1, group}, dt::f32);
+                attr.set_scales(DNNL_ARG_WEIGHTS,      (1 << 1) | (1 << 2), {group, 1}, dt::f16);
+                attr.set_zero_points(DNNL_ARG_WEIGHTS, (1 << 1) | (1 << 2), {group, 1}, dt::u4);
+                auto pd = dnnl::matmul::primitive_desc(eng, src_md, wei_md, dst_md, attr);
+                ok = 1;
+                GGML_UNUSED(kg);
+            } catch (const dnnl::error &) {
+                ok = 0;
+            }
+        }
+        return ok == 1;
+    }
+
+    // GGML_SYCL_W4A8_ATTR_REPORT=1 times the (s8 x u4) matmul over this model's actual
+    // gemm shapes so per-shape efficiency can be compared against the FLOP budget
+    static void w4a8_attr_report(ggml_backend_sycl_context & ctx, const queue_ptr & q) {
+        auto eng = ctx.engine_dnnl(q);
+        auto stream = ctx.stream_dnnl(q);
+        const int reps = 10;
+        struct shape_t { const char * name; int K, N, count; };
+        static const shape_t shapes[] = {
+            { "ffn_gate/up",   5120, 17408, 128 },
+            { "ffn_down",     17408,  5120,  64 },
+            { "gdn_qkv",       5120, 10240,  48 },
+            { "gdn_gate",      5120,  6144,  48 },
+            { "ssm_out",       6144,  5120,  48 },
+            { "attn_q",        5120, 12288,  16 },
+            { "attn_out",      6144,  5120,  16 },
+            { "attn_kv",       5120,  1024,  32 },
+            { "ssm_alphabeta", 5120,    48,  96 },
+        };
+        const int M = 2048, group = 128;
+        fprintf(stderr, "[SHAPE] %-14s %6s %6s %5s %10s %8s %9s %10s %9s\n",
+                "shape", "K", "N", "cnt", "ms_f16", "TOPS", "pf_f16", "ms_f32", "pf_f32");
+        double total_ms = 0.0;
+        for (const auto & sh : shapes) {
+            const dnnl_dim_t kg = sh.K / group;
+            void * act    = sycl::malloc_device((size_t) M * sh.K, *q);
+            void * act_sc = sycl::malloc_device((size_t) M * kg * sizeof(sycl::half), *q);
+            void * w      = sycl::malloc_device((size_t) sh.K * sh.N / 2, *q);
+            void * w_sc   = sycl::malloc_device((size_t) kg * sh.N * sizeof(sycl::half), *q);
+            void * w_zp   = sycl::malloc_device((size_t) kg * sh.N, *q);
+            void * dstb   = sycl::malloc_device((size_t) M * sh.N * sizeof(float), *q);
+            if (!act || !act_sc || !w || !w_sc || !w_zp || !dstb) {
+                fprintf(stderr, "[SHAPE] %-14s allocation failed\n", sh.name);
+                continue;
+            }
+            q->memset(act, 1, (size_t) M * sh.K).wait();
+            q->memset(w, 0x11, (size_t) sh.K * sh.N / 2).wait();
+            q->memset(w_zp, 8, (size_t) kg * sh.N).wait();
+            q->memset(act_sc, 0x3c, (size_t) M * kg * sizeof(sycl::half)).wait();
+            q->memset(w_sc, 0x3c, (size_t) kg * sh.N * sizeof(sycl::half)).wait();
+            double ms = -1.0, ms32 = -1.0;
+            for (int pass = 0; pass < 2; pass++) {
+                const dt ct = pass == 0 ? dt::f16 : dt::f32;
+                try {
+                    row_gemm_w4a8(ctx, M, sh.N, sh.K, (const int8_t *) act, (const sycl::half *) act_sc,
+                                  (const uint8_t *) w, (const sycl::half *) w_sc, (const uint8_t *) w_zp,
+                                  dstb, q, group, group, ct);
+                    stream.wait();
+                    const auto t0 = std::chrono::steady_clock::now();
+                    for (int r = 0; r < reps; r++) {
+                        row_gemm_w4a8(ctx, M, sh.N, sh.K, (const int8_t *) act, (const sycl::half *) act_sc,
+                                      (const uint8_t *) w, (const sycl::half *) w_sc, (const uint8_t *) w_zp,
+                                      dstb, q, group, group, ct);
+                    }
+                    stream.wait();
+                    const double t = std::chrono::duration<double, std::milli>(
+                                 std::chrono::steady_clock::now() - t0).count() / reps;
+                    if (pass == 0) { ms = t; } else { ms32 = t; }
+                } catch (const dnnl::error &) {
+                }
+            }
+            // one launch covers M tokens of one tensor; a 16384-token prefill runs
+            // count tensors x (16384 / M) chunks
+            const double per_prefill = ms * sh.count * (16384.0 / M);
+            const double tops = ms > 0.0 ? 2.0 * M * sh.N * sh.K / (ms * 1e-3) / 1e12 : 0.0;
+            total_ms += per_prefill;
+            fprintf(stderr, "[SHAPE] %-14s %6d %6d %5d %10.4f %8.1f %9.0f %10.4f %9.0f\n",
+                    sh.name, sh.K, sh.N, sh.count, ms, tops, per_prefill,
+                    ms32, ms32 * sh.count * (16384.0 / M));
+            sycl::free(act, *q);  sycl::free(act_sc, *q); sycl::free(w, *q);
+            sycl::free(w_sc, *q); sycl::free(w_zp, *q);   sycl::free(dstb, *q);
+        }
+        fprintf(stderr, "[SHAPE] total dense-mm ms per 16384-token prefill: %.0f\n", total_ms);
+    }
+
+    // probe: does this oneDNN build take precomputed SRC reductions on that matmul?
+    static bool w4a8_reductions_supported(ggml_backend_sycl_context & ctx, const queue_ptr & q) {
+        static int ok = -1;
+        if (ok < 0) {
+            if (getenv("GGML_SYCL_W4A8_ATTR_REPORT") != nullptr) {
+                w4a8_attr_report(ctx, q);
+            }
+            try {
+                auto eng = ctx.engine_dnnl(q);
+                const int M = 32, N = 256, K = 256, group = 64;
+                const auto src_md = dnnl::memory::desc({1, M, K}, dt::s8, dnnl::memory::dims{(dnnl_dim_t) M * K, K, 1});
+                const auto wei_md = dnnl::memory::desc({1, K, N}, dt::u4, dnnl::memory::dims{(dnnl_dim_t) K * N, 1, K});
+                const auto dst_md = dnnl::memory::desc({1, M, N}, dt::f32, dnnl::memory::dims{(dnnl_dim_t) M * N, N, 1});
+                dnnl::primitive_attr attr;
+                attr.set_scratchpad_mode(dnnl::scratchpad_mode::user);
+                attr.set_scales(DNNL_ARG_SRC,          (1 << 1) | (1 << 2), {1, group}, dt::f32);
+                attr.set_scales(DNNL_ARG_WEIGHTS,      (1 << 1) | (1 << 2), {group, 1}, dt::f16);
+                attr.set_zero_points(DNNL_ARG_WEIGHTS, (1 << 1) | (1 << 2), {group, 1}, dt::u4);
+                attr.set_precomputed_reductions(DNNL_ARG_SRC, (1 << 0) | (1 << 1) | (1 << 2), {1, group}, dt::s32);
+                auto pd = dnnl::matmul::primitive_desc(eng, src_md, wei_md, dst_md, attr);
+                ok = 1;
+            } catch (const dnnl::error &) {
+                ok = 0;
+            }
+        }
+        return ok == 1;
+    }
+
+#if defined(DNNL_EXPERIMENTAL_GROUPED_MEMORY) && DNNL_EXPERIMENTAL_GROUPED_MEMORY
+    // One grouped matmul over all experts at once (variable tokens/expert), W4A16. Mirrors OV's
+    // grouped_gemm:micro. dst[total_rows,N] = act_f16[total_rows,K] (grouped by expert) x u4 weights.
+    //   act     : f16 [total_rows, K], rows concatenated in expert order (== src1_contiguous, f16)
+    //   w       : u4 weights, logical [n_experts, K, N], stored acb = [n_experts, N, K] (the in-place
+    //             converted buffer); w_sc [n_experts, K/group, N] f16, w_zp [n_experts, K/group, N] u4
+    //   offsets : s32 [n_experts], cumulative exclusive-end row index per expert
+    //   dst     : f32 [total_rows, N], rows in the same expert order
+    static void grouped_gemm_int4(ggml_backend_sycl_context & ctx,
+        int64_t total_rows, int n_experts, int K, int N, int group,
+        const sycl::half * act, const uint8_t * w, const sycl::half * w_sc, const uint8_t * w_zp,
+        const int32_t * offsets, int32_t max_rows_per_expert, void * dst, dt dst_dt, const queue_ptr & q) {
+
+        auto stream = ctx.stream_dnnl(q);
+        auto eng = ctx.engine_dnnl(q);
+        const dnnl_dim_t kg = K / group;
+
+        const auto src_md = dnnl::memory::desc::grouped({total_rows, K}, dt::f16, 0, n_experts);
+        const auto wei_md = dnnl::memory::desc({n_experts, (dnnl_dim_t) K, (dnnl_dim_t) N}, dt::u4, tag::acb);
+        const auto dst_md = dnnl::memory::desc::grouped({total_rows, N}, dst_dt, 0, n_experts);
+        const auto sc_md  = dnnl::memory::desc({n_experts, kg, (dnnl_dim_t) N}, dt::f16, tag::abc);
+        const auto zp_md  = dnnl::memory::desc({n_experts, kg, (dnnl_dim_t) N}, dt::u4,  tag::abc);
+
+        dnnl::primitive_attr attr;
+        attr.set_scratchpad_mode(dnnl::scratchpad_mode::user);
+        // per-expert (dim0) + grouped along K (dim1) + per-N (dim2): mask 0b111, group {group,1}
+        attr.set_scales(DNNL_ARG_WEIGHTS,      (1 << 0) | (1 << 1) | (1 << 2), {group, 1}, dt::f16);
+        attr.set_zero_points(DNNL_ARG_WEIGHTS, (1 << 0) | (1 << 1) | (1 << 2), {group, 1}, dt::u4);
+        attr.set_fpmath_mode(dnnl::fpmath_mode::f16, true);
+
+        auto src_mem = dnnl::memory(src_md, eng, std::vector<void *>{ (void *) act, (void *) offsets });
+        auto wei_mem = dnnl::memory(wei_md, eng, const_cast<uint8_t *>(w));
+        auto dst_mem = dnnl::memory(dst_md, eng, std::vector<void *>{ (void *) dst, (void *) offsets });
+        auto sc_mem  = dnnl::memory(sc_md,  eng, const_cast<sycl::half *>(w_sc));
+        auto zp_mem  = dnnl::memory(zp_md,  eng, const_cast<uint8_t *>(w_zp));
+
+        auto pd = dnnl::matmul::primitive_desc(eng, src_md, wei_md, dst_md, attr);
+        { static int _pn = 0;
+          if (_pn < 2) { ++_pn;
+              fprintf(stderr, "[MOE_DNN] grouped impl = %s  (M=%ld N=%d K=%d experts=%d)\n",
+                      pd.impl_info_str(), (long) total_rows, N, K, n_experts); } }
+        auto scratchpad_mem = ctx.get_scratchpad_mem(pd.scratchpad_desc(), eng, q);
+        auto prim = dnnl::matmul(pd);
+
+        std::unordered_map<int, dnnl::memory> args;
+        args.insert({ DNNL_ARG_SRC, src_mem });
+        args.insert({ DNNL_ARG_WEIGHTS, wei_mem });
+        args.insert({ DNNL_ARG_DST, dst_mem });
+        args.insert({ DNNL_ARG_SCRATCHPAD, scratchpad_mem });
+        args.insert({ DNNL_ARG_ATTR_SCALES | DNNL_ARG_WEIGHTS, sc_mem });
+        args.insert({ DNNL_ARG_ATTR_ZERO_POINTS | DNNL_ARG_WEIGHTS, zp_mem });
