+int llama_context::dflash_decode_inject(const llama_batch & batch) {
+    GGML_ASSERT(cparams.dflash_features_dev && "the target features are not on the device");
+
+    // after the target batch has written the features
+    features_wait(*cparams.ctx_other);
+
+    cparams.dflash_inject_rows = true;
+    const int ret = decode(batch);
+    cparams.dflash_inject_rows = false;
+
+    features_record();
+
+    return ret;
+}
+
+void llama_context::features_wait(llama_context & other) {
+    if (backend_features && other.ev_features) {
+        ggml_backend_event_wait(backend_features, other.ev_features.get());
+    } else {
+        other.synchronize();
+    }
+}
+
+void llama_context::features_record() {
+    if (ev_features) {
+        ggml_backend_event_record(ev_features.get(), backend_features);
+    }
+}
