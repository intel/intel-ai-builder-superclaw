+    if constexpr (NL) {
+        d = (float) reinterpret_cast<const sycl::half *>(h)[b];
+    } else {
+        const uint8_t * hb = h + i * 8;   // d | scales_h | scales_l x 4
+        const int       sh = hb[2] | (hb[3] << 8);
+        const int       ls = ((hb[4 + ib / 2] >> 4 * (ib % 2)) & 0xf) | (((sh >> 2 * ib) & 3) << 4);
