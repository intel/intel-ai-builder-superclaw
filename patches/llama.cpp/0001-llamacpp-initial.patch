diff --git a/src/llama-moe-directstorage.cpp b/src/llama-moe-directstorage.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..da92f88fac623e48e1ec51cd0c0e72a0b2483388
--- /dev/null
+++ b/src/llama-moe-directstorage.cpp
@@ -0,0 +1,173 @@
+#include "llama-moe-directstorage.h"
+
+#ifdef LLAMA_MOE_DIRECTSTORAGE
+
+#include <unordered_map>
+
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#include <windows.h>
+#include <dstorage.h>
+
+static std::wstring llama_moe_ds_to_wide(const std::string & s) {
+    if (s.empty()) {
+        return std::wstring();
+    }
+    int n = MultiByteToWideChar(CP_UTF8, 0, s.data(), (int) s.size(), nullptr, 0);
+    std::wstring w((size_t) n, L'\0');
+    MultiByteToWideChar(CP_UTF8, 0, s.data(), (int) s.size(), &w[0], n);
+    return w;
+}
+
+static void llama_moe_ds_fill_queue_desc(DSTORAGE_QUEUE_DESC & desc, const char * name) {
+    desc = {};
+    desc.SourceType = DSTORAGE_REQUEST_SOURCE_FILE;
+    desc.Capacity   = DSTORAGE_MAX_QUEUE_CAPACITY;
+    desc.Priority   = DSTORAGE_PRIORITY_HIGH;
+    desc.Name       = name;
+    desc.Device     = nullptr; // memory destination: no D3D12 device needed
+}
+
+struct llama_moe_ds_reader::impl {
+    IDStorageFactory     * factory = nullptr;
+    IDStorageQueue       * queue   = nullptr;
+    IDStorageStatusArray * status  = nullptr;
+    long                   last_hr = 0;
+    std::unordered_map<std::string, IDStorageFile *> files;
+
+    IDStorageFile * get_file(const std::string & path) {
+        auto it = files.find(path);
+        if (it != files.end()) {
+            return it->second;
+        }
+        IDStorageFile * file = nullptr;
+        const std::wstring wpath = llama_moe_ds_to_wide(path);
+        HRESULT hr = factory->OpenFile(wpath.c_str(), IID_PPV_ARGS(&file));
+        if (FAILED(hr) || file == nullptr) {
+            if (file) {
+                file->Release();
+                file = nullptr;
+            }
+        }
+        files[path] = file;
+        return file;
+    }
+
+    ~impl() {
+        for (auto & kv : files) {
+            if (kv.second) {
+                kv.second->Release();
+            }
+        }
+        if (status) {
+            status->Release();
+        }
+        if (queue) {
+            queue->Release();
+        }
+        if (factory) {
+            factory->Release();
+        }
+    }
+};
+
+llama_moe_ds_reader::llama_moe_ds_reader() : pimpl(new impl()) {
+    HRESULT hr = DStorageGetFactory(IID_PPV_ARGS(&pimpl->factory));
+    if (FAILED(hr) || pimpl->factory == nullptr) {
+        return;
+    }
+
+    DSTORAGE_QUEUE_DESC desc;
+    llama_moe_ds_fill_queue_desc(desc, "llama-moe-ds");
+
+    hr = pimpl->factory->CreateQueue(&desc, IID_PPV_ARGS(&pimpl->queue));
+    if (FAILED(hr) || pimpl->queue == nullptr) {
+        return;
+    }
+
+    hr = pimpl->factory->CreateStatusArray(n_slots, nullptr, IID_PPV_ARGS(&pimpl->status));
+    if (FAILED(hr) || pimpl->status == nullptr) {
+        return;
+    }
+}
+
+llama_moe_ds_reader::~llama_moe_ds_reader() = default;
+
+bool llama_moe_ds_reader::ok() const {
+    return pimpl->factory != nullptr && pimpl->queue != nullptr && pimpl->status != nullptr;
+}
+
+bool llama_moe_ds_reader::available() {
+    IDStorageFactory * factory = nullptr;
+    HRESULT hr = DStorageGetFactory(IID_PPV_ARGS(&factory));
+    if (FAILED(hr) || factory == nullptr) {
+        return false;
+    }
+
+    DSTORAGE_QUEUE_DESC desc;
+    llama_moe_ds_fill_queue_desc(desc, "llama-moe-ds-probe");
+
+    IDStorageQueue * queue = nullptr;
+    hr = factory->CreateQueue(&desc, IID_PPV_ARGS(&queue));
+    const bool ok = SUCCEEDED(hr) && queue != nullptr;
+    if (queue) {
+        queue->Release();
+    }
+    factory->Release();
+    return ok;
+}
+
+bool llama_moe_ds_reader::enqueue(void * dst, const std::string & path, uint64_t file_offset, uint32_t size) {
+    if (!ok()) {
+        return false;
+    }
+    IDStorageFile * file = pimpl->get_file(path);
+    if (file == nullptr) {
+        return false;
+    }
+
+    DSTORAGE_REQUEST req = {};
+    req.Options.SourceType        = DSTORAGE_REQUEST_SOURCE_FILE;
+    req.Options.DestinationType   = DSTORAGE_REQUEST_DESTINATION_MEMORY;
+    req.Options.CompressionFormat = DSTORAGE_COMPRESSION_FORMAT_NONE;
+    req.Source.File.Source        = file;
+    req.Source.File.Offset        = file_offset;
+    req.Source.File.Size          = size;
+    req.Destination.Memory.Buffer = dst;
+    req.Destination.Memory.Size   = size;
+    req.UncompressedSize          = size;
+
+    pimpl->queue->EnqueueRequest(&req);
+    return true;
+}
+
+bool llama_moe_ds_reader::submit_and_wait() {
+    return submit(0) && wait(0);
+}
+
+bool llama_moe_ds_reader::submit(uint32_t slot) {
+    if (!ok() || slot >= n_slots) {
+        return false;
+    }
+    pimpl->queue->EnqueueStatus(pimpl->status, slot);
+    pimpl->queue->Submit();
+    return true;
+}
+
+bool llama_moe_ds_reader::wait(uint32_t slot) {
+    if (!ok() || slot >= n_slots) {
+        return false;
+    }
+    while (!pimpl->status->IsComplete(slot)) {
+        YieldProcessor();
+    }
+    const HRESULT hr = pimpl->status->GetHResult(slot);
+    pimpl->last_hr = (long) hr;
+    return SUCCEEDED(hr);
+}
+
+long llama_moe_ds_reader::last_hresult() const {
+    return pimpl->last_hr;
+}
+
+#endif // LLAMA_MOE_DIRECTSTORAGE
diff --git a/src/llama-moe-directstorage.h b/src/llama-moe-directstorage.h
new file mode 100644
index 0000000000000000000000000000000000000000..e58c768e77a3c302395afab4902faa819307541d
--- /dev/null
+++ b/src/llama-moe-directstorage.h
@@ -0,0 +1,58 @@
+#pragma once
+
+#ifdef LLAMA_MOE_DIRECTSTORAGE
+
+#include <cstdint>
+#include <memory>
+#include <string>
+
+// DirectStorage-backed reader for MoE expert slots. Reads expert bytes straight
+// from the GGUF file into host-visible Vulkan slot memory, bypassing the mmap
+// staging copy. See docs/moe-offload/2026-07-30-phase5-directstorage-plan.md.
+//
+// Uses a single file-source / memory-destination queue with an
+// IDStorageStatusArray for completion, so no ID3D12Device or ID3D12Fence is
+// required. This mirrors the proven OpenVINO MoE OTD reader.
+struct llama_moe_ds_reader {
+    llama_moe_ds_reader();
+    ~llama_moe_ds_reader();
+
+    llama_moe_ds_reader(const llama_moe_ds_reader &) = delete;
+    llama_moe_ds_reader & operator=(const llama_moe_ds_reader &) = delete;
+
+    // Capability probe: true if a DirectStorage factory and a memory-destination
+    // queue can be created on this system. Callers use this to decide whether to
+    // engage DirectStorage or fall back to the mmap path.
+    static bool available();
+
+    // True if this instance created its factory, queue and event successfully.
+    bool ok() const;
+
+    // Enqueue a read of `size` bytes from `path` at `file_offset` into `dst`.
+    // Files are opened once and cached. Returns false if the file cannot be
+    // opened or the reader is not usable.
+    bool enqueue(void * dst, const std::string & path, uint64_t file_offset, uint32_t size);
+
+    // Submit all enqueued reads and block until they complete. Returns false on
+    // a DirectStorage error.
+    bool submit_and_wait();
+
+    // Async double-buffer path. submit() associates all requests enqueued since
+    // the previous submit() with completion `slot` and kicks them off without
+    // blocking; wait() blocks until that slot's reads finish. Slots are
+    // independent (one per ping-pong buffer). Returns false on error.
+    bool submit(uint32_t slot);
+    bool wait(uint32_t slot);
+
+    // Number of independent completion slots (ping-pong buffers).
+    static constexpr uint32_t n_slots = 2;
+
+    // HRESULT of the most recent wait(); 0 (S_OK) on success. For diagnostics.
+    long last_hresult() const;
+
+private:
+    struct impl;
+    std::unique_ptr<impl> pimpl;
+};
+
+#endif // LLAMA_MOE_DIRECTSTORAGE
