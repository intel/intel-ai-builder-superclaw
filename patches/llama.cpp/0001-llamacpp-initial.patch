+// allocator whose resize() leaves the new elements uninitialized, for large buffers that are about to be overwritten
+template <typename T>
+struct common_uninit_allocator : std::allocator<T> {
+    template <typename U> struct rebind { using other = common_uninit_allocator<U>; };
+
+    common_uninit_allocator() noexcept = default;
+    template <typename U> common_uninit_allocator(const common_uninit_allocator<U> &) noexcept {}
+
+    template <typename U> void construct(U * p) noexcept { ::new (static_cast<void *>(p)) U; }
+    template <typename U, typename... Args> void construct(U * p, Args &&... args) {
+        ::new (static_cast<void *>(p)) U(std::forward<Args>(args)...);
+    }
+};
+
 struct common_prompt_checkpoint {
     int64_t n_tokens;
 
@@ -1171,8 +1186,10 @@ struct common_prompt_checkpoint {
     llama_pos pos_min;
     llama_pos pos_max;
 
-    std::vector<uint8_t> data_tgt;
-    std::vector<uint8_t> data_dft;
+    // with LLAMA_STATE_SEQ_FLAGS_ASYNC the state copies fill these after the update returns, so they are not
+    // zero-filled first (that alone takes longer than the copy)
+    std::vector<uint8_t, common_uninit_allocator<uint8_t>> data_tgt;
+    std::vector<uint8_t, common_uninit_allocator<uint8_t>> data_dft;
 
     // (optional) speculative-decoding implementation state stashed with the checkpoint
     // (e.g. eagle3's deferred-boundary g_embd row)
