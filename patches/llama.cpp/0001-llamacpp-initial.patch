+
+// fused conv-state prepend + conv: x is channel-contiguous [d_inner, n_t, n_s] (the
+// projection output, no transpose), the first d_conv-1 taps come from state, and the
+// output stays channel-contiguous. src reads/dst writes coalesce over the channel axis,
+// so no transpose/tiling is needed (unlike ggml_sycl_ssm_conv above).
+// Token-blocked form of the state conv: one work-item owns TT consecutive tokens of
+// one channel. The per-token kernel below reads every x element once per tap (d_conv
+// times) and reloads the channel's filter for every token, which leaves it waiting on
+// memory (VTune: ALU0 18%, SBID 34%) even though it is only d_conv fmas per output.
+// Holding the tap window in registers brings that down to (TT + d_conv - 1) x loads
+// and d_conv filter loads per TT outputs. The fused l2 reduction keeps the shape of
+// the per-token tree - all TT trees advance together over the same barriers - so the
+// result is bit-identical to the scalar path.
+template <int TT, int DC>
+static void kernel_ssm_conv_state_tt(
+    queue &q,
+    const float *x,
+    const float *weights,
+    const float *state,
+    float *dst_data,
+    int d_inner,
+    int n_t,
+    int n_s,
+    int64_t x_nb1,  int64_t x_nb2,
+    int64_t st_nb1, int64_t st_nb2,
+    int64_t d_nb1,  int64_t d_nb2,
+    bool silu,
+    int qk2_dim, int head_dim, float l2_eps
+) {
+    const int      block = SSM_CONV_TILE_C * SSM_CONV_TILE_T;   // 256 threads, channel-major
+    const int      nblk  = (d_inner + block - 1) / block;
+    const int      tblk  = (n_t + TT - 1) / TT;
+    const range<3> global_range(n_s, tblk, nblk * block);
+    const range<3> local_range(1, 1, block);
+
+    q.submit([&](handler &h) {
+        local_accessor<float, 1> ssum(range<1>(qk2_dim > 0 ? block * TT : 1), h);
+
+        h.parallel_for(nd_range<3>(global_range, local_range), [=](nd_item<3> item) {
+            const int i3 = item.get_group(0);            // sequence
+            const int t0 = (int) item.get_group(1) * TT; // first token of the block
+            const int ch = item.get_global_id(2);        // channel (fastest, contiguous)
+            const int lc = item.get_local_id(2);
+            // qk work-groups are always fully in range (2*qk_dim is block-aligned),
+            // so the barriers below stay uniform; the d_inner tail can only fall in
+            // the plain path
+            const bool qk_wg = ch - lc + block <= qk2_dim;
+            if (!qk_wg && ch >= d_inner) {
+                return;
+            }
+
+            float w[DC];
+#pragma unroll
+            for (int i0 = 0; i0 < DC; i0++) {
+                w[i0] = weights[(size_t) ch * DC + i0];
+            }
+
+            // tap window: xv[i] is token t0 - (DC-1) + i, so token t0+tt convolves
+            // xv[tt .. tt+DC-1]. Tokens before 0 come from the carried state and
+            // tokens past the end are zero, which also keeps them out of the l2 sum.
+            float xv[TT + DC - 1];
+#pragma unroll
+            for (int i = 0; i < TT + DC - 1; i++) {
+                const int t = t0 - (DC - 1) + i;
+                if (t < 0) {
+                    xv[i] = state[(size_t) ((DC - 1) + t) + (size_t) ch * st_nb1 +
+                                  (size_t) i3 * st_nb2];
+                } else if (t < n_t) {
+                    xv[i] = x[(size_t) ch + (size_t) t * x_nb1 + (size_t) i3 * x_nb2];
+                } else {
+                    xv[i] = 0.0f;
+                }
+            }
+
+            float out[TT];
+#pragma unroll
+            for (int tt = 0; tt < TT; tt++) {
+                float sumf = 0.0f;
+#pragma unroll
+                for (int i0 = 0; i0 < DC; i0++) {
+                    sumf += xv[tt + i0] * w[i0];
+                }
+                if (silu) {
+                    sumf = sumf / (1.0f + sycl::exp(-sumf));
+                }
+                out[tt] = sumf;
+            }
+
+            if (qk_wg) {
+                // per-head sum of squares, one tree per token, all sharing the barriers
+#pragma unroll
+                for (int tt = 0; tt < TT; tt++) {
+                    ssum[tt * block + lc] = out[tt] * out[tt];
+                }
+                for (int s = head_dim / 2; s > 0; s >>= 1) {
+                    item.barrier(sycl::access::fence_space::local_space);
+                    if (lc % head_dim < s) {
+#pragma unroll
+                        for (int tt = 0; tt < TT; tt++) {
+                            ssum[tt * block + lc] += ssum[tt * block + lc + s];
+                        }
+                    }
+                }
+                item.barrier(sycl::access::fence_space::local_space);
+                const int base = lc - lc % head_dim;
+#pragma unroll
+                for (int tt = 0; tt < TT; tt++) {
+                    const float sum = ssum[tt * block + base];
+                    out[tt] *= sycl::rsqrt(sycl::fmax(sum, l2_eps * l2_eps));
+                }
+            }
+
+#pragma unroll
+            for (int tt = 0; tt < TT; tt++) {
+                const int t = t0 + tt;
+                if (t < n_t) {
+                    dst_data[(size_t) ch + (size_t) t * d_nb1 + (size_t) i3 * d_nb2] = out[tt];
+                }
+            }
+        });
+    });
+}
+
+static void kernel_ssm_conv_state(
+    queue &q,
+    const float *x,
+    const float *weights,
+    const float *state,
+    float *dst_data,
+    int d_conv,
+    int d_inner,
+    int n_t,
+    int n_s,
+    int64_t x_nb1,  int64_t x_nb2,
+    int64_t st_nb1, int64_t st_nb2,
+    int64_t d_nb1,  int64_t d_nb2,
+    bool silu,
+    // optional fused per-head l2 norm of the leading 2*qk_dim channels (the q|k
+    // slices, heads of head_dim): the normalized values land in the same dst slots,
+    // matching in-place L2_NORM nodes on the q/k views. Requires 2*qk_dim
+    // block-aligned so a work-group never straddles the qk/v boundary and heads
+    // never straddle a work-group.
+    int qk2_dim = 0, int head_dim = 0, float l2_eps = 0.0f
+) {
+    const int    block   = SSM_CONV_TILE_C * SSM_CONV_TILE_T; // 256 threads, channel-major
+    const int    nblk    = (d_inner + block - 1) / block;
+    const range<3> global_range(n_s, n_t, nblk * block);
+    const range<3> local_range(1, 1, block);
+
+    q.submit([&](handler &h) {
+        local_accessor<float, 1> ssum(range<1>(qk2_dim > 0 ? block : 1), h);
+
+        h.parallel_for(nd_range<3>(global_range, local_range), [=](nd_item<3> item) {
+            const int i3 = item.get_group(0);            // sequence
+            const int i2 = item.get_group(1);            // token
+            const int ch = item.get_global_id(2);        // channel (fastest, contiguous)
+            const int lc = item.get_local_id(2);
+            // qk work-groups are always fully in range (2*qk_dim is block-aligned),
+            // so the barriers below stay uniform; the d_inner tail can only fall in
+            // the plain path
+            const bool qk_wg = ch - lc + block <= qk2_dim;
+            if (!qk_wg && ch >= d_inner) {
+                return;
+            }
+            const float * cw = weights + (size_t) ch * d_conv;
+            float sumf = 0.0f;
+            for (int i0 = 0; i0 < d_conv; ++i0) {
+                const int t = i2 + i0 - (d_conv - 1);    // causal source token; <0 -> from state
+                float v;
+                if (t < 0) {
+                    v = state[(size_t) ((d_conv - 1) + t) + (size_t) ch * st_nb1 + (size_t) i3 * st_nb2];
+                } else {
+                    v = x[(size_t) ch + (size_t) t * x_nb1 + (size_t) i3 * x_nb2];
+                }
+                sumf += v * cw[i0];
+            }
+            if (silu) {
+                sumf = sumf / (1.0f + sycl::exp(-sumf));
+            }
+            if (qk_wg) {
+                // per-head sum of squares: tree reduction over each head_dim segment
+                ssum[lc] = sumf * sumf;
+                for (int s = head_dim / 2; s > 0; s >>= 1) {
+                    item.barrier(sycl::access::fence_space::local_space);
+                    if (lc % head_dim < s) {
+                        ssum[lc] += ssum[lc + s];
+                    }
+                }
+                item.barrier(sycl::access::fence_space::local_space);
+                const float sum = ssum[lc - lc % head_dim];
+                sumf *= sycl::rsqrt(sycl::fmax(sum, l2_eps * l2_eps));
+            }
+            dst_data[(size_t) ch + (size_t) i2 * d_nb1 + (size_t) i3 * d_nb2] = sumf;
+        });
+    });
+}
+
+inline void ggml_sycl_op_ssm_conv_state(ggml_backend_sycl_context & ctx, ggml_tensor * dst,
+                                        float * dst_data, const bool silu,
+                                        int qk2_dim = 0, int head_dim = 0, float l2_eps = 0.0f) {
+    ggml_tensor * src0 = dst->src[0]; // x     {d_inner, n_t, n_s}
+    ggml_tensor * src1 = dst->src[1]; // weight {d_conv, d_inner}
+    ggml_tensor * src2 = dst->src[2]; // state {d_conv - 1, d_inner, n_s}
+
+    GGML_ASSERT(src0->type == GGML_TYPE_F32);
+    GGML_ASSERT(src1->type == GGML_TYPE_F32);
+    GGML_ASSERT(src2->type == GGML_TYPE_F32);
+    GGML_ASSERT(dst->type  == GGML_TYPE_F32);
+
+    const int d_conv  = src1->ne[0];
+    const int d_inner = src0->ne[0];
+    const int n_t     = dst->ne[1];
+    const int n_s     = dst->ne[2];
+
+    GGML_ASSERT(dst->ne[0]  == d_inner);
+    GGML_ASSERT(src1->ne[1] == d_inner);
+    GGML_ASSERT(src2->ne[0] == d_conv - 1);
+    GGML_ASSERT(src2->ne[1] == d_inner);
+    GGML_ASSERT(src0->nb[0] == sizeof(float));
+    GGML_ASSERT(src1->nb[0] == sizeof(float));
+    GGML_ASSERT(src2->nb[0] == sizeof(float));
+
+    const int64_t x_nb1  = src0->nb[1] / sizeof(float), x_nb2  = src0->nb[2] / sizeof(float);
+    const int64_t st_nb1 = src2->nb[1] / sizeof(float), st_nb2 = src2->nb[2] / sizeof(float);
+    const int64_t d_nb1  = dst->nb[1]  / sizeof(float), d_nb2  = dst->nb[2]  / sizeof(float);
+
+    try {
+        queue *q = ctx.stream();
+        if (d_conv == 4 && n_t >= SSM_CONV_STATE_TT) {
+            kernel_ssm_conv_state_tt<SSM_CONV_STATE_TT, 4>(
+                *q,
+                static_cast<const float *>(src0->data),
+                static_cast<const float *>(src1->data),
+                static_cast<const float *>(src2->data),
+                dst_data,
+                d_inner, n_t, n_s,
+                x_nb1, x_nb2, st_nb1, st_nb2, d_nb1, d_nb2, silu,
+                qk2_dim, head_dim, l2_eps);
+        } else {
+            kernel_ssm_conv_state(
+                *q,
+                static_cast<const float *>(src0->data),
+                static_cast<const float *>(src1->data),
+                static_cast<const float *>(src2->data),
+                dst_data,
+                d_conv, d_inner, n_t, n_s,
+                x_nb1, x_nb2, st_nb1, st_nb2, d_nb1, d_nb2, silu,
+                qk2_dim, head_dim, l2_eps);
+        }
+    } catch (const std::exception &e) {
+        std::fprintf(stderr, "[SYCL-SSM_CONV_STATE] ERROR: %s\n", e.what());
+        throw;
+    }
+}
+
+void ggml_sycl_ssm_conv_state(ggml_backend_sycl_context & ctx, ggml_tensor * dst) {
+    scope_op_debug_print scope_dbg_print(__func__, dst, /*num_src=*/3);
+    ggml_sycl_op_ssm_conv_state(ctx, dst, static_cast<float *>(dst->data), /*silu=*/false);
+}
+
+// fused conv + silu: computes the conv node but applies silu and writes into the
+// following UNARY(SILU) node's tensor (the conv node's own tensor is left unwritten)
+void ggml_sycl_ssm_conv_state_silu(ggml_backend_sycl_context & ctx, ggml_tensor * conv, ggml_tensor * out) {
+    scope_op_debug_print scope_dbg_print(__func__, conv, /*num_src=*/3);
+    ggml_sycl_op_ssm_conv_state(ctx, conv, static_cast<float *>(out->data), /*silu=*/true);
+}
+
+// fused conv + silu + per-head l2 norm of the q/k slices: the leading qk2_dim channels
+// are normalized per head_dim group before landing in the silu tensor, matching the
+// in-place L2_NORM nodes on the q/k views (which are then skipped)
+void ggml_sycl_ssm_conv_state_silu_l2(ggml_backend_sycl_context & ctx, ggml_tensor * conv, ggml_tensor * out,
+                                      ggml_tensor * l2q, int qk2_dim, int head_dim) {
+    scope_op_debug_print scope_dbg_print(__func__, conv, /*num_src=*/3);
+    float l2_eps;
+    memcpy(&l2_eps, l2q->op_params, sizeof(float));
+    ggml_sycl_op_ssm_conv_state(ctx, conv, static_cast<float *>(out->data), /*silu=*/true,
+                                qk2_dim, head_dim, l2_eps);
+}
