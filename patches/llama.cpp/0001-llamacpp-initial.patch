@@ -0,0 +1,21 @@
+#pragma once
+
+#include "common.hpp"
+
+// Single-launch grouped Q4_K GEMM for the mul_mat_id (MoE expert FFN) prefill path.
+// Replaces the per-expert loop of 256 small GEMMs with one kernel: each work-group computes a
+// 16x16 (token x column) output tile for one expert, tiling K through local memory so the
+// dequantized expert weight is reused across the token tile (L2 catches the cross-tile re-reads).
+//
+//   src0            : Q4_K expert weights, contiguous [K, N, n_experts]
+//   src1_contiguous : f32 activations already gathered/sorted by expert, [K, n_routed_rows]
+//   dst_contiguous  : f32 output, [N, n_routed_rows] (scattered back to dst by the caller)
+//   tiles           : device array of int4 {r0, n0, expert, r_cnt} enumerated on the host
+void ggml_sycl_moe_grouped_q4_K(
+    ggml_backend_sycl_context & ctx,
+    const void * src0, const float * src1_contiguous, float * dst_contiguous,
+    const int32_t * tiles, int num_tiles, int K, int N);
+
+static constexpr int MOE_GROUPED_TM = 16; // tokens per tile
+static constexpr int MOE_GROUPED_TN = 16; // columns per tile
+static constexpr int MOE_GROUPED_TK = 32; // K per step (one Q4_K sub-block)
