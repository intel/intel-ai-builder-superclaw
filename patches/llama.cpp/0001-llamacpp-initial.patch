+// the delta-net gate and beta of nt tokens from f32 [K, nr] weights (unsloth keeps ssm_alpha / ssm_beta f32): one
+// 256-thread work-group per (token, projection, row), as the few-row path of mul_mat_vec_f32_sycl, with the epilogues of
+// ggml_sycl_mul_mat_vec_q_gdn_gate_beta; x holds nt rows of K (row stride ldx), gate and beta are [nt][nr]
+static void gdn_gate_beta_f32_sycl(const float * wa, const float * wb, const float * x, const int64_t ldx,
+                                   const float * dt, const float * a, float * gate, float * beta, const int K,
+                                   const int nr, const int nt, queue_ptr stream) {
+    stream->parallel_for(
+        sycl::nd_range<1>(sycl::range<1>((size_t) 2 * nr * nt * 256), sycl::range<1>(256)),
+        [=](sycl::nd_item<1> it) {
+            const int     g   = it.get_group(0);
+            const int     c   = g / (2 * nr);   // the token
+            const int     r   = g % (2 * nr);
+            const bool    isb = r >= nr;
+            const int     row = isb ? r - nr : r;
+            const float * wr  = (isb ? wb : wa) + (size_t) row * K;
+            const float * xr  = x + (size_t) c * ldx;
+            float         acc = 0.0f;
+            for (int k = (int) it.get_local_id(0) * 4; k + 3 < K; k += 256 * 4) {
+                const sycl::float4 wv = *reinterpret_cast<const sycl::float4 *>(wr + k);
+                const sycl::float4 xv = *reinterpret_cast<const sycl::float4 *>(xr + k);
+                acc += wv[0] * xv[0] + wv[1] * xv[1] + wv[2] * xv[2] + wv[3] * xv[3];
+            }
+            acc = sycl::reduce_over_group(it.get_group(), acc, sycl::plus<float>());
+            if (it.get_local_id(0) == 0) {
+                if (isb) {
+                    beta[c * nr + row] = op_sigmoid(acc);
+                } else {
+                    gate[c * nr + row] = op_softplus(acc + dt[row]) * a[row];
+                }
+            }
+        });
+}
