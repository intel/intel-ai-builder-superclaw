+static void k_moe_gather_quant_s8(const char * x, int8_t * q, float * scales,
+                                  const mmid_row_mapping * map, const int64_t ne11,
+                                  const size_t nb11, const size_t nb12,
+                                  const int64_t k, const int64_t n_rows,
+                                  queue_ptr stream) {
+    constexpr int wg  = 256;
+    constexpr int epl = 64 / WARP_SIZE;   // group elements per lane
+    const int64_t ngroups = k / 64;
+    const int64_t total   = n_rows * ngroups;
+    const int64_t n_wg    = (total + wg / WARP_SIZE - 1) / (wg / WARP_SIZE);
+    stream->parallel_for(
+        sycl::nd_range<1>(sycl::range<1>(n_wg * wg), sycl::range<1>(wg)),
+        [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+            auto sg = it.get_sub_group();
+            const int64_t gid = it.get_group(0) * (wg / WARP_SIZE) + sg.get_group_id()[0];
+            if (gid >= total) {
+                return;
+            }
+            const int64_t row = gid / ngroups;
+            const int64_t g   = gid % ngroups;
+            const int64_t i11 = map[row].i1 % ne11;
+            const int64_t i12 = map[row].i2;
+            const float * src = (const float *) (x + i11 * nb11 + i12 * nb12) + g * 64;
+            const int lane = sg.get_local_id()[0];
+            float v[epl];
+            float amax = 0.0f;
+            for (int i = 0; i < epl; ++i) {
+                v[i] = src[lane * epl + i];
+                amax = sycl::fmax(amax, sycl::fabs(v[i]));
+            }
+            amax = sycl::reduce_over_group(sg, amax, sycl::maximum<float>());
+            const float inv = amax > 0.0f ? 127.0f / amax : 0.0f;
+            int8_t * qd = q + row * k + g * 64 + lane * epl;
+            for (int i = 0; i < epl; ++i) {
+                qd[i] = (int8_t) sycl::clamp(sycl::round(v[i] * inv), -127.0f, 127.0f);
+            }
+            if (lane == 0) {
+                scales[row * ngroups + g] = amax / 127.0f;
+            }
+        });
+}
+
+// silu(gate) * up over the fused gate_up gemm output, quantized straight to grouped
+// s8 for the W4A8 down gemm (same sub-group-per-64-group scheme and scale layout as
+// k_moe_gather_quant_s8)
+static void k_moe_swiglu_quant_s8(const sycl::half * gu, int8_t * q, float * scales,
+                                  const int64_t n_ff, const int64_t n_rows,
+                                  queue_ptr stream) {
+    constexpr int wg  = 256;
+    constexpr int epl = 64 / WARP_SIZE;   // group elements per lane
+    const int64_t ngroups = n_ff / 64;
+    const int64_t total   = n_rows * ngroups;
+    const int64_t n_wg    = (total + wg / WARP_SIZE - 1) / (wg / WARP_SIZE);
+    stream->parallel_for(
+        sycl::nd_range<1>(sycl::range<1>(n_wg * wg), sycl::range<1>(wg)),
+        [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+            auto sg = it.get_sub_group();
+            const int64_t gid = it.get_group(0) * (wg / WARP_SIZE) + sg.get_group_id()[0];
+            if (gid >= total) {
+                return;
+            }
+            const int64_t row = gid / ngroups;
+            const int64_t g   = gid % ngroups;
+            const sycl::half * gr = gu + row * 2 * n_ff + g * 64;
+            const int lane = sg.get_local_id()[0];
+            float v[epl];
+            float amax = 0.0f;
+            for (int i = 0; i < epl; ++i) {
+                const float xg = (float) gr[lane * epl + i];
+                v[i] = xg / (1.0f + sycl::exp(-xg)) * (float) gr[n_ff + lane * epl + i];
+                amax = sycl::fmax(amax, sycl::fabs(v[i]));
+            }
+            amax = sycl::reduce_over_group(sg, amax, sycl::maximum<float>());
+            const float inv = amax > 0.0f ? 127.0f / amax : 0.0f;
+            int8_t * qd = q + row * n_ff + g * 64 + lane * epl;
+            for (int i = 0; i < epl; ++i) {
+                qd[i] = (int8_t) sycl::clamp(sycl::round(v[i] * inv), -127.0f, 127.0f);
+            }
+            if (lane == 0) {
+                scales[row * ngroups + g] = amax / 127.0f;
+            }
+        });
+}
+
+// Per-group s8 quantization of the src1 rows, once per row instead of once per routed row:
+// topk routed rows share a row, so quantizing during the gather reads src1 topk times.
+// Emits q [nx, k], scales/sums [nx, k/64].
+static void k_moe_quant_rows(const char * x, int8_t * q, float * scales, int32_t * sums,
+                             const int64_t ne11, const size_t nb11, const size_t nb12,
+                             const int64_t k, const int64_t nx, queue_ptr stream) {
+    constexpr int wg  = 256;
+    constexpr int epl = 64 / WARP_SIZE;
+    const int64_t ngroups = k / 64;
+    const int64_t total   = nx * ngroups;
+    const int64_t n_wg    = (total + wg / WARP_SIZE - 1) / (wg / WARP_SIZE);
+    stream->parallel_for(
+        sycl::nd_range<1>(sycl::range<1>(n_wg * wg), sycl::range<1>(wg)),
+        [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+            auto sg = it.get_sub_group();
+            const int64_t gid = it.get_group(0) * (wg / WARP_SIZE) + sg.get_group_id()[0];
+            if (gid >= total) {
+                return;
+            }
+            const int64_t row = gid / ngroups;
+            const int64_t g   = gid % ngroups;
+            const float * src = (const float *) (x + (row % ne11) * nb11 + (row / ne11) * nb12) + g * 64;
+            const int lane = sg.get_local_id()[0];
+            float v[epl];
+            float amax = 0.0f;
+            for (int i = 0; i < epl; ++i) {
+                v[i] = src[lane * epl + i];
+                amax = sycl::fmax(amax, sycl::fabs(v[i]));
+            }
+            amax = sycl::reduce_over_group(sg, amax, sycl::maximum<float>());
+            const float inv = amax > 0.0f ? 127.0f / amax : 0.0f;
+            int8_t * qd = q + row * k + g * 64 + lane * epl;
+            int32_t lsum = 0;
+            for (int i = 0; i < epl; ++i) {
+                const int8_t qv = (int8_t) sycl::clamp(sycl::round(v[i] * inv), -127.0f, 127.0f);
+                qd[i] = qv;
+                lsum += qv;
+            }
+            lsum = sycl::reduce_over_group(sg, lsum, sycl::plus<int32_t>());
+            if (lane == 0) {
+                scales[row * ngroups + g] = amax / 127.0f;
+                sums[row * ngroups + g]   = lsum;
+            }
+        });
+}
+
+// Zero the scales of the rows each expert pads its range with, so the gemm epilogue reads
+// no garbage exponents on rows whose result is dropped (at most 7 rows per expert).
+static void k_moe_zero_pad_scales(float * sc1, int32_t * sum1, float * sc2, int32_t * sum2,
+                                  const int32_t * offs, const int32_t * pbeg, const int64_t n_as,
+                                  const int64_t kg1, const int64_t kg2, const int64_t P,
+                                  queue_ptr stream) {
+    const int64_t kg = std::max(kg1, kg2);
+    stream->parallel_for(sycl::range<1>((size_t) n_as * 7 * kg), [=](sycl::id<1> id) {
+        const int64_t i = id[0];
+        const int64_t g = i % kg;
+        const int64_t j = (i / kg) % 7;
+        const int64_t e = i / (kg * 7);
+        const int64_t R = offs[e] - (e > 0 ? offs[e - 1] : 0);
+        if (j >= (8 - R % 8) % 8) {
+            return;
+        }
+        const int64_t pr = pbeg[e] + R + j;
+        if (g < kg1) {
+            sc1[g * P + pr]  = 0.0f;
+            sum1[g * P + pr] = 0;
+        }
+        if (g < kg2) {
+            sc2[g * P + pr]  = 0.0f;
+            sum2[g * P + pr] = 0;
+        }
+    });
+}
+
+// Expand the quantized rows into the routed order as dpas A tiles: [row/8][k/32] blocks of
+// 256 B (8 rows x 32 k), each expert starting at the row block prow[] gives. Rows run
+// fastest so a work-group fills whole tiles.
+static void k_moe_expand_pk(const int8_t * q, const float * scales, const int32_t * sums,
+                            int8_t * qp, float * scp, int32_t * sup,
+                            const mmid_row_mapping * map, const int32_t * prow,
+                            const int64_t ne11, const int64_t k, const int64_t n_rows,
+                            const int64_t P, queue_ptr stream) {
+    const int64_t kb_n    = k / 32;
+    const int64_t ngroups = k / 64;
+    stream->parallel_for(sycl::range<1>((size_t) n_rows * kb_n), [=](sycl::id<1> id) {
+        const int64_t i   = id[0];
+        const int64_t row = i % n_rows;
+        const int64_t kb  = i / n_rows;
+        const int64_t src = (int64_t) map[row].i2 * ne11 + (map[row].i1 % ne11);
+        const int64_t pr  = prow[row];
+        // one 32 B store per work-item: consecutive rows then cover whole cache lines
+        using v32 = sycl::vec<uint32_t, 8>;
+        *(v32 *) (qp + ((pr / 8) * kb_n + kb) * 256 + (pr % 8) * 32) =
+            *(const v32 *) (q + src * k + kb * 32);
+    });
+    stream->parallel_for(sycl::range<1>((size_t) n_rows * ngroups), [=](sycl::id<1> id) {
+        const int64_t i   = id[0];
+        const int64_t row = i % n_rows;
+        const int64_t g   = i / n_rows;
+        const int64_t src = (int64_t) map[row].i2 * ne11 + (map[row].i1 % ne11);
+        scp[g * P + prow[row]] = scales[src * ngroups + g];
+        sup[g * P + prow[row]] = sums[src * ngroups + g];
+    });
+}
+
+// k_moe_swiglu_quant_s8 into the same dpas A tile layout as k_moe_expand_pk
+static void k_moe_swiglu_quant_pk(const sycl::half * gu, int8_t * q, float * scales, int32_t * sums,
+                                  const int32_t * prow, const int64_t n_ff, const int64_t n_rows,
+                                  const int64_t P, queue_ptr stream) {
+    constexpr int wg  = 256;
+    constexpr int epl = 64 / WARP_SIZE;
+    const int64_t ngroups = n_ff / 64;
+    const int64_t kb_n    = n_ff / 32;
+    const int64_t total   = n_rows * ngroups;
+    const int64_t n_wg    = (total + wg / WARP_SIZE - 1) / (wg / WARP_SIZE);
+    stream->parallel_for(
+        sycl::nd_range<1>(sycl::range<1>(n_wg * wg), sycl::range<1>(wg)),
+        [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+            auto sg = it.get_sub_group();
+            const int64_t gid = it.get_group(0) * (wg / WARP_SIZE) + sg.get_group_id()[0];
+            if (gid >= total) {
+                return;
+            }
+            const int64_t row = gid / ngroups;
+            const int64_t g   = gid % ngroups;
+            const sycl::half * gr = gu + row * 2 * n_ff + g * 64;
+            const int lane = sg.get_local_id()[0];
+            float v[epl];
+            float amax = 0.0f;
+            for (int i = 0; i < epl; ++i) {
+                const float xg = (float) gr[lane * epl + i];
+                v[i] = xg / (1.0f + sycl::exp(-xg)) * (float) gr[n_ff + lane * epl + i];
+                amax = sycl::fmax(amax, sycl::fabs(v[i]));
+            }
+            amax = sycl::reduce_over_group(sg, amax, sycl::maximum<float>());
+            const float inv = amax > 0.0f ? 127.0f / amax : 0.0f;
+            const int64_t pr = prow[row];
+            const int64_t kb = g * 2 + lane * epl / 32;
+            int8_t * qd = q + ((pr / 8) * kb_n + kb) * 256 + (pr % 8) * 32 + lane * epl % 32;
+            int32_t lsum = 0;
+            sycl::vec<int8_t, epl> qv;
+            for (int i = 0; i < epl; ++i) {
+                qv[i] = (int8_t) sycl::clamp(sycl::round(v[i] * inv), -127.0f, 127.0f);
+                lsum += qv[i];
+            }
+            *(sycl::vec<int8_t, epl> *) qd = qv;
+            lsum = sycl::reduce_over_group(sg, lsum, sycl::plus<int32_t>());
+            if (lane == 0) {
+                scales[g * P + pr] = amax / 127.0f;
+                sums[g * P + pr]   = lsum;
+            }
+        });
+}
+
+// out[t] = [residual[t] +] sum_s weights[t*topk+s] * rows[inv[t*topk+s]] : collapses the
+// routed expert rows (expert-sorted order) straight into the final [ne0, n_tokens] tensor
+static void k_moe_weighted_reduce(const sycl::half * rows, const float * weights, const int32_t * inv,
+                                  const float * residual, float * out, const int64_t ne0,
+                                  const int64_t topk, const int64_t n_tokens, queue_ptr stream) {
+    constexpr int wg = 256;
+    // one work-group per 256-element slice so single-token reduces still fill the device
+    const int64_t slices = (ne0 + wg - 1) / wg;
+    stream->parallel_for(
+        sycl::nd_range<1>(sycl::range<1>(n_tokens * slices * wg), sycl::range<1>(wg)),
+        [=](sycl::nd_item<1> it) {
+            const int64_t t = it.get_group(0) / slices;
+            const int64_t j = (it.get_group(0) % slices) * wg + it.get_local_id(0);
+            if (j >= ne0) {
+                return;
+            }
+            float acc = residual ? residual[t * ne0 + j] : 0.0f;
+            for (int64_t s = 0; s < topk; ++s) {
+                acc += weights[t * topk + s] * (float) rows[(int64_t) inv[t * topk + s] * ne0 + j];
+            }
+            out[t * ne0 + j] = acc;
+        });
+}
+
+struct moe_fused_nodes {
+    ggml_tensor * gu_mmid;
+    ggml_tensor * down_mmid;
+    ggml_tensor * weights;
+    ggml_tensor * residual;   // src of a folded trailing residual add, or null
+    ggml_tensor * out;
+    int           count;
+    bool          geglu;
+    ggml_tensor * scale;      // per-expert down scale [n_expert] f32, or null
+};
+
+// Matches the merged-gate_up MoE block emitted by build_moe_ffn:
+//   MUL_MAT_ID -> VIEW(gate) VIEW(up) -> GLU(swiglu) -> MUL_MAT_ID
+//   [-> RESHAPE REPEAT GET_ROWS MUL(scale)] -> MUL(weights) -> VIEW x topk -> ADD x (topk-1)
+// so the whole block can run on expert-sorted rows with a single gather and a
+// single weighted reduce (no scatter/re-gather/mul/add chain).
+static bool ggml_sycl_moe_fused_match(const ggml_cgraph * g, int i, moe_fused_nodes & m) {
+    ggml_tensor * gu = g->nodes[i];
+    if (gu->op != GGML_OP_MUL_MAT_ID) return false;
+    ggml_tensor * ids = gu->src[2];
+    const int64_t topk = ids->ne[0];
+    if (topk < 2 || topk > 16) return false;
+    // per-expert down scale of build_lora_mm_id (gemma4)
+    const int sc = i + 8 < g->n_nodes && g->nodes[i + 5]->op == GGML_OP_RESHAPE &&
+                   g->nodes[i + 6]->op == GGML_OP_REPEAT && g->nodes[i + 7]->op == GGML_OP_GET_ROWS &&
+                   g->nodes[i + 8]->op == GGML_OP_MUL ? 4 : 0;
+    int count = (int) (2 * topk + 5) + sc;
+    if (count >= 32 || i + count > g->n_nodes) return false;
+
+    ggml_op ops[40];
+    int n_ops = 0;
+    ops[n_ops++] = GGML_OP_MUL_MAT_ID;
+    ops[n_ops++] = GGML_OP_VIEW;
+    ops[n_ops++] = GGML_OP_VIEW;
+    ops[n_ops++] = GGML_OP_GLU;
+    ops[n_ops++] = GGML_OP_MUL_MAT_ID;
+    if (sc) {
+        ops[n_ops++] = GGML_OP_RESHAPE;
+        ops[n_ops++] = GGML_OP_REPEAT;
+        ops[n_ops++] = GGML_OP_GET_ROWS;
+        ops[n_ops++] = GGML_OP_MUL;
+    }
+    ops[n_ops++] = GGML_OP_MUL;
+    for (int64_t k = 0; k < topk; ++k)     ops[n_ops++] = GGML_OP_VIEW;
+    for (int64_t k = 0; k < topk - 1; ++k) ops[n_ops++] = GGML_OP_ADD;
+
+    const int out_idx = i + count - 1;
+    if (!ggml_can_fuse_subgraph(g, i, count, ops, &out_idx, 1)) return false;
+
+    ggml_tensor * v_gate = g->nodes[i + 1];
+    ggml_tensor * v_up   = g->nodes[i + 2];
+    ggml_tensor * glu    = g->nodes[i + 3];
+    ggml_tensor * down   = g->nodes[i + 4];
+    ggml_tensor * mul    = g->nodes[i + 5 + sc];
+    const int     vb     = i + 6 + sc;   // first expert-slot view
+
+    if (gu->ne[0] % 2) return false;
+    const int64_t n_ff = gu->ne[0] / 2;
+    if (v_gate->src[0] != gu || v_up->src[0] != gu) return false;
+    if (v_gate->view_offs != 0 || v_up->view_offs != (size_t) (n_ff * gu->nb[0])) return false;
+    if (v_gate->ne[0] != n_ff || v_up->ne[0] != n_ff) return false;
+    if (glu->src[0] != v_gate || glu->src[1] != v_up) return false;
+    const ggml_glu_op glu_op = ggml_get_glu_op(glu);
+    if (glu_op != GGML_GLU_OP_SWIGLU && glu_op != GGML_GLU_OP_GEGLU) return false;
+    if (ggml_get_op_params_i32(glu, 1) != 0) return false;   // swapped halves
+    if (glu->type != GGML_TYPE_F32) return false;
+    if (down->src[1] != glu || down->src[2] != ids) return false;
+
+    ggml_tensor * scale = nullptr;
+    if (sc) {
+        ggml_tensor * rs = g->nodes[i + 5];
+        ggml_tensor * rp = g->nodes[i + 6];
+        ggml_tensor * gr = g->nodes[i + 7];
+        ggml_tensor * sm = g->nodes[i + 8];
+        scale = rs->src[0];
+        if (rp->src[0] != rs || gr->src[0] != rp || gr->src[1] != ids || sm->src[0] != down || sm->src[1] != gr) return false;
+        if (scale == nullptr || scale->type != GGML_TYPE_F32 || !ggml_is_contiguous(scale) ||
+            ggml_nelements(scale) != gu->src[0]->ne[2]) return false;
+        if (gr->type != GGML_TYPE_F32 || gr->ne[0] != 1 || gr->ne[1] != topk || gr->ne[2] != gu->ne[2]) return false;
+    }
+    if (mul->src[0] != (sc ? g->nodes[i + 8] : down)) return false;
+
+    ggml_tensor * w = mul->src[1];
+    if (w->type != GGML_TYPE_F32 || !ggml_is_contiguous(w)) return false;
+    if (w->ne[0] != 1 || w->ne[1] != topk || w->ne[2] != gu->ne[2]) return false;
+
+    const int64_t d = down->ne[0];
+    for (int64_t k = 0; k < topk; ++k) {
+        ggml_tensor * v = g->nodes[vb + k];
+        if (v->src[0] != mul) return false;
+        if (v->ne[0] != d || v->ne[1] != gu->ne[2]) return false;
+        if (v->view_offs != (size_t) (k * mul->nb[1])) return false;
+        if (v->nb[1] != mul->nb[2]) return false;
+    }
+    ggml_tensor * acc = g->nodes[vb + topk];
+    if (acc->src[0] != g->nodes[vb] || acc->src[1] != g->nodes[vb + 1]) return false;
+    for (int64_t k = 1; k < topk - 1; ++k) {
+        ggml_tensor * a = g->nodes[vb + topk + k];
+        if (a->src[0] != g->nodes[vb + topk + k - 1]) return false;
+        if (a->src[1] != g->nodes[vb + 1 + k]) return false;
+        acc = a;
+    }
+    if (acc->type != GGML_TYPE_F32 || !ggml_is_contiguous(acc)) return false;
+
+    const ggml_tensor * x = gu->src[1];
+    if (x->type != GGML_TYPE_F32 || x->nb[1] != (size_t) x->ne[0] * sizeof(float)) return false;
+
+    // fold a directly following residual add into the reduce when possible
+    ggml_tensor * residual = nullptr;
+    ggml_tensor * out = acc;
+    if (i + count < g->n_nodes && count + 1 < 32) {
+        ggml_tensor * res_add = g->nodes[i + count];
+        ggml_tensor * other = res_add->src[0] == acc ? res_add->src[1]
+                            : res_add->src[1] == acc ? res_add->src[0] : nullptr;
+        if (res_add->op == GGML_OP_ADD && other && other->type == GGML_TYPE_F32 &&
+            res_add->type == GGML_TYPE_F32 && ggml_are_same_shape(res_add, acc) &&
+            ggml_are_same_shape(other, acc) && ggml_is_contiguous(other) &&
+            ggml_is_contiguous(res_add)) {
+            ops[n_ops++] = GGML_OP_ADD;
+            const int out_idx2 = i + count;
+            if (ggml_can_fuse_subgraph(g, i, count + 1, ops, &out_idx2, 1)) {
+                residual = other;
+                out = res_add;
+                count += 1;
+            }
+        }
+    }
+
+    m = { gu, down, w, residual, out, count, glu_op == GGML_GLU_OP_GEGLU, scale };
+    return true;
+}
+
+// Executes the matched MoE block: gather (f32->f16 fold) -> grouped gate_up gemm ->
+// swiglu (f16 out) -> grouped down gemm -> weighted reduce into the final tensor.
+// Rows stay expert-sorted throughout. Returns false (nothing written to graph
+// tensors) to fall back to per-node execution.
+// device-side counting sort of the routed rows for small batches (decode and
+// spec-decode verify): one work-group builds the expert offsets, row mapping
+// and its inverse without the ids readback + host sort + reupload round trip
+// (2 queue drains per MoE layer)
+static constexpr int MMID_ROUTE_SMALL_MAX_ROWS = 512;
+
+// Counting sort of the routed rows on the device, for any row count: a histogram, one
+// serial scan over the experts, then a scatter. Replaces the ids readback + host sort +
+// upload, which drains the queue twice per layer and leaves the device idle while the host
+// sorts. Rows inside one expert come out in atomic order, which the gemm does not care
+// about (map/inv/prow stay consistent).
+static void k_mmid_route_dev(const char * ids, int64_t topk, int64_t n_tok,
+                             size_t nb0, size_t nb1, int n_as,
+                             mmid_row_mapping * map, int32_t * inv, int32_t * offs,
+                             int32_t * pbeg, int32_t * prow, int32_t * cur, int32_t * beg,
+                             queue_ptr stream) {
+    const int64_t n_rows = topk * n_tok;
+    SYCL_CHECK(CHECK_TRY_ERROR(stream->memset(cur, 0, n_as * sizeof(int32_t))));
+    stream->parallel_for(sycl::range<1>(n_rows), [=](sycl::id<1> id) {
+        const int64_t i = id[0];
+        const int32_t e = *(const int32_t *) (ids + (i / topk) * nb1 + (i % topk) * nb0);
+        sycl::atomic_ref<int32_t, sycl::memory_order::relaxed, sycl::memory_scope::device,
+                         sycl::access::address_space::global_space> c(cur[e]);
+        c.fetch_add(1);
+    });
+    stream->parallel_for(sycl::nd_range<1>(sycl::range<1>(1), sycl::range<1>(1)),
+        [=](sycl::nd_item<1>) {
+            int32_t acc = 0, p = 0;
+            for (int e = 0; e < n_as; ++e) {
+                const int32_t n = cur[e];
+                beg[e]  = acc;
+                cur[e]  = acc;
+                acc    += n;
+                offs[e] = acc;
+                pbeg[e] = p;
+                p      += (n + 7) / 8 * 8;
+            }
+        });
+    stream->parallel_for(sycl::range<1>(n_rows), [=](sycl::id<1> id) {
+        const int64_t i = id[0];
+        const int32_t e = *(const int32_t *) (ids + (i / topk) * nb1 + (i % topk) * nb0);
+        sycl::atomic_ref<int32_t, sycl::memory_order::relaxed, sycl::memory_scope::device,
+                         sycl::access::address_space::global_space> c(cur[e]);
+        const int32_t pos = c.fetch_add(1);
+        map[pos].i1 = (int32_t) (i % topk);
+        map[pos].i2 = (int32_t) (i / topk);
+        inv[i]      = pos;
+        prow[pos]   = pbeg[e] + pos - beg[e];
+    });
+}
+
+static void k_mmid_route_small(const char * ids, int64_t topk, int64_t n_tok,
+                               size_t nb0, size_t nb1, int n_as,
+                               mmid_row_mapping * map, int32_t * inv, int32_t * offs,
+                               int32_t * actives, int32_t * pbeg, int32_t * prow,
+                               queue_ptr stream) {
+    const int n_rows = (int) (topk * n_tok);
+    stream->submit([&](sycl::handler & cgh) {
+        sycl::local_accessor<int32_t, 1> sid(sycl::range<1>(MMID_ROUTE_SMALL_MAX_ROWS), cgh);
+        cgh.parallel_for(sycl::nd_range<1>(sycl::range<1>(256), sycl::range<1>(256)),
+            [=](sycl::nd_item<1> it) {
+                const int lid = it.get_local_id(0);
+                for (int r = lid; r < n_rows; r += 256) {
+                    sid[r] = *(const int32_t *) (ids + (r / topk) * nb1 + (r % topk) * nb0);
+                }
+                it.barrier(sycl::access::fence_space::local_space);
+                // exclusive-end offsets: rows with expert id <= e
+                for (int e = lid; e < n_as; e += 256) {
+                    int cnt = 0;
+                    for (int r = 0; r < n_rows; ++r) {
+                        cnt += sid[r] <= e ? 1 : 0;
+                    }
+                    offs[e] = cnt;
+                }
+                // activation-side row base per expert: rows padded to a dpas row block of 8
+                if (pbeg != nullptr) {
+                    it.barrier();
+                    if (lid == 0) {
+                        int p = 0;
+                        for (int e = 0; e < n_as; ++e) {
+                            pbeg[e] = p;
+                            p += (offs[e] - (e > 0 ? offs[e - 1] : 0) + 7) / 8 * 8;
+                        }
+                    }
+                    it.barrier();
+                }
+                // each row's routed position: rows before it in (expert, row) order
+                for (int i = lid; i < n_rows; i += 256) {
+                    const int32_t my = sid[i];
+                    int pos = 0;
+                    for (int r = 0; r < n_rows; ++r) {
+                        pos += (sid[r] < my || (sid[r] == my && r < i)) ? 1 : 0;
+                    }
+                    map[pos].i1 = (int32_t) (i % topk);
+                    map[pos].i2 = (int32_t) (i / topk);
+                    inv[i] = pos;
+                    if (prow != nullptr) {
+                        prow[pos] = pbeg[my] + pos - (my > 0 ? offs[my - 1] : 0);
+                    }
+                }
+                // compact active-expert list (actives[0] = count, then ids, any order)
+                // for the small-M gemv grid, so inactive experts dispatch nothing
+                if (actives != nullptr) {
+                    if (lid == 0) {
+                        actives[0] = 0;
+                    }
+                    it.barrier();
+                    for (int e = lid; e < n_as; e += 256) {
+                        int cnt = 0;
+                        for (int r = 0; r < n_rows; ++r) {
+                            cnt += sid[r] == e ? 1 : 0;
+                        }
+                        if (cnt > 0) {
+                            sycl::atomic_ref<int32_t, sycl::memory_order::relaxed,
+                                             sycl::memory_scope::work_group,
+                                             sycl::access::address_space::global_space> n_act(actives[0]);
+                            actives[1 + n_act.fetch_add(1)] = e;
+                        }
+                    }
+                }
+            });
+    });
+}
+
+// Small-M grouped W4A16 gemv for the MoE decode/verify shapes (1..8 rows per active
+// expert), replacing the oneDNN grouped GEMM whose small-M config tops out at
+// 62-83 GB/s here: one sub-group per (expert, output column) streams the u4 weight
+// column once (one uint4, 32 packed weights, per lane per k-chunk) and multiplies it
+// into every row of the expert. The work-group's 16 columns share the activation
+// rows through double-buffered SLM (direct per-column reads saturate L3: 81-89%
+// busy at 65% miss), staging the next k-chunk while the current one is computed -
+// one barrier per chunk. GATED also streams the up column (n_eff apart) and writes
+// silu(gate)*up straight into the down activations, absorbing the swiglu kernel.
+// Grid slots read the compact active-expert list, so inactive experts dispatch
+// nothing.
+template <bool GATED>
+static void k_moe_gemv_u4(const uint8_t * w, const sycl::half * sc, const uint8_t * zp,
+                          const sycl::half * act, sycl::half * out,
+                          const int32_t * offs, const int32_t * actives, int n_slots,
+                          const int64_t N, const int64_t K, queue_ptr stream) {
+    constexpr int WS     = 16;      // lanes per sub-group = one output column
+    constexpr int RW     = 16;      // columns per work-group
+    constexpr int KCHUNK = WS * 32; // k-span staged per buffer
+    constexpr int MAX_R  = 8;       // rows per expert (n_tok <= 8, caller-gated)
+
+    const int64_t n_eff   = GATED ? N / 2 : N;
+    const int64_t n_tiles = (n_eff + RW - 1) / RW;
+    const int64_t kg_n    = K / 64;
+
+    GGML_ASSERT(K % KCHUNK == 0);
+
+    stream->submit([&](sycl::handler & cgh) {
+        sycl::local_accessor<sycl::half, 1> x_slm(sycl::range<1>(2 * MAX_R * KCHUNK), cgh);
+        cgh.parallel_for(
+            sycl::nd_range<1>(sycl::range<1>((size_t) n_slots * n_tiles * (WS * RW)),
+                              sycl::range<1>(WS * RW)),
+            [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(WS)]] {
+                const int64_t wg   = it.get_group(0);
+                const int64_t slot = wg / n_tiles;
+                const int64_t tile = wg % n_tiles;
+                const int     lid  = (int) it.get_local_id(0);
+                const int     lane = lid % WS;
+
+                // uniform per work-group: returning before the first barrier is safe
+                if (slot >= actives[0]) {
+                    return;
+                }
+                const int e       = actives[1 + slot];
+                const int row_beg = e > 0 ? offs[e - 1] : 0;
+                const int R       = offs[e] - row_beg;
+                if (R <= 0 || R > MAX_R) {
+                    return;
+                }
+
+                const int64_t col  = tile * RW + lid / WS;
+                const bool    live = col < n_eff;
+
+                const uint8_t    * we  = w  + (size_t) e * (size_t) N * (K / 2);
+                const sycl::half * sce = sc + (size_t) e * kg_n * N;
+                const uint8_t    * zpe = zp + (size_t) e * (kg_n * N / 2);
+
+                using half2 = sycl::vec<sycl::half, 2>;
+                using half8 = sycl::vec<sycl::half, 8>;
+
+                half2 * s2 = reinterpret_cast<half2 *>(
+                    x_slm.template get_multi_ptr<sycl::access::decorated::no>().get());
+                const half2 * a2 = reinterpret_cast<const half2 *>(act);
+
+                const auto stage = [&](int buf, int64_t k0) {
+                    half2 * dst = s2 + buf * (MAX_R * KCHUNK / 2);
+                    for (int i = lid; i < R * (KCHUNK / 2); i += WS * RW) {
+                        const int r = i / (KCHUNK / 2);
+                        dst[i] = a2[((size_t) (row_beg + r) * K + k0) / 2 + i % (KCHUNK / 2)];
+                    }
+                };
+
+                float acc_g[MAX_R] = {};
+                float acc_u[MAX_R] = {};
+
+                const int n_chunks = (int) (K / KCHUNK);
+
+                stage(0, 0);
+                it.barrier(sycl::access::fence_space::local_space);
+
+                for (int ci = 0; ci < n_chunks; ++ci) {
+                    // issue the next chunk's staging loads before computing this one
+                    if (ci + 1 < n_chunks) {
+                        stage((ci + 1) & 1, (int64_t) (ci + 1) * KCHUNK);
+                    }
+
+                    if (live) {
+                        const int k = ci * KCHUNK + lane * 32;
+
+                        // one 64-wide quant group covers two 32-weight chunks: per-chunk
+                        // scale/zp are lane-uniform. nibble j of each uint32 pairs with
+                        // x[8c + j], nibble j+4 with x[8c + 4 + j] (pack_u4 layout).
+                        const int64_t gbase = ((int64_t) (k >> 6)) * N;
+
+                        const int64_t     gi_g = gbase + col;
+                        const float       scg  = (float) sce[gi_g];
+                        const uint8_t     zbg  = zpe[gi_g >> 1];
+                        const int         zvg  = (gi_g & 1) ? (zbg >> 4) : (zbg & 0xF);
+                        const sycl::uint4 bqg  = *reinterpret_cast<const sycl::uint4 *>(
+                                                     we + (size_t) col * (K / 2) + (k >> 1));
+
+                        float       scu = 0.0f;
+                        int         zvu = 0;
+                        sycl::uint4 bqu = {};
+                        if (GATED) {
+                            const int64_t cu   = n_eff + col;
+                            const int64_t gi_u = gbase + cu;
+                            scu = (float) sce[gi_u];
+                            const uint8_t zbu = zpe[gi_u >> 1];
+                            zvu = (gi_u & 1) ? (zbu >> 4) : (zbu & 0xF);
+                            bqu = *reinterpret_cast<const sycl::uint4 *>(
+                                      we + (size_t) cu * (K / 2) + (k >> 1));
+                        }
+
+                        const sycl::half * xs = &x_slm[(ci & 1) * (MAX_R * KCHUNK) + lane * 32];
+#pragma unroll
+                        for (int r = 0; r < MAX_R; ++r) {
+                            if (r >= R) {
+                                break;
+                            }
+                            const half8 * xr = reinterpret_cast<const half8 *>(xs + r * KCHUNK);
+                            float pg = 0.0f;
+                            float pu = 0.0f;
+#pragma unroll
+                            for (int c = 0; c < 4; ++c) {
+                                const half8    xv = xr[c];
+                                const uint32_t bg = bqg[c];
+                                const uint32_t bu = bqu[c];
+#pragma unroll
+                                for (int j = 0; j < 4; ++j) {
+                                    pg += (float) ((int) ((bg >> (4 * j)) & 0xF) - zvg)       * (float) xv[j];
+                                    pg += (float) ((int) ((bg >> (4 * (j + 4))) & 0xF) - zvg) * (float) xv[4 + j];
+                                    if (GATED) {
+                                        pu += (float) ((int) ((bu >> (4 * j)) & 0xF) - zvu)       * (float) xv[j];
+                                        pu += (float) ((int) ((bu >> (4 * (j + 4))) & 0xF) - zvu) * (float) xv[4 + j];
+                                    }
+                                }
+                            }
+                            acc_g[r] += scg * pg;
+                            if (GATED) {
+                                acc_u[r] += scu * pu;
+                            }
+                        }
+                    }
+
+                    it.barrier(sycl::access::fence_space::local_space);
+                }
+
+                if (!live) {
+                    return;
+                }
+
+                auto sg = it.get_sub_group();
+#pragma unroll
+                for (int r = 0; r < MAX_R; ++r) {
+                    if (r >= R) {
+                        break;
+                    }
+                    const float g = sycl::reduce_over_group(sg, acc_g[r], sycl::plus<float>());
+                    if (GATED) {
+                        const float u = sycl::reduce_over_group(sg, acc_u[r], sycl::plus<float>());
+                        if (lane == 0) {
+                            out[(size_t) (row_beg + r) * n_eff + col] =
+                                (sycl::half) (g / (1.0f + sycl::exp(-g)) * u);
+                        }
+                    } else if (lane == 0) {
+                        out[(size_t) (row_beg + r) * n_eff + col] = (sycl::half) g;
+                    }
+                }
+            });
+    });
+}
+
+// Decode-only (n_tok==1 -> exactly one row per active expert) variant of the above: the
+// SLM double-buffer + per-chunk barriers only pay off when the 16 columns share R>1 rows,
+// but at decode R is always 1, so they are pure overhead (worst for the K=512 down proj,
+// one chunk = all-barrier). Each sub-group streams the u4 weight column once and reads its
+// one activation row directly (K/2..2 KB, L1-resident across the work-group's 16 columns).
+template <bool GATED>
+static void k_moe_gemv_u4_r1(const uint8_t * w, const sycl::half * sc, const uint8_t * zp,
+                             const sycl::half * act, sycl::half * out,
+                             const int32_t * offs, const int32_t * actives, int n_slots,
+                             const int64_t N, const int64_t K, queue_ptr stream) {
+    constexpr int WS = 16;
+    constexpr int RW = 16;
+    const int64_t n_eff   = GATED ? N / 2 : N;
+    const int64_t n_tiles = (n_eff + RW - 1) / RW;
+    const int64_t kg_n    = K / 64;
+    GGML_ASSERT(K % (WS * 32) == 0);
+
+    stream->submit([&](sycl::handler & cgh) {
+        cgh.parallel_for(
+            sycl::nd_range<1>(sycl::range<1>((size_t) n_slots * n_tiles * (WS * RW)),
+                              sycl::range<1>(WS * RW)),
+            [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(WS)]] {
+                const int64_t wg   = it.get_group(0);
+                const int64_t slot = wg / n_tiles;
+                const int64_t tile = wg % n_tiles;
+                const int     lane = (int) it.get_local_id(0) % WS;
+
+                if (slot >= actives[0]) {
+                    return;
+                }
+                const int e       = actives[1 + slot];
+                const int row_beg = e > 0 ? offs[e - 1] : 0;
+                if (offs[e] - row_beg <= 0) {
+                    return;
+                }
+                const int64_t col = tile * RW + it.get_local_id(0) / WS;
+                if (col >= n_eff) {
+                    return;
+                }
+
+                using half8 = sycl::vec<sycl::half, 8>;
+                const uint8_t    * we  = w  + (size_t) e * (size_t) N * (K / 2);
+                const sycl::half * sce = sc + (size_t) e * kg_n * N;
+                const uint8_t    * zpe = zp + (size_t) e * (kg_n * N / 2);
+                const sycl::half * xr  = act + (size_t) row_beg * K;
+
+                float acc_g = 0.0f;
+                float acc_u = 0.0f;
+                for (int k0 = 0; k0 < K; k0 += WS * 32) {
+                    const int     k     = k0 + lane * 32;
+                    const int64_t gbase = ((int64_t) (k >> 6)) * N;
+
+                    const int64_t     gi_g = gbase + col;
+                    const float       scg  = (float) sce[gi_g];
+                    const uint8_t     zbg  = zpe[gi_g >> 1];
+                    const int         zvg  = (gi_g & 1) ? (zbg >> 4) : (zbg & 0xF);
+                    const sycl::uint4 bqg  = *reinterpret_cast<const sycl::uint4 *>(
+                                                 we + (size_t) col * (K / 2) + (k >> 1));
+
+                    float       scu = 0.0f;
+                    int         zvu = 0;
+                    sycl::uint4 bqu = {};
+                    if (GATED) {
+                        const int64_t cu   = n_eff + col;
+                        const int64_t gi_u = gbase + cu;
+                        scu = (float) sce[gi_u];
+                        const uint8_t zbu = zpe[gi_u >> 1];
+                        zvu = (gi_u & 1) ? (zbu >> 4) : (zbu & 0xF);
+                        bqu = *reinterpret_cast<const sycl::uint4 *>(
+                                  we + (size_t) cu * (K / 2) + (k >> 1));
+                    }
+
+                    const half8 * xa = reinterpret_cast<const half8 *>(xr + k);
+                    float pg = 0.0f;
+                    float pu = 0.0f;
+#pragma unroll
+                    for (int c = 0; c < 4; ++c) {
+                        const half8    xv = xa[c];
+                        const uint32_t bg = bqg[c];
+                        const uint32_t bu = bqu[c];
+#pragma unroll
+                        for (int j = 0; j < 4; ++j) {
+                            pg += (float) ((int) ((bg >> (4 * j)) & 0xF) - zvg)       * (float) xv[j];
+                            pg += (float) ((int) ((bg >> (4 * (j + 4))) & 0xF) - zvg) * (float) xv[4 + j];
+                            if (GATED) {
+                                pu += (float) ((int) ((bu >> (4 * j)) & 0xF) - zvu)       * (float) xv[j];
+                                pu += (float) ((int) ((bu >> (4 * (j + 4))) & 0xF) - zvu) * (float) xv[4 + j];
+                            }
+                        }
+                    }
+                    acc_g += scg * pg;
+                    if (GATED) {
+                        acc_u += scu * pu;
+                    }
+                }
+
+                auto sg = it.get_sub_group();
+                const float g = sycl::reduce_over_group(sg, acc_g, sycl::plus<float>());
+                if (GATED) {
+                    const float u = sycl::reduce_over_group(sg, acc_u, sycl::plus<float>());
+                    if (lane == 0) {
+                        out[(size_t) row_beg * n_eff + col] = (sycl::half) (g / (1.0f + sycl::exp(-g)) * u);
+                    }
+                } else if (lane == 0) {
+                    out[(size_t) row_beg * n_eff + col] = (sycl::half) g;
+                }
+            });
+    });
+}
+
+// exact MoE block on the GGUF Q4_K experts for prefill batches; decode and small batches return false and run per node on mmvq
+static bool ggml_sycl_moe_fused_exec_gguf(ggml_backend_sycl_context & ctx, const moe_fused_nodes & m) try {
+    ggml_tensor *       gu   = m.gu_mmid;
+    ggml_tensor *       down = m.down_mmid;
+    const ggml_tensor * w1   = gu->src[0];
+    const ggml_tensor * w2   = down->src[0];
+    const ggml_tensor * x    = gu->src[1];
+    const ggml_tensor * ids  = gu->src[2];
+
+    const int64_t n_as   = w1->ne[2];
+    const int64_t topk   = ids->ne[0];
+    const int64_t n_tok  = ids->ne[1];
+    const int64_t n_rows = topk * n_tok;
+    const int64_t K1     = w1->ne[0];
+    const int64_t N1     = w1->ne[1];
+    const int64_t n_ff   = N1 / 2;
+    const int64_t N2     = w2->ne[1];
+
+    // from two tokens on: every routed expert is read once for all its rows, where the per-row mmvq reads an expert once
+    // per token (a speculative verify step of 8 tokens: 1.24x on Qwen3.6-35B-A3B, Arc B390); a decode token stays there
+    if (!g_ggml_sycl_gguf_gemm || n_tok < 2 || n_as > 32767) {
+        return false;
+    }
+    if (!ggml_sycl_gguf_moe_ok(w1->type, N1, K1) || !ggml_sycl_gguf_moe_ok(w2->type, N2, n_ff)) {
+        return false;
+    }
+    // only the Q4_K gate_up epilogue implements geglu
+    if (m.geglu && (w1->type != GGML_TYPE_Q4_K || n_ff % 64 != 0)) {
+        return false;
+    }
+    if (w2->ne[0] != n_ff || w2->ne[2] != n_as || !ggml_is_contiguous(w1) || !ggml_is_contiguous(w2) ||
+        !ggml_is_contiguous(x)) {
+        return false;
+    }
+    ggml_tensor_extra_gpu * e1 = (ggml_tensor_extra_gpu *) w1->extra;
+    ggml_tensor_extra_gpu * e2 = (ggml_tensor_extra_gpu *) w2->extra;
+    // Q5_1 gets no extra: it has no reorder or u4 layout, so its GGUF blocks are always readable
+    const bool e2_ok = e2 != nullptr ? !e2->optimized_feature.u4_dense : w2->type == GGML_TYPE_Q5_1;
+    const bool w2_reordered = e2 != nullptr && e2->optimized_feature.reorder;
+    if (e1 == nullptr || !e2_ok || e1->optimized_feature.u4_dense ||
+        g_mmid_u4_converted.count(w1->data) != 0 || g_mmid_u4_converted.count(w2->data) != 0) {
+        return false;
+    }
+    // the reduce reads the residual while writing m.out: exact in-place is fine, partial is not
+    const float * residual = nullptr;
+    if (m.residual != nullptr) {
+        const char * rb = (const char *) m.residual->data;
+        const char * ob = (const char *) m.out->data;
+        const bool disjoint = rb + ggml_nbytes(m.residual) <= ob || ob + ggml_nbytes(m.out) <= rb;
+        if (!disjoint && rb != ob) {
+            return false;
+        }
+        residual = (const float *) m.residual->data;
+    }
+
+    const queue_ptr stream = ctx.stream();
+    // reorder now, so prefill and decode read the same experts
+    opt_for_reorder_id(&ctx, w1);
+    opt_for_reorder_id(&ctx, w2);
+
+    // the VMM pool frees strictly LIFO: keep declaration order == allocation order
+    ggml_sycl_pool_alloc<mmid_row_mapping> map_dev(ctx.pool(), n_rows);
+    ggml_sycl_pool_alloc<int32_t> inv_dev(ctx.pool(), n_rows);
+    ggml_sycl_pool_alloc<int32_t> offs_dev(ctx.pool(), n_as);
+    ggml_sycl_pool_alloc<int32_t> pbeg_dev(ctx.pool(), n_as);
+    ggml_sycl_pool_alloc<int32_t> prow_dev(ctx.pool(), n_rows);
+    ggml_sycl_pool_alloc<int32_t> cur_dev(ctx.pool(), n_as);
+    ggml_sycl_pool_alloc<int32_t> beg_dev(ctx.pool(), n_as);
+    const int64_t max_rg = ggml_sycl_gguf_moe_max_row_groups(n_rows, n_as);
+    ggml_sycl_pool_alloc<int32_t> rg_dev(ctx.pool(), max_rg);
+    ggml_sycl_pool_alloc<int32_t> nrg_dev(ctx.pool(), 1);
+    const int64_t nx = x->ne[1] * x->ne[2];
+    ggml_sycl_pool_alloc<sycl::half> xh(ctx.pool(), (size_t) nx * K1);
+    // the swiglu runs in the gate_up epilogue when n_ff fills whole 64-column work-groups, and that gemm reads the
+    // token rows of xh directly; the plain gate_up gemm reads them expanded to per-expert tiles
+    static const bool expand = getenv("GGML_SYCL_GGUF_MOE_EXPAND") != nullptr;
+    const bool        glu    = n_ff % 64 == 0 && w1->type == GGML_TYPE_Q4_K;
+    const bool        direct = glu && !expand;
+    ggml_sycl_pool_alloc<sycl::half> act1(ctx.pool(), direct ? 1 : ggml_sycl_gguf_moe_act_elems(n_rows, n_as, K1));
+    ggml_sycl_pool_alloc<sycl::half> gu_out(ctx.pool(), glu ? 1 : (size_t) n_rows * N1);
+    ggml_sycl_pool_alloc<sycl::half> act2(ctx.pool(), ggml_sycl_gguf_moe_act_elems(n_rows, n_as, n_ff));
+    ggml_sycl_pool_alloc<sycl::half> down_out(ctx.pool(), (size_t) n_rows * N2);
+    ggml_sycl_pool_alloc<float> w_copy(ctx.pool(), (size_t) n_rows);
+
+    k_mmid_route_dev((const char *) ids->data, topk, n_tok, ids->nb[0], ids->nb[1], (int) n_as,
+                     map_dev.get(), inv_dev.get(), offs_dev.get(), pbeg_dev.get(), prow_dev.get(),
+                     cur_dev.get(), beg_dev.get(), stream);
+    ggml_sycl_gguf_moe_row_groups(offs_dev.get(), (int) n_as, rg_dev.get(), nrg_dev.get(), stream);
+    static_assert(sizeof(mmid_row_mapping) == 2 * sizeof(int32_t), "mmid_row_mapping is (slot, token)");
+    ggml_sycl_gguf_moe_pack((const float *) x->data, (int64_t) (x->nb[1] / sizeof(float)), nx, x->ne[1],
+                            (const int32_t *) map_dev.get(), offs_dev.get(), pbeg_dev.get(), rg_dev.get(),
+                            nrg_dev.get(), max_rg, xh.get(), direct ? nullptr : act1.get(), K1, stream);
+    if (glu) {
+        ggml_sycl_gguf_moe_gemm_glu(w1->type, w1->data, e1->optimized_feature.reorder, direct ? xh.get() : act1.get(),
+                                    offs_dev.get(), pbeg_dev.get(), rg_dev.get(), nrg_dev.get(), max_rg, act2.get(),
+                                    n_ff, K1, stream, m.geglu, direct ? (const int32_t *) map_dev.get() : nullptr, x->ne[1]);
+    } else {
+        ggml_sycl_gguf_moe_gemm(w1->type, w1->data, e1->optimized_feature.reorder, act1.get(), offs_dev.get(),
+                                pbeg_dev.get(), rg_dev.get(), nrg_dev.get(), max_rg, gu_out.get(), N1, K1, stream);
+        ggml_sycl_gguf_moe_swiglu(gu_out.get(), prow_dev.get(), act2.get(), n_rows, n_ff, stream);
+    }
+    ggml_sycl_gguf_moe_gemm(w2->type, w2->data, w2_reordered, act2.get(), offs_dev.get(),
+                            pbeg_dev.get(), rg_dev.get(), nrg_dev.get(), max_rg, down_out.get(), N2, n_ff, stream);
+    // the graph allocator may alias m.out onto the (dead-after-mul) weights tensor;
+    // the reduce reads weights while writing m.out, so read from a copy
+    if (m.scale != nullptr) {
+        // the per-expert down scale multiplies whole rows, so it folds into the routing weight
+        const float * wsrc = (const float *) m.weights->data;
+        const float * scl  = (const float *) m.scale->data;
+        const char *  idsd = (const char *) ids->data;
+        const size_t  inb0 = ids->nb[0];
+        const size_t  inb1 = ids->nb[1];
+        float *       wdst = w_copy.get();
+        stream->parallel_for(sycl::range<1>(n_rows), [=](sycl::id<1> id) {
+            const int64_t r = id[0];
+            const int32_t e = *(const int32_t *) (idsd + (r / topk) * inb1 + (r % topk) * inb0);
+            wdst[r] = wsrc[r] * scl[e];
+        });
+    } else {
+        SYCL_CHECK(CHECK_TRY_ERROR(stream->memcpy(w_copy.get(), m.weights->data, (size_t) n_rows * sizeof(float))));
+    }
+    k_moe_weighted_reduce(down_out.get(), w_copy.get(), inv_dev.get(), residual, (float *) m.out->data, N2,
+                          topk, n_tok, stream);
+    return true;
+} catch (sycl::exception const & exc) {
+    std::cerr << exc.what() << "Exception caught at file:" << __FILE__ << ", line:" << __LINE__ << std::endl;
+    std::exit(1);
+}
+
+static bool ggml_sycl_moe_fused_exec(ggml_backend_sycl_context & ctx, const moe_fused_nodes & m) try {
+    if (!g_ggml_sycl_moe_dnn) {
+        return ggml_sycl_moe_fused_exec_gguf(ctx, m);
+    }
+    if (m.geglu || m.scale != nullptr) {
+        return false;
+    }
+    ggml_tensor * gu   = m.gu_mmid;
+    ggml_tensor * down = m.down_mmid;
+    const ggml_tensor * x   = gu->src[1];
+    const ggml_tensor * ids = gu->src[2];
+
+    const queue_ptr stream = ctx.stream();
+
+    const int64_t n_as   = gu->src[0]->ne[2];
+    const int64_t topk   = ids->ne[0];
+    const int64_t n_tok  = ids->ne[1];
+    const int64_t n_rows = topk * n_tok;
+    const int64_t K1     = gu->src[0]->ne[0];
+    const int64_t N1     = gu->src[0]->ne[1];
+    const int64_t n_ff   = N1 / 2;
+    const int64_t N2     = down->src[0]->ne[1];
+    const int     group  = 64;
+
+    // GGML_SYCL_MOE_STAGE_TIME=<n>: wall time per stage of the block, synchronising after
+    // each one and printed every n calls (the syncs inflate the total)
+    static const int stage_time = ggml_sycl_get_env("GGML_SYCL_MOE_STAGE_TIME", 0);
+    static double    stage_acc[10] = {};
+    static int       stage_calls  = 0;
+    int64_t          stage_last   = stage_time ? ggml_time_us() : 0;
+    auto tick = [&](int s) {
+        if (stage_time) {
+            stream->wait();
+            const int64_t now = ggml_time_us();
+            stage_acc[s] += (now - stage_last) / 1000.0;
+            stage_last = now;
+        }
+    };
+
+    // reduce reads the residual while writing m.out; exact in-place is fine, partial is not.
+    // Checked before the weight conversion: once converted there is no path back.
+    const float * residual = nullptr;
+    if (m.residual != nullptr) {
+        const char * rb = (const char *) m.residual->data;
+        const char * ob = (const char *) m.out->data;
+        const bool disjoint = rb + ggml_nbytes(m.residual) <= ob || ob + ggml_nbytes(m.out) <= rb;
+        if (!disjoint && rb != ob) return false;
+        residual = (const float *) m.residual->data;
+    }
+
+    // native XMX gemm in place of the oneDNN grouped matmul: the weights are swizzled into
+    // its operand layout at conversion time, so both shapes must be settled up front
+    static const bool dpas_on = ggml_sycl_get_env("GGML_SYCL_MOE_DPAS", 1) != 0;
+    const bool use_dpas = dpas_on && ggml_sycl_moe_u4_dpas_ok(N1, K1) &&
+                          ggml_sycl_moe_u4_dpas_ok(N2, n_ff) && (n_ff % 16) == 0;
+    // Folding swiglu + the down-side quantization into the gate_up epilogue removes the
+    // [n_rows, 2*n_ff] f16 round trip (67 MB per layer at 2048 tokens), and it is correct,
+    // but it loses on B390: one thread must own a whole 64-column quant group, so the tile
+    // needs 8 accumulators and a repeat-4 dpas - twice the dpas instructions and twice the
+    // L1 weight re-reads per MAC. gate_up 3.29 -> 4.72 ms, more than the 0.44 ms swiglu pass
+    // and the 24 MB of writes it saves. Worth retrying on a part with a wider register file.
+    static const bool glu_on = ggml_sycl_get_env("GGML_SYCL_MOE_DPAS_GLU", 0) != 0;
+
+#if !(defined(DNNL_EXPERIMENTAL_GROUPED_MEMORY) && DNNL_EXPERIMENTAL_GROUPED_MEMORY)
+    if (!use_dpas) {
+        return false;   // no oneDNN grouped matmul in this build
+    }
+#endif
+
+    mmid_u4_weights w_gu, w_down;
+    if (!mmid_dnn_ensure_u4(ctx, gu->src[0], gu, stream, w_gu, use_dpas)) return false;
+    if (!mmid_dnn_ensure_u4(ctx, down->src[0], down, stream, w_down, use_dpas)) return false;
+
+    ggml_sycl_pool_alloc<mmid_row_mapping> map_dev(ctx.pool(), n_rows);
+    ggml_sycl_pool_alloc<int32_t> inv_dev(ctx.pool(), n_rows);
+    ggml_sycl_pool_alloc<int32_t> offs_dev(ctx.pool(), n_as);
+    ggml_sycl_pool_alloc<int32_t> actives_dev(ctx.pool(), n_rows + 1);
+    ggml_sycl_pool_alloc<int32_t> pbeg_dev(ctx.pool(), use_dpas ? n_as : 1);
+    ggml_sycl_pool_alloc<int32_t> prow_dev(ctx.pool(), use_dpas ? n_rows : 1);
+    // the dpas path needs no routing value on the host, so the sort can stay on the device
+    static const bool route_dev_on = ggml_sycl_get_env("GGML_SYCL_MOE_ROUTE_DEV", 1) != 0;
+    const bool route_dev = use_dpas && route_dev_on && n_rows > MMID_ROUTE_SMALL_MAX_ROWS;
+    ggml_sycl_pool_alloc<int32_t> cur_dev(ctx.pool(), route_dev ? n_as : 1);
+    ggml_sycl_pool_alloc<int32_t> beg_dev(ctx.pool(), route_dev ? n_as : 1);
+    bool route_small = false;
+    int32_t max_rows = 0;
+    if (route_dev) {
+        k_mmid_route_dev((const char *) ids->data, topk, n_tok, ids->nb[0], ids->nb[1],
+                         (int) n_as, map_dev.get(), inv_dev.get(), offs_dev.get(),
+                         pbeg_dev.get(), prow_dev.get(), cur_dev.get(), beg_dev.get(), stream);
+    } else if (n_rows <= MMID_ROUTE_SMALL_MAX_ROWS && n_as <= 1024) {
+        // decode / spec verify: route on the device, no readback (each expert gets at most n_tok rows)
+        k_mmid_route_small((const char *) ids->data, topk, n_tok, ids->nb[0], ids->nb[1],
+                           (int) n_as, map_dev.get(), inv_dev.get(), offs_dev.get(),
+                           actives_dev.get(), use_dpas ? pbeg_dev.get() : nullptr,
+                           use_dpas ? prow_dev.get() : nullptr, stream);
+        max_rows = (int32_t) n_tok;
+        route_small = true;
+    } else {
+        std::vector<char> ids_host(ggml_nbytes(ids));
+        SYCL_CHECK(CHECK_TRY_ERROR(stream->memcpy(ids_host.data(), ids->data, ggml_nbytes(ids))));
+        SYCL_CHECK(CHECK_TRY_ERROR(stream->wait()));
+        tick(8);   // everything the queue still owed plus the ids readback
+
+        std::vector<int64_t> expert_row_counts;
+        std::vector<int64_t> expert_row_offsets;
+        std::vector<mmid_row_mapping> & routed = ctx.mmid_row_mapping_host;
+        mmid_counting_sort_rows(ids, ids_host.data(), topk, n_as, n_rows,
+                                expert_row_counts, expert_row_offsets, routed);
+
+        // inverse of the sort for the reduce: routed row of (token, slot)
+        std::vector<int32_t> inv(n_rows);
+        for (int64_t r = 0; r < n_rows; ++r) {
+            inv[(int64_t) routed[r].i2 * topk + routed[r].i1] = (int32_t) r;
+        }
+        std::vector<int32_t> offs(n_as);
+        for (int64_t e = 0; e < n_as; ++e) {
+            offs[e] = (int32_t) expert_row_offsets[e + 1];
+            max_rows = std::max(max_rows, (int32_t) expert_row_counts[e]);
+        }
+        if (const char * dump = getenv("GGML_SYCL_MOE_DUMP_COUNTS")) {
+            static int32_t worst = 0;
+            if (max_rows > worst) {
+                worst = max_rows;
+                if (FILE * f = fopen(dump, "w")) {
+                    for (int64_t e = 0; e < n_as; ++e) {
+                        fprintf(f, "%d\n", (int) expert_row_counts[e]);
+                    }
+                    fclose(f);
+                }
+            }
+        }
+        SYCL_CHECK(CHECK_TRY_ERROR(stream->memcpy(map_dev.get(), routed.data(), n_rows * sizeof(mmid_row_mapping))));
+        SYCL_CHECK(CHECK_TRY_ERROR(stream->memcpy(inv_dev.get(), inv.data(), n_rows * sizeof(int32_t))));
+        SYCL_CHECK(CHECK_TRY_ERROR(stream->memcpy(offs_dev.get(), offs.data(), n_as * sizeof(int32_t))));
+        if (use_dpas) {
+            // activation-side row base per expert, rows padded to a dpas row block of 8
+            std::vector<int32_t> pbeg(n_as), prow(n_rows);
+            int32_t p = 0;
+            for (int64_t e = 0; e < n_as; ++e) {
+                pbeg[e] = p;
+                for (int64_t j = expert_row_offsets[e]; j < expert_row_offsets[e + 1]; ++j) {
+                    prow[j] = p + (int32_t) (j - expert_row_offsets[e]);
+                }
+                p += (int32_t) ((expert_row_counts[e] + 7) / 8 * 8);
+            }
+            SYCL_CHECK(CHECK_TRY_ERROR(stream->memcpy(pbeg_dev.get(), pbeg.data(), n_as * sizeof(int32_t))));
+            SYCL_CHECK(CHECK_TRY_ERROR(stream->memcpy(prow_dev.get(), prow.data(), n_rows * sizeof(int32_t))));
+        }
+        SYCL_CHECK(CHECK_TRY_ERROR(stream->wait()));
+        tick(9);
+    }
+
+    tick(0);
+
+    // pad the pd shape to a power-of-two row count: non-pow2 totals in 65..255 JIT
+    // a non-XMX grouped config (pp24/M=192: 18x the work-items at 6% XMX vs the
+    // M=256 config; M=128 and M=256 are both good). offsets bound the actual work,
+    // the padded tail belongs to no expert, and the fixed Ms cache one pd per tier.
+    // rows below GGML_SYCL_MOE_PAD_MIN (default: all decode/verify totals <= 64)
+    // keep their tuned pds; padding 64-row pp8 batches to M=128 measured -16%.
+    static const int moe_pad_min = ggml_sycl_get_env("GGML_SYCL_MOE_PAD_MIN", 65);
+    const int64_t n_rows_pd = n_rows < moe_pad_min ? n_rows : n_rows <= 128 ? 128 : n_rows <= 256 ? 256 : n_rows;
+
+    // staged debug mode: hand back to per-node execution after N fused stages
+    const char * dbg_stage_env = getenv("GGML_SYCL_MOE_FUSE_STAGE");
+    const int    dbg_stage     = dbg_stage_env ? atoi(dbg_stage_env) : 0;
+
+    // W4A8 at prefill shapes: quantize the routed activations per group and run the
+    // s8 x u4 grouped gemms (~1.5-2x the f16-src kernel at <= ~128 rows/expert, at the
+    // DRAM ceiling). Batches below GGML_SYCL_MOE_A8_MIN tokens (default 32: decode and
+    // spec-verify) keep the f16 path so their numerics are untouched - and because the
+    // s8 config is SLOWER there (pp8 in-graph: a8 35.3 ms/fwd vs f16 25.9, zp-folded
+    // no-zp variant 33.2; the s8 micro config drops to 51-65 GB/s at 1-2 rows/expert
+    // while f16 holds 75-83). Past ~128 rows/expert the f16 kernel is equal.
+    static const bool moe_a8_on  = ggml_sycl_get_env("GGML_SYCL_MOE_A8", 1) != 0;
+    static const int  moe_a8_min = ggml_sycl_get_env("GGML_SYCL_MOE_A8_MIN", 32);
+
+    // one row per active expert (decode) keeps the f16 gemv; everything else runs the
+    // s8 x u4 dpas gemm, which is the only kernel that reads the swizzled weights
+    static const bool smallm_on = ggml_sycl_get_env("GGML_SYCL_MOE_SMALLM", 1) != 0;
+    const bool use_smallm_dpas = use_dpas && smallm_on && route_small && dbg_stage == 0 && n_tok == 1;
+    const bool use_a8 = use_dpas ? !use_smallm_dpas
+                                 : (moe_a8_on && dbg_stage == 0 && n_tok >= moe_a8_min &&
+                                    n_rows / n_as <= 128 && (K1 % group) == 0 && (n_ff % group) == 0);
+
+    // the dpas gemm reads 8-row activation tiles, so every expert's rows start on a row
+    // block: P bounds the padded row count (at most 7 pad rows per active expert)
+    const int64_t P = use_dpas ? (n_rows + 7 * std::min<int64_t>(n_as, n_rows) + 7) / 8 * 8 : n_rows_pd;
+
+    // the VMM pool frees strictly LIFO: keep declaration order == allocation order
+    ggml_sycl_pool_alloc<sycl::half> act(ctx.pool());
+    ggml_sycl_pool_alloc<int8_t>     act_s8(ctx.pool());
+    ggml_sycl_pool_alloc<float>      act_sc(ctx.pool());
+    ggml_sycl_pool_alloc<int32_t>    act_sum(ctx.pool());
+    ggml_sycl_pool_alloc<sycl::half> act2(ctx.pool());
+    ggml_sycl_pool_alloc<int8_t>     act2_s8(ctx.pool());
+    ggml_sycl_pool_alloc<float>      act2_sc(ctx.pool());
+    ggml_sycl_pool_alloc<int32_t>    act2_sum(ctx.pool());
+    ggml_sycl_pool_alloc<sycl::half> gu_out(ctx.pool());
+    ggml_sycl_pool_alloc<sycl::half> down_out(ctx.pool());
+    // src1 quantized once per row (before the routed expansion), freed with the block
+    ggml_sycl_pool_alloc<int8_t>  xq(ctx.pool());
+    ggml_sycl_pool_alloc<float>   xsc(ctx.pool());
+    ggml_sycl_pool_alloc<int32_t> xsm(ctx.pool());
+    if (use_a8) {
+        act_s8.alloc((size_t) P * K1);
+        act_sc.alloc((size_t) P * (K1 / group));
+        if (use_dpas) {
+            act_sum.alloc((size_t) P * (K1 / group));
+        }
+        act2_s8.alloc((size_t) P * n_ff);
+        act2_sc.alloc((size_t) P * (n_ff / group));
+        if (use_dpas) {
+            act2_sum.alloc((size_t) P * (n_ff / group));
+        }
+    } else {
+        act.alloc((size_t) n_rows_pd * K1);
+        act2.alloc((size_t) n_rows_pd * n_ff);
+    }
+    if (!(use_dpas && glu_on && dbg_stage == 0 && ggml_sycl_moe_u4_dpas_glu_ok(n_ff))) {
+        gu_out.alloc((size_t) n_rows_pd * N1);
+    }
+    down_out.alloc((size_t) n_rows_pd * N2);
+
+    if (use_a8 && use_dpas) {
+        // pad rows are never quantized: zero their scales so the epilogue cannot pick up
+        // garbage exponents on rows whose result is thrown away
+        k_moe_zero_pad_scales(act_sc.get(), act_sum.get(), act2_sc.get(), act2_sum.get(),
+                              offs_dev.get(), pbeg_dev.get(), n_as, K1 / group, n_ff / group, P, stream);
+        const int64_t nx = x->ne[1] * x->ne[2];
+        xq.alloc((size_t) nx * K1);
+        xsc.alloc((size_t) nx * (K1 / group));
+        xsm.alloc((size_t) nx * (K1 / group));
+        k_moe_quant_rows((const char *) x->data, xq.get(), xsc.get(), xsm.get(),
+                         x->ne[1], x->nb[1], x->nb[2], K1, nx, stream);
+        tick(6);
+        k_moe_expand_pk(xq.get(), xsc.get(), xsm.get(), act_s8.get(), act_sc.get(), act_sum.get(),
+                        map_dev.get(), prow_dev.get(), x->ne[1], K1, n_rows, P, stream);
+        tick(7);
+    } else if (use_a8) {
+        k_moe_gather_quant_s8((const char *) x->data, act_s8.get(), act_sc.get(), map_dev.get(),
+                              x->ne[1], x->nb[1], x->nb[2], K1, n_rows, stream);
+    } else {
+        const unsigned int max_wg = ggml_sycl_info().max_work_group_sizes[ctx.device];
+        sycl::range<3> block_dims(1, 1, std::min((unsigned int) K1, max_wg));
+        sycl::range<3> grid_dims(1, 1, n_rows);
+        const char *__restrict x_data = (const char *) x->data;
+        sycl::half *__restrict act_get = act.get();
+        mmid_row_mapping *__restrict map_get = map_dev.get();
+        const int64_t ne11 = x->ne[1];
+        const size_t  nb11 = x->nb[1];
+        const size_t  nb12 = x->nb[2];
+        const int64_t ne10 = K1;
+        stream->submit([&](sycl::handler & cgh) {
+            cgh.parallel_for(
+                sycl::nd_range<3>(grid_dims * block_dims, block_dims),
+                [=](sycl::nd_item<3> item_ct1) {
+                    k_copy_src1_to_contiguous<sycl::half>(
+                        x_data, act_get, map_get, ne11, ne10, nb11, nb12, item_ct1);
+                });
+        });
+    }
+
+    tick(1);
+
+    // decode shape: the custom small-M gemv streams each active expert's u4 weights
+    // once at gemv-class bandwidth and folds the swiglu into the gate_up epilogue
+    // (tg 43.2 -> 45.0 over the oneDNN grouped config). verify batches (n_tok 2..8)
+    // stay on oneDNN: three gemv designs (SLM-serial, direct reads, double-buffered
+    // SLM) reached 164 vs its 176 t/s at pp8 - the multi-row activation reuse always
+    // pays either an L3 or a latency tax there.
+    const bool use_smallm = use_dpas ? use_smallm_dpas
+                                     : (smallm_on && !use_a8 && route_small && dbg_stage == 0 &&
+                                        n_tok == 1 && group == 64 &&
+                                        K1 % 512 == 0 && n_ff % 512 == 0 && N2 % 8 == 0);
+
+    if (use_smallm) {
+        const int n_slots = (int) std::min<int64_t>(n_rows, n_as);
+        // n_tok==1 guarantees R==1 per expert: the direct-read r1 kernel drops the SLM
+        // double-buffer + barriers (GGML_SYCL_MOE_GEMV_R1=0 falls back to the staged path).
+        static const bool r1 = ggml_sycl_get_env("GGML_SYCL_MOE_GEMV_R1", 1) != 0;
+        if (use_dpas) {
+            ggml_sycl_moe_u4_dpas_gemv(w_gu.w, w_gu.sc, w_gu.zp, act.get(), act2.get(),
+                    offs_dev.get(), actives_dev.get(), n_slots, N1, K1, true, stream);
+            ggml_sycl_moe_u4_dpas_gemv(w_down.w, w_down.sc, w_down.zp, act2.get(), down_out.get(),
+                    offs_dev.get(), actives_dev.get(), n_slots, N2, n_ff, false, stream);
+        } else if (r1) {
+            k_moe_gemv_u4_r1<true>(w_gu.w, w_gu.sc, w_gu.zp, act.get(), act2.get(),
+                                offs_dev.get(), actives_dev.get(), n_slots, N1, K1, stream);
+            k_moe_gemv_u4_r1<false>(w_down.w, w_down.sc, w_down.zp, act2.get(), down_out.get(),
+                                 offs_dev.get(), actives_dev.get(), n_slots, N2, n_ff, stream);
+        } else {
+            k_moe_gemv_u4<true>(w_gu.w, w_gu.sc, w_gu.zp, act.get(), act2.get(),
+                                offs_dev.get(), actives_dev.get(), n_slots, N1, K1, stream);
+            k_moe_gemv_u4<false>(w_down.w, w_down.sc, w_down.zp, act2.get(), down_out.get(),
+                                 offs_dev.get(), actives_dev.get(), n_slots, N2, n_ff, stream);
+        }
+
+        ggml_sycl_pool_alloc<float> w_copy_s(ctx.pool(), (size_t) n_rows);
+        SYCL_CHECK(CHECK_TRY_ERROR(stream->memcpy(w_copy_s.get(), m.weights->data, (size_t) n_rows * sizeof(float))));
+        k_moe_weighted_reduce(down_out.get(), w_copy_s.get(), inv_dev.get(), residual,
+                (float *) m.out->data, N2, topk, n_tok, stream);
+        return true;
+    }
+
+    const bool use_glu = use_dpas && glu_on && dbg_stage == 0 && ggml_sycl_moe_u4_dpas_glu_ok(n_ff);
+    if (use_glu) {
+        ggml_sycl_moe_u4_dpas_gemm_glu(w_gu.w, w_gu.sc, w_gu.zp, act_s8.get(), act_sc.get(),
+                act_sum.get(), offs_dev.get(), pbeg_dev.get(),
+                act2_s8.get(), act2_sc.get(), act2_sum.get(),
+                (int) n_as, (int) P, (int) n_ff, (int) K1, stream);
+    } else if (use_dpas) {
+        ggml_sycl_moe_u4_dpas_gemm(w_gu.w, w_gu.sc, w_gu.zp, act_s8.get(), act_sc.get(),
+                act_sum.get(), offs_dev.get(), pbeg_dev.get(), gu_out.get(),
+                (int) n_as, (int) P, (int) N1, (int) K1, stream);
+#if defined(DNNL_EXPERIMENTAL_GROUPED_MEMORY) && DNNL_EXPERIMENTAL_GROUPED_MEMORY
+    } else if (use_a8) {
+        DnnlGemmWrapper::grouped_gemm_w4a8(ctx, n_rows_pd, (int) n_as, (int) K1, (int) N1, group,
+                act_s8.get(), act_sc.get(), w_gu.w, w_gu.sc, w_gu.zp, offs_dev.get(), max_rows,
+                gu_out.get(), DnnlGemmWrapper::dt::f16, stream);
+    } else {
+        DnnlGemmWrapper::grouped_gemm_int4(ctx, n_rows_pd, (int) n_as, (int) K1, (int) N1, group,
+                act.get(), w_gu.w, w_gu.sc, w_gu.zp, offs_dev.get(), max_rows,
+                gu_out.get(), DnnlGemmWrapper::dt::f16, stream);
+#endif
+    }
+    tick(2);
+
+    const unsigned int max_wg2 = ggml_sycl_info().max_work_group_sizes[ctx.device];
+    auto scatter_f16_as_f32 = [&](const sycl::half * rows_src, int64_t row_elems, ggml_tensor * dst_t) {
+        ggml_sycl_pool_alloc<float> rows_f32(ctx.pool(), (size_t) n_rows * row_elems);
+        {
+            const sycl::half * hsrc = rows_src;
+            float * fdst = rows_f32.get();
+            const int64_t n = n_rows * row_elems;
+            stream->parallel_for(sycl::range<1>(n), [=](sycl::id<1> idx) {
+                fdst[idx[0]] = (float) hsrc[idx[0]];
+            });
+        }
+        sycl::range<3> block_dims(1, 1, std::min((unsigned int) dst_t->ne[0], max_wg2));
+        sycl::range<3> grid_dims(1, 1, n_rows);
+        const char * src_c = (const char *) rows_f32.get();
+        char * dst_c = (char *) dst_t->data;
+        const mmid_row_mapping *__restrict map_get = map_dev.get();
+        const int64_t ne0_ = dst_t->ne[0];
+        const size_t  nb1_ = dst_t->nb[1];
+        const size_t  nb2_ = dst_t->nb[2];
+        stream->submit([&](sycl::handler & cgh) {
+            cgh.parallel_for(
+                sycl::nd_range<3>(grid_dims * block_dims, block_dims),
+                [=](sycl::nd_item<3> item_ct1) {
+                    k_copy_dst_from_contiguous(dst_c, src_c, map_get, ne0_, nb1_, nb2_, item_ct1);
+                });
+        });
+        SYCL_CHECK(CHECK_TRY_ERROR(stream->wait()));   // rows_f32 is freed on return
+    };
+    if (dbg_stage == 1) {   // gather + gate_up gemm only, rest runs per-node
+        scatter_f16_as_f32(gu_out.get(), N1, m.gu_mmid);
+        const_cast<moe_fused_nodes &>(m).count = 1;
+        return true;
+    }
+
+    if (use_glu) {
+        // already done in the gate_up epilogue
+    } else if (use_dpas) {
+        k_moe_swiglu_quant_pk(gu_out.get(), act2_s8.get(), act2_sc.get(), act2_sum.get(),
+                              prow_dev.get(), n_ff, n_rows, P, stream);
+    } else if (use_a8) {
+        k_moe_swiglu_quant_s8(gu_out.get(), act2_s8.get(), act2_sc.get(), n_ff, n_rows, stream);
+    } else {
+        k_moe_swiglu_to_f16(gu_out.get(), act2.get(), n_ff, n_rows, stream);
+    }
+    tick(3);
+    static const bool glu_check = getenv("GGML_SYCL_MOE_GLU_CHECK") != nullptr;
+    if (use_dpas && glu_check) {
+        static int nchk = 0;
+        if (nchk < 2) {
+            ++nchk;
+            std::vector<int8_t>  h_q((size_t) P * n_ff);
+            std::vector<float>   h_s((size_t) P * (n_ff / group));
+            std::vector<int32_t> h_m((size_t) P * (n_ff / group));
+            SYCL_CHECK(CHECK_TRY_ERROR(stream->memcpy(h_q.data(), act2_s8.get(), h_q.size())));
+            SYCL_CHECK(CHECK_TRY_ERROR(stream->memcpy(h_s.data(), act2_sc.get(), h_s.size() * 4)));
+            SYCL_CHECK(CHECK_TRY_ERROR(stream->memcpy(h_m.data(), act2_sum.get(), h_m.size() * 4).wait()));
+            double qs = 0.0, ss = 0.0, ms = 0.0;
+            for (size_t i = 0; i < h_q.size(); ++i) qs += std::abs((int) h_q[i]);
+            for (size_t i = 0; i < h_s.size(); ++i) ss += std::abs(h_s[i]);
+            for (size_t i = 0; i < h_m.size(); ++i) ms += std::abs((double) h_m[i]);
+            fprintf(stderr, "[GLU_CHECK] glu=%d n_rows=%d P=%d n_ff=%d  |q|=%.0f  |sc|=%.4f  |sum|=%.0f"
+                            "  q[0..7]=%d %d %d %d %d %d %d %d  sc[0]=%.6f sum[0]=%d\n",
+                    (int) use_glu, (int) n_rows, (int) P, (int) n_ff, qs, ss, ms,
+                    h_q[0], h_q[1], h_q[2], h_q[3], h_q[4], h_q[5], h_q[6], h_q[7],
+                    h_s[0], h_m[0]);
+        }
+    }
+    if (dbg_stage == 2) {   // + swiglu, scattered into the glu tensor
+        scatter_f16_as_f32(act2.get(), n_ff, m.down_mmid->src[1]);
+        const_cast<moe_fused_nodes &>(m).count = 4;
+        return true;
+    }
+
+    if (use_dpas) {
+        ggml_sycl_moe_u4_dpas_gemm(w_down.w, w_down.sc, w_down.zp, act2_s8.get(), act2_sc.get(),
+                act2_sum.get(), offs_dev.get(), pbeg_dev.get(), down_out.get(),
+                (int) n_as, (int) P, (int) N2, (int) n_ff, stream);
+#if defined(DNNL_EXPERIMENTAL_GROUPED_MEMORY) && DNNL_EXPERIMENTAL_GROUPED_MEMORY
+    } else if (use_a8) {
+        DnnlGemmWrapper::grouped_gemm_w4a8(ctx, n_rows_pd, (int) n_as, (int) n_ff, (int) N2, group,
+                act2_s8.get(), act2_sc.get(), w_down.w, w_down.sc, w_down.zp, offs_dev.get(), max_rows,
+                down_out.get(), DnnlGemmWrapper::dt::f16, stream);
+    } else {
+        DnnlGemmWrapper::grouped_gemm_int4(ctx, n_rows_pd, (int) n_as, (int) n_ff, (int) N2, group,
+                act2.get(), w_down.w, w_down.sc, w_down.zp, offs_dev.get(), max_rows,
+                down_out.get(), DnnlGemmWrapper::dt::f16, stream);
+#endif
+    }
+    tick(4);
+    if (dbg_stage == 3) {   // + down gemm, weighted sum runs per-node
+        scatter_f16_as_f32(down_out.get(), N2, m.down_mmid);
+        const_cast<moe_fused_nodes &>(m).count = 5;
+        return true;
+    }
+
+    // the graph allocator may alias m.out onto the (dead-after-mul) weights tensor;
+    // the fused reduce reads weights while writing m.out, so read from a copy
+    ggml_sycl_pool_alloc<float> w_copy(ctx.pool(), (size_t) n_rows);
+    SYCL_CHECK(CHECK_TRY_ERROR(stream->memcpy(w_copy.get(), m.weights->data, (size_t) n_rows * sizeof(float))));
+    k_moe_weighted_reduce(down_out.get(), w_copy.get(), inv_dev.get(), residual,
+            (float *) m.out->data, N2, topk, n_tok, stream);
+    tick(5);
+    static const bool out_check = getenv("GGML_SYCL_MOE_OUT_CHECK") != nullptr;
+    if (out_check) {
+        static int nout = 0;
+        if (nout < 3) {
+            ++nout;
+            const size_t n = ggml_nelements(m.out);
+            std::vector<float> h(n);
+            SYCL_CHECK(CHECK_TRY_ERROR(stream->memcpy(h.data(), m.out->data, n * 4).wait()));
+            double sum = 0.0, amax = 0.0;
+            for (size_t i = 0; i < n; ++i) {
+                sum  += std::abs((double) h[i]);
+                amax  = std::max(amax, (double) std::abs(h[i]));
+            }
+            fprintf(stderr, "[OUT_CHECK] layer %d  n=%zu  sum|out|=%.3f  max|out|=%.5f  out[0]=%.6f out[1]=%.6f\n",
+                    nout, n, sum, amax, h[0], h[1]);
+        }
+    }
+    if (stage_time && ++stage_calls % stage_time == 0) {
+        double tot = 0.0;
+        for (int s = 0; s < 10; ++s) {
+            tot += stage_acc[s];
+        }
+        fprintf(stderr, "[MOE_STAGE] %d calls  %.3f ms/call  route %.3f  quant %.3f  gate_up %.3f"
+                        "  swiglu %.3f  down %.3f  reduce %.3f  qrow %.3f  expand %.3f"
+                        "  ids %.3f  sort %.3f   rows/expert %d max %d\n",
+                stage_calls, tot / stage_calls, stage_acc[0] / stage_calls, stage_acc[1] / stage_calls,
+                stage_acc[2] / stage_calls, stage_acc[3] / stage_calls, stage_acc[4] / stage_calls,
+                stage_acc[5] / stage_calls, stage_acc[6] / stage_calls, stage_acc[7] / stage_calls,
+                stage_acc[8] / stage_calls, stage_acc[9] / stage_calls,
+                (int) (n_rows / n_as), (int) max_rows);
+    }
+    return true;
+} catch (const dnnl::error & de) {
+    fprintf(stderr, "[MOE_FUSED] dnnl error, falling back: status=%d %s\n", (int) de.status, de.message);
+    return false;
+}
+
+
+struct ffn_fused_nodes {
+    ggml_tensor * mm_gate;
+    ggml_tensor * mm_up;
+    ggml_tensor * mm_down;
+    ggml_tensor * residual;   // src of a folded trailing residual add, or null
+    ggml_tensor * out;        // the add node when folded, else mm_down
+    int           count;
+    bool          use_u4;     // weights converted in place to u4 -> W4A16 gemms
+    bool          geglu;
+    // gated shared expert: out = down * sigmoid(gate_mm) + res2 + residual, gate_mm and gate_act run before the down gemm
+    ggml_tensor * gate_mm  = nullptr;
+    ggml_tensor * gate_act = nullptr;
+    ggml_tensor * res2     = nullptr;
+};
+
+// Matches the dense FFN block emitted by build_ffn (LLM_FFN_SILU + LLM_FFN_PAR):
+//   MUL_MAT(gate) MUL_MAT(up) -> GLU(swiglu split) -> MUL_MAT(down)
+// so it can run on the int8 gemm path with f16 intermediates and the swiglu
+// output quantized directly for the down gemm (no f32 round trips).
+static bool ggml_sycl_ffn_fused_match(const ggml_cgraph * g, int i, ffn_fused_nodes & m) {
+    if (i + 4 > g->n_nodes) return false;
+    ggml_tensor * mm0  = g->nodes[i];
+    ggml_tensor * mm1  = g->nodes[i + 1];
+    ggml_tensor * glu  = g->nodes[i + 2];
+    ggml_tensor * down = g->nodes[i + 3];
+    if (mm0->op != GGML_OP_MUL_MAT || mm1->op != GGML_OP_MUL_MAT ||
+        glu->op != GGML_OP_GLU || down->op != GGML_OP_MUL_MAT) return false;
+    const ggml_glu_op glu_op = ggml_get_glu_op(glu);
+    if (glu_op != GGML_GLU_OP_SWIGLU && glu_op != GGML_GLU_OP_GEGLU) return false;
+    if (ggml_get_op_params_i32(glu, 1) != 0) return false;   // swapped halves
+    ggml_tensor * mm_gate = glu->src[0];
+    ggml_tensor * mm_up   = glu->src[1];
+    if (!((mm_gate == mm0 && mm_up == mm1) || (mm_gate == mm1 && mm_up == mm0))) return false;
+    if (down->src[1] != glu) return false;
+    if (mm_gate->src[1] != mm_up->src[1]) return false;
+
+    const ggml_op ops[4] = { GGML_OP_MUL_MAT, GGML_OP_MUL_MAT, GGML_OP_GLU, GGML_OP_MUL_MAT };
+    const int out_idx = i + 3;
+    if (!ggml_can_fuse_subgraph(g, i, 4, ops, &out_idx, 1)) return false;
+
+    const ggml_tensor * x = mm_gate->src[1];
+    if (x->type != GGML_TYPE_F32 || !ggml_is_contiguous(x) || x->ne[2] != 1 || x->ne[3] != 1) return false;
+    if (glu->type != GGML_TYPE_F32 || down->type != GGML_TYPE_F32 || !ggml_is_contiguous(down)) return false;
+    // decode stays on the mmvq fast path; the int8 gemms take batches past 8, the exact ones narrow batches too
+    if (x->ne[1] < (g_ggml_sycl_dnn_int8 && g_ggml_sycl_enable_dnn ? 9 : ggml_sycl_gguf_min_m())) return false;
+
+    int n_u4 = 0;
+    for (const ggml_tensor * mm : { mm_gate, mm_up, down }) {
+        const ggml_tensor * w = mm->src[0];
+        const bool exact = g_ggml_sycl_gguf_gemm && ggml_sycl_gguf_gemm_ok(w->type, w->ne[1], w->ne[0]);
+        if (!(dnn_int8_supported_type(w->type) || exact) || !ggml_is_contiguous(w)) return false;
+        if ((!exact && w->ne[0] % 128) || w->ne[1] < 32 || w->ne[2] != 1) return false;
+        if (g_ggml_sycl_u4_dense && w->extra != nullptr &&
+            (((const ggml_tensor_extra_gpu *) w->extra)->optimized_feature.u4_dense ||
+             dense_u4_eligible(w))) {
+            n_u4++;
+        }
+    }
+    if (n_u4 != 0 && n_u4 != 3) return false;   // mixed formats fall back per-node
+    if (mm_gate->src[0]->ne[1] != mm_up->src[0]->ne[1]) return false;
+    if (down->src[0]->ne[0] != mm_gate->src[0]->ne[1]) return false;
+
+    m = { mm_gate, mm_up, down, nullptr, down, 4, n_u4 == 3, glu_op == GGML_GLU_OP_GEGLU };
+
+    // fold a directly following residual add into the down gemm when possible
+    if (i + 4 < g->n_nodes) {
+        ggml_tensor * res_add = g->nodes[i + 4];
+        ggml_tensor * other = res_add->src[0] == down ? res_add->src[1]
+                            : res_add->src[1] == down ? res_add->src[0] : nullptr;
+        if (res_add->op == GGML_OP_ADD && other && other->type == GGML_TYPE_F32 &&
+            res_add->type == GGML_TYPE_F32 && ggml_are_same_shape(res_add, down) &&
+            ggml_are_same_shape(other, down) && ggml_is_contiguous(other) &&
+            ggml_is_contiguous(res_add)) {
+            const ggml_op ops5[5] = { GGML_OP_MUL_MAT, GGML_OP_MUL_MAT, GGML_OP_GLU,
+                                      GGML_OP_MUL_MAT, GGML_OP_ADD };
+            const int out_idx5 = i + 4;
+            // the post-op reads the residual while the gemm writes out; exact
+            // in-place is fine (per-element read before write), partial is not
+            const char * rb = (const char *) other->data;
+            const char * ob = (const char *) res_add->data;
+            const bool disjoint = rb + ggml_nbytes(other) <= ob || ob + ggml_nbytes(res_add) <= rb;
+            if ((disjoint || rb == ob) && ggml_can_fuse_subgraph(g, i, 5, ops5, &out_idx5, 1)) {
+                m.residual = other;
+                m.out      = res_add;
+                m.count    = 5;
+            }
+        }
+    }
+    // or the gated shared-expert tail of qwen3.5 MoE, folded into the exact down gemm:
+    //   MUL_MAT(gate, x) -> SIGMOID -> MUL(down, .) -> ADD(moe_out, .) -> ADD(., residual)
+    if (m.count == 4 && !m.use_u4 && g_ggml_sycl_gguf_gemm && !(g_ggml_sycl_dnn_int8 && g_ggml_sycl_enable_dnn) &&
+        i + 8 < g->n_nodes) {
+        ggml_tensor * gmm = g->nodes[i + 4];
+        ggml_tensor * sig = g->nodes[i + 5];
+        ggml_tensor * mul = g->nodes[i + 6];
+        ggml_tensor * ad1 = g->nodes[i + 7];
+        ggml_tensor * ad2 = g->nodes[i + 8];
+        const bool chain = gmm->op == GGML_OP_MUL_MAT && gmm->src[1] == x && gmm->type == GGML_TYPE_F32 &&
+                           gmm->ne[0] == 1 && gmm->ne[1] == down->ne[1] && ggml_is_contiguous(gmm) &&
+                           sig->op == GGML_OP_UNARY && ggml_get_unary_op(sig) == GGML_UNARY_OP_SIGMOID &&
+                           sig->src[0] == gmm && sig->type == GGML_TYPE_F32 && ggml_is_contiguous(sig) &&
+                           mul->op == GGML_OP_MUL &&
+                           ((mul->src[0] == down && mul->src[1] == sig) || (mul->src[0] == sig && mul->src[1] == down)) &&
+                           ad1->op == GGML_OP_ADD && (ad1->src[0] == mul || ad1->src[1] == mul) &&
+                           ad2->op == GGML_OP_ADD && (ad2->src[0] == ad1 || ad2->src[1] == ad1);
+        if (chain) {
+            ggml_tensor * other = ad1->src[0] == mul ? ad1->src[1] : ad1->src[0];
+            ggml_tensor * resid = ad2->src[0] == ad1 ? ad2->src[1] : ad2->src[0];
+            // the gemm store reads both addends while writing ad2: exact in-place is fine, partial is not
+            auto safe = [&](const ggml_tensor * t) {
+                const char * tb = (const char *) t->data;
+                const char * ob = (const char *) ad2->data;
+                return t->type == GGML_TYPE_F32 && ggml_are_same_shape(t, down) && ggml_is_contiguous(t) &&
+                       (tb == ob || tb + ggml_nbytes(t) <= ob || ob + ggml_nbytes(ad2) <= tb);
+            };
+            const ggml_op ops9[9] = { GGML_OP_MUL_MAT, GGML_OP_MUL_MAT, GGML_OP_GLU,  GGML_OP_MUL_MAT, GGML_OP_MUL_MAT,
+                                      GGML_OP_UNARY,   GGML_OP_MUL,     GGML_OP_ADD,  GGML_OP_ADD };
+            const int     out_idx9 = i + 8;
+            if (other != mul && resid != ad1 && safe(other) && safe(resid) && ad2->type == GGML_TYPE_F32 &&
+                ggml_are_same_shape(ad2, down) && ggml_is_contiguous(ad2) &&
+                ggml_can_fuse_subgraph(g, i, 9, ops9, &out_idx9, 1)) {
+                m.residual = resid;
+                m.res2     = other;
+                m.gate_mm  = gmm;
+                m.gate_act = sig;
+                m.out      = ad2;
+                m.count    = 9;
+            }
+        }
+    }
+    return true;
+}
+
+static bool ggml_sycl_compute_forward(ggml_backend_sycl_context & ctx, struct ggml_tensor * dst);
+
+// Executes the matched dense FFN block: shared src quant -> gate/up int8 gemms
+// (f16 dst) -> fused swiglu+s8 quant -> down int8 gemm into the graph tensor.
+// Returns false (nothing written to graph tensors) to fall back per-node.
+// dense FFN on the exact gemm: gate and up in one kernel with the swiglu in its epilogue, which writes the down gemm's packed input
+static bool ggml_sycl_ffn_fused_exec_gguf(ggml_backend_sycl_context & ctx, const ffn_fused_nodes & m) {
+    const ggml_tensor * wg = m.mm_gate->src[0];
+    const ggml_tensor * wu = m.mm_up->src[0];
+    const ggml_tensor * wd = m.mm_down->src[0];
+    const ggml_tensor * x  = m.mm_gate->src[1];
