+            const int      v1 = (int) (lut[(q >> 16) & 0xFF] | (lut[q >> 24] << 16));
+            sumi              = dpct::dp4a(v0, a.u[2 * j + 0], sumi);
+            sumi              = dpct::dp4a(v1, a.u[2 * j + 1], sumi);
+        }
+        return w.d * a.d8 * sumi;
+    }
