+
+#include "gguf_gemm.hpp"
+#include "gguf_gemm_launch.hpp"
+
+// activations are packed for M rounded up to the largest token tile of a work-group (the int8 gemms' 256, whose tile
+// stores cover it, see gguf_gemm_i8_kernels.hpp)
+static constexpr int64_t GGUF_MP = 256;
+
+// A discrete GPU (Arc Pro B70: 24 MB L2, ~600 GB/s) is fastest with the weight panel outer at any M, over groups of
+// 1024 tokens once the f16 activations outgrow L2, and splits every large-K gemm. An integrated one (Arc B390: 16 MB
+// cache on ~110 GB/s shared memory) must switch to token-outer once the activations outgrow the cache, or it
+// re-streams them for every weight panel.
+// decided once (the current-device lookup takes a lock); a mix with an integrated GPU keeps the integrated rules
+static bool gguf_discrete() {
+    static const bool discrete = [] {
+        const auto & info = ggml_sycl_info();
+        bool all = info.device_count > 0;
+        for (int i = 0; i < info.device_count; ++i) {
+            all = all && info.devices[i].l0_device_type_valid && info.devices[i].l0_discrete_gpu;
+        }
+        return all;
+    }();
+    return discrete;
+}
+
+// the wg_panels mode of a gemm over a k slice of K: 0 token-outer, 1 weight-outer, 2 weight-outer over groups of
+// GGUF_GROUP_TOKENS tokens. On B70 the groups gain 4-18% at M = 2048 and 15-64% at M = 4096 (Qwen3.8-27B shapes)
+static int gguf_rast(ggml_type type, int64_t M, int64_t K) {
+    if (gguf_discrete()) {
+        return M > GGUF_GROUP_TOKENS && M * K * 2 > (int64_t) 12 * 1024 * 1024 ? 2 : 1;
+    }
+    return type == GGML_TYPE_Q6_K || M * K < (int64_t) 8 * 1024 * 1024 ? 1 : 0;
+}
+
+// the IQ types have tuned kernels on their file layout, which serves until their reorder (for good with
+// GGML_SYCL_ENABLE_OPT=0); the K-quants' file layout only serves until the first reorder
+static bool gguf_file_layout_tuned(ggml_type type) {
+    return type == GGML_TYPE_IQ4_XS || type == GGML_TYPE_IQ4_NL || type == GGML_TYPE_IQ3_S;
+}
+
+bool ggml_sycl_gguf_gemm_ok(ggml_type type, int64_t N, int64_t K) {
+    // gather offsets are 32-bit
+    if ((double) N * K > 4.0e9) {
+        return false;
+    }
+    switch (type) {
+        case GGML_TYPE_Q8_0: return N % 32 == 0 && K % 64 == 0;   // N % 128 != 0 takes the narrow kernel
+        case GGML_TYPE_Q3_K:
+        case GGML_TYPE_Q4_K:
+        case GGML_TYPE_Q5_K:
+        case GGML_TYPE_IQ4_XS:
+        case GGML_TYPE_IQ4_NL: return N % 128 == 0 && K % 256 == 0;
+        case GGML_TYPE_Q6_K: return N % 64 == 0 && K % 512 == 0;
+        case GGML_TYPE_IQ3_S: return N % 128 == 0 && K % 512 == 0;
+        default:             return false;
+    }
+}
+
+bool ggml_sycl_gguf_gemm_layout_ok(ggml_type type, bool reordered, int64_t M) {
+    // Q3_K is read only after the reorder: its 110 B file blocks are not dword aligned; the narrow kernels only read
+    // the reorder layout (the first exact gemm of a weight reorders it)
+    return reordered || (type != GGML_TYPE_Q3_K && M > GGML_SYCL_GGUF_NW_MAX_M);
+}
+
+size_t ggml_sycl_gguf_gemm_act_elems(int64_t M, int64_t K) {
+    return (size_t) ((M + GGUF_MP - 1) / GGUF_MP * GGUF_MP) * K;
+}
+
+template <bool SOA>
+static void gguf_gemm_launch(ggml_type type, const uint8_t * w, const sycl::half * act, float * dst, int M, int N,
+                             int K, int rast, int ks, const gguf_xmx::gemm_epi & epi, sycl::queue & q) {
+    switch (rast) {
+        case 0:  gguf_gemm_launch<SOA, 0>(type, w, act, dst, M, N, K, ks, epi, q); break;
+        case 1:  gguf_gemm_launch<SOA, 1>(type, w, act, dst, M, N, K, ks, epi, q); break;
+        default: gguf_gemm_launch_grouped(SOA, type, w, act, dst, M, N, K, ks, epi, q); break;
+    }
+}
+
+int ggml_sycl_gguf_gemm_splits(ggml_type type, int64_t M, int64_t N, int64_t K) {
+    GGML_UNUSED(N);
+    // a narrow gemm splits K inside its work-groups
+    if (K < 8192 || type == GGML_TYPE_Q8_0 || M <= GGML_SYCL_GGUF_NW_MAX_M) {
+        return 1;
+    }
+    if (gguf_discrete()) {
+        // two k slices keep a small grid fed, and with the rasterization groups they win at any M as well;
+        // every slice must hold whole super-blocks (block pairs for Q6_K / IQ3_S)
+        const int64_t unit = type == GGML_TYPE_Q6_K || type == GGML_TYPE_IQ3_S ? 512 : 256;
+        return (K / unit) % 2 == 0 ? 2 : 1;
+    }
+    // with a large K the activations of the work-groups in flight overflow L3: the k slices run as one grid, then a reduce
+    if (type == GGML_TYPE_Q6_K) {
+        return (K / 512) % 3 == 0 ? 3 : (K / 512) % 2 == 0 ? 2 : 1;
+    }
+    // Q4_K only gains once the weight-inner rasterization is in use
+    if (type == GGML_TYPE_Q4_K && gguf_rast(type, M, K) == 0) {
+        return (K / 256) % 2 == 0 ? 2 : 1;
+    }
+    return 1;
+}
+
+void ggml_sycl_gguf_pack(const float * x, int64_t ldx, sycl::half * act, int64_t M, int64_t K, queue_ptr stream) {
+    gguf_xmx::pack_act(*stream, x, ldx, act, (int) M, (int) K);
+}
+
+bool ggml_sycl_gguf_rms_pack_ok(int64_t K) {
+    return K % 128 == 0;
+}
+
+void ggml_sycl_gguf_rms_pack(const float * x, int64_t ldx, const float * w, float * dst, int64_t ldd, sycl::half * act,
+                             int64_t M, int64_t K, float eps, queue_ptr stream) {
+    GGML_ASSERT(ggml_sycl_gguf_rms_pack_ok(K));
+    // the largest thread count that divides the 128-column spans and still fits one Xe core
+    const int nkc = (int) (K / 128);
+    int       wgt = std::min(nkc, gguf_xmx::RMS_WGT_MAX);
+    while (nkc % wgt != 0) {
+        --wgt;
+    }
+    if (M <= GGML_SYCL_GGUF_NW_MAX_M) {
+        gguf_xmx::rms_pack_act_rows(*stream, x, ldx, w, dst, ldd, act, (int) M, (int) K, eps, wgt);
+    } else {
+        gguf_xmx::rms_pack_act(*stream, x, ldx, w, dst, ldd, act, (int) M, (int) K, eps, wgt);
+    }
+}
+
+void ggml_sycl_gguf_silu_mul_pack(const float * z, int64_t ldz, const float * a, int64_t lda, float * dst, int64_t ldd,
+                                  sycl::half * act, int64_t M, int64_t K, queue_ptr stream) {
+    GGML_ASSERT(K % 64 == 0);
+    gguf_xmx::silu_mul_pack(*stream, z, ldz, a, lda, dst, ldd, act, (int) M, (int) K);
+}
+
+void ggml_sycl_gguf_gemm(ggml_type type, const void * w, bool reordered, const sycl::half * act, float * dst,
+                         int64_t M, int64_t N, int64_t K, queue_ptr stream, const float * res, const float * res2,
+                         const float * rs, float * part) {
+    GGML_ASSERT(ggml_sycl_gguf_gemm_ok(type, N, K) && ggml_sycl_gguf_gemm_layout_ok(type, reordered, M));
+    const int                ks   = part != nullptr && (reordered || gguf_file_layout_tuned(type)) ? ggml_sycl_gguf_gemm_splits(type, M, N, K) : 1;
+    const bool               grp  = (reordered || type == GGML_TYPE_IQ3_S) && (type != GGML_TYPE_Q8_0 || N % 128 == 0);
+    const int                rast = std::min(gguf_rast(type, M, K / ks), grp ? 2 : 1);
+    const gguf_xmx::gemm_epi epi{ res, res2, rs, part };
+    if (M <= GGML_SYCL_GGUF_NW_MAX_M) {
+        gguf_gemm_launch_narrow(type, (const uint8_t *) w, act, dst, (int) M, (int) N, (int) K, epi, *stream);
+    } else if (reordered) {
+        gguf_gemm_launch<true>(type, (const uint8_t *) w, act, dst, (int) M, (int) N, (int) K, rast, ks, epi, *stream);
+    } else {
+        // a K-quant's file layout only serves until the first reorder, weight-outer is enough there
+        const bool keep = gguf_file_layout_tuned(type);
+        gguf_gemm_launch<false>(type, (const uint8_t *) w, act, dst, (int) M, (int) N, (int) K, keep ? rast : 1,
+                                keep ? ks : 1, epi, *stream);
+    }
+}
+
+void ggml_sycl_gguf_gemm_packed(ggml_type type, const void * w, bool reordered, const sycl::half * act, int64_t M,
+                                int64_t N, int64_t K, queue_ptr stream, float * tiles, const float * glu,
+                                sycl::half * pack) {
+    GGML_ASSERT(ggml_sycl_gguf_gemm_ok(type, N, K) && N % 128 == 0 && (tiles != nullptr) != (pack != nullptr));
+    GGML_ASSERT(ggml_sycl_gguf_gemm_layout_ok(type, reordered, M));
+    gguf_xmx::gemm_epi epi;
+    epi.tiles = tiles;
+    epi.glu   = glu;
+    epi.pack  = pack;
+    const int rast = std::min(gguf_rast(type, M, K), reordered || type == GGML_TYPE_IQ3_S ? 2 : 1);
+    if (M <= GGML_SYCL_GGUF_NW_MAX_M) {
+        gguf_gemm_launch_narrow(type, (const uint8_t *) w, act, nullptr, (int) M, (int) N, (int) K, epi, *stream);
+    } else if (reordered) {
+        gguf_gemm_launch<true>(type, (const uint8_t *) w, act, nullptr, (int) M, (int) N, (int) K, rast, 1, epi, *stream);
+    } else {
+        gguf_gemm_launch<false>(type, (const uint8_t *) w, act, nullptr, (int) M, (int) N, (int) K, rast, 1, epi, *stream);
+    }
+}
+
+bool ggml_sycl_gguf_glu_ok(ggml_type type, int64_t N, int64_t K) {
+    if (N % 64 != 0 || (double) N * K >= 4.0e9) {
+        return false;
+    }
+    switch (type) {
+        case GGML_TYPE_Q8_0: return K % 64 == 0;
+        case GGML_TYPE_Q4_K:
+        case GGML_TYPE_Q5_K:
+        case GGML_TYPE_IQ4_XS:
+        case GGML_TYPE_IQ4_NL: return K % 256 == 0;
+        default: return false;
+    }
+}
+
+bool ggml_sycl_gguf_glu_layout_ok(ggml_type type, bool reordered) {
+    // the IQ4 dual gemm reads the file layout; in the pair order the split gate / up gemms are faster anyway
+    return !reordered || (type != GGML_TYPE_IQ4_XS && type != GGML_TYPE_IQ4_NL);
+}
+
+void ggml_sycl_gguf_glu(ggml_type type, const void * wg, const void * wu, bool reordered, const sycl::half * act,
+                        sycl::half * out, int64_t M, int64_t N, int64_t K, queue_ptr stream, bool geglu) {
+    GGML_ASSERT(ggml_sycl_gguf_glu_ok(type, N, K) && ggml_sycl_gguf_glu_layout_ok(type, reordered));
+    const uint8_t * g = (const uint8_t *) wg;
+    const uint8_t * u = (const uint8_t *) wu;
+    const int rast = gguf_rast(type, M, K);
+    if (!reordered) {
+        // the IQ types have tuned file-layout kernels, so their rasterization still matters (the groups aside:
+        // the file layout of the others only serves until the first reorder)
+        if (gguf_file_layout_tuned(type) && rast == 0) {
+            gguf_glu_launch<0, false>(type, g, u, act, out, (int) M, (int) N, (int) K, *stream, geglu);
+        } else {
+            gguf_glu_launch<1, false>(type, g, u, act, out, (int) M, (int) N, (int) K, *stream, geglu);
+        }
+    } else if (rast == 2) {
+        gguf_glu_launch_grouped(type, g, u, act, out, (int) M, (int) N, (int) K, *stream, geglu);
+    } else if (rast == 1) {
+        gguf_glu_launch<1, true>(type, g, u, act, out, (int) M, (int) N, (int) K, *stream, geglu);
+    } else {
+        gguf_glu_launch<0, true>(type, g, u, act, out, (int) M, (int) N, (int) K, *stream, geglu);
+    }
+}
+
+bool ggml_sycl_gguf_moe_ok(ggml_type type, int64_t N, int64_t K) {
