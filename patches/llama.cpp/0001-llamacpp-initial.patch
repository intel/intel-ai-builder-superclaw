diff --git a/repack_gateup.py b/repack_gateup.py
new file mode 100644
index 0000000000000000000000000000000000000000..f3365e6b40ac32784b67a5a4e24ffffb5fd4d788
--- /dev/null
+++ b/repack_gateup.py
@@ -0,0 +1,77 @@
+#!/usr/bin/env python3
+# Repack a Qwen3.5-MoE GGUF so each layer's separate ffn_gate_exps + ffn_up_exps are merged into
+# one ffn_gate_up_exps [n_embd, 2*n_ff, n_expert] (per-expert: gate rows then up rows). This is a
+# pure byte-level concat of the quantized blocks (no dequant), enabling llama's native fused
+# gate_up path (one mul_mat_id instead of two). Same-quant assumed for gate & up.
+import sys, re, argparse
+sys.path.insert(0, "gguf-py")
+import numpy as np
+import gguf
+from gguf import GGUFReader, GGUFWriter
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("inp"); ap.add_argument("out")
+    a = ap.parse_args()
+
+    reader = GGUFReader(a.inp)
+    arch = reader.fields["general.architecture"].contents()
+    print(f"arch = {arch}")
+    writer = GGUFWriter(a.out, arch)
+
+    # --- copy KV metadata (GGUFWriter emits GGUF.* and general.architecture itself) ---
+    for field in reader.fields.values():
+        if field.name == gguf.Keys.General.ARCHITECTURE or field.name.startswith("GGUF."):
+            continue
+        vt = field.types[0]
+        st = field.types[-1] if vt == gguf.GGUFValueType.ARRAY else None
+        writer.add_key_value(field.name, field.contents(), vt, sub_type=st)
+
+    # --- collect gate/up data per layer ---
+    pat = re.compile(r"blk\.(\d+)\.ffn_(gate|up)_exps\.weight$")
+    gate, up, gtype = {}, {}, {}
+    for t in reader.tensors:
+        m = pat.match(t.name)
+        if m:
+            L, which = int(m.group(1)), m.group(2)
+            (gate if which == "gate" else up)[L] = t
+            if which == "gate":
+                gtype[L] = t.tensor_type
+
+    # --- build output tensor list in reader order; replace gate with merged, drop up ---
+    out = []   # (name, np_data, ggml_type)
+    n_merged = 0
+    for t in reader.tensors:
+        m = pat.match(t.name)
+        if m:
+            L, which = int(m.group(1)), m.group(2)
+            if which == "gate":
+                g, u = gate[L], up[L]
+                assert g.tensor_type == u.tensor_type, f"layer {L} gate/up quant mismatch"
+                assert g.data.shape == u.data.shape, f"layer {L} shape mismatch"
+                merged = np.concatenate([g.data, u.data], axis=1)  # (n_expert, 2*n_ff, row_bytes)
+                out.append((f"blk.{L}.ffn_gate_up_exps.weight", merged, g.tensor_type))
+                n_merged += 1
+            # drop both gate and up
+            continue
+        out.append((t.name, t.data, t.tensor_type))
+
+    print(f"merged {n_merged} layers; total tensors {len(out)} (was {len(reader.tensors)})")
+    sample = next(o for o in out if "gate_up" in o[0])
+    print(f"sample merged: {sample[0]} data.shape={sample[1].shape} dtype={sample[1].dtype} type={sample[2].name}")
+
+    for name, data, ttype in out:
+        writer.add_tensor_info(name, data.shape, data.dtype, data.nbytes, ttype)
+
+    writer.write_header_to_file()
+    writer.write_kv_data_to_file()
+    writer.write_ti_data_to_file()
+    for i, (name, data, ttype) in enumerate(out):
+        writer.write_tensor_data(data)
+        if i % 50 == 0:
+            print(f"  wrote {i}/{len(out)}", flush=True)
+    writer.close()
+    print("DONE")
+
+if __name__ == "__main__":
+    main()
