+bool ggml_sycl_flash_attn_gate(ggml_backend_sycl_context & ctx, ggml_tensor * fattn,
+                               const float * gate, int64_t gate_s1, int64_t gate_s2,
+                               ggml_tensor * mul, int8_t * q_out, float * q_sc,
+                               sycl::half * q_sc16) {
+    sycl::half * att = nullptr;
+    if (!(g_ggml_sycl_dnn_sdpa && g_ggml_sycl_enable_dnn) ||
+        !ggml_sycl_flash_attn_ext_dnn(ctx, fattn, &att)) {
+        return false;
+    }
+    const ggml_tensor * Q = fattn->src[0];
+    { static int _pn = 0;
+      if (_pn < 2 && getenv("GGML_SYCL_DNN_VERBOSE")) { ++_pn;
+          fprintf(stderr, "[ATTN_GATE] fused (D=%ld M=%ld H=%ld q=%d)\n",
+                  (long) Q->ne[0], (long) Q->ne[1], (long) Q->ne[2], q_out != nullptr); } }
+    ggml_sycl_sdpa_gate(att, gate, (float *) mul->data,
+                        Q->ne[0], Q->ne[1], Q->ne[2], gate_s1, gate_s2,
+                        q_out, q_sc, ctx.stream(), q_sc16);
+    return true;
+}
+
+// Prefill-sized batches (M >= 64) with a quantized q8_0/q4_0 KV cache cannot enter
+// the fused oneDNN SDPA (f16 only), so they fall to the much slower tile kernel which
+// also re-converts the whole cache to f16 every call. Convert K/V to f16 once into the
+// fattn buffers and run the fused XMX path on shadow f16 tensors - restores f16 speed.
+static bool ggml_sycl_flash_attn_ext_dnn_quant(ggml_backend_sycl_context & ctx, ggml_tensor * dst) {
+    if (!g_ggml_sycl_fattn_quant_prefill || !g_ggml_sycl_dnn_sdpa || !g_ggml_sycl_enable_dnn || g_sdpa_failed) {
+        return false;
+    }
+    ggml_tensor * Q = dst->src[0];
+    ggml_tensor * K = dst->src[1];
+    ggml_tensor * V = dst->src[2];
+    if ((K->type != GGML_TYPE_Q8_0 && K->type != GGML_TYPE_Q4_0) || V->type != K->type) {
+        return false;
+    }
+    if (Q->ne[1] < 64) {  // decode / small batches keep the hand-written kernels
+        return false;
+    }
+
+    queue_ptr stream = ctx.stream();
+    ggml_sycl_fattn_kv_buffers & fbuf = ctx.fattn_buffers();
+
+    // Gather src into a dense [ne0, ne1, ne2, ne3] f16 tensor. The KV cache is laid out
+    // heads-interleaved-per-token, so the non-contiguous gather (which reads via the source
+    // strides and writes packed) both dequantizes and normalizes the layout to the clean
+    // strides the fused SDPA reads most efficiently.
+    auto convert = [&](const ggml_tensor * src, sycl::half * out, ggml_tensor & shadow) {
+        const size_t ts = ggml_type_size(src->type);
+        GGML_ASSERT(src->nb[0] == ts);
+        to_fp16_nc_sycl_t f = ggml_get_to_fp16_nc_sycl(src->type);
+        f((const char *) src->data, out, src->ne[0], src->ne[1], src->ne[2], src->ne[3],
+          src->nb[1] / ts, src->nb[2] / ts, src->nb[3] / ts, stream);
+        shadow       = *src;
+        shadow.type  = GGML_TYPE_F16;
+        shadow.data  = out;
+        shadow.nb[0] = sizeof(sycl::half);
+        shadow.nb[1] = src->ne[0] * sizeof(sycl::half);
+        shadow.nb[2] = src->ne[1] * shadow.nb[1];
+        shadow.nb[3] = src->ne[2] * shadow.nb[2];
+    };
+
+    ggml_tensor K16, V16;
+    convert(K, fbuf.K.ensure_half(ggml_nelements(K)), K16);
+    convert(V, fbuf.V.ensure_half(ggml_nelements(V)), V16);
+
+    ggml_tensor * K_orig = dst->src[1];
+    ggml_tensor * V_orig = dst->src[2];
+    dst->src[1] = &K16;
+    dst->src[2] = &V16;
+    const bool ok = ggml_sycl_flash_attn_ext_dnn(ctx, dst);
+    dst->src[1] = K_orig;
+    dst->src[2] = V_orig;
+    return ok;
+}
