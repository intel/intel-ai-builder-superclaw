+    const ggml_tensor * src1 = dst->src[1]; // conv1d.weight {d_conv, d_inner}
+    const ggml_tensor * src2 = dst->src[2]; // state        {d_conv - 1, d_inner, n_s}
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+
+    const int nc  = src1->ne[0]; // d_conv
+    const int nr  = src0->ne[0]; // d_inner
+    const int n_t = dst->ne[1];  // tokens per sequence
+    const int n_s = dst->ne[2];  // number of sequences in the batch
+
+    GGML_ASSERT( dst->ne[0] == nr);
+    GGML_ASSERT(src0->nb[0] == sizeof(float));
+    GGML_ASSERT(src1->nb[0] == sizeof(float));
+    GGML_ASSERT(src2->nb[0] == sizeof(float));
+    GGML_ASSERT(src2->ne[0] == nc - 1);
+
+    // channels per thread
+    const int dr  = (nr + nth - 1)/nth;
+    const int ir0 = dr*ith;
+    const int ir1 = MIN(ir0 + dr, nr);
+
+    for (int i3 = 0; i3 < n_s; ++i3) {
+        for (int i2 = 0; i2 < n_t; ++i2) {
+            float * x = (float *) ((char *) dst->data + i2*dst->nb[1] + i3*dst->nb[2]); // {d_inner}
+            for (int i1 = ir0; i1 < ir1; ++i1) {
+                const float * c = (const float *) ((const char *) src1->data + i1*src1->nb[1]); // {d_conv}
+                float sumf = 0.0f;
+                for (int i0 = 0; i0 < nc; ++i0) {
+                    // causal tap i0 reads token (i2 + i0 - (nc - 1)); negatives come from state
+                    const int t = i2 + i0 - (nc - 1);
+                    float v;
+                    if (t < 0) {
+                        v = *(const float *) ((const char *) src2->data + ((nc - 1) + t)*src2->nb[0] + i1*src2->nb[1] + i3*src2->nb[2]);
+                    } else {
+                        v = *(const float *) ((const char *) src0->data + i1*src0->nb[0] + t*src0->nb[1] + i3*src0->nb[2]);
+                    }
+                    sumf += v * c[i0];
+                }
+                x[i1] = sumf;
+            }
+        }
+    }
+}
