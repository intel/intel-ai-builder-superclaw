+#if GGML_SYCL_DNNL
+// Fused SDPA through the oneDNN Graph API (opt-in via GGML_SYCL_DNN_SDPA=1).
+// The fused kernel keeps the KQ matrix on chip and uses the XMX microkernels,
+// which is the same mechanism PyTorch XPU uses for attention on Intel GPUs.
+
+static void * ggml_sycl_sdpa_malloc(size_t size, size_t alignment, const void * dev, const void * context) {
+    if (alignment <= 1) {
+        return sycl::malloc_device(size, *static_cast<const sycl::device *>(dev),
+                                   *static_cast<const sycl::context *>(context));
+    }
+    return sycl::aligned_alloc_device(alignment, size, *static_cast<const sycl::device *>(dev),
+                                      *static_cast<const sycl::context *>(context));
+}
+
+static void ggml_sycl_sdpa_free(void * ptr, const void * dev, const void * context, void * event) {
+    GGML_UNUSED(dev);
+    if (event != nullptr) {
+        static_cast<sycl::event *>(event)->wait();
+    }
+    sycl::free(ptr, *static_cast<const sycl::context *>(context));
+}
+
+struct ggml_sycl_sdpa_entry {
+    dnnl::graph::compiled_partition cp;
+    dnnl::graph::logical_tensor lt_q, lt_k, lt_scale, lt_mask, lt_v, lt_out;
+    // bottom-right causal variant: the mask is generated inside the kernel from the
+    // sequence lengths instead of read from a materialized [M, N] tensor
+    dnnl::graph::logical_tensor lt_seq_kv, lt_seq_q, lt_neg_inf;
+    float scale_val;
+    bool  causal = false;
+};
+
+// The implicit bottom-right causal mask (GenIndex/GreaterEqual/Select) is folded by
+// oneDNN into micro_sdpa's causal path, which skips fully-masked key blocks instead of
+// reading a materialized [M, N] mask (pp16384 1951 -> 2084 t/s on B70). It is only
+// equivalent when the KQ mask really is bottom-right causal, which a plain single-
+// sequence prefill gives but a multi-slot or cache-reusing one does not, so the mask
+// contents are checked once per graph evaluation. GGML_SYCL_SDPA_CAUSAL=0 disables it.
+static bool sdpa_causal_mask() {
+    static const bool v = ggml_sycl_get_env("GGML_SYCL_SDPA_CAUSAL", 1) != 0;
+    return v;
+}
+
+// mask[m][n] must be 0 where n <= m + (N - M) and -inf elsewhere
+static void sdpa_mask_causal_probe(const sycl::half * mask, int64_t M, int64_t N, int64_t m_sm,
+                                  int32_t * flag, queue_ptr stream) {
+    constexpr int wg = 256;
+    const int64_t total = M * N;
+    const int64_t n_wg  = (total + wg - 1) / wg;
+    const int64_t off   = N - M;
+    stream->memset(flag, 0, sizeof(int32_t));
+    stream->parallel_for(
+        sycl::nd_range<1>(sycl::range<1>(n_wg * wg), sycl::range<1>(wg)),
+        [=](sycl::nd_item<1> it) {
+            const int64_t i = it.get_global_linear_id();
+            if (i >= total) {
+                return;
+            }
+            const int64_t m = i / N;
+            const int64_t n = i - m * N;
+            const float   v = (float) mask[m * m_sm + n];
+            const bool    keep = n <= m + off;
+            if (keep ? v != 0.0f : !(sycl::isinf(v) && v < 0.0f)) {
+                sycl::atomic_ref<int32_t, sycl::memory_order::relaxed,
+                                 sycl::memory_scope::device>(*flag)
+                        .store(1);
+            }
+        });
+}
+
+// Runs the probe and blocks on its result, so it must be called BEFORE the graph
+// evaluation starts - a wait() on a queue that is recording to a SYCL graph is not
+// allowed (see check_graph_compatibility). ggml_sycl_flash_attn_* only reads the
+// verdict cached here.
+void ggml_sycl_sdpa_mask_probe(ggml_backend_sycl_context & ctx, const ggml_tensor * mask,
+                               int64_t M, int64_t N, queue_ptr stream) {
+    if (!sdpa_causal_mask() || mask == nullptr || mask->type != GGML_TYPE_F16) {
+        ctx.sdpa_causal_ok = false;
+        return;
+    }
+    if (ctx.sdpa_causal_flag == nullptr) {
+        ctx.sdpa_causal_flag = (int32_t *) sycl::malloc_device(sizeof(int32_t), *stream);
+        if (ctx.sdpa_causal_flag == nullptr) {
+            ctx.sdpa_causal_ok = false;
+            return;
+        }
+        ctx.q8_cache_queue = stream;
+    }
+    const int64_t m_sm = mask->nb[1] / sizeof(sycl::half);
+    sdpa_mask_causal_probe((const sycl::half *) mask->data, M, N, m_sm, ctx.sdpa_causal_flag, stream);
+    int32_t bad = 1;
+    stream->memcpy(&bad, ctx.sdpa_causal_flag, sizeof(int32_t)).wait();
+    ctx.sdpa_causal_data = mask->data;
+    ctx.sdpa_causal_m    = M;
+    ctx.sdpa_causal_n    = N;
+    ctx.sdpa_causal_ok   = bad == 0;
+}
+
+// verdict for this graph evaluation, established by ggml_sycl_sdpa_mask_probe
+static bool sdpa_mask_is_causal(ggml_backend_sycl_context & ctx, const ggml_tensor * mask,
+                                int64_t M, int64_t N) {
+    return ctx.sdpa_causal_ok && ctx.sdpa_causal_data == mask->data &&
+           ctx.sdpa_causal_m == M && ctx.sdpa_causal_n == N;
+}
+
+// prototype: one process-lifetime cache (single device / single context usage)
+static bool                                            g_sdpa_failed = false;
+static bool                                            g_sdpa_eng_init = false;
+static dnnl::engine                                    g_sdpa_eng;
+static std::unordered_map<sycl::queue *, dnnl::stream> g_sdpa_streams;
+static std::map<std::vector<int64_t>, ggml_sycl_sdpa_entry> g_sdpa_cache;
+
+// gather Q from the ggml layout [D contiguous, token (s_m), head (s_h)] into a
+// dense f16 [head, token, D] buffer
+// A flat range would cost three 64-bit divisions per element to recover (h, m, d) -
+// D is a runtime value so they do not fold into shifts - and one scalar load/store per
+// half. A 3D range makes the indices free and four elements per item make both sides
+// vector accesses; this kernel was running at half the memory roof.
+static void ggml_sycl_sdpa_convert_q(const float * q, sycl::half * out, const int64_t D, const int64_t M,
+                                     const int64_t H, const int64_t s_m, const int64_t s_h, queue_ptr stream) {
+    constexpr int vw = 4;
+    if ((D % vw) == 0 && (s_m % vw) == 0 && (s_h % vw) == 0) {
+        using f4 = sycl::vec<float, vw>;
+        using h4 = sycl::vec<sycl::half, vw>;
+        stream->parallel_for(sycl::range<3>(H, M, D / vw), [=](sycl::id<3> id) {
+            const int64_t h = id[0], m = id[1], dv = id[2] * vw;
+            const f4 v = *reinterpret_cast<const f4 *>(q + h * s_h + m * s_m + dv);
+            h4 o;
+#pragma unroll
+            for (int i = 0; i < vw; i++) {
+                o[i] = sycl::half(v[i]);
+            }
+            *reinterpret_cast<h4 *>(out + (h * M + m) * D + dv) = o;
+        });
+        return;
+    }
+    stream->parallel_for(sycl::range<3>(H, M, D), [=](sycl::id<3> id) {
+        const int64_t h = id[0], m = id[1], d = id[2];
+        out[(h * M + m) * D + d] = sycl::half(q[h * s_h + m * s_m + d]);
+    });
+}
+
+// scatter the dense f16 [head, token, D] attention output into the ggml dst
+// layout f32 [D contiguous, head, token]
+static void ggml_sycl_sdpa_convert_out(const sycl::half * in, float * dst, const int64_t D, const int64_t M,
+                                       const int64_t H, queue_ptr stream) {
+    constexpr int vw = 4;
+    if ((D % vw) == 0) {
+        using f4 = sycl::vec<float, vw>;
+        using h4 = sycl::vec<sycl::half, vw>;
+        stream->parallel_for(sycl::range<3>(H, M, D / vw), [=](sycl::id<3> id) {
+            const int64_t h = id[0], m = id[1], dv = id[2] * vw;
+            const h4 v = *reinterpret_cast<const h4 *>(in + (h * M + m) * D + dv);
+            f4 o;
+#pragma unroll
+            for (int i = 0; i < vw; i++) {
+                o[i] = (float) v[i];
+            }
+            *reinterpret_cast<f4 *>(dst + (m * H + h) * D + dv) = o;
+        });
+        return;
+    }
+    stream->parallel_for(sycl::range<3>(H, M, D), [=](sycl::id<3> id) {
+        const int64_t h = id[0], m = id[1], d = id[2];
+        dst[(m * H + h) * D + d] = (float) in[(h * M + m) * D + d];
+    });
+}
+
+// keep_out (optional): skip the f32 scatter and hand back the dense f16
+// [head, token, D] attention output in a ctx-owned staging buffer (the fused
+// attention-gate hook consumes it; dst is left unwritten)
+static bool ggml_sycl_flash_attn_ext_dnn(ggml_backend_sycl_context & ctx, ggml_tensor * dst,
+                                         sycl::half ** keep_out = nullptr) {
+#if DNNL_VERSION_MINOR < 8
+    // oneDNN Graph SDPA requires DNNL >= 3.8 (host_scalar / make_scalar_tensor)
+    GGML_UNUSED(ctx); GGML_UNUSED(dst); GGML_UNUSED(keep_out);
+    return false;
+#else
+    using namespace dnnl::graph;
+    using ltensor = dnnl::graph::logical_tensor;
+
+    if (g_sdpa_failed) {
+        return false;
+    }
+
+    const ggml_tensor * Q    = dst->src[0];
+    const ggml_tensor * K    = dst->src[1];
+    const ggml_tensor * V    = dst->src[2];
+    const ggml_tensor * mask = dst->src[3];
+
+    if (mask == nullptr || dst->src[4] != nullptr) {  // mask required, sinks unsupported
+        return false;
+    }
+    if (Q->type != GGML_TYPE_F32 || K->type != GGML_TYPE_F16 || V->type != GGML_TYPE_F16 ||
+        mask->type != GGML_TYPE_F16 || dst->type != GGML_TYPE_F32) {
+        return false;
+    }
+
+    float scale = 1.0f, max_bias = 0.0f, logit_softcap = 0.0f;
+    memcpy(&scale,         (const float *) dst->op_params + 0, sizeof(float));
+    memcpy(&max_bias,      (const float *) dst->op_params + 1, sizeof(float));
+    memcpy(&logit_softcap, (const float *) dst->op_params + 2, sizeof(float));
+    if (max_bias != 0.0f || logit_softcap != 0.0f) {
+        return false;
+    }
+
+    const int64_t D   = Q->ne[0];
+    const int64_t M   = Q->ne[1];
+    const int64_t H   = Q->ne[2];
+    const int64_t N   = K->ne[1];
+    const int64_t Hkv = K->ne[2];
+
+    if (Q->ne[3] != 1 || K->ne[3] != 1 || V->ne[3] != 1 || mask->ne[2] != 1 || mask->ne[3] != 1) {
+        return false;
+    }
+    if (K->ne[0] != D || V->ne[0] != D || V->ne[1] != N || V->ne[2] != Hkv || H % Hkv != 0) {
+        return false;
+    }
+    if (M < 64) {  // decode-sized batches stay on the existing kernels
+        return false;
+    }
+    if (Q->nb[0] != sizeof(float) || K->nb[0] != sizeof(sycl::half) || V->nb[0] != sizeof(sycl::half) ||
+        mask->nb[0] != sizeof(sycl::half) || !ggml_is_contiguous(dst)) {
+        return false;
+    }
+    if (mask->ne[0] < N || mask->ne[1] < M) {
+        return false;
+    }
+
+    const int64_t rep  = H / Hkv;
+    const int64_t k_sn = K->nb[1] / 2, k_sh = K->nb[2] / 2;
+    const int64_t v_sn = V->nb[1] / 2, v_sh = V->nb[2] / 2;
+    const int64_t m_sm = mask->nb[1] / 2;
+
+    queue_ptr stream = ctx.stream();
+
+    try {
+        if (!g_sdpa_eng_init) {
+            auto alloc  = dnnl::graph::sycl_interop::make_allocator(ggml_sycl_sdpa_malloc, ggml_sycl_sdpa_free);
+            g_sdpa_eng  = dnnl::graph::sycl_interop::make_engine_with_allocator(
+                    stream->get_device(), stream->get_context(), alloc);
+            g_sdpa_eng_init = true;
+        }
+
+        const bool causal = sdpa_causal_mask() && sdpa_mask_is_causal(ctx, mask, M, N);
+        const std::vector<int64_t> key = {M, N, D, Hkv, rep, k_sn, k_sh, v_sn, v_sh, m_sm,
+                                          (int64_t) causal};
+        auto it = g_sdpa_cache.find(key);
+        if (it == g_sdpa_cache.end()) {
+            const auto dt   = ltensor::data_type::f16;
+            const auto dt32 = ltensor::data_type::f32;
+
+            const ltensor::dims q_sz     = {1, Hkv, rep, M, D};
+            const ltensor::dims kv_sz    = {1, Hkv, 1, N, D};
+            const ltensor::dims score_sz = {1, Hkv, rep, M, N};
+            const ltensor::dims mask_sz  = {1, 1, 1, M, N};
+
+            const ltensor::dims q_st    = {Hkv * rep * M * D, rep * M * D, M * D, D, 1};
+            const ltensor::dims k_st    = {Hkv * k_sh, k_sh, k_sh, k_sn, 1};
+            const ltensor::dims v_st    = {Hkv * v_sh, v_sh, v_sh, v_sn, 1};
+            const ltensor::dims mask_st = {M * m_sm, M * m_sm, M * m_sm, m_sm, 1};
+
+            size_t id = 0;
+            ggml_sycl_sdpa_entry e;
+            e.lt_q     = ltensor(id++, dt, q_sz, q_st);
+            e.lt_k     = ltensor(id++, dt, kv_sz, k_st);
+            auto score = ltensor(id++, dt32, score_sz, ltensor::layout_type::strided);
+            e.lt_scale = ltensor(id++, dt32, 0, ltensor::layout_type::strided, ltensor::property_type::host_scalar);
+            auto scaled = ltensor(id++, dt32, score_sz, ltensor::layout_type::strided);
+            e.lt_mask  = ltensor(id++, dt, mask_sz, mask_st);
+            auto masked = ltensor(id++, dt32, score_sz, ltensor::layout_type::strided);
+            auto probs  = ltensor(id++, dt, score_sz, ltensor::layout_type::strided);
+            e.lt_v     = ltensor(id++, dt, kv_sz, v_st);
+            e.lt_out   = ltensor(id++, dt, q_sz, q_st);
+
+            auto bmm1 = op(id++, op::kind::MatMul, "kq");
+            bmm1.set_attr<bool>(op::attr::transpose_b, true);
+            bmm1.add_inputs({e.lt_q, e.lt_k});
+            bmm1.add_outputs({score});
+
+            auto vscale = op(id++, op::kind::Multiply, "scale");
+            vscale.add_inputs({score, e.lt_scale});
+            vscale.add_outputs({scaled});
+
+            auto row     = ltensor(id++, ltensor::data_type::s32, score_sz, ltensor::layout_type::strided);
+            auto row_kv  = ltensor(id++, ltensor::data_type::s32, score_sz, ltensor::layout_type::strided);
+            auto row_adj = ltensor(id++, ltensor::data_type::s32, score_sz, ltensor::layout_type::strided);
+            auto col     = ltensor(id++, ltensor::data_type::s32, score_sz, ltensor::layout_type::strided);
+            auto keep    = ltensor(id++, ltensor::data_type::boolean, score_sz, ltensor::layout_type::strided);
+            e.lt_seq_kv  = ltensor(id++, ltensor::data_type::s32, 0, ltensor::layout_type::strided,
+                                   ltensor::property_type::host_scalar);
+            e.lt_seq_q   = ltensor(id++, ltensor::data_type::s32, 0, ltensor::layout_type::strided,
+                                   ltensor::property_type::host_scalar);
+            e.lt_neg_inf = ltensor(id++, dt32, 0, ltensor::layout_type::strided,
+                                   ltensor::property_type::host_scalar);
+
+            auto gen_row = op(id++, op::kind::GenIndex, "gen_row");
+            gen_row.set_attr<int64_t>(op::attr::axis, -2);
+            gen_row.add_inputs({scaled});
+            gen_row.add_outputs({row});
+
+            auto add_kv = op(id++, op::kind::Add, "mask_add");
+            add_kv.add_inputs({row, e.lt_seq_kv});
+            add_kv.add_outputs({row_kv});
+
+            auto sub_q = op(id++, op::kind::Subtract, "mask_sub");
+            sub_q.add_inputs({row_kv, e.lt_seq_q});
+            sub_q.add_outputs({row_adj});
+
+            auto gen_col = op(id++, op::kind::GenIndex, "gen_col");
+            gen_col.set_attr<int64_t>(op::attr::axis, -1);
+            gen_col.add_inputs({scaled});
+            gen_col.add_outputs({col});
+
+            auto mask_ge = op(id++, op::kind::GreaterEqual, "mask_ge");
+            mask_ge.add_inputs({row_adj, col});
+            mask_ge.add_outputs({keep});
+
+            auto mask_sel = op(id++, op::kind::Select, "mask_select");
+            mask_sel.add_inputs({keep, scaled, e.lt_neg_inf});
+            mask_sel.add_outputs({masked});
+
+            auto madd = op(id++, op::kind::Add, "mask");
+            madd.add_inputs({scaled, e.lt_mask});
+            madd.add_outputs({masked});
+
+            auto smax = op(id++, op::kind::SoftMax, "softmax");
+            smax.set_attr<int64_t>(op::attr::axis, -1);
+            smax.set_attr<std::string>(op::attr::mode, "inf_as_zero");
+            smax.add_inputs({masked});
+            smax.add_outputs({probs});
+
+            auto bmm2 = op(id++, op::kind::MatMul, "kqv");
+            bmm2.add_inputs({probs, e.lt_v});
+            bmm2.add_outputs({e.lt_out});
+
+            dnnl::graph::graph g(dnnl::engine::kind::gpu);
+            g.add_op(bmm1);
+            g.add_op(vscale);
+            if (causal) {
+                g.add_op(gen_row);
+                g.add_op(add_kv);
+                g.add_op(sub_q);
+                g.add_op(gen_col);
+                g.add_op(mask_ge);
+                g.add_op(mask_sel);
+            } else {
+                g.add_op(madd);
+            }
+            g.add_op(smax);
+            g.add_op(bmm2);
+            g.finalize();
+
+            auto parts = g.get_partitions();
+            if (parts.size() != 1 || !parts[0].is_supported()) {
+                GGML_LOG_WARN("%s: oneDNN graph SDPA not fused (%zu partitions), falling back\n",
+                              __func__, parts.size());
+                g_sdpa_failed = true;
+                return false;
+            }
+            e.causal = causal;
+            e.cp = causal
+                    ? parts[0].compile({e.lt_q, e.lt_k, e.lt_scale, e.lt_seq_kv, e.lt_seq_q,
+                                        e.lt_neg_inf, e.lt_v}, {e.lt_out}, g_sdpa_eng)
+                    : parts[0].compile({e.lt_q, e.lt_k, e.lt_scale, e.lt_mask, e.lt_v},
+                                       {e.lt_out}, g_sdpa_eng);
+            it = g_sdpa_cache.emplace(key, std::move(e)).first;
+        }
+
+        auto st_it = g_sdpa_streams.find(stream);
+        if (st_it == g_sdpa_streams.end()) {
+            st_it = g_sdpa_streams.emplace(stream, dnnl::sycl_interop::make_stream(g_sdpa_eng, *stream)).first;
+        }
+
+        ggml_sycl_sdpa_entry & e = it->second;
+        e.scale_val = scale;
+
+        ggml_sycl_pool_alloc<sycl::half> q_f16(ctx.pool(), H * M * D);
+        ggml_sycl_pool_alloc<sycl::half> out_pool(ctx.pool());
+        sycl::half * out_f16;
+        if (keep_out != nullptr) {
+            const size_t need = (size_t) H * M * D * sizeof(sycl::half);
+            if (need > ctx.sdpa_out_cap) {
+                if (ctx.sdpa_out != nullptr) {
+                    // in-flight work may still read it, and waiting for the queue is
+                    // illegal while a SYCL graph is recording: release it at the next
+                    // graph boundary instead
+                    ctx.pending_frees.push_back(ctx.sdpa_out);
+                }
