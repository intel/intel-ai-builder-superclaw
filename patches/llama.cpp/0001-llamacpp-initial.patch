+    static FILE * f = []() -> FILE * {
+        const char * v = getenv("LLAMA_MOE_LAT_DEBUG");
+        if (v == nullptr || v[0] == '\0' || v[0] == '0') {
+            return nullptr;
+        }
+        const char * path = getenv("LLAMA_MOE_LAT_FILE");
+        if (path == nullptr || path[0] == '\0') {
+            path = "moe_latency.log";
+        }
+        return fopen(path, "w");
+    }();
+    return f;
+}
+
+// Prefill fill uses DirectStorage by default, which wins for large-context /
+// agentic workloads where the fill is I/O-bound. Set LLAMA_MOE_PREFILL_DS=0 to
+// force the warm mmap memcpy path (faster only for small prompts on a warm
+// cache).
+static bool llama_moe_prefill_useds() {
+    static const bool v = []() {
+        const char * e = getenv("LLAMA_MOE_PREFILL_DS");
+        return !(e != nullptr && e[0] == '0');
+    }();
+    return v;
+}
+
+bool llama_moe_prefill_uses_directstorage() {
+    return llama_moe_prefill_useds();
+}
+
+// Prefill mode. Default is adaptive: pick per ubatch between the full-layer
+// ping-pong stream (all experts, one-layer prefetch overlaps the read with
+// compute) and the used-only stream (only routed experts, synchronous). Full
+// wins when there is enough compute per layer to hide the read; used wins for
+// small/low-coverage ubatches. LLAMA_MOE_PREFILL_USED forces a mode (1=used,
+// 0=full); LLAMA_MOE_PREFILL_ADAPTIVE=0 disables adaptivity (keeps used-only).
+enum class llama_moe_prefill_mode { adaptive, forced_full, forced_used };
+
+static llama_moe_prefill_mode llama_moe_prefill_mode_get() {
+    static const llama_moe_prefill_mode m = []() {
+        const char * u = getenv("LLAMA_MOE_PREFILL_USED");
+        if (u != nullptr && u[0] != '\0') {
+            return u[0] == '0' ? llama_moe_prefill_mode::forced_full
+                               : llama_moe_prefill_mode::forced_used;
+        }
+        const char * a = getenv("LLAMA_MOE_PREFILL_ADAPTIVE");
+        if (a != nullptr && a[0] == '0') {
+            return llama_moe_prefill_mode::forced_used;
+        }
+        return llama_moe_prefill_mode::adaptive;
+    }();
+    return m;
+}
+
+// Adaptive threshold R: choose used-only when n_tokens < R * n_experts, i.e.
+// when there is too little compute per layer to overlap the full-layer read.
+// Compute per layer scales with n_tokens; full read size scales with n_experts.
+// Both are constant across a ubatch, so the choice is uniform per ubatch and the
+// existing full/used code paths run unchanged (no per-layer buffer mixing).
+static double llama_moe_prefill_adapt_ratio() {
+    static const double r = []() {
+        const char * e = getenv("LLAMA_MOE_PREFILL_ADAPT_RATIO");
+        if (e != nullptr && e[0] != '\0') {
+            const double v = atof(e);
+            if (v > 0.0) {
+                return v;
+            }
+        }
+        return 2.0;
+    }();
+    return r;
+}
+
+// Compare the filled destination against the mmap source over the whole block.
+// Returns first mismatch offset or -1 if identical; also fills byte sums.
+static void llama_moe_prefill_verify(FILE * f, int layer_id, int buf_index, size_t proj,
+                                     const uint8_t * dst, const uint8_t * src, size_t block) {
+    if (f == nullptr || dst == nullptr || src == nullptr || block == 0) {
+        return;
+    }
+    uint64_t sum_dst = 0;
+    uint64_t sum_src = 0;
+    ptrdiff_t first_mismatch = -1;
+    const size_t scan = block < (size_t) (1 << 16) ? block : (size_t) (1 << 16);
+    for (size_t i = 0; i < scan; ++i) {
+        sum_dst += dst[i];
+        sum_src += src[i];
+        if (first_mismatch < 0 && dst[i] != src[i]) {
+            first_mismatch = (ptrdiff_t) i;
+        }
+    }
+    fprintf(f, "verify layer=%d buf=%d proj=%zu block=%zu scan=%zu dst=%p src=%p sum_dst=%llu sum_src=%llu first_mismatch=%td\n",
+            layer_id, buf_index, proj, block, scan, (const void *) dst, (const void *) src,
+            (unsigned long long) sum_dst, (unsigned long long) sum_src, first_mismatch);
+    fflush(f);
+}
+
+void llama_moe_layer_cache::init(int32_t n_slots_, int32_t n_experts_) {
+    n_slots = n_slots_;
+    n_experts = n_experts_;
+
+    slot_expert.assign(n_slots, -1);
+    slot_filled.assign(n_slots, false);
+    lru_order.clear();
+    expert_to_iter.clear();
+    for (int32_t i = 0; i < n_slots; ++i) {
+        lru_order.push_back(i);
+    }
+
+    n_hits = 0;
+    n_misses = 0;
+    n_evictions = 0;
+    LLAMA_LOG_INFO("%s: MoE layer %d cache initialized: %d slots for %d experts\n",
+                   __func__, layer_id, n_slots, n_experts);
+}
+
+void llama_moe_layer_cache::set_source(llama_moe_projection projection, size_t expert_stride, const uint8_t * mmap_data, ggml_tensor * gpu_tensor,
+                                       const std::string & file_path, uint64_t file_offset) {
+    auto & source = sources[static_cast<size_t>(projection)];
+    source.configured = true;
+    source.expert_stride = expert_stride;
+    source.mmap_data = mmap_data;
+    source.gpu_tensor = gpu_tensor;
+    source.file_path = file_path;
+    source.file_offset = file_offset;
+}
+
+int32_t llama_moe_layer_cache::reserve_slot(int32_t expert_id, bool & needs_fill) {
+    needs_fill = false;
+    if (expert_id < 0 || expert_id >= n_experts) {
+        return -1;
+    }
+
+    auto it = expert_to_iter.find(expert_id);
+    if (it != expert_to_iter.end()) {
+        // Cache hit: move to back of LRU list (most-recently-used)
+        const int32_t slot = *it->second;
+        lru_order.erase(it->second);
+        lru_order.push_back(slot);
+        expert_to_iter[expert_id] = std::prev(lru_order.end());
+        n_hits++;
+        LLAMA_LOG_DEBUG("%s: [layer %d] HIT  expert %3d -> slot %d\n", __func__, layer_id, expert_id, slot);
+        return slot;
+    }
+
+    // Cache miss: evict the LRU slot and reserve it for this expert. No IO here.
+    // Synchronization guarantee: this callback runs CPU-side inside ggml_map_custom1.
+    // The ggml backend scheduler ensures all GPU ops that depend on inputs BEFORE this
+    // node have completed before the callback is invoked. Additionally, llama_decode()
+    // is synchronous - the GPU finishes all work before returning - so any slot evicted
+    // here cannot be in-flight from a prior decode call. The batched fill that follows
+    // writes bytes before the subsequent ggml_mul_mat_id GPU submission, which provides
+    // the required host-write -> GPU-read ordering.
+    const int32_t slot = lru_order.front();
+    lru_order.pop_front();
+    const int32_t old_expert = slot_expert[slot];
+    if (old_expert != -1) {
+        expert_to_iter.erase(old_expert);
+        n_evictions++;
+        LLAMA_LOG_INFO("%s: [layer %d] MISS expert %3d -> slot %d (evicting expert %d)\n",
+                       __func__, layer_id, expert_id, slot, old_expert);
+    } else {
+        LLAMA_LOG_INFO("%s: [layer %d] MISS expert %3d -> slot %d (empty slot)\n",
+                       __func__, layer_id, expert_id, slot);
+    }
+
+    slot_expert[slot] = expert_id;
+    slot_filled[slot] = true;
+    lru_order.push_back(slot);
+    expert_to_iter[expert_id] = std::prev(lru_order.end());
+    n_misses++;
+    needs_fill = true;
+    return slot;
+}
+
+// no-mmap fallback: read `size` bytes at `offset` from `path` into `dst`. Used
+// when a source has no mmap pointer and DirectStorage is unavailable or a read
+// failed. Opens the file per call (rare error path). Returns true on success.
+static bool llama_moe_file_read(const std::string & path, uint64_t offset, void * dst, size_t size) {
+    if (path.empty() || dst == nullptr || size == 0) {
+        return false;
+    }
+    FILE * f = fopen(path.c_str(), "rb");
+    if (f == nullptr) {
+        return false;
+    }
+#ifdef _WIN32
+    const bool seek_ok = _fseeki64(f, (long long) offset, SEEK_SET) == 0;
+#else
+    const bool seek_ok = fseeko(f, (off_t) offset, SEEK_SET) == 0;
+#endif
+    const bool ok = seek_ok && fread(dst, 1, size, f) == size;
+    fclose(f);
+    return ok;
+}
+
+void llama_moe_layer_cache::fill_mmap_expert(int32_t expert_id, int32_t slot) {
+    for (const auto & source : sources) {
+        if (!source.configured || source.gpu_tensor == nullptr || source.expert_stride == 0) {
+            continue;
+        }
+        const size_t slot_off = (size_t) slot * source.expert_stride;
+        if (source.mmap_data != nullptr) {
+            const uint8_t * src = source.mmap_data + (size_t) expert_id * source.expert_stride;
+            ggml_backend_tensor_set(source.gpu_tensor, src, slot_off, source.expert_stride);
+            continue;
+        }
+        // no-mmap: read the expert from the GGUF file into staging, then upload.
+        if (file_staging.size() < source.expert_stride) {
+            file_staging.resize(source.expert_stride);
+        }
+        const uint64_t eoff = source.file_offset + (uint64_t) expert_id * source.expert_stride;
+        if (llama_moe_file_read(source.file_path, eoff, file_staging.data(), source.expert_stride)) {
+            ggml_backend_tensor_set(source.gpu_tensor, file_staging.data(), slot_off, source.expert_stride);
+        } else {
+            LLAMA_LOG_ERROR("%s: [layer %d] no-mmap file read failed for expert %d\n", __func__, layer_id, expert_id);
+        }
+    }
+}
+
+bool llama_moe_layer_cache::fill_enqueue_expert(int32_t expert_id, int32_t slot) {
+#ifdef LLAMA_MOE_DIRECTSTORAGE
+    const bool try_ds = ds_reader != nullptr && ds_reader->ok();
+#endif
+    bool ds_enqueued = false;
+    for (const auto & source : sources) {
+        if (!source.configured) {
+            continue;
+        }
+        if (source.gpu_tensor == nullptr || source.expert_stride == 0 ||
+            (source.mmap_data == nullptr && source.file_path.empty())) {
+            LLAMA_LOG_ERROR("%s: incomplete source configuration for expert %d\n", __func__, expert_id);
+            GGML_ABORT("MoE expert source misconfigured");
+        }
+
+        const size_t slot_off = (size_t) slot * source.expert_stride;
+#ifdef LLAMA_MOE_DIRECTSTORAGE
+        if (try_ds && !source.file_path.empty()) {
+            void * dst = ggml_backend_sycl_moe_cache_host_ptr(source.gpu_tensor, slot_off);
+            if (dst != nullptr &&
+                ds_reader->enqueue(dst, source.file_path,
+                                   source.file_offset + (uint64_t) expert_id * source.expert_stride,
+                                   (uint32_t) source.expert_stride)) {
+                ds_enqueued = true;
+                continue;
+            }
+        }
+#endif
+        // Host-visible slot (USM shared/host): write straight into GPU-visible memory
+        // (zero-copy), skipping the host->device upload. no-mmap reads the expert
+        // bytes directly into the slot.
+        void * hdst = ggml_backend_sycl_moe_cache_host_ptr(source.gpu_tensor, slot_off);
+        if (hdst != nullptr) {
+            if (source.mmap_data != nullptr) {
+                memcpy(hdst, source.mmap_data + (size_t) expert_id * source.expert_stride, source.expert_stride);
+            } else {
+                const uint64_t eoff = source.file_offset + (uint64_t) expert_id * source.expert_stride;
+                if (!llama_moe_file_read(source.file_path, eoff, hdst, source.expert_stride)) {
+                    LLAMA_LOG_ERROR("%s: no-mmap file read failed for expert %d\n", __func__, expert_id);
+                    GGML_ABORT("MoE no-mmap expert file read failed");
+                }
+            }
+            continue;
+        }
+        if (source.mmap_data != nullptr) {
+            const uint8_t * src = source.mmap_data + (size_t) expert_id * source.expert_stride;
+            // Write expert data from mmap into the GPU cache slot.
+            // For iGPU (HOST_VISIBLE|HOST_COHERENT) this is a direct mapped write.
+            // For discrete GPU this uses a staging copy internally.
+            ggml_backend_tensor_set(source.gpu_tensor, src, slot_off, source.expert_stride);
+        } else {
+            // no-mmap: read from the GGUF file into staging, then upload.
+            if (file_staging.size() < source.expert_stride) {
+                file_staging.resize(source.expert_stride);
+            }
+            const uint64_t eoff = source.file_offset + (uint64_t) expert_id * source.expert_stride;
+            if (llama_moe_file_read(source.file_path, eoff, file_staging.data(), source.expert_stride)) {
+                ggml_backend_tensor_set(source.gpu_tensor, file_staging.data(), slot_off, source.expert_stride);
+            } else {
+                LLAMA_LOG_ERROR("%s: no-mmap file read failed for expert %d\n", __func__, expert_id);
+                GGML_ABORT("MoE no-mmap expert file read failed");
+            }
+        }
+    }
+    return ds_enqueued;
+}
+
+int32_t llama_moe_layer_cache::acquire(int32_t expert_id) {
+    std::lock_guard<std::mutex> lock(mtx);
+    bool needs_fill = false;
+    const int32_t slot = reserve_slot(expert_id, needs_fill);
+    if (slot < 0 || !needs_fill) {
+        return slot;
+    }
+
+    const bool ds_enqueued = fill_enqueue_expert(expert_id, slot);
+#ifdef LLAMA_MOE_DIRECTSTORAGE
+    if (ds_enqueued && !ds_reader->submit_and_wait()) {
+        LLAMA_LOG_WARN("%s: [layer %d] DirectStorage read failed for expert %d, using mmap\n",
+                       __func__, layer_id, expert_id);
+        fill_mmap_expert(expert_id, slot);
+    }
+#else
+    (void) ds_enqueued;
+#endif
+
+    if (llama_moe_io_debug()) {
+        fprintf(stderr, "[moe-io] layer=%d expert=%d slot=%d\n", layer_id, expert_id, slot);
+    }
+    return slot;
+}
+
+void llama_moe_layer_cache::log_stats_and_reset() {
+    const int64_t total = n_hits + n_misses;
+    if (total > 0) {
+        LLAMA_LOG_INFO("%s: [layer %d] decode stats: hits=%lld misses=%lld evictions=%lld (hit_rate=%.1f%%)\n",
+                       __func__, layer_id,
+                       (long long)n_hits, (long long)n_misses, (long long)n_evictions,
+                       100.0 * n_hits / total);
+    }
+    n_hits = 0;
+    n_misses = 0;
+    n_evictions = 0;
+}
+
+size_t llama_moe_layer_cache::full_layer_bytes() const {
+    size_t total = 0;
+    for (const auto & source : sources) {
+        if (source.configured) {
+            total += (size_t) n_experts * source.expert_stride;
+        }
+    }
+    return total;
+}
+
+bool llama_moe_layer_cache::prefill_enqueue_self() {
+#ifdef LLAMA_MOE_DIRECTSTORAGE
+    const bool try_ds = ds_reader != nullptr && ds_reader->ok() && llama_moe_prefill_useds();
+#else
+    const bool try_ds = false;
+#endif
+    bool ds_enqueued = false;
+
+    for (size_t p = 0; p < sources.size(); ++p) {
+        const auto & source = sources[p];
+        if (!source.configured) {
+            continue;
+        }
+        uint8_t * dst = prefill_dst_self[p];
+        ggml_tensor * gt = prefill_tensor_self[p];
+        if ((dst == nullptr && gt == nullptr) || source.expert_stride == 0 ||
+            (source.mmap_data == nullptr && source.file_path.empty())) {
+            LLAMA_LOG_ERROR("%s: [layer %d] incomplete source/destination for full-layer fill\n", __func__, layer_id);
+            continue;
+        }
+
+        const size_t block_bytes = (size_t) n_experts * source.expert_stride;
+
+#ifdef LLAMA_MOE_DIRECTSTORAGE
+        if (dst != nullptr && try_ds && !source.file_path.empty() && source.expert_stride <= (size_t) UINT32_MAX) {
+            // DirectStorage caps a single request at the staging buffer size, so
+            // enqueue one read per expert (like the decode path) instead of one
+            // giant block, which fails with E_DSTORAGE_REQUEST_TOO_LARGE.
+            bool all_queued = true;
+            for (int32_t expert_id = 0; expert_id < n_experts; ++expert_id) {
+                uint8_t * edst = dst + (size_t) expert_id * source.expert_stride;
+                const uint64_t eoff = source.file_offset + (uint64_t) expert_id * source.expert_stride;
+                if (!ds_reader->enqueue(edst, source.file_path, eoff, (uint32_t) source.expert_stride)) {
+                    all_queued = false;
+                    break;
+                }
+            }
+            if (all_queued) {
+                ds_enqueued = true;
+                continue;
+            }
+        }
+#endif
+        // Fallback: experts are contiguous from expert 0 in the file layout.
+        // dst != null: host-visible buffer, write directly. dst == null: device
+        // memory, upload via ggml_backend_tensor_set (mmap read or file staging).
+        if (dst != nullptr) {
+            if (source.mmap_data != nullptr) {
+                memcpy(dst, source.mmap_data, block_bytes);
+            } else if (!llama_moe_file_read(source.file_path, source.file_offset, dst, block_bytes)) {
+                LLAMA_LOG_ERROR("%s: [layer %d] no-mmap file read failed for full-layer fill\n", __func__, layer_id);
+            }
+        } else if (source.mmap_data != nullptr) {
+            ggml_backend_tensor_set(gt, source.mmap_data, 0, block_bytes);
+        } else {
+            if (file_staging.size() < block_bytes) {
+                file_staging.resize(block_bytes);
+            }
+            if (llama_moe_file_read(source.file_path, source.file_offset, file_staging.data(), block_bytes)) {
+                ggml_backend_tensor_set(gt, file_staging.data(), 0, block_bytes);
+            } else {
+                LLAMA_LOG_ERROR("%s: [layer %d] no-mmap file read failed for full-layer fill\n", __func__, layer_id);
+            }
+        }
+    }
+
+    return ds_enqueued;
+}
+
+void llama_moe_layer_cache::prefill_fill_mmap() {
+    for (size_t p = 0; p < sources.size(); ++p) {
+        const auto & source = sources[p];
+        if (!source.configured) {
+            continue;
+        }
+        uint8_t * dst = prefill_dst_self[p];
+        ggml_tensor * gt = prefill_tensor_self[p];
+        if ((dst == nullptr && gt == nullptr) || source.expert_stride == 0) {
+            continue;
+        }
+        const size_t block_bytes = (size_t) n_experts * source.expert_stride;
+        if (dst != nullptr) {
+            if (source.mmap_data != nullptr) {
+                memcpy(dst, source.mmap_data, block_bytes);
+            } else if (!llama_moe_file_read(source.file_path, source.file_offset, dst, block_bytes)) {
+                LLAMA_LOG_ERROR("%s: [layer %d] no-mmap file read failed for full-layer fill\n", __func__, layer_id);
+            }
+        } else if (source.mmap_data != nullptr) {
+            ggml_backend_tensor_set(gt, source.mmap_data, 0, block_bytes);
+        } else {
+            if (file_staging.size() < block_bytes) {
+                file_staging.resize(block_bytes);
+            }
+            if (llama_moe_file_read(source.file_path, source.file_offset, file_staging.data(), block_bytes)) {
+                ggml_backend_tensor_set(gt, file_staging.data(), 0, block_bytes);
+            } else {
+                LLAMA_LOG_ERROR("%s: [layer %d] no-mmap file read failed for full-layer fill\n", __func__, layer_id);
+            }
+        }
+    }
+}
+
+void llama_moe_layer_cache::prefill_stream_self(bool wait_now) {
+    const bool queued = prefill_enqueue_self();
+    prefill_inflight = false;
+#ifdef LLAMA_MOE_DIRECTSTORAGE
+    if (queued && ds_reader != nullptr) {
+        ds_reader->submit((uint32_t) prefill_buf_index);
+        if (wait_now) {
+            if (!ds_reader->wait((uint32_t) prefill_buf_index)) {
+                prefill_fill_mmap();
+            }
+        } else {
+            prefill_inflight = true;
+        }
+        return;
+    }
+#else
+    (void) queued;
+    (void) wait_now;
+#endif
+    // mmap path: prefill_enqueue_self already filled the buffer synchronously.
+}
+
+void llama_moe_layer_cache::prefill_wait_self() {
+#ifdef LLAMA_MOE_DIRECTSTORAGE
+    if (prefill_inflight && ds_reader != nullptr) {
+        if (!ds_reader->wait((uint32_t) prefill_buf_index)) {
+            prefill_fill_mmap();
+        }
+    }
+#endif
+    prefill_inflight = false;
+}
+
+bool llama_moe_layer_cache::prefill_enqueue_used(const std::vector<int32_t> & used_experts) {
+#ifdef LLAMA_MOE_DIRECTSTORAGE
+    const bool try_ds = ds_reader != nullptr && ds_reader->ok() && llama_moe_prefill_useds();
+#else
+    const bool try_ds = false;
+#endif
+    bool ds_enqueued = false;
+
+    for (size_t p = 0; p < sources.size(); ++p) {
+        const auto & source = sources[p];
+        if (!source.configured) {
+            continue;
+        }
+        uint8_t * dst = prefill_dst_self[p];
+        ggml_tensor * gt = prefill_tensor_self[p];
+        if ((dst == nullptr && gt == nullptr) || source.expert_stride == 0 ||
+            (source.mmap_data == nullptr && source.file_path.empty())) {
+            LLAMA_LOG_ERROR("%s: [layer %d] incomplete source/destination for used-expert fill\n", __func__, layer_id);
+            continue;
+        }
+
+#ifdef LLAMA_MOE_DIRECTSTORAGE
+        if (dst != nullptr && try_ds && !source.file_path.empty() && source.expert_stride <= (size_t) UINT32_MAX) {
+            bool all_queued = true;
+            for (int32_t expert_id : used_experts) {
+                uint8_t * edst = dst + (size_t) expert_id * source.expert_stride;
+                const uint64_t eoff = source.file_offset + (uint64_t) expert_id * source.expert_stride;
+                if (!ds_reader->enqueue(edst, source.file_path, eoff, (uint32_t) source.expert_stride)) {
+                    all_queued = false;
+                    break;
+                }
+            }
+            if (all_queued) {
+                ds_enqueued = true;
+                continue;
+            }
+        }
+#endif
+        // Fallback: copy only the used experts at their natural offsets. dst != null:
+        // host-visible write. dst == null: device memory upload via tensor_set.
+        for (int32_t expert_id : used_experts) {
+            const size_t off = (size_t) expert_id * source.expert_stride;
+            if (dst != nullptr) {
+                if (source.mmap_data != nullptr) {
+                    memcpy(dst + off, source.mmap_data + off, source.expert_stride);
+                } else if (!llama_moe_file_read(source.file_path, source.file_offset + off, dst + off, source.expert_stride)) {
+                    LLAMA_LOG_ERROR("%s: [layer %d] no-mmap file read failed for used expert %d\n", __func__, layer_id, expert_id);
+                }
+            } else if (source.mmap_data != nullptr) {
+                ggml_backend_tensor_set(gt, source.mmap_data + off, off, source.expert_stride);
+            } else {
+                if (file_staging.size() < source.expert_stride) {
+                    file_staging.resize(source.expert_stride);
+                }
+                if (llama_moe_file_read(source.file_path, source.file_offset + off, file_staging.data(), source.expert_stride)) {
+                    ggml_backend_tensor_set(gt, file_staging.data(), off, source.expert_stride);
+                } else {
+                    LLAMA_LOG_ERROR("%s: [layer %d] no-mmap file read failed for used expert %d\n", __func__, layer_id, expert_id);
+                }
+            }
+        }
+    }
+
+    return ds_enqueued;
+}
+
+void llama_moe_layer_cache::prefill_mmap_used(const std::vector<int32_t> & used_experts) {
+    for (size_t p = 0; p < sources.size(); ++p) {
+        const auto & source = sources[p];
+        if (!source.configured) {
+            continue;
+        }
+        uint8_t * dst = prefill_dst_self[p];
+        ggml_tensor * gt = prefill_tensor_self[p];
+        if ((dst == nullptr && gt == nullptr) || source.expert_stride == 0) {
+            continue;
+        }
+        for (int32_t expert_id : used_experts) {
+            const size_t off = (size_t) expert_id * source.expert_stride;
+            if (dst != nullptr) {
+                if (source.mmap_data != nullptr) {
+                    memcpy(dst + off, source.mmap_data + off, source.expert_stride);
+                } else if (!llama_moe_file_read(source.file_path, source.file_offset + off, dst + off, source.expert_stride)) {
+                    LLAMA_LOG_ERROR("%s: [layer %d] no-mmap file read failed for used expert %d\n", __func__, layer_id, expert_id);
+                }
+            } else if (source.mmap_data != nullptr) {
+                ggml_backend_tensor_set(gt, source.mmap_data + off, off, source.expert_stride);
+            } else {
+                if (file_staging.size() < source.expert_stride) {
+                    file_staging.resize(source.expert_stride);
+                }
+                if (llama_moe_file_read(source.file_path, source.file_offset + off, file_staging.data(), source.expert_stride)) {
+                    ggml_backend_tensor_set(gt, file_staging.data(), off, source.expert_stride);
+                } else {
+                    LLAMA_LOG_ERROR("%s: [layer %d] no-mmap file read failed for used expert %d\n", __func__, layer_id, expert_id);
+                }
+            }
+        }
+    }
+}
+
+void llama_moe_layer_cache::prefill_stream_used(const std::vector<int32_t> & used_experts) {
+    const bool queued = prefill_enqueue_used(used_experts);
+    prefill_inflight = false;
+#ifdef LLAMA_MOE_DIRECTSTORAGE
+    if (queued && ds_reader != nullptr) {
+        ds_reader->submit((uint32_t) prefill_buf_index);
+        if (!ds_reader->wait((uint32_t) prefill_buf_index)) {
+            prefill_mmap_used(used_experts);
+        }
+        return;
+    }
+#else
+    (void) queued;
+#endif
+}
+
+void llama_moe_offload_update(struct ggml_tensor * dst, const struct ggml_tensor * ids, int ith, int nth, void * userdata) {
+    GGML_UNUSED(nth);
+    if (ith != 0) {
+        return;
+    }
+
+    auto * cache = static_cast<llama_moe_layer_cache *>(userdata);
+    if (cache == nullptr) {
+        GGML_ABORT("MoE layer cache is missing");
+    }
+
+    // ids shape: [n_expert_used, n_tokens]
+    // ggml_argsort_top_k keeps nb[1] = n_expert_full * sizeof(I32) (full argsort buffer width),
+    // so contiguous pointer arithmetic is WRONG for multi-token batches.
+    // Must use stride-aware access via ggml_get_i32_nd / ggml_set_i32_nd.
+    const int ne0 = (int)ids->ne[0]; // n_expert_used
+    const int ne1 = (int)ids->ne[1]; // n_tokens
+
+    // Log the expert->slot remapping for this layer invocation (debug level to avoid flood)
+    LLAMA_LOG_DEBUG("%s: [layer %d] remapping %d x %d expert IDs to slot IDs\n",
+                    __func__, cache->layer_id, ne0, ne1);
+
+    FILE * lat = llama_moe_lat_dbg();
+    std::chrono::steady_clock::time_point lt0, lt1, lt2, lt3;
+    if (lat != nullptr) {
+        lt0 = std::chrono::steady_clock::now();
+    }
+
+    // Phase 1: reserve a slot for every (token, expert) pair. Pure LRU
+    // bookkeeping with no IO; records the fresh misses that need filling. A
+    // repeated expert within the batch resolves to a hit on its just-reserved
+    // slot, so each missing expert is filled exactly once.
+    std::vector<std::pair<int32_t, int32_t>> misses; // (expert_id, slot)
+    {
+        std::lock_guard<std::mutex> lock(cache->mtx);
+        for (int t = 0; t < ne1; ++t) {
+            for (int k = 0; k < ne0; ++k) {
+                const int32_t expert_id = ggml_get_i32_nd(ids, k, t, 0, 0);
+                if (expert_id < 0 || expert_id >= cache->n_experts) {
+                    LLAMA_LOG_ERROR("%s: [layer %d] invalid expert_id=%d (n_experts=%d) at token %d expert-slot %d\n",
+                                    __func__, cache->layer_id, expert_id, cache->n_experts, t, k);
+                    GGML_ABORT("MoE router produced an invalid expert ID");
+                }
+
+                bool needs_fill = false;
+                const int32_t slot = cache->reserve_slot(expert_id, needs_fill);
+                if (slot < 0) {
+                    LLAMA_LOG_ERROR("%s: [layer %d] reserve failed for expert_id=%d\n",
+                                    __func__, cache->layer_id, expert_id);
+                    GGML_ABORT("MoE expert cache acquisition failed");
+                }
+                LLAMA_LOG_DEBUG("%s: [layer %d]   [t=%d k=%d] expert %3d -> slot %d\n",
+                                __func__, cache->layer_id, t, k, expert_id, slot);
+                ggml_set_i32_nd(dst, k, t, 0, 0, slot);
+                if (needs_fill) {
+                    misses.emplace_back(expert_id, slot);
+                }
+            }
+        }
+    }
+
+    if (lat != nullptr) {
+        lt1 = std::chrono::steady_clock::now();
+        lt2 = lt1;
+        lt3 = lt1;
+    }
+
+    // Phase 2: fill all missing experts, then a SINGLE submit/wait for the whole
+    // layer instead of one blocking DirectStorage round-trip per expert.
+    if (!misses.empty()) {
+        bool ds_enqueued = false;
+        for (const auto & m : misses) {
+            if (cache->fill_enqueue_expert(m.first, m.second)) {
+                ds_enqueued = true;
+            }
+        }
+        if (lat != nullptr) {
+            lt2 = std::chrono::steady_clock::now();
+        }
+#ifdef LLAMA_MOE_DIRECTSTORAGE
+        if (ds_enqueued && !cache->ds_reader->submit_and_wait()) {
+            LLAMA_LOG_WARN("%s: [layer %d] batched DirectStorage read failed, using mmap for %zu expert(s)\n",
+                           __func__, cache->layer_id, misses.size());
+            for (const auto & m : misses) {
+                cache->fill_mmap_expert(m.first, m.second);
+            }
+        }
+#else
+        (void) ds_enqueued;
+#endif
+        if (lat != nullptr) {
+            lt3 = std::chrono::steady_clock::now();
+        }
+        if (llama_moe_io_debug()) {
+            fprintf(stderr, "[moe-io] layer=%d batched-fill experts=%zu\n", cache->layer_id, misses.size());
+        }
+    }
+
+    if (lat != nullptr) {
+        const long long reserve_us = std::chrono::duration_cast<std::chrono::microseconds>(lt1 - lt0).count();
+        const long long fill_us    = std::chrono::duration_cast<std::chrono::microseconds>(lt2 - lt1).count();
+        const long long submit_us  = std::chrono::duration_cast<std::chrono::microseconds>(lt3 - lt2).count();
+        // reserve_us = LRU bookkeeping; fill_us = enqueue + host->device upload
+        // (tensor_set) or DS enqueue; submit_us = batched DS submit/wait (0 when
+        // DS is off, since the upload already happened in fill_us).
+        size_t per_expert_bytes = 0;
+        for (const auto & s : cache->sources) {
+            if (s.configured) {
+                per_expert_bytes += s.expert_stride;
+            }
+        }
+        const double upload_mib = (double) (per_expert_bytes * misses.size()) / (1024.0 * 1024.0);
+        fprintf(lat, "decode layer=%d ntok=%d nused=%d misses=%zu reserve_us=%lld fill_us=%lld submit_us=%lld upload_MiB=%.3f\n",
+                cache->layer_id, ne1, ne0, misses.size(), reserve_us, fill_us, submit_us, upload_mib);
+        fflush(lat);
+    }
+
+    // Log per-layer stats (these are cumulative since last reset)
+    // Call log_stats_and_reset() from the outside (e.g. llama_decode) for per-decode stats.
+    // Here we just log a brief summary at DEBUG level.
+    const int64_t total = cache->n_hits + cache->n_misses;
+    if (total > 0 && total % 100 == 0) {
+        cache->log_stats_and_reset();
+    }
+}
+
+void llama_moe_prefill_fill(struct ggml_tensor * dst, const struct ggml_tensor * ids, int ith, int nth, void * userdata) {
+    GGML_UNUSED(nth);
+    if (ith != 0) {
+        return;
+    }
+
+    auto * cache = static_cast<llama_moe_layer_cache *>(userdata);
+    if (cache == nullptr) {
+        GGML_ABORT("MoE layer cache is missing");
+    }
+
+    // Identity-copy the expert ids so the downstream MUL_MAT_ID takes a data
+    // dependency on this node. ids uses the argsort stride; dst is contiguous.
+    const int ne0 = (int) ids->ne[0];
+    const int ne1 = (int) ids->ne[1];
+    for (int t = 0; t < ne1; ++t) {
+        for (int k = 0; k < ne0; ++k) {
+            ggml_set_i32_nd(dst, k, t, 0, 0, ggml_get_i32_nd(ids, k, t, 0, 0));
+        }
+    }
+
+    FILE * dbg = llama_moe_prefill_dbg();
+    const bool timing = dbg != nullptr;
+    const llama_moe_prefill_mode pmode = llama_moe_prefill_mode_get();
+
+    // Adaptive: use used-only when there is too little compute per layer to
+    // overlap the full-layer read (small/low-coverage ubatch), else full.
+    // n_tokens and n_experts are constant across the ubatch, so this is uniform.
+    bool used_only;
+    switch (pmode) {
+        case llama_moe_prefill_mode::forced_full: used_only = false; break;
+        case llama_moe_prefill_mode::forced_used: used_only = true;  break;
+        default:
+            used_only = (double) ne1 < llama_moe_prefill_adapt_ratio() * (double) cache->n_experts;
+            break;
+    }
+
+    // Unique experts routed by this ubatch (needed to stream used-only, and to
+    // log coverage). Their natural offset in the full-size buffer is expert*stride.
+    std::vector<int32_t> used_experts;
+    if ((used_only || timing) && cache->n_experts > 0) {
+        std::vector<uint8_t> seen((size_t) cache->n_experts, 0);
+        for (int t = 0; t < ne1; ++t) {
+            for (int k = 0; k < ne0; ++k) {
+                const int32_t e = ggml_get_i32_nd(ids, k, t, 0, 0);
+                if (e >= 0 && e < cache->n_experts && !seen[(size_t) e]) {
+                    seen[(size_t) e] = 1;
+                    used_experts.push_back(e);
+                }
+            }
+        }
+        // Ascending expert id => ascending file offset, so the DirectStorage
+        // reads run in increasing-offset order (more sequential, less seek).
+        std::sort(used_experts.begin(), used_experts.end());
+    }
+
+    std::chrono::steady_clock::time_point t_w0, t_w1, t_s1;
+    if (timing) {
+        t_w0 = std::chrono::steady_clock::now();
+    }
+
+    if (used_only) {
+        // Stream only the routed experts into their natural positions, then
+        // MUL_MAT_ID reads only those rows (identity ids). Synchronous: the next
+        // layer's routing is not known here, so there is no cross-layer prefetch.
+        cache->prefill_stream_used(used_experts);
+        if (timing) {
+            t_w1 = std::chrono::steady_clock::now();
+            t_s1 = t_w1;
+        }
+    } else {
+        // Ping-pong. This layer computes against prefill_buf_index, which the
+        // previous layer already kicked off into that buffer (or, for the first
+        // layer, is streamed synchronously here). Then the next layer's read is
+        // launched into the other buffer so it overlaps this layer's MUL_MAT_ID.
+        // The buffer the next layer targets was last read by layer il-1, whose
+        // matmul is already retired at this point in the graph.
+        if (cache->prefill_first) {
+            cache->prefill_stream_self(true);
+        } else {
+            cache->prefill_wait_self();
+        }
+
+        if (timing) {
+            t_w1 = std::chrono::steady_clock::now();
+        }
+
+        if (cache->prefill_next != nullptr) {
+            cache->prefill_next->prefill_stream_self(false);
+        }
+
+        if (timing) {
+            t_s1 = std::chrono::steady_clock::now();
+        }
+    }
+
+    if (timing) {
+        const long long wait_us   = std::chrono::duration_cast<std::chrono::microseconds>(t_w1 - t_w0).count();
+        const long long submit_us = std::chrono::duration_cast<std::chrono::microseconds>(t_s1 - t_w1).count();
+        // wait_us = exposed IO stall (blocked on this layer's read);
+        // submit_us = cost of kicking off the next layer's async read (0 in used mode);
+        // used/total = unique routed experts vs experts available each layer.
+        fprintf(dbg, "timing layer=%d first=%d wait_us=%lld submit_us=%lld used=%d total=%d ntok=%d mode=%s\n",
+                cache->layer_id, (int) cache->prefill_first, wait_us, submit_us,
+                (int) used_experts.size(), cache->n_experts, ne1, used_only ? "used" : "full");
+    }
+
+    if (dbg != nullptr) {
+        fprintf(dbg, "fill  layer=%d buf=%d first=%d n_expert_used=%d n_tokens=%d ids[t0]=",
+                cache->layer_id, cache->prefill_buf_index, (int) cache->prefill_first, ne0, ne1);
+        for (int k = 0; k < ne0; ++k) {
+            fprintf(dbg, "%d,", (int) ggml_get_i32_nd(ids, k, 0, 0, 0));
+        }
+        fprintf(dbg, "\n");
+        for (size_t p = 0; p < cache->sources.size(); ++p) {
+            const auto & source = cache->sources[p];
+            if (!source.configured) {
+                continue;
+            }
+            const size_t block = (size_t) cache->n_experts * source.expert_stride;
+            llama_moe_prefill_verify(dbg, cache->layer_id, cache->prefill_buf_index, p,
+                                     cache->prefill_dst_self[p], source.mmap_data, block);
+        }
+    }
+}
diff --git a/src/llama-moe-offload.h b/src/llama-moe-offload.h
new file mode 100644
index 0000000000000000000000000000000000000000..dc63902e701b2fcb2e5200fbf302c7d8aed711df
--- /dev/null
+++ b/src/llama-moe-offload.h
@@ -0,0 +1,156 @@
+// llama-moe-offload.h
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <list>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+struct ggml_tensor;
+struct llama_moe_ds_reader;
+
+enum class llama_moe_projection : uint32_t {
+    GATE,
+    UP,
+    GATE_UP,
+    DOWN,
+    COUNT,
+};
+
+struct llama_moe_expert_source {
+    bool configured = false;
+    const uint8_t * mmap_data = nullptr;
+    size_t expert_stride = 0;
+    ggml_tensor * gpu_tensor = nullptr;
+    std::string file_path;      // source GGUF path, for DirectStorage reads
+    uint64_t file_offset = 0;   // byte offset of expert 0 within the file
+};
+
+struct ggml_backend;
+
+struct llama_moe_layer_cache {
+    int32_t n_slots = 0;
+    int32_t n_experts = 0;
+    int32_t layer_id = -1;   // for log context
+
+    std::vector<int32_t> slot_expert;
+    std::vector<bool> slot_filled;
+    std::list<int32_t> lru_order;
+    std::unordered_map<int32_t, std::list<int32_t>::iterator> expert_to_iter;
+
+    std::array<llama_moe_expert_source, static_cast<size_t>(llama_moe_projection::COUNT)> sources;
+
+    // Prefill full-layer residency (ping-pong). prefill_dst_self points at this
+    // layer's own buffer (one of the two shared buffers, chosen by parity);
+    // prefill_next is the layer prefetched into the OTHER buffer while this
+    // layer computes. Empty/unset unless prefill residency is enabled.
+    std::array<uint8_t *, static_cast<size_t>(llama_moe_projection::COUNT)> prefill_dst_self{};
+    // Graph matmul operands: this layer's signature buffer at its ping-pong parity.
+    std::array<struct ggml_tensor *, static_cast<size_t>(llama_moe_projection::COUNT)> prefill_tensor_self{};
+    int32_t prefill_buf_index = -1;                 // DirectStorage completion slot (execution parity)
+    llama_moe_layer_cache * prefill_next = nullptr; // next offloaded layer to prefetch, or null
+    bool prefill_first = false;                     // first layer in the offloaded sequence
+    bool prefill_inflight = false;                  // an async DS prefetch is pending for this buffer
+
+    std::mutex mtx;
+
+    // Shared DirectStorage reader (non-owning); nullptr means mmap/file fill only.
+    llama_moe_ds_reader * ds_reader = nullptr;
+
+    // Reusable host staging buffer for the no-mmap fallback. When a source has no
+    // mmap pointer and a DirectStorage read is unavailable or fails, expert bytes
+    // are read from the GGUF file into here, then uploaded into the slot.
+    std::vector<uint8_t> file_staging;
+
+    // Per-decode statistics (reset each token)
+    int64_t n_hits     = 0;
+    int64_t n_misses   = 0;
+    int64_t n_evictions = 0;
+
+    void init(int32_t n_slots_, int32_t n_experts_);
+    void set_source(llama_moe_projection projection, size_t expert_stride, const uint8_t * mmap_data, ggml_tensor * gpu_tensor,
+                    const std::string & file_path = std::string(), uint64_t file_offset = 0);
+    int32_t acquire(int32_t expert_id);
+    // Batched decode fill helpers (see llama_moe_offload_update). reserve_slot
+    // does the LRU bookkeeping only, no IO; caller must hold mtx. It sets
+    // needs_fill=true on a fresh miss. The fill helpers move an expert's bytes
+    // into its slot: fill_enqueue_expert queues DirectStorage reads (mmap-filling
+    // any projection that cannot use DS) and returns true if the caller must
+    // submit()/wait() a DS batch; fill_mmap_expert is the synchronous mmap
+    // fallback for all projections.
+    int32_t reserve_slot(int32_t expert_id, bool & needs_fill);
+    bool fill_enqueue_expert(int32_t expert_id, int32_t slot);
+    void fill_mmap_expert(int32_t expert_id, int32_t slot);
+    void log_stats_and_reset();  // log hit/miss stats then reset counters
+
+    // Prefill full-layer residency (distinct from the decode slot cache).
+    // Total bytes to hold ALL n_experts of every configured projection.
+    // Model-derived (n_experts x expert_stride summed over configured
+    // projections), so it adapts to any GGUF MoE arch.
+    size_t full_layer_bytes() const;
+    // Enqueue every expert of every configured projection of THIS layer into
+    // prefill_dst_self. With DirectStorage this only queues the reads (caller
+    // submits/waits a completion slot); without it, the bytes are memcpy'd from
+    // mmap synchronously. Returns true if reads were queued through
+    // DirectStorage (caller must submit), false if already filled via mmap.
+    bool prefill_enqueue_self();
+    // Synchronous mmap fill of THIS layer's prefill_dst_self, used as a fallback
+    // when a DirectStorage read fails.
+    void prefill_fill_mmap();
+    // Kick off this layer's stream into prefill_dst_self. wait_now=true blocks
+    // until the data is present (mmap fallback on DS failure); wait_now=false
+    // only launches the async DirectStorage read and marks prefill_inflight so a
+    // later prefill_wait_self() completes it (the ping-pong prefetch path).
+    void prefill_stream_self(bool wait_now);
+    // Block until a prefill_stream_self(false) read for this buffer completes,
+    // falling back to mmap on DirectStorage failure.
+    void prefill_wait_self();
+
+    // Used-expert prefill: stream ONLY the experts this ubatch routes to into
+    // their natural positions in the full-size prefill buffer. Unused rows keep
+    // stale data but are never read by MUL_MAT_ID (identity ids). Cuts IO by the
+    // routing coverage ratio. Synchronous (no cross-layer prefetch, since the
+    // next layer's routing is not known here).
+    bool prefill_enqueue_used(const std::vector<int32_t> & used_experts);
+    void prefill_mmap_used(const std::vector<int32_t> & used_experts);
+    void prefill_stream_used(const std::vector<int32_t> & used_experts);
+};
+
+struct llama_moe_offload_context {
+    int32_t offload_ratio = 0;
+    std::unordered_map<int32_t, llama_moe_layer_cache> caches;
+
+    // Prefill full-layer residency (opt-in via LLAMA_MOE_PREFILL_RESIDENT).
+    // Two shared host-visible buffers (ping-pong) live in one backend buffer:
+    // while a multi-token ubatch matmuls layer il against tensor set (il-parity)
+    // with identity ids, the next layer streams into the other set so its read
+    // overlaps compute. Decode keeps the per-layer LRU slots.
+    static constexpr size_t PREFILL_NBUF = 2;
+    bool prefill_resident = false;
+    struct ggml_context * prefill_ctx = nullptr;
+    struct ggml_backend_buffer * prefill_buffer = nullptr;
+    int32_t prefill_signatures = 0;                 // distinct expert-tensor signatures (ping-pong pairs)
+
+    bool prefill_ready() const { return prefill_resident && prefill_buffer != nullptr; }
+
+#ifdef LLAMA_MOE_DIRECTSTORAGE
+    std::unique_ptr<llama_moe_ds_reader> ds_reader;
+#endif
+    ~llama_moe_offload_context();
+
+    llama_moe_layer_cache * get_cache(int32_t layer) {
+        auto it = caches.find(layer);
+        return it == caches.end() ? nullptr : &it->second;
+    }
+};
+
+void llama_moe_offload_update(struct ggml_tensor * dst, const struct ggml_tensor * ids, int ith, int nth, void * userdata);
+void llama_moe_prefill_fill(struct ggml_tensor * dst, const struct ggml_tensor * ids, int ith, int nth, void * userdata);
+
+// True if the prefill fill will use DirectStorage (default), false for the warm
+// mmap memcpy path (LLAMA_MOE_PREFILL_DS=0). For the startup summary banner.
+bool llama_moe_prefill_uses_directstorage();
