+#ifndef GGML_SYCL_MOE_U4_DPAS_HPP
+#define GGML_SYCL_MOE_U4_DPAS_HPP
+
+#include "common.hpp"
+
+// Grouped W4A8 MoE gemm on XMX, in place of oneDNN's grouped_gemm:micro.
+//
+// dst[r,n] = sum_g as[r,g]*ws[g,n] * ( sum_{k in g} a[r,k]*w[n,k] - zp[g,n]*asum[r,g] )
+// over expert-sorted rows, one expert per row range (offs holds the exclusive ends).
+// group is 64 along k. Operand layouts (see moe_u4_dpas.cpp for the full description):
+//   w/wsc/wzp : dpas-swizzled, written by ggml_sycl_moe_u4_pack_swizzle
+//   act       : dpas A tiles [row/8][K/32] of 256 B, expert rows starting at pbeg[e]
+//   asc/asum  : [K/64][P] f32/s32
+//   dst       : [M, N] f16, rows in expert order (not padded)
+
+// can the dpas kernel take this shape?
+bool ggml_sycl_moe_u4_dpas_ok(int64_t N, int64_t K);
+
+void ggml_sycl_moe_u4_dpas_gemm(const uint8_t * w, const sycl::half * wsc, const uint8_t * wzp,
+                                const int8_t * act, const float * asc, const int32_t * asum,
+                                const int32_t * offs, const int32_t * pbeg, sycl::half * dst,
+                                int E, int P, int N, int K, queue_ptr stream);
+
+// gate_up gemm with silu(gate)*up and the down-side activation quantization folded into the
+// epilogue: writes the down gemm's A operands (packed s8 + [n_ff/64, P] scales and sums)
+// instead of the [n_rows, 2*n_ff] f16 intermediate. w is the fused gate_up tensor.
+bool ggml_sycl_moe_u4_dpas_glu_ok(int64_t n_ff);
+
+void ggml_sycl_moe_u4_dpas_gemm_glu(const uint8_t * w, const sycl::half * wsc, const uint8_t * wzp,
+                                    const int8_t * act, const float * asc, const int32_t * asum,
+                                    const int32_t * offs, const int32_t * pbeg,
+                                    int8_t * q2, float * sc2, int32_t * sum2,
+                                    int E, int P, int n_ff, int K, queue_ptr stream);
+
+// W4A16 gemv for one row per active expert (decode), on the same swizzled weights.
+// GATED folds silu(gate)*up over the two halves of a fused gate_up tensor.
+void ggml_sycl_moe_u4_dpas_gemv(const uint8_t * w, const sycl::half * wsc, const uint8_t * wzp,
+                                const sycl::half * act, sycl::half * dst, const int32_t * offs,
+                                const int32_t * actives, int n_slots, int64_t N, int64_t K,
+                                bool gated, queue_ptr stream);
+
+// q (unpacked u4 values, [nrows, k]) + scales/zp ([k/64, nrows]) -> swizzled layout
+void ggml_sycl_moe_u4_pack_swizzle(const uint8_t * q, const sycl::half * sc_in, const uint8_t * zp_in,
+                                   uint8_t * w, sycl::half * sc, uint8_t * zp,
+                                   int64_t nrows, int64_t k, queue_ptr stream);
+
+#endif // GGML_SYCL_MOE_U4_DPAS_HPP
