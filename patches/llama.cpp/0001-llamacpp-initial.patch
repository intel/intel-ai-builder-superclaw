+ggml_tensor * llm_build_delta_net_base::build_ssm_conv_fused(
+        llm_graph_input_rs * inp,
+        ggml_tensor *        conv_states_all,
+        ggml_tensor *        qkv_mixed,
+        ggml_tensor *        conv_kernel,
+        int64_t              conv_kernel_size,
+        int64_t              conv_channels,
+        int                  il) {
+    const auto * mctx_cur = inp->mctx;
+
+    const auto kv_head  = mctx_cur->get_head();
+    const auto mem_size = mctx_cur->get_size();
+
+    const int64_t n_seqs       = ubatch.n_seqs;
+    const int64_t n_seq_tokens = qkv_mixed->ne[1];
+
+    // slot 0 is the state after the last token, slot s the state s tokens back
+    // ([TAG_RECURRENT_ROLLBACK_SPLITS] rollback snapshots, same layout as build_conv_state)
+    const int64_t K = (int64_t) cparams.n_rs_seq + 1;
+
+    // caller must guarantee every snapshot window is sourced entirely from new tokens
+    GGML_ASSERT(n_seq_tokens >= conv_kernel_size - 1 + (int64_t) cparams.n_rs_seq);
+
+    ggml_tensor * conv_states = build_rs(inp, conv_states_all, hparams.n_embd_r(), n_seqs);
+    cb(conv_states, "conv_states", il);
+
+    conv_states = ggml_reshape_3d(ctx0, conv_states, conv_kernel_size - 1, conv_channels, n_seqs);
+    cb(conv_states, "conv_states_reshaped", il);
+
+    // qkv_mixed stays channel-contiguous [conv_channels, n_seq_tokens, n_seqs]: no transpose/concat
+    ggml_tensor * conv_output = ggml_ssm_conv_state(ctx0, qkv_mixed, conv_kernel, conv_states);
+    cb(conv_output, LLAMA_TENSOR_NAME_FCONV, il);
+
+    // write the trailing conv windows back as the next conv state(s)
+    const int64_t row_count = (conv_kernel_size - 1) * conv_channels;
+    const size_t  row_size  = ggml_row_size(conv_states_all->type, row_count);
+
+    // materialize the trailing kernel-1 + K-1 tokens once in cache layout
+    // [tokens, channels, seqs]; every snapshot window is a contiguous-row view of it
+    // (the SYCL conv-snap hook then folds the K slot writebacks into one kernel)
+    const int64_t tail_tokens = conv_kernel_size - 1 + (K - 1);
+    ggml_tensor * tail =
+        ggml_view_3d(ctx0, qkv_mixed,
+                conv_channels, tail_tokens, n_seqs,
+                qkv_mixed->nb[1], qkv_mixed->nb[2],
+                (n_seq_tokens - tail_tokens) * qkv_mixed->nb[1]);
+    // to [tail_tokens, conv_channels, n_seqs], matching the cache layout
+    tail = ggml_cont(ctx0, ggml_transpose(ctx0, tail));
+    cb(tail, "conv_state_tail", il);
+
+    for (int64_t t = 1; t <= K; ++t) {
+        const int64_t s_slot = K - t;
+
+        ggml_tensor * conv_state_last =
+            ggml_view_3d(ctx0, tail,
+                    conv_kernel_size - 1, conv_channels, n_seqs,
+                    tail->nb[1], tail->nb[2],
+                    ggml_row_size(tail->type, t - 1));
+        cb(conv_state_last, "conv_state_last", il);
+
+        ggml_tensor * conv_state_update =
+            ggml_view_2d(ctx0, conv_states_all,
+                    row_count, n_seqs, conv_states_all->nb[1],
+                    (s_slot * mem_size + kv_head) * row_size);
+        cb(conv_state_update, "conv_state_update", il);
+
+        ggml_build_forward_expand(gf, ggml_cpy(ctx0, conv_state_last, conv_state_update));
+    }
+
+    return conv_output;
+}
