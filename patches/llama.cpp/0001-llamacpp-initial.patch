+}
+
+static size_t ggml_sycl_alloc_trace_forget(const void * ptr) {
+    std::lock_guard<std::mutex> lock(g_alloc_trace_mtx);
+    auto it = g_alloc_trace_sizes.find(ptr);
+    if (it == g_alloc_trace_sizes.end()) {
+        return 0;
+    }
+    size_t size = it->second;
+    g_alloc_trace_sizes.erase(it);
+    return size;
+}
