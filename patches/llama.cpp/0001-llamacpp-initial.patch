+// f32 -> f16 activation staging with the same one-writer-per-graph reuse rules as the
+// q8 cache (gate/up, q/k/v and the GDN projections share one copy)
+static bool dense_f16_src1(ggml_backend_sycl_context & ctx, const ggml_tensor * src1,
+                           const float * src1_ddf, const int64_t nrows, const int64_t k,
+                           queue_ptr stream) {
+    const bool reuse = ctx.f16_src1 == src1 && ctx.f16_src1_data == src1_ddf &&
+                       ctx.f16_src1_gen == ctx.q8_cache_generation && ctx.f16_act != nullptr;
+    if (reuse) {
+        return true;
+    }
+    // Every int8 path was expected to consume the s8 copy of this tensor, so its
+    // producer skipped the f32 store; converting from it now would read stale memory.
+    if (ctx.dnn_int8_src1_f32_dead && ctx.dnn_int8_src1 == src1 &&
+        ctx.dnn_int8_src1_data == src1_ddf &&
+        ctx.dnn_int8_src1_gen == ctx.dnn_int8_generation) {
+        GGML_ABORT("dense f16 staging of a tensor whose f32 payload was elided "
+                   "(set GGML_SYCL_DEAD_ELIDE=0)");
+    }
+    const size_t need = (size_t) nrows * k * sizeof(sycl::half);
+    if (ctx.f16_act_cap < need) {
+        if (ctx.f16_act != nullptr) {
+            ctx.pending_frees.push_back(ctx.f16_act);
+        }
+        ctx.f16_act = (sycl::half *) sycl::malloc_device(need, *stream);
+        ctx.f16_act_cap = ctx.f16_act != nullptr ? need : 0;
+        ctx.q8_cache_queue = stream;
+    }
+    if (ctx.f16_act == nullptr) {
+        return false;
+    }
+    const int64_t n = nrows * k;
+    sycl::half * dst16 = ctx.f16_act;
+    stream->parallel_for(sycl::range<1>(n), [=](sycl::id<1> i) {
+        dst16[i[0]] = (sycl::half) src1_ddf[i[0]];
+    });
+    ctx.f16_src1      = src1;
+    ctx.f16_src1_data = src1_ddf;
+    ctx.f16_src1_gen  = ctx.q8_cache_generation;
+    return true;
+}
