+}   // namespace
+
+bool ggml_sycl_moe_u4_dpas_ok(int64_t N, int64_t K) {
+    return (N % (TN * WGN)) == 0 && (K % 64) == 0 && N >= TN * WGN;
+}
+
+bool ggml_sycl_moe_u4_dpas_glu_ok(int64_t n_ff) {
+    return (n_ff % 64) == 0 && n_ff >= 64;
+}
+
+void ggml_sycl_moe_u4_dpas_gemm_glu(const uint8_t * w, const sycl::half * wsc, const uint8_t * wzp,
+                                    const int8_t * act, const float * asc, const int32_t * asum,
+                                    const int32_t * offs, const int32_t * pbeg,
+                                    int8_t * q2, float * sc2, int32_t * sum2,
+                                    int E, int P, int n_ff, int K, queue_ptr stream) {
+    moe_gemm_glu(w, wsc, wzp, act, asc, asum, offs, pbeg, q2, sc2, sum2, E, P, n_ff, K, stream);
+}
+
+void ggml_sycl_moe_u4_dpas_gemm(const uint8_t * w, const sycl::half * wsc, const uint8_t * wzp,
+                                const int8_t * act, const float * asc, const int32_t * asum,
+                                const int32_t * offs, const int32_t * pbeg, sycl::half * dst,
+                                int E, int P, int N, int K, queue_ptr stream) {
+    moe_gemm(w, wsc, wzp, act, asc, asum, offs, pbeg, dst, E, P, N, K, stream);
+}
+
+void ggml_sycl_moe_u4_dpas_gemv(const uint8_t * w, const sycl::half * wsc, const uint8_t * wzp,
+                                const sycl::half * act, sycl::half * dst, const int32_t * offs,
+                                const int32_t * actives, int n_slots, int64_t N, int64_t K,
+                                bool gated, queue_ptr stream) {
+    // k slices only pay off when they divide the group count evenly
+    static const int sk_env = ggml_sycl_get_env("GGML_SYCL_MOE_GEMV_SK", 4);
+    const int sk = (K / 64) % sk_env == 0 ? sk_env : 1;
+    if (gated) {
+        switch (sk) {
+            case 4: moe_gemv<true, 4>(w, wsc, wzp, act, dst, offs, actives, n_slots, N, K, stream); break;
+            case 2: moe_gemv<true, 2>(w, wsc, wzp, act, dst, offs, actives, n_slots, N, K, stream); break;
+            default: moe_gemv<true, 1>(w, wsc, wzp, act, dst, offs, actives, n_slots, N, K, stream); break;
+        }
+    } else {
+        switch (sk) {
+            case 4: moe_gemv<false, 4>(w, wsc, wzp, act, dst, offs, actives, n_slots, N, K, stream); break;
+            case 2: moe_gemv<false, 2>(w, wsc, wzp, act, dst, offs, actives, n_slots, N, K, stream); break;
+            default: moe_gemv<false, 1>(w, wsc, wzp, act, dst, offs, actives, n_slots, N, K, stream); break;
+        }
+    }
+}
+
+void ggml_sycl_moe_u4_pack_swizzle(const uint8_t * q, const sycl::half * sc_in, const uint8_t * zp_in,
+                                   uint8_t * w, sycl::half * sc, uint8_t * zp,
+                                   int64_t nrows, int64_t k, queue_ptr stream) {
+    const int64_t kg = k / 64;
+    const int64_t kb = k / 32;
+    // weights: one dword (8 nibbles along k) per work-item
+    {
+        uint32_t * wd = (uint32_t *) w;
+        stream->parallel_for(sycl::range<1>((size_t) nrows * (k / 8)), [=](sycl::id<1> id) {
+            const int64_t i  = id[0];
+            const int64_t n  = i / (k / 8);
+            const int64_t k8 = i % (k / 8);
+            uint32_t v = 0;
+            for (int j = 0; j < 8; ++j) {
+                v |= (uint32_t) (q[n * k + k8 * 8 + j] & 0xF) << (4 * j);
+            }
+            wd[(n / 16) * kb * 64 + (k8 / 4) * 64 + (k8 % 4) * 16 + (n % 16)] = v;
+        });
+    }
+    // scales [kg, nrows] -> [nrows/16][kg][16]
+    stream->parallel_for(sycl::range<1>((size_t) nrows * kg), [=](sycl::id<1> id) {
+        const int64_t i = id[0];
+        const int64_t g = i / nrows;
+        const int64_t n = i % nrows;
+        sc[(n / 16) * kg * 16 + g * 16 + (n % 16)] = sc_in[i];
+    });
+    // zp [kg, nrows] -> [nrows/16][kg][8], two n per byte
+    stream->parallel_for(sycl::range<1>((size_t) nrows * kg / 2), [=](sycl::id<1> id) {
+        const int64_t i = id[0];
+        const int64_t g = i / (nrows / 2);
