+#if GGML_SYCL_DNNL
+// ---- dense u4 weights: ONE in-place copy of each large dense weight serves both the
+// oneDNN W4A16 prefill matmul and a decode gemv, replacing the gguf-format original
+// (read by mmvq) plus the separate s8 cache the int8 path kept per weight.
+// layout inside the original allocation (asym u4@group64 = 4.3125 b/w, always fits
+// in a Q*_K row): [u4 data ne/2 B][f16 scales ne/64*2 B][packed u4 zp ne/64/2 B]
+
+struct dense_u4_planes {
+    uint8_t    * w;
+    sycl::half * sc;
+    uint8_t    * zp;
+    int          group;
+};
+
+static int dense_u4_group(const ggml_tensor * t) {
+    GGML_UNUSED(t);
+    // g128 is what oneDNN's (s8 x u4) gemm is tuned for: on B70 the 2048x5120x17408
+    // FFN shape runs 1.71 -> 1.32 ms (214 -> 277 TOPS) going from g64 to g128, and the
+    // coarser groups also stream half the scales on the memory-bound decode.
+    // GGML_SYCL_U4_G32 / _G64 force the finer groups as quality probes.
+    if (getenv("GGML_SYCL_U4_G32") != nullptr) return 32;
+    if (getenv("GGML_SYCL_U4_G64") != nullptr) return 64;
+    return 128;
+}
+
+// log2(group) for the (k >> gshift) group index arithmetic over the u4 planes
+static int dense_u4_gshift(int group) {
+    return group == 128 ? 7 : group == 64 ? 6 : 5;
+}
+
+// activation quant group for the w4a8 gemms; matches the weight group so oneDNN
+// sees one group size along K
+static int dense_u4_act_group(int group_w) {
+    return group_w;
+}
+
+static dense_u4_planes dense_u4_get_planes(const ggml_tensor * t) {
+    const int     group = dense_u4_group(t);
+    const int64_t ne = t->ne[0] * t->ne[1];
+    const int64_t kg = t->ne[0] / group;
+    uint8_t * base = (uint8_t *) t->data;
+    dense_u4_planes p;
+    p.w     = base;
+    p.sc    = (sycl::half *) (base + ne / 2);
+    p.zp    = base + ne / 2 + t->ne[1] * kg * (int64_t) sizeof(sycl::half);
+    p.group = group;
+    return p;
+}
+
+#ifndef GGML_SYCL_U4_S8_ROWS_DEFAULT
+#define GGML_SYCL_U4_S8_ROWS_DEFAULT 128
+#endif
+
+// batches at least this many rows route to the s8 x s8 gemm (tuned gemm_kernel)
+// instead of the u4-weight paths, whose (s8 x u4) matmul only gets the generic
+// jit:gemm:any config (4B pp1024 3.3k -> 3.9k t/s); decode and spec-verify sizes
+// keep the u4 planes and their numerics. 0 disables the rerouting.
+static int64_t dense_u4_s8_rows() {
+    static const int64_t v = []() -> int64_t {
+        const char * e = getenv("GGML_SYCL_U4_S8_ROWS");
+        if (e != nullptr) {
+            return atoll(e);
+        }
+        const int64_t dflt = GGML_SYCL_U4_S8_ROWS_DEFAULT;
+        if (dflt <= 0) {
+            return 0;
+        }
+        // the s8 cache is additive and only freed with the context, needing about 1.5x
+        // the resident weight bytes on top of the u4 planes. when that does not fit,
+        // WDDM oversubscribes and pages to host rather than failing the allocation,
+        // which costs ~5x prefill - such models stay on the u4 path. evaluated on the
+        // first matmul, i.e. once the weights are already resident.
+        size_t free_mem = 0, total_mem = 0;
+        try {
+            dpct::dev_mgr::instance().get_device(0).get_memory_info(free_mem, total_mem);
+        } catch (const std::exception &) {
+            return dflt;
+        }
+        if (free_mem == 0 || total_mem == 0 || free_mem > total_mem) {
+            return dflt; // no usable free-memory query, keep the tuned default
+        }
+        if (free_mem * 2 < (total_mem - free_mem) * 3) {
+            GGML_LOG_INFO("dense_u4_s8_rows: s8 rerouting disabled, the weight cache would "
+                          "not fit (%zu MiB free, %zu MiB used)\n",
+                          free_mem / (1024 * 1024), (total_mem - free_mem) / (1024 * 1024));
+            return 0;
+        }
+        return dflt;
+    }();
+    return v;
+}
+
+// does a u4-eligible weight at this batch width take the s8-weight gemm instead of
+// (s8 x u4)? the two want different activation scale layouts, so the graph scan that
+// decides which layouts to emit has to ask the same question ggml_sycl_mul_mat_u4 does
+static bool dense_u4_s8_reroutes(const ggml_tensor * w, int64_t ncols) {
+    const int64_t s8_rows = dense_u4_s8_rows();
+    return s8_rows > 0 && ncols >= s8_rows && (w->ne[0] % 128) == 0 && w->ne[1] >= 32;
+}
+
+// dequantize rows [r0, r0+nr) of the in-place u4 planes back to f32 (same
+// addressing as ggml_sycl_get_rows_u4) so the s8 weight cache can be rebuilt
+static void dense_u4_dequant_rows(const ggml_tensor * src0, float * out,
+                                  int64_t r0, int64_t nr, queue_ptr stream) {
+    const dense_u4_planes p = dense_u4_get_planes(src0);
+    const int64_t K = src0->ne[0];
+    const int64_t N = src0->ne[1];
+    const int gshift = dense_u4_gshift(p.group);
+    const uint8_t    * w   = p.w;
+    const sycl::half * sc  = p.sc;
+    const uint8_t    * zpp = p.zp;
+    stream->parallel_for(
+        sycl::nd_range<1>(sycl::range<1>((size_t) nr * 256), sycl::range<1>(256)),
+        [=](sycl::nd_item<1> it) {
+            const int64_t i = it.get_group(0);
+            const int64_t r = r0 + i;
+            const uint8_t * wr = w + (size_t) r * (K / 2);
+            for (int64_t j = it.get_local_id(0); j < K; j += 256) {
+                const int64_t gi = (j >> gshift) * N + r;
+                const uint8_t qb = wr[j >> 1];
+                const int     qv = (j & 1) ? (qb >> 4) : (qb & 0xF);
+                const uint8_t zb = zpp[gi >> 1];
+                const int     zv = (gi & 1) ? (zb >> 4) : (zb & 0xF);
+                out[i * K + j] = (float) sc[gi] * (float) (qv - zv);
+            }
+        });
+}
+
+static bool dense_u4_eligible(const ggml_tensor * t) {
+    if (t->type != GGML_TYPE_Q4_K && t->type != GGML_TYPE_Q5_K && t->type != GGML_TYPE_Q6_K &&
+        t->type != GGML_TYPE_Q8_0) return false;
+    if (t->ne[2] != 1 || t->ne[3] != 1 || !ggml_is_contiguous(t)) return false;
+    if (t->ne[0] % 256 != 0 || t->ne[1] % 8 != 0) return false;
+    // per-expert slices from the mul_mat_id loop share the whole expert tensor's extra
+    if (strstr(t->name, "_exps") != nullptr) return false;
+    // below this size a tensor stays in gguf format (mmvq path); small attn k/v are
+    // both bandwidth-cheap and quant-sensitive so excluding them can help PPL for free
+    static const int64_t u4_min_bytes = []{
+        const char * e = getenv("GGML_SYCL_U4_MINMB");
+        return (int64_t)(e ? atoi(e) : 2) * 1024 * 1024;
+    }();
+    // the shared expert (~1.1MB q8_0) is below the gate but not quant-sensitive; converting
+    // it to u4 halves its per-token bytes for ~0.67% PPL, so it converts by default
+    // (GGML_SYCL_U4_SHEXP=0 keeps it native)
+    static const bool u4_shexp = ggml_sycl_get_env("GGML_SYCL_U4_SHEXP", 1) != 0;
+    const bool shexp_ok = u4_shexp && strstr(t->name, "shexp") != nullptr;
+    if (ggml_nbytes(t) < u4_min_bytes && !shexp_ok) return false;
+    // the (possibly tied) embedding needs the u4 get_rows path for token lookup;
+    // GGML_SYCL_U4_EMBD=0 keeps it in gguf format instead
+    if (!g_ggml_sycl_u4_embd &&
+        (strcmp(t->name, "token_embd.weight") == 0 || strcmp(t->name, "output.weight") == 0)) return false;
+    // a GDN projection the quant recipe kept at 8 bits is marked sensitive; with the
+    // ALS refit converting them costs ~1.5% PPL for ~11% decode speed on the 35B, so
+    // they convert by default. GGML_SYCL_U4_ALL=0 keeps them at 8 bits instead.
+    static const bool u4_all = []{
+        const char * e = getenv("GGML_SYCL_U4_ALL");
+        return e == nullptr || atoi(e) != 0;
+    }();
+    if (t->type == GGML_TYPE_Q8_0 && !u4_all &&
+        (strstr(t->name, "attn_qkv") != nullptr || strstr(t->name, "ssm_out") != nullptr)) return false;
+    const char * only = getenv("GGML_SYCL_U4_ONLY");   // per-class PPL bisect aid
+    if (only != nullptr && strstr(t->name, only) == nullptr) return false;
+    return true;
+}
+
+static size_t dense_u4_compact_size(const ggml_tensor * t) {
+    const size_t elements = (size_t) t->ne[0] * (size_t) t->ne[1];
+    const size_t groups = (size_t) t->ne[1] * (size_t) (t->ne[0] / dense_u4_group(t));
+    return elements / 2 + groups * sizeof(sycl::half) + (groups + 1) / 2;
+}
+
+static bool dense_u4_load_eligible(const ggml_tensor * t) {
+    const ggml_tensor_extra_gpu * extra = (const ggml_tensor_extra_gpu *) t->extra;
+    const bool marked_weight = (t->flags & GGML_TENSOR_FLAG_MODEL_WEIGHT) != 0 ||
+        (extra != nullptr && extra->optimized_feature.u4_load);
+    return marked_weight &&
+        g_ggml_sycl_u4_load != 0 &&
+        g_ggml_sycl_u4_dense != 0 &&
+        g_ggml_sycl_enable_dnn &&
+        t->op == GGML_OP_NONE &&
+        t->view_src == nullptr &&
+        dense_u4_eligible(t);
+}
+
+// dequantizing row gather over the in-place u4 planes (token embedding lookup);
+// false = tensor not converted, caller uses the gguf-format path
+bool ggml_sycl_get_rows_u4(ggml_backend_sycl_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * src0 = dst->src[0];
+    const ggml_tensor * src1 = dst->src[1];
+    if (src0->extra == nullptr ||
+        !((const ggml_tensor_extra_gpu *) src0->extra)->optimized_feature.u4_dense) {
+        return false;
+    }
+    GGML_ASSERT(dst->type == GGML_TYPE_F32 && src1->type == GGML_TYPE_I32);
+    GGML_ASSERT(ggml_is_contiguous(src1) && ggml_is_contiguous(dst));
+
+    const int64_t K  = src0->ne[0];
+    const int64_t N  = src0->ne[1];
+    const int64_t nr = ggml_nelements(src1);
+    const dense_u4_planes p = dense_u4_get_planes(src0);
+    const int gshift = dense_u4_gshift(p.group);
+    const uint8_t    * w   = p.w;
+    const sycl::half * sc  = p.sc;
+    const uint8_t    * zpp = p.zp;
+    const int32_t    * ids = (const int32_t *) src1->data;
+    float            * out = (float *) dst->data;
+    const queue_ptr stream = ctx.stream();
+    stream->parallel_for(
+        sycl::nd_range<1>(sycl::range<1>((size_t) nr * 256), sycl::range<1>(256)),
+        [=](sycl::nd_item<1> it) {
+            const int64_t i = it.get_group(0);
+            const int64_t r = ids[i];
+            const uint8_t * wr = w + (size_t) r * (K / 2);
+            for (int64_t j = it.get_local_id(0); j < K; j += 256) {
+                const int64_t gi = (j >> gshift) * N + r;
+                const uint8_t qb = wr[j >> 1];
+                const int     qv = (j & 1) ? (qb >> 4) : (qb & 0xF);
+                const uint8_t zb = zpp[gi >> 1];
+                const int     zv = (gi & 1) ? (zb >> 4) : (zb & 0xF);
+                out[i * K + j] = (float) sc[gi] * (float) (qv - zv);
+            }
+        });
+    return true;
+}
