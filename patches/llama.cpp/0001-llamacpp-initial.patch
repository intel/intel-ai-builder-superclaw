+// one-time in-place f32 -> f16 conversion of a large dense f32 weight (the MoE
+// router): halves its decode reads and keeps a single copy
+static bool dense_f16_ensure(ggml_backend_sycl_context & ctx, const ggml_tensor * t) {
+    ggml_tensor_extra_gpu * extra = (ggml_tensor_extra_gpu *) t->extra;
+    if (extra != nullptr && extra->optimized_feature.f16_dense) return true;
+    if (t->type != GGML_TYPE_F32 || extra == nullptr) return false;
+    if (extra->optimized_feature.reorder || extra->optimized_feature.u4_dense) return false;
+    if (t->ne[2] != 1 || t->ne[3] != 1 || !ggml_is_contiguous(t)) return false;
+    if (t->ne[0] % 128 != 0 || ggml_nbytes(t) < 1024 * 1024) return false;
+    if (!g_ggml_sycl_f16_dense || getenv("GGML_SYCL_F16_DENSE_OFF") != nullptr) return false;
+
+    const int64_t ne = t->ne[0] * t->ne[1];
+    const queue_ptr stream = ctx.stream();
+    const size_t tot_bytes = ggml_nbytes(t);
+    sycl_reorder_temp_buffer tmp(stream, tot_bytes);
+    if (!tmp) return false;
+    SYCL_CHECK(CHECK_TRY_ERROR(stream->memcpy(tmp.ptr, t->data, tot_bytes).wait()));
+    const float * src = (const float *) tmp.ptr;
+    sycl::half *  dst16 = (sycl::half *) t->data;
+    stream->parallel_for(sycl::range<1>((size_t) ne), [=](sycl::id<1> i) {
+        dst16[i[0]] = (sycl::half) src[i[0]];
+    });
+    SYCL_CHECK(CHECK_TRY_ERROR(stream->wait()));
+    extra->optimized_feature.f16_dense = true;
+    return true;
+}
+
+// y[row] = w_f16[row,:] . x_f32
+static void mul_mat_vec_f16w_sycl(const sycl::half * w, const float * x, float * y,
+                                  const int K, const int N, queue_ptr stream) {
+    constexpr int WS = 16;
+    constexpr int RW = 8;
+    const int n_wg = (N + RW - 1) / RW;
+    stream->parallel_for(
+        sycl::nd_range<1>(sycl::range<1>((size_t) n_wg * WS * RW), sycl::range<1>(WS * RW)),
+        [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(WS)]] {
+            const int row  = it.get_group(0) * RW + it.get_local_id(0) / WS;
+            const int lane = it.get_local_id(0) % WS;
+            if (row >= N) {
+                return;
+            }
+            const sycl::half * wr = w + (size_t) row * K;
+            float acc = 0.0f;
+            for (int k = lane * 8; k + 7 < K; k += WS * 8) {
+                const sycl::vec<sycl::half, 8> wv = *reinterpret_cast<const sycl::vec<sycl::half, 8> *>(wr + k);
+                const sycl::float4 xa = *reinterpret_cast<const sycl::float4 *>(x + k);
+                const sycl::float4 xb = *reinterpret_cast<const sycl::float4 *>(x + k + 4);
+#pragma unroll
+                for (int j = 0; j < 4; ++j) {
+                    acc += (float) wv[j] * xa[j] + (float) wv[j + 4] * xb[j];
+                }
+            }
+            acc = sycl::reduce_over_group(it.get_sub_group(), acc, sycl::plus<float>());
+            if (lane == 0) {
+                y[row] = acc;
+            }
+        });
+}
+
+// y[row] = w[row,:] . x for small f32 weights (MoE router, GDN alpha/beta): one
+// subgroup per row instead of an oneMKL sgemm call per projection
+static void mul_mat_vec_f32_sycl(const float * w, const float * x, float * y,
+                                 const int K, const int N, queue_ptr stream) {
+    if (N < 128) {
+        // few rows: one 256-thread work-group per row so the K reduction still spreads
+        stream->parallel_for(
+            sycl::nd_range<1>(sycl::range<1>((size_t) N * 256), sycl::range<1>(256)),
+            [=](sycl::nd_item<1> it) {
+                const int row = it.get_group(0);
+                const float * wr = w + (size_t) row * K;
+                float acc = 0.0f;
+                for (int k = (int) it.get_local_id(0) * 4; k + 3 < K; k += 256 * 4) {
+                    const sycl::float4 wv = *reinterpret_cast<const sycl::float4 *>(wr + k);
+                    const sycl::float4 xv = *reinterpret_cast<const sycl::float4 *>(x + k);
+                    acc += wv[0] * xv[0] + wv[1] * xv[1] + wv[2] * xv[2] + wv[3] * xv[3];
+                }
+                acc = sycl::reduce_over_group(it.get_group(), acc, sycl::plus<float>());
+                if (it.get_local_id(0) == 0) {
+                    y[row] = acc;
+                }
+            });
+        return;
+    }
+    constexpr int WS = 16;
+    constexpr int RW = 8;
+    const int n_wg = (N + RW - 1) / RW;
+    stream->parallel_for(
+        sycl::nd_range<1>(sycl::range<1>((size_t) n_wg * WS * RW), sycl::range<1>(WS * RW)),
+        [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(WS)]] {
+            const int row  = it.get_group(0) * RW + it.get_local_id(0) / WS;
+            const int lane = it.get_local_id(0) % WS;
+            if (row >= N) {
+                return;
+            }
+            const float * wr = w + (size_t) row * K;
+            float acc = 0.0f;
+            for (int k = lane * 4; k + 3 < K; k += WS * 4) {
+                const sycl::float4 wv = *reinterpret_cast<const sycl::float4 *>(wr + k);
+                const sycl::float4 xv = *reinterpret_cast<const sycl::float4 *>(x + k);
+                acc += wv[0] * xv[0] + wv[1] * xv[1] + wv[2] * xv[2] + wv[3] * xv[3];
+            }
+            acc = sycl::reduce_over_group(it.get_sub_group(), acc, sycl::plus<float>());
+            if (lane == 0) {
+                y[row] = acc;
+            }
+        });
+}
+
+static void mul_mat_vec_u4_sycl(const dense_u4_planes p, const float * x, float * y,
+                                const int K, const int N, queue_ptr stream) {
+    const int gshift = dense_u4_gshift(p.group);
+    if (K % (16 * 32) == 0) {
+        mul_mat_vec_u4_kern<32>(p.w, p.sc, p.zp, x, y, K, N, gshift, stream);
+    } else {
+        mul_mat_vec_u4_kern<16>(p.w, p.sc, p.zp, x, y, K, N, gshift, stream);
+    }
+}
