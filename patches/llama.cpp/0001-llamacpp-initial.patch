+// of qs byte 16 b + p; the header plane follows the nb32 * 16 qs bytes. 8 blocks per work-group of 32
+template <bool NL, typename dst_t>
+static void dequantize_block_iq4_reorder(const void * __restrict__ vx, dst_t * __restrict__ yy,
+                                         const sycl::nd_item<3> & item_ct1, const int64_t nb32) {
+    const int64_t i   = item_ct1.get_group(2);
+    const int     tid = item_ct1.get_local_id(2);
+    const int     ib  = tid / 4;   // block of the group, 0...7
+    const int     il  = tid % 4;   // 8 weights each
+    const int64_t b   = i * 8 + ib;
+    if (b >= nb32) {
+        return;
+    }
+    const uint8_t * base = static_cast<const uint8_t *>(vx);
+    const uint8_t * q    = base + b * 16 + 4 * il;
+    const uint8_t * h    = base + nb32 * 16;
