+//
+// MIT license
+// Copyright (C) 2024 Intel Corporation
+// SPDX-License-Identifier: MIT
+//
+
+// the narrow (M <= 8) exact gemm, in a device image of its own (gguf_gemm_narrow_kernels.hpp): the verify step of
+// speculative decoding
+#include "gguf_gemm_launch.hpp"
+#include "gguf_gemm_narrow_kernels.hpp"
+
+// the k a thread of a narrow work-group aims at: on B70 512 (up to 16 threads) is +2.3% on a Qwen3.8-27B 8-token forward
+// over 1024 (up to 8); the row group stays 16 rows, which beat 32
+static constexpr int GGUF_NW_K = 512;
+
+// threads for a K split into nu k units
+static int gguf_nw_ki(int K, int nu) {
+    const int ki = K / GGUF_NW_K;
+    return ki < 1 ? 1 : ki > gguf_xmx::NW_KI_MAX ? gguf_xmx::NW_KI_MAX : ki > nu ? nu : ki;
+}
+
+void gguf_gemm_launch_narrow(ggml_type type, const uint8_t * w, const sycl::half * act, float * dst, int M, int N, int K,
+                             const gguf_xmx::gemm_epi & epi, sycl::queue & q) {
+    using namespace gguf_xmx;
+    GGML_ASSERT(M <= GGML_SYCL_GGUF_NW_MAX_M);
+    const int nsb = K / 256;
+    switch (type) {
+        case GGML_TYPE_Q8_0:
+            (void) gemm_nw_q8_0<1>(q, w, act, dst, M, N, K, epi, gguf_nw_ki(K, K / 64));
+            break;
+        case GGML_TYPE_Q3_K:
+            (void) gemm_nw_q3_K<1>(q, w, act, dst, M, N, K, epi, gguf_nw_ki(K, nsb));
+            break;
+        case GGML_TYPE_Q4_K:
+            (void) gemm_nw_q4_K<1>(q, w, act, dst, M, N, K, epi, gguf_nw_ki(K, nsb));
+            break;
+        case GGML_TYPE_Q5_K:
+            (void) gemm_nw_q5_K<1>(q, w, act, dst, M, N, K, epi, gguf_nw_ki(K, nsb));
+            break;
+        case GGML_TYPE_Q6_K:
+            (void) gemm_nw_q6_K<1>(q, w, act, dst, M, N, K, epi, gguf_nw_ki(K, nsb / 2));
+            break;
+        case GGML_TYPE_IQ4_XS:
+            (void) gemm_nw_iq4<false>(q, w, act, dst, M, N, K, epi, gguf_nw_ki(K, nsb));
+            break;
+        case GGML_TYPE_IQ4_NL:
+            (void) gemm_nw_iq4<true>(q, w, act, dst, M, N, K, epi, gguf_nw_ki(K, nsb));
+            break;
+        case GGML_TYPE_IQ3_S:
+            (void) gemm_nw_iq3_s<1, iq3s_grid>(q, w, act, dst, M, N, K, epi, gguf_nw_ki(K, nsb / 2));
+            break;
+        default:
+            GGML_ABORT("gguf narrow gemm: unsupported type %s", ggml_type_name(type));
+    }
+}
