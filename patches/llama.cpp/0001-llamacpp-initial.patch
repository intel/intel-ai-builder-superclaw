+
+#ifndef GGML_SYCL_GGUF_GEMM_NARROW_KERNELS_HPP
+#define GGML_SYCL_GGUF_GEMM_NARROW_KERNELS_HPP
+
+// The exact gemm for M <= 8, the verify step of speculative decoding: one 8-token tile on a work-group of ki threads (at
+// most NW_KI_MAX) that share one panel of NB x 16 weight rows and split its k units (super-blocks; block pairs for Q6_K and
+// IQ3_S, 32-weight block pairs for Q8_0), their slices meeting in SLM in a fixed order. The weights stream once for all tokens, where the dp4a mmvq
+// loses 2-5x of its bandwidth on 8 columns. Every kernel dequantizes the reorder layout to the same f16 values as its
+// prefill kernel in gguf_gemm_kernels.hpp, as a copy of it: IGC reschedules a prefill kernel on the smallest change to
+// its body (a runtime k slice made gemm_q4_K 2.2x slower at K = 5120), so they share nothing but helpers.
+
+#include "gguf_gemm_kernels.hpp"
+
+namespace gguf_xmx {
+
+constexpr int NW_KI_MAX = 16;
+
+// SLM bytes of nw_store for NB row groups
+template <int NB> constexpr int nw_slm = (NW_KI_MAX - 1) * NB * 128 * (int) sizeof(float);
+
+// the k units [u0, u0 + count) of thread t of ki, from nu
+ESIMD_INLINE int nw_units(int t, int ki, int nu, int & u0) {
+    const int upt = (nu + ki - 1) / ki;
+    u0 = t * upt;
+    const int n = nu - u0 < upt ? nu - u0 : upt;
+    return n > 0 ? n : 0;
+}
+
+// thread 0 adds the k slices of threads 1 .. ki - 1 (from SLM byte slm0) to its own and stores them with the post-ops of epi
+template <int NB>
+ESIMD_INLINE void nw_store(simd<float, 128> (&acc)[NB], uint32_t slm0, int t, int ki, float * dst, const gemm_epi & epi,
+                           int M, int N, int n0) {
+    if (t > 0) {
+#pragma unroll
+        for (int g = 0; g < NB; ++g) {
+            slm_block_store<float, 128>(slm0 + (uint32_t) (((t - 1) * NB + g) * 128 * sizeof(float)), acc[g]);
+        }
+    }
+    barrier();
+    if (t == 0) {
+        for (int i = 1; i < ki; ++i) {
+#pragma unroll
+            for (int g = 0; g < NB; ++g) {
+                acc[g] += slm_block_load<float, 128>(slm0 + (uint32_t) (((i - 1) * NB + g) * 128 * sizeof(float)));
+            }
+        }
+        store_tiles<NB, 1>(acc, dst, epi, 0, M, N, n0);
+    }
+}
+
+// ---- Q8_0 (gemm_q8_0_narrow) -----------------------------------------------------------------
+// the k units are block pairs (64 k) of the reorder layout: qs [row][block] 32 B, then d [row][block] 2 B. Where
+// gemm_q8_0_narrow keeps 32 rows on 8 threads, this takes 16 rows on ki threads, so a small N (a shared expert) still
+// fills the device
+template <int NB>
+sycl::event gemm_nw_q8_0(sycl::queue & q, const uint8_t * w, const sycl::half * act, float * dst, int M, int N, int K,
+                         const gemm_epi epi, int ki) {
+    const int      nb    = K / 32;
+    const uint32_t rowb  = (uint32_t) nb * 32;
+    const uint32_t dbase = (uint32_t) N * nb * 32;
+    const int      gn    = N / (16 * NB);
+    namespace sx = sycl::ext::oneapi::experimental;
+    sx::properties props{ sycl::ext::intel::experimental::grf_size<GRF> };
+
+    return q.parallel_for(sycl::nd_range<1>(sycl::range<1>((size_t) gn * ki), sycl::range<1>(ki)), props,
+        [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL {
+            slm_init<nw_slm<NB>>();
+            const int t  = (int) it.get_local_id(0);
+            const int n0 = (int) it.get_group(0) * 16 * NB;
+            int       k0;
+            const int kn = nw_units(t, ki, nb / 2, k0);
+
+            simd<float, 128> acc[NB];
+#pragma unroll
+            for (int g = 0; g < NB; ++g) {
+                acc[g] = 0.0f;
+            }
+            const uint32_t * w32 = (const uint32_t *) w;
+            simd<uint32_t, 16> oq[NB], od[NB];
+#pragma unroll
+            for (int g = 0; g < NB; ++g) {
+                const simd<uint32_t, 16> rows = lane_rows(n0, g);
+                oq[g] = rows * rowb + (uint32_t) k0 * 64;
+                od[g] = dbase + rows * (uint32_t) (nb * 2) + (uint32_t) k0 * 4;
+            }
+            const sycl::half * pa = act + (size_t) k0 * 4 * 128;
+
+            for (int kp = 0; kp < kn; ++kp) {
+                simd<uint32_t, 17 * 16> raw[NB];   // [dword][lane]: the qs of the pair, then its two d
+#pragma unroll
+                for (int g = 0; g < NB; ++g) {
+                    raw[g].template select<128, 1>(0)   = gather<uint32_t, 128, 8>(w32, oq[g]);
+                    raw[g].template select<128, 1>(128) = gather<uint32_t, 128, 8>(w32, oq[g] + 32);
+                    raw[g].template select<16, 1>(256)  = gather<uint32_t, 16, 1>(w32, od[g]);
+                    oq[g] += 64;
+                    od[g] += 4;
+                }
+#pragma unroll
+                for (int j = 0; j < 2; ++j) {
+#pragma unroll
+                    for (int c = 0; c < 2; ++c) {
+                        const simd<sycl::half, 128> a = block_load<sycl::half, 128>(pa);
+                        pa += 128;
+#pragma unroll
+                        for (int g = 0; g < NB; ++g) {
+                            auto r8 = raw[g].template bit_cast_view<uint8_t>();
+                            auto rh = raw[g].template bit_cast_view<sycl::half>();
+                            const int odj = 64 + 2 * j;
+                            const simd<sycl::half, 32> dv =
+                                rh.template replicate_vs_w_hs<16, 2, 2, 0>((odj / 4) * 32 + (odj % 4) / 2);
+                            simd<sycl::half, 256> b;
+#pragma unroll
+                            for (int p = 0; p < 8; ++p) {
+                                const int o = 32 * j + 16 * c + 2 * p;
+                                simd<uint16_t, 32> u = r8.template replicate_vs_w_hs<16, 4, 2, 1>((o / 4) * 64 + o % 4);
+                                u ^= (uint16_t) 0x6480;
+                                b.template select<32, 1>(p * 32) = (u.template bit_cast_view<sycl::half>() - (sycl::half) 1152.0f) * dv;
+                            }
+                            acc[g] = xmx::dpas<8, 8, float, float, sycl::half, sycl::half>(acc[g], b, a);
+                        }
+                    }
+                }
+            }
+            nw_store<NB>(acc, 0, t, ki, dst, epi, M, N, n0);
+        });
+}
+
+// ---- Q4_K (gemm_q4_K) ------------------------------------------------------------------------
+// the images [dm][scales x 3][qs x 32 dwords] of one super-block of the NB row groups, the lane rows' blocks at the offsets
+template <int NB>
+ESIMD_INLINE void nw_q4_K_load(simd<uint32_t, 36 * 16> (&raw)[NB], const uint32_t * w32, const simd<uint32_t, 16> (&oq)[NB],
+                               const simd<uint32_t, 16> (&os)[NB], const simd<uint32_t, 16> (&om)[NB]) {
+#pragma unroll
+    for (int g = 0; g < NB; ++g) {
+        raw[g].template select<16, 1>(0)  = gather<uint32_t, 16, 1>(w32, om[g]);
+        raw[g].template select<48, 1>(16) = gather<uint32_t, 48, 3>(w32, os[g]);
+#pragma unroll
+        for (int i = 0; i < 4; ++i) {
+            raw[g].template select<128, 1>(64 + i * 128) = gather<uint32_t, 128, 8>(w32, oq[g] + 32 * i);
+        }
+    }
+}
+
+// the scales and the 16 k-steps of one super-block, the activations at pa
+template <int NB>
+ESIMD_INLINE void nw_q4_K_sb(simd<uint32_t, 36 * 16> (&raw)[NB], const sycl::half * pa, simd<float, 128> (&acc)[NB]) {
+    simd<sycl::half, 16> sc[NB][8], mn[NB][8];
+#pragma unroll
+    for (int g = 0; g < NB; ++g) {
+        auto r8 = raw[g].template bit_cast_view<uint8_t>();
+        auto rh = raw[g].template bit_cast_view<sycl::half>();
+        const simd<float, 16> d    = rh.template replicate_vs_w_hs<16, 2, 1, 0>(0);
+        const simd<float, 16> dmin = rh.template replicate_vs_w_hs<16, 2, 1, 0>(1);
+        simd<uint16_t, 16> s[12];
+#pragma unroll
+        for (int b = 0; b < 12; ++b) {
+            s[b] = r8.template replicate_vs_w_hs<16, 4, 1, 0>((1 + b / 4) * 64 + b % 4);
+        }
+#pragma unroll
+        for (int j = 0; j < 8; ++j) {
+            simd<uint16_t, 16> scj, mj;
+            if (j < 4) {
+                scj = s[j] & 63;
+                mj  = s[j + 4] & 63;
+            } else {
+                scj = (s[j + 4] & 0xF) | ((s[j - 4] >> 6) << 4);
+                mj  = (s[j + 4] >> 4) | ((s[j] >> 6) << 4);
+            }
+            const float hs = (j & 1) ? 1.0f / 16 : 1.0f;
+            sc[g][j] = d * convert<float>(scj) * hs;
+            mn[g][j] = dmin * convert<float>(mj);
+        }
+    }
+#pragma unroll
+    for (int s = 0; s < 16; ++s) {
+        const int j = s / 2, h = s % 2, c = j / 2;
+        simd<sycl::half, 256> b[NB];
+#pragma unroll
+        for (int g = 0; g < NB; ++g) {
+            auto r8 = raw[g].template bit_cast_view<uint8_t>();
+            const simd<sycl::half, 32> dv = sc[g][j].template replicate_vs_w_hs<16, 1, 2, 0>(0);
+            const simd<sycl::half, 32> mv = mn[g][j].template replicate_vs_w_hs<16, 1, 2, 0>(0);
+#pragma unroll
+            for (int p = 0; p < 8; ++p) {
+                const int o = 16 + 32 * c + 16 * h + 2 * p;   // byte of this k pair in the image
+                simd<uint16_t, 32> u = r8.template replicate_vs_w_hs<16, 4, 2, 1>((o / 4) * 64 + o % 4);
+                u = (u & (uint16_t) ((j & 1) ? 0xF0 : 0x0F)) | (uint16_t) 0x6400;
+                const simd<sycl::half, 32> qh = u.template bit_cast_view<sycl::half>() - (sycl::half) 1024.0f;
+                b[g].template select<32, 1>(p * 32) = qh * dv - mv;
+            }
+        }
+        const simd<sycl::half, 128> a = block_load<sycl::half, 128>(pa + 128 * s);
+#pragma unroll
+        for (int g = 0; g < NB; ++g) {
+            acc[g] = xmx::dpas<8, 8, float, float, sycl::half, sycl::half>(acc[g], b[g], a);
+        }
+    }
+}
+
+template <int NB>
+sycl::event gemm_nw_q4_K(sycl::queue & q, const uint8_t * w, const sycl::half * act, float * dst, int M, int N, int K,
+                         const gemm_epi epi, int ki) {
+    const int      nsb  = K / 256;
+    const uint32_t nblk = (uint32_t) N * nsb;
+    const int      gn   = N / (16 * NB);
+    namespace sx = sycl::ext::oneapi::experimental;
+    sx::properties props{ sycl::ext::intel::experimental::grf_size<GRF> };
+
+    return q.parallel_for(sycl::nd_range<1>(sycl::range<1>((size_t) gn * ki), sycl::range<1>(ki)), props,
+        [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL {
+            slm_init<nw_slm<NB>>();
+            const int t  = (int) it.get_local_id(0);
+            const int n0 = (int) it.get_group(0) * 16 * NB;
+            int       k0;
+            const int kn = nw_units(t, ki, nsb, k0);
+
+            simd<float, 128> acc[NB];
+#pragma unroll
+            for (int g = 0; g < NB; ++g) {
+                acc[g] = 0.0f;
+            }
+            const uint32_t * w32 = (const uint32_t *) w;
+            simd<uint32_t, 16> oq[NB], os[NB], om[NB];   // qs, scales, dm
+#pragma unroll
+            for (int g = 0; g < NB; ++g) {
+                const simd<uint32_t, 16> blk = lane_rows(n0, g) * (uint32_t) nsb + (uint32_t) k0;
+                oq[g] = blk * 128;
+                os[g] = nblk * 128 + blk * 12;
+                om[g] = nblk * 140 + blk * 4;
+            }
+            const sycl::half * pa = act + (size_t) k0 * 2048;
+
+            // prefetching the next super-block into a second image (both here and in gemm_nw_iq4) was 3-10% slower
+            for (int sb = 0; sb < kn; ++sb) {
+                simd<uint32_t, 36 * 16> raw[NB];   // [dword][lane]
+                nw_q4_K_load<NB>(raw, w32, oq, os, om);
+#pragma unroll
+                for (int g = 0; g < NB; ++g) {
+                    oq[g] += 128;
+                    os[g] += 12;
+                    om[g] += 4;
+                }
+                nw_q4_K_sb<NB>(raw, pa, acc);
+                pa += 2048;
+            }
+            nw_store<NB>(acc, 0, t, ki, dst, epi, M, N, n0);
+        });
+}
+
+// ---- Q5_K (gemm_q5_K) ------------------------------------------------------------------------
+template <int NB>
+sycl::event gemm_nw_q5_K(sycl::queue & q, const uint8_t * w, const sycl::half * act, float * dst, int M, int N, int K,
+                         const gemm_epi epi, int ki) {
+    const int      nsb  = K / 256;
+    const uint32_t nblk = (uint32_t) N * nsb;
+    const int      gn   = N / (16 * NB);
+    namespace sx = sycl::ext::oneapi::experimental;
+    sx::properties props{ sycl::ext::intel::experimental::grf_size<GRF> };
+
+    return q.parallel_for(sycl::nd_range<1>(sycl::range<1>((size_t) gn * ki), sycl::range<1>(ki)), props,
+        [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL {
+            slm_init<nw_slm<NB>>();
+            const int t  = (int) it.get_local_id(0);
+            const int n0 = (int) it.get_group(0) * 16 * NB;
+            int       k0;
+            const int kn = nw_units(t, ki, nsb, k0);
+
+            simd<float, 128> acc[NB];
+#pragma unroll
+            for (int g = 0; g < NB; ++g) {
+                acc[g] = 0.0f;
+            }
+            const uint32_t * w32 = (const uint32_t *) w;
+            simd<uint32_t, 16> oq[NB], oh[NB], os[NB], om[NB];   // qs, qh, scales, dm
+#pragma unroll
+            for (int g = 0; g < NB; ++g) {
+                const simd<uint32_t, 16> blk = lane_rows(n0, g) * (uint32_t) nsb + (uint32_t) k0;
+                oq[g] = blk * 128;
+                oh[g] = nblk * 128 + blk * 32;
+                os[g] = nblk * 160 + blk * 12;
+                om[g] = nblk * 172 + blk * 4;
+            }
+            const sycl::half * pa = act + (size_t) k0 * 2048;
+
+            for (int sb = 0; sb < kn; ++sb) {
+                simd<sycl::half, 128> sc[NB], mn[NB];
+                simd<uint32_t, 8 * 16> qh[NB];   // qh[32] of 16 rows, [dword][lane]
+#pragma unroll
+                for (int g = 0; g < NB; ++g) {
+                    simd<uint32_t, 4 * 16> hdr;
+                    hdr.template select<16, 1>(0)  = gather<uint32_t, 16, 1>(w32, om[g]);
+                    hdr.template select<48, 1>(16) = gather<uint32_t, 48, 3>(w32, os[g]);
+                    qh[g] = gather<uint32_t, 128, 8>(w32, oh[g]);
+                    kquant_scale_min(hdr, sc[g], mn[g]);
+                }
+#pragma unroll
+                for (int c = 0; c < 4; ++c) {
+                    simd<uint32_t, 8 * 16> raw[NB];
+                    simd<uint64_t, 64>     a2;
+#pragma unroll
+                    for (int g = 0; g < NB; ++g) {
+                        raw[g] = gather<uint32_t, 128, 8>(w32, oq[g] + (uint32_t) (32 * c));
+                    }
+#pragma unroll
+                    for (int s = 0; s < 4; ++s) {
+                        const int j = 2 * c + s / 2, h = s % 2;
+                        simd<sycl::half, 256> b[NB];
+#pragma unroll
+                        for (int g = 0; g < NB; ++g) {
+                            auto r8 = raw[g].template bit_cast_view<uint8_t>();
+                            auto h8 = qh[g].template bit_cast_view<uint8_t>();
+                            const simd<sycl::half, 32> dv = sc[g].template replicate_vs_w_hs<16, 1, 2, 0>(16 * j);
+                            const simd<sycl::half, 32> mv = mn[g].template replicate_vs_w_hs<16, 1, 2, 0>(16 * j);
+#pragma unroll
+                            for (int p = 0; p < 8; ++p) {
+                                const int o = 16 * h + 2 * p;   // byte of this k pair in the chunk and in qh
+                                const simd<uint16_t, 32> lo = r8.template replicate_vs_w_hs<16, 4, 2, 1>((o / 4) * 64 + o % 4);
+                                const simd<uint16_t, 32> hb = h8.template replicate_vs_w_hs<16, 4, 2, 1>((o / 4) * 64 + o % 4);
+                                simd<uint16_t, 32> u;
+                                if (j % 2 == 0) {
+                                    const int shl = 4 - 2 * c;   // qh bit 2c -> bit 4
+                                    const simd<uint16_t, 32> hs = shl >= 0 ? simd<uint16_t, 32>(hb << shl) : simd<uint16_t, 32>(hb >> -shl);
+                                    u = (lo & 0x0F) | (hs & 0x10) | 0x6400;
+                                } else {
+                                    u = (lo & 0xF0) | ((hb << (7 - 2 * c)) & 0x100) | 0x6400;   // qh bit 2c+1 -> bit 8
+                                }
+                                const simd<sycl::half, 32> qv = u.template bit_cast_view<sycl::half>() - (sycl::half) 1024.0f;
+                                b[g].template select<32, 1>(p * 32) = qv * dv - mv;
+                            }
+                        }
+                        // the A tiles of k-steps s, s + 1 in one 512 B load
+                        if (s % 2 == 0) {
+                            a2 = block_load<uint64_t, 64>((const uint64_t *) pa);
+                            pa += 256;
+                        }
+                        const simd<sycl::half, 128> a = a2.template bit_cast_view<sycl::half>().template select<128, 1>((s % 2) * 128);
+#pragma unroll
+                        for (int g = 0; g < NB; ++g) {
+                            acc[g] = xmx::dpas<8, 8, float, float, sycl::half, sycl::half>(acc[g], b[g], a);
+                        }
+                    }
+                }
+#pragma unroll
+                for (int g = 0; g < NB; ++g) {
+                    oq[g] += 128;
+                    oh[g] += 32;
+                    os[g] += 12;
+                    om[g] += 4;
+                }
+            }
+            nw_store<NB>(acc, 0, t, ki, dst, epi, M, N, n0);
+        });
+}
+
+// ---- Q6_K (gemm_q6_K) ------------------------------------------------------------------------
+// the k units are block pairs, as in gemm_q6_K
+template <int NB>
+sycl::event gemm_nw_q6_K(sycl::queue & q, const uint8_t * w, const sycl::half * act, float * dst, int M, int N, int K,
+                         const gemm_epi epi, int ki) {
+    const int      nsb  = K / 256;
+    const uint32_t nblk = (uint32_t) N * nsb;
+    const int      gn   = N / (16 * NB);
+    namespace sx = sycl::ext::oneapi::experimental;
+    sx::properties props{ sycl::ext::intel::experimental::grf_size<GRF> };
+
+    return q.parallel_for(sycl::nd_range<1>(sycl::range<1>((size_t) gn * ki), sycl::range<1>(ki)), props,
+        [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL {
+            slm_init<nw_slm<NB>>();
+            const int t  = (int) it.get_local_id(0);
+            const int n0 = (int) it.get_group(0) * 16 * NB;
+            int       k0;
+            const int kn = nw_units(t, ki, nsb / 2, k0);
+
+            simd<float, 128> acc[NB];
+#pragma unroll
+            for (int g = 0; g < NB; ++g) {
+                acc[g] = 0.0f;
+            }
+            const uint32_t * w32 = (const uint32_t *) w;
+            simd<uint32_t, 16> ol[NB], oh[NB], os[NB], od[NB];   // ql, qh, scales, d (of the pair)
+#pragma unroll
+            for (int g = 0; g < NB; ++g) {
+                const simd<uint32_t, 16> blk = lane_rows(n0, g) * (uint32_t) nsb + (uint32_t) (2 * k0);
+                ol[g] = blk * 128;
+                oh[g] = nblk * 128 + blk * 64;
+                os[g] = nblk * 192 + blk * 16;
+                od[g] = nblk * 208 + blk * 2;
+            }
+            const sycl::half * pa = act + (size_t) k0 * 4096;
+
+            for (int sp = 0; sp < kn; ++sp) {
+#pragma unroll
+                for (int e = 0; e < 2; ++e) {
+                    // tail image: [scales 16 B][d dword]; scale j at byte j, the d of block e at half e
+                    simd<sycl::half, 256> dv[NB];   // [sub-block][lane] d * scale
+#pragma unroll
+                    for (int g = 0; g < NB; ++g) {
+                        simd<uint32_t, 5 * 16> tl;
+                        tl.template select<64, 1>(0)  = gather<uint32_t, 64, 4>(w32, os[g] + 16 * e);
+                        tl.template select<16, 1>(64) = gather<uint32_t, 16, 1>(w32, od[g]);
+                        auto t8 = tl.template bit_cast_view<int8_t>();
+                        auto th = tl.template bit_cast_view<sycl::half>();
+                        const int odd = 16 + 2 * e;
+                        const simd<float, 16> d = th.template replicate_vs_w_hs<16, 2, 1, 0>((odd / 4) * 32 + (odd % 4) / 2);
+#pragma unroll
+                        for (int j = 0; j < 16; ++j) {
+                            const simd<int16_t, 16> scj = t8.template replicate_vs_w_hs<16, 4, 1, 0>((j / 4) * 64 + j % 4);
+                            dv[g].template select<16, 1>(16 * j) = d * convert<float>(scj);
+                        }
+                    }
+#pragma unroll
+                    for (int n = 0; n < 2; ++n) {
+                        simd<uint32_t, 17 * 16> ql[NB];   // ql[64 n ..] (+4 B of the GGUF layout's shift room)
+                        simd<uint32_t, 9 * 16>  qh[NB];   // qh[32 n ..]
+#pragma unroll
+                        for (int g = 0; g < NB; ++g) {
+                            const simd<uint32_t, 16> o0 = ol[g] + (uint32_t) (128 * e + 64 * n);
+                            ql[g].template select<128, 1>(0)   = gather<uint32_t, 128, 8>(w32, o0);
+                            ql[g].template select<128, 1>(128) = gather<uint32_t, 128, 8>(w32, o0 + 32);
+                            ql[g].template select<16, 1>(256)  = gather<uint32_t, 16, 1>(w32, o0 + 64);
+                            const simd<uint32_t, 16> o1 = oh[g] + (uint32_t) (64 * e + 32 * n);
+                            qh[g].template select<128, 1>(0)  = gather<uint32_t, 128, 8>(w32, o1);
+                            qh[g].template select<16, 1>(128) = gather<uint32_t, 16, 1>(w32, o1 + 32);
+                        }
+                        // k-steps 2r and 2r+1 (h = 0, 1) share one 512 B activation load
+#pragma unroll
+                        for (int r = 0; r < 4; ++r) {
+                            simd<sycl::half, 256> b[2][NB];
+#pragma unroll
+                            for (int h = 0; h < 2; ++h) {
+                                const int j = 8 * n + 2 * r + h;
+#pragma unroll
+                                for (int g = 0; g < NB; ++g) {
+                                    auto l8 = ql[g].template bit_cast_view<uint8_t>();
+                                    auto h8 = qh[g].template bit_cast_view<uint8_t>();
+                                    const simd<sycl::half, 32> sv = dv[g].template replicate_vs_w_hs<16, 1, 2, 0>(16 * j);
+#pragma unroll
+                                    for (int p = 0; p < 8; ++p) {
+                                        const int bl = 32 * (r & 1) + 16 * h + 2 * p;
+                                        const int bh = 16 * h + 2 * p;
+                                        const simd<uint16_t, 32> lo = l8.template replicate_vs_w_hs<16, 4, 2, 1>((bl / 4) * 64 + bl % 4);
+                                        const simd<uint16_t, 32> hb = h8.template replicate_vs_w_hs<16, 4, 2, 1>((bh / 4) * 64 + bh % 4);
+                                        const simd<uint16_t, 32> nib = r < 2 ? simd<uint16_t, 32>(lo & 0x0F) : simd<uint16_t, 32>(lo >> 4);
+                                        const int hs = 4 - 2 * r;   // qh bits 2r, 2r+1 -> bits 4, 5
+                                        const simd<uint16_t, 32> hv = hs >= 0 ? simd<uint16_t, 32>(hb << hs) : simd<uint16_t, 32>(hb >> -hs);
+                                        simd<uint16_t, 32> u = nib | (hv & 0x30) | 0x6400;
+                                        const simd<sycl::half, 32> qv = u.template bit_cast_view<sycl::half>() - (sycl::half) 1056.0f;
+                                        b[h][g].template select<32, 1>(p * 32) = qv * sv;
+                                    }
+                                }
+                            }
+                            simd<sycl::half, 256> a2 = block_load<sycl::half, 256>(pa);
+                            pa += 256;
+#pragma unroll
+                            for (int h = 0; h < 2; ++h) {
+                                const simd<sycl::half, 128> a = a2.template select<128, 1>(128 * h);
+#pragma unroll
+                                for (int g = 0; g < NB; ++g) {
+                                    acc[g] = xmx::dpas<8, 8, float, float, sycl::half, sycl::half>(acc[g], b[h][g], a);
+                                }
+                            }
+                        }
+                    }
+                }
+#pragma unroll
+                for (int g = 0; g < NB; ++g) {
+                    ol[g] += 256;
+                    oh[g] += 128;
+                    os[g] += 32;
+                    od[g] += 4;
+                }
+            }
+            nw_store<NB>(acc, 0, t, ki, dst, epi, M, N, n0);
+        });
+}
+
+// ---- Q3_K (gemm_q3_K) ------------------------------------------------------------------------
+template <int NB>
+sycl::event gemm_nw_q3_K(sycl::queue & q, const uint8_t * w, const sycl::half * act, float * dst, int M, int N, int K,
+                         const gemm_epi epi, int ki) {
+    const int      nsb  = K / 256;
+    const uint32_t nblk = (uint32_t) N * nsb;
+    const int      gn   = N / (16 * NB);
+    namespace sx = sycl::ext::oneapi::experimental;
+    sx::properties props{ sycl::ext::intel::experimental::grf_size<GRF> };
+
+    return q.parallel_for(sycl::nd_range<1>(sycl::range<1>((size_t) gn * ki), sycl::range<1>(ki)), props,
+        [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL {
+            slm_init<nw_slm<NB>>();
+            const int t  = (int) it.get_local_id(0);
+            const int n0 = (int) it.get_group(0) * 16 * NB;
+            int       k0;
+            const int kn = nw_units(t, ki, nsb, k0);
+
+            simd<float, 128> acc[NB];
+#pragma unroll
+            for (int g = 0; g < NB; ++g) {
+                acc[g] = 0.0f;
+            }
+            const uint32_t * w32 = (const uint32_t *) w;
+            const uint16_t * w16 = (const uint16_t *) w;
+            simd<uint32_t, 16> oq[NB], oh[NB], os[NB], od[NB];   // qs, hmask, scales, d
+#pragma unroll
+            for (int g = 0; g < NB; ++g) {
+                const simd<uint32_t, 16> blk = lane_rows(n0, g) * (uint32_t) nsb + (uint32_t) k0;
+                oq[g] = blk * 64;
+                oh[g] = nblk * 64 + blk * 32;
+                os[g] = nblk * 96 + blk * 12;
+                od[g] = nblk * 108 + blk * 2;
+            }
+            const sycl::half * pa = act + (size_t) k0 * 2048;
+
+            for (int sb = 0; sb < kn; ++sb) {
+                simd<uint32_t, 16 * 16> rq[NB];   // qs [dword][lane]
+                simd<uint32_t, 8 * 16>  rm[NB];   // hmask
+                simd<sycl::half, 16>    dv[NB][16];
+#pragma unroll
+                for (int g = 0; g < NB; ++g) {
+                    rq[g].template select<128, 1>(0)   = gather<uint32_t, 128, 8>(w32, oq[g]);
+                    rq[g].template select<128, 1>(128) = gather<uint32_t, 128, 8>(w32, oq[g] + 32);
+                    rm[g] = gather<uint32_t, 128, 8>(w32, oh[g]);
+                    simd<uint32_t, 48>       rs = gather<uint32_t, 48, 3>(w32, os[g]);
+                    simd<uint16_t, 16>       dh = gather<uint16_t, 16>(w16, od[g]);
+                    const simd<float, 16>    d  = dh.template bit_cast_view<sycl::half>();
+                    oq[g] += 64;
+                    oh[g] += 32;
+                    os[g] += 12;
+                    od[g] += 2;
+                    // the 16 6-bit scales: low nibble from byte 4 (c % 2) + i (>> 4 for c >= 2), 2 bits from byte 8 + i
+                    auto s8 = rs.template bit_cast_view<uint8_t>();
+                    simd<uint16_t, 16> b8[12];
+#pragma unroll
+                    for (int b = 0; b < 12; ++b) {
+                        b8[b] = s8.template replicate_vs_w_hs<16, 4, 1, 0>((b / 4) * 64 + b % 4);
+                    }
+#pragma unroll
+                    for (int is = 0; is < 16; ++is) {
+                        const int c = is / 4, i = is % 4;
+                        const simd<uint16_t, 16> sc =
+                            ((b8[4 * (c % 2) + i] >> (4 * (c / 2))) & 0xF) | (((b8[8 + i] >> (2 * c)) & 3) << 4);
+                        dv[g][is] = d * (convert<float>(sc) - 32.0f);
+                    }
+                }
+                simd<uint64_t, 64> a2;
+#pragma unroll
+                for (int s = 0; s < 16; ++s) {
+                    const int hf = s / 8, j = (s % 8) / 2, tt = s % 2, hb = 4 * hf + j;
+                    simd<sycl::half, 256> b[NB];
+#pragma unroll
+                    for (int g = 0; g < NB; ++g) {
+                        auto q8 = rq[g].template bit_cast_view<uint8_t>();
+                        auto m8 = rm[g].template bit_cast_view<uint8_t>();
+                        const simd<sycl::half, 32> dv2 = dv[g][s].template replicate_vs_w_hs<16, 1, 2, 0>(0);
+#pragma unroll
+                        for (int p = 0; p < 8; ++p) {
+                            const int oqb = 32 * hf + 16 * tt + 2 * p, omb = 16 * tt + 2 * p;   // bytes of this k pair
+                            const simd<uint16_t, 32> uq = q8.template replicate_vs_w_hs<16, 4, 2, 1>((oqb / 4) * 64 + oqb % 4);
+                            const simd<uint16_t, 32> um = m8.template replicate_vs_w_hs<16, 4, 2, 1>((omb / 4) * 64 + omb % 4);
+                            const simd<uint16_t, 32> hi = hb >= 2 ? simd<uint16_t, 32>(um >> (hb - 2)) : simd<uint16_t, 32>(um << (2 - hb));
+                            simd<uint16_t, 32> u = ((uq >> (2 * j)) & (uint16_t) 3) | (hi & (uint16_t) 4) | (uint16_t) 0x6400;
+                            b[g].template select<32, 1>(p * 32) = (u.template bit_cast_view<sycl::half>() - (sycl::half) 1028.0f) * dv2;
+                        }
+                    }
+                    // the A tiles of k-steps s, s + 1 in one 512 B load
+                    if (s % 2 == 0) {
+                        a2 = block_load<uint64_t, 64>((const uint64_t *) pa);
+                        pa += 256;
+                    }
+                    const simd<sycl::half, 128> a = a2.template bit_cast_view<sycl::half>().template select<128, 1>((s % 2) * 128);
+#pragma unroll
+                    for (int g = 0; g < NB; ++g) {
+                        acc[g] = xmx::dpas<8, 8, float, float, sycl::half, sycl::half>(acc[g], b[g], a);
+                    }
+                }
+            }
+            nw_store<NB>(acc, 0, t, ki, dst, epi, M, N, n0);
+        });
+}
+
+// ---- IQ3_S (gemm_iq3_s, SOA) -----------------------------------------------------------------
+// the k units are block pairs, as in gemm_iq3_s; the grid sits in SLM ahead of the k slices
+template <int NB, const uint32_t * GRID>
+sycl::event gemm_nw_iq3_s(sycl::queue & q, const uint8_t * w, const sycl::half * act, float * dst, int M, int N, int K,
+                          const gemm_epi epi, int ki) {
+    const int      nsb  = K / 256;
+    const uint32_t nblk = (uint32_t) N * nsb;
+    const int      gn   = N / (16 * NB);
+    namespace sx = sycl::ext::oneapi::experimental;
+    sx::properties props{ sycl::ext::intel::experimental::grf_size<GRF> };
+
+    return q.parallel_for(sycl::nd_range<1>(sycl::range<1>((size_t) gn * ki), sycl::range<1>(ki)), props,
+        [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL {
+            slm_init<512 * 4 + nw_slm<NB>>();
+            const int t = (int) it.get_local_id(0);
+            for (int e = t * 32; e < 512; e += ki * 32) {
+                slm_block_store<uint32_t, 32>(e * 4, block_load<uint32_t, 32>(GRID + e));
+            }
+            barrier();
+            const int n0 = (int) it.get_group(0) * 16 * NB;
+            int       k0;
+            const int kn = nw_units(t, ki, nsb / 2, k0);
+
+            simd<float, 128> acc[NB];
+#pragma unroll
+            for (int g = 0; g < NB; ++g) {
+                acc[g] = 0.0f;
+            }
+            const uint32_t * w32 = (const uint32_t *) w;
+            // byte offsets of the qs plane, with the signs, qh | scales and d planes in pg, pm, pd
+            simd<uint32_t, 16> ob[NB], pg[NB], pm[NB], pd[NB];
+#pragma unroll
+            for (int g = 0; g < NB; ++g) {
+                const simd<uint32_t, 16> bi = lane_rows(n0, g) * (uint32_t) nsb + (uint32_t) (k0 * 2);
+                ob[g] = bi * 64;
+                pg[g] = nblk * 64 + bi * 32;
+                pm[g] = nblk * 96 + bi * 12;
+                pd[g] = nblk * 108 + bi * 2;
+            }
+            const sycl::half * pa = act + (size_t) k0 * 4096;
+            // shifts that bring the sign bit of k 2e, 2e + 1 of an odd (x = 1) or even grid entry to bit 15
+            simd<uint16_t, 32> shv[4];
+#pragma unroll
+            for (int x = 0; x < 2; ++x) {
+#pragma unroll
+                for (int e = 0; e < 2; ++e) {
+                    shv[2 * x + e].template select<16, 2>(0) = (uint16_t) (15 - 4 * x - 2 * e);
+                    shv[2 * x + e].template select<16, 2>(1) = (uint16_t) (14 - 4 * x - 2 * e);
+                }
+            }
+
+            for (int sp = 0; sp < kn; ++sp) {
+                simd<uint32_t, 16> rd[NB];   // the d of the pair, a half each
+#pragma unroll
+                for (int g = 0; g < NB; ++g) {
+                    rd[g] = gather<uint32_t, 16>(w32, pd[g]);
+                }
+#pragma unroll
+                for (int e2 = 0; e2 < 2; ++e2) {
+                    simd<uint32_t, 16 * 16> raw[NB];   // qs, [dword][lane]
+                    simd<uint32_t, 8 * 16>  rsg[NB];   // signs
+                    simd<uint32_t, 3 * 16>  rmt[NB];   // qh | scales
+                    simd<sycl::half, 16>    db[NB][8];
+#pragma unroll
+                    for (int g = 0; g < NB; ++g) {
+                        const simd<uint32_t, 16> o = ob[g] + (uint32_t) (64 * e2);
+                        raw[g].template select<128, 1>(0)   = gather<uint32_t, 128, 8>(w32, o);
+                        raw[g].template select<128, 1>(128) = gather<uint32_t, 128, 8>(w32, o + 32);
+                        rsg[g] = gather<uint32_t, 128, 8>(w32, pg[g] + (uint32_t) (32 * e2));
+                        rmt[g] = gather<uint32_t, 48, 3>(w32, pm[g] + (uint32_t) (12 * e2));
+                        const simd<float, 16> d =
+                            rd[g].template bit_cast_view<sycl::half>().template replicate_vs_w_hs<16, 2, 1, 0>(e2);
+                        auto m8 = rmt[g].template bit_cast_view<uint8_t>();
+#pragma unroll
+                        for (int ib = 0; ib < 8; ++ib) {   // scales: bytes 8 .. 11 of the qh | scales plane
+                            const simd<uint16_t, 16> sc = m8.template replicate_vs_w_hs<16, 4, 1, 0>(2 * 64 + ib / 2);
+                            db[g][ib] = d * (1.0f + 2.0f * convert<float>(simd<uint16_t, 16>((sc >> (4 * (ib % 2))) & 0xF)));
+                        }
+                    }
+                    simd<uint64_t, 64> a2;
+#pragma unroll
+                    for (int s = 0; s < 16; ++s) {
+                        simd<sycl::half, 256> b[NB];
+#pragma unroll
+                        for (int g = 0; g < NB; ++g) {
+                            auto r8 = raw[g].template bit_cast_view<uint8_t>();
+                            auto m8 = rmt[g].template bit_cast_view<uint8_t>();
+                            auto s8 = rsg[g].template bit_cast_view<uint8_t>();
+                            const simd<sycl::half, 32> db2 = db[g][s / 2].template replicate_vs_w_hs<16, 1, 2, 0>(0);
+#pragma unroll
+                            for (int i = 0; i < 4; ++i) {
+                                const int gi = 4 * s + i;   // bytes of qs[gi], qh[gi / 8], signs[gi / 2] in their planes
+                                const int oq = gi, oh = gi / 8, og = gi / 2;
+                                const simd<uint16_t, 16> qv = r8.template replicate_vs_w_hs<16, 4, 1, 0>((oq / 4) * 64 + oq % 4);
+                                const simd<uint16_t, 16> hv = m8.template replicate_vs_w_hs<16, 4, 1, 0>((oh / 4) * 64 + oh % 4);
+                                const simd<uint16_t, 32> sv = s8.template replicate_vs_w_hs<16, 4, 2, 0>((og / 4) * 64 + og % 4);
+                                const simd<uint16_t, 16> idx = qv | (((hv >> (gi % 8)) & 1) << 8);
+                                simd<uint32_t, 16>       gr  = slm_gather<uint32_t, 16>(convert<uint32_t>(idx) * 4);
+                                auto                     g8  = gr.template bit_cast_view<uint8_t>();
+#pragma unroll
+                                for (int e = 0; e < 2; ++e) {
+                                    simd<uint16_t, 32> u = g8.template replicate_vs_w_hs<16, 4, 2, 1>(2 * e);
+                                    u |= (uint16_t) 0x6400;
+                                    simd<sycl::half, 32> v = (u.template bit_cast_view<sycl::half>() - (sycl::half) 1024.0f) * db2;
+                                    v.template bit_cast_view<uint16_t>() ^= simd<uint16_t, 32>((sv << shv[2 * (gi % 2) + e]) & 0x8000);
+                                    b[g].template select<32, 1>((2 * i + e) * 32) = v;
+                                }
+                            }
+                        }
+                        // the A tiles of k-steps s, s + 1 in one 512 B load
+                        if (s % 2 == 0) {
+                            a2 = block_load<uint64_t, 64>((const uint64_t *) pa);
+                            pa += 256;
+                        }
+                        const simd<sycl::half, 128> a = a2.template bit_cast_view<sycl::half>().template select<128, 1>((s % 2) * 128);
+#pragma unroll
+                        for (int g = 0; g < NB; ++g) {
+                            acc[g] = xmx::dpas<8, 8, float, float, sycl::half, sycl::half>(acc[g], b[g], a);
+                        }
+                    }
+                }
+#pragma unroll
+                for (int g = 0; g < NB; ++g) {
+                    ob[g] += 128;
+                    pg[g] += 64;
+                    pm[g] += 24;
+                    pd[g] += 4;
+                }
+            }
+            nw_store<NB>(acc, 512 * 4, t, ki, dst, epi, M, N, n0);
+        });
+}
+
+// ---- IQ4_XS / IQ4_NL (gemm_iq4_pair) ---------------------------------------------------------
+// the image of one super-block of the 16 lane rows at super-block index ob: the header, then the qs
+template <int HB, int ND>
+ESIMD_INLINE void nw_iq4_load(simd<uint32_t, ND * 16> & raw, const uint32_t * w32, uint32_t nblk, simd<uint32_t, 16> ob) {
+    raw.template select<HB * 4, 1>(0) = gather<uint32_t, HB * 4, HB / 4>(w32, nblk * 128 + ob * HB);
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+        raw.template select<128, 1>(HB * 4 + i * 128) = gather<uint32_t, 128, 8>(w32, ob * 128 + 32 * i);
+    }
+}
+
+// the scales and the 16 k-steps of one super-block, the activations at pa; the pair table in SLM
+template <int HB, int ND, bool NL>
+ESIMD_INLINE void nw_iq4_sb(simd<uint32_t, ND * 16> & raw, const sycl::half * pa, simd<float, 128> & acc) {
+    auto                 r8 = raw.template bit_cast_view<uint8_t>();
+    auto                 rh = raw.template bit_cast_view<sycl::half>();
+    simd<sycl::half, 16> dv[8];
+    if constexpr (NL) {
+#pragma unroll
+        for (int ib = 0; ib < 8; ++ib) {
+            dv[ib] = rh.template replicate_vs_w_hs<16, 2, 1, 0>((ib / 2) * 32 + ib % 2);
+        }
+    } else {
+        auto                     r16 = raw.template bit_cast_view<uint16_t>();
+        const simd<float, 16>    d   = rh.template replicate_vs_w_hs<16, 2, 1, 0>(0);
+        const simd<uint16_t, 16> sh  = r16.template replicate_vs_w_hs<16, 2, 1, 0>(1);
+#pragma unroll
+        for (int ib = 0; ib < 8; ++ib) {
+            const simd<uint16_t, 16> sl = r8.template replicate_vs_w_hs<16, 4, 1, 0>(64 + ib / 2);
+            const simd<uint16_t, 16> ls = ((sl >> (4 * (ib % 2))) & 0xF) | (((sh >> (2 * ib)) & 3) << 4);
+            dv[ib] = d * (convert<float>(ls) - 32.0f);
+        }
+    }
+    // the lookups run one k-step ahead of their dpas
+    simd<uint32_t, 32> pr[2][4];
+    simd<uint64_t, 64> a2;
+    iq4_pair_lookup<HB>(raw, 0, pr[0]);
+#pragma unroll
+    for (int s = 0; s < 16; ++s) {
+        if (s + 1 < 16) {
+            iq4_pair_lookup<HB>(raw, s + 1, pr[(s + 1) % 2]);
+        }
+        simd<sycl::half, 256>      b;
+        const simd<sycl::half, 32> dv2 = dv[s / 2].template replicate_vs_w_hs<16, 1, 2, 0>(0);
+        const simd<sycl::half, 64> dv4 = dv2.template replicate<2>();
+#pragma unroll
+        for (int j = 0; j < 4; ++j) {
+            b.template select<64, 1>(j * 64) = pr[s % 2][j].template bit_cast_view<sycl::half>() * dv4;
+        }
+        if (s % 2 == 0) {
+            a2 = block_load<uint64_t, 64>((const uint64_t *) (pa + 256 * (s / 2)));
+        }
+        const simd<sycl::half, 128> a = a2.template bit_cast_view<sycl::half>().template select<128, 1>((s % 2) * 128);
+        acc = xmx::dpas<8, 8, float, float, sycl::half, sycl::half>(acc, b, a);
+    }
+}
+
+// the pair table sits in SLM ahead of the k slices; one row group of 16 rows, as gemm_iq4_pair
+template <bool NL>
+sycl::event gemm_nw_iq4(sycl::queue & q, const uint8_t * w, const sycl::half * act, float * dst, int M, int N, int K,
+                        const gemm_epi epi, int ki) {
+    constexpr int  NB   = 1;
+    constexpr int  HB   = NL ? 16 : 8;        // header bytes per 256 weights
+    constexpr int  ND   = (HB + 128) / 4;     // image dwords: the header, then the qs
+    const int      nsb  = K / 256;
+    const uint32_t nblk = (uint32_t) N * nsb;
+    const int      gn   = N / 16;
+    namespace sx = sycl::ext::oneapi::experimental;
+    sx::properties props{ sycl::ext::intel::experimental::grf_size<GRF> };
+
+    return q.parallel_for(sycl::nd_range<1>(sycl::range<1>((size_t) gn * ki), sycl::range<1>(ki)), props,
+        [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL {
+            // pair e = (kvalues_iq4nl[e & 15], kvalues_iq4nl[e >> 4]) at SLM dword e, stored before any thread leaves
+            slm_init<1024 + nw_slm<NB>>();
+            const int t = (int) it.get_local_id(0);
+            {
+                simd<sycl::half, 16> kv = simd<float, 16>({ -127.f, -104.f, -83.f, -65.f, -49.f, -35.f, -22.f, -10.f,
+                                                            1.f, 13.f, 25.f, 38.f, 53.f, 69.f, 89.f, 113.f });   // iselect is not const
+                for (int e = t * 16; e < 256; e += ki * 16) {
+                    const simd<uint16_t, 16> i = simd<uint16_t, 16>(0, 1) + (uint16_t) e;
+                    simd<sycl::half, 32>     pr;
+                    pr.template select<16, 2>(0) = kv.iselect(simd<uint16_t, 16>(i & (uint16_t) 15));
+                    pr.template select<16, 2>(1) = kv.iselect(simd<uint16_t, 16>(i >> 4));
+                    slm_block_store<uint32_t, 16>(e * 4, pr.template bit_cast_view<uint32_t>());
+                }
+            }
+            barrier();
+            const int n0 = (int) it.get_group(0) * 16;
+            int       k0;
+            const int kn = nw_units(t, ki, nsb, k0);
+
+            simd<float, 128> acc[NB];
+            acc[0] = 0.0f;
+            const uint32_t *   w32 = (const uint32_t *) w;
+            simd<uint32_t, 16> ob  = lane_rows(n0, 0) * (uint32_t) nsb + (uint32_t) k0;   // super-block index
+            const sycl::half * pa  = act + (size_t) k0 * 2048;
+
+            for (int sb = 0; sb < kn; ++sb) {
+                simd<uint32_t, ND * 16> raw;   // [dword][lane]
+                nw_iq4_load<HB, ND>(raw, w32, nblk, ob);
+                ob += 1;
+                nw_iq4_sb<HB, ND, NL>(raw, pa, acc[0]);
+                pa += 2048;
+            }
+            nw_store<NB>(acc, 1024, t, ki, dst, epi, M, N, n0);
+        });
+}
+
+}  // namespace gguf_xmx
