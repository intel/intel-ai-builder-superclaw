+// Eligibility + one-time in-place Q*_K -> asym u4@group64 conversion of the expert weights
+// for the MoE gemms. Idempotent; returns false (tensor untouched) if src0 cannot take
+// the path (type/layout), the staging buffer cannot be allocated, or the tensor was
+// already converted to the other layout.
+static bool mmid_dnn_ensure_u4(ggml_backend_sycl_context & ctx, const ggml_tensor * src0,
+                               ggml_tensor * dst, const queue_ptr & stream, mmid_u4_weights & out,
+                               bool swizzled = false) {
+    const ggml_tensor_extra_gpu * extra = static_cast<const ggml_tensor_extra_gpu *>(src0->extra);
+    if (extra && extra->optimized_feature.reorder) return false;
+    if (src0->type != GGML_TYPE_Q4_K && src0->type != GGML_TYPE_Q5_K && src0->type != GGML_TYPE_Q6_K) return false;
+    if (!ggml_is_contiguous(src0) || (src0->ne[0] % 64) != 0) return false;
+
+    const int64_t ne10  = src0->ne[0];      // K
+    const int64_t nrows = src0->ne[1];      // weight rows (dst ne0)
+    const int64_t n_as  = src0->ne[2];
+    const int     group = 64;               // u4@group64 (4.31 b/w) fits inside the Q4_K bytes
+    const int64_t kg    = ne10 / group;
+    const int64_t we    = nrows * ne10;     // weight elements per expert
+
+    uint8_t * const wbase    = (uint8_t *) src0->data;
+    const int64_t   u4_bytes = n_as * we / 2;
+    const int64_t   sc_bytes = n_as * nrows * kg * (int64_t) sizeof(sycl::half);
+    out.w  = wbase;
+    out.sc = (sycl::half *) (wbase + u4_bytes);
+    out.zp = wbase + u4_bytes + sc_bytes;
+
+    const char want = swizzled ? 2 : 1;
+    auto it = g_mmid_u4_converted.find((const void *) src0->data);
+    if (it != g_mmid_u4_converted.end()) return it->second == want;
+
+    const size_t tot_bytes = ggml_nbytes(src0);
+    sycl_reorder_temp_buffer tmp(stream, tot_bytes);   // holds original Q*_K while we overwrite
+    if (!tmp) return false;
+    SYCL_CHECK(CHECK_TRY_ERROR(stream->memcpy(tmp.ptr, src0->data, tot_bytes).wait()));
+    ggml_sycl_pool_alloc<float>   stg(ctx.pool(), we);
+    ggml_sycl_pool_alloc<uint8_t> q8 (ctx.pool(), we);
+    ggml_sycl_pool_alloc<uint8_t> zp8(ctx.pool(), nrows * kg);
+    ggml_sycl_pool_alloc<sycl::half> sc8(ctx.pool(), swizzled ? nrows * kg : 1);
+    const to_fp32_sycl_t to_fp32 = ggml_get_to_fp32_sycl(src0->type, dst);
+    for (int64_t e = 0; e < n_as; ++e) {
+        to_fp32((const char *) tmp.ptr + e * src0->nb[2], stg.get(), we, stream);
+        sycl::half * sc_e = swizzled ? sc8.get() : out.sc + e * nrows * kg;
+        ggml_sycl_quantize_groups_u4(stg.get(), q8.get(), sc_e, zp8.get(), ne10, nrows, group, stream,
+                                     /*als_refit=*/false);
+        if (swizzled) {
+            ggml_sycl_moe_u4_pack_swizzle(q8.get(), sc_e, zp8.get(), out.w + e * we / 2,
+                                          out.sc + e * nrows * kg, out.zp + e * nrows * kg / 2,
+                                          nrows, ne10, stream);
+        } else {
+            ggml_sycl_pack_u4(q8.get(),  out.w  + e * we / 2,         we,         stream);
+            ggml_sycl_pack_u4(zp8.get(), out.zp + e * nrows * kg / 2, nrows * kg, stream);
+        }
+    }
+    stream->wait();
+    g_mmid_u4_converted.emplace((const void *) src0->data, want);
+    return true;
+}
