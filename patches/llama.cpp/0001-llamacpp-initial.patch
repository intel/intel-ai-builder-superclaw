+    uint8_t *    qs_ptr = data_device;
+    uint8_t *    hd_ptr = data_device + nblocks * nq;
+    const int    nc     = nq / 16;   // 32-weight chunks per block
+    auto reorder_event = stream->parallel_for(nblocks * nc, [=](auto id) {
+        const size_t    c  = id;
+        const size_t    b  = c / nc;
+        const int       ic = (int) (c % nc);
+        const uint8_t * x  = tmp_buf + b * bs;
+        const uint8_t * in = x + nh + 16 * ic;
+        uint8_t *       out = qs_ptr + b * nq + 16 * ic;
+        for (int p = 0; p < 16; ++p) {
+            const int lo = p < 8 ? in[2 * p] & 0xF : in[2 * p - 16] >> 4;
+            const int hi = p < 8 ? in[2 * p + 1] & 0xF : in[2 * p - 15] >> 4;
+            out[p]       = (uint8_t) (lo | (hi << 4));
+        }
+        if (ic == 0) {
+            for (int j = 0; j < nh; ++j) {
+                hd_ptr[b * nh + j] = x[j];
+            }
+        }
+    });
+    if (!g_ggml_sycl_use_async_mem_op) {
+        reorder_event.wait_and_throw();
