+#ifndef GGML_SYCL_GGUF_GEMM_I8_KERNELS_HPP
+#define GGML_SYCL_GGUF_GEMM_I8_KERNELS_HPP
+
+// Exact-weight prefill GEMM with s8 activations: dst[m][n] = sum_k x[m][k] * w[n][k] on the GGUF weight blocks as they
+// are, with int8 dpas (K = 32 per instruction: the f16 dpas rate at twice the MACs).
+// Activations are s8 with one scale per 8 rows x 32 k (the m-block of a dpas; wikitext KLD 0.0012 on Qwen3.8-27B against
+// the f16 activations, PPL +0.07%): shared by the 8 tokens of a dpas, the activation scale folds into the 16 rows'
+// weight scale once per dpas, and the per-32 epilogue is one mad per accumulator row (see i8_acc).
+// Weights are the dpas B operand as in gguf_gemm_kernels.hpp: a 16-lane gather puts one weight row in each lane, and
+// its [dword][lane] result is the VNNI layout (for int8: 4 consecutive k per dword).
+// The K-quant mins meet the activations' 32-k row sums in one f16 dpas per 512 k.
+// Activation layout: aq[Mp/8][K/32][8][32] s8, as[Mp/8][K/32] f32, xs[Mp/8][K/512][8][16] f16 (see a8_pack).
+
+#include "gguf_gemm_kernels.hpp"
+
+namespace gguf_xmx {
+
+// token rows the s8 activations and the tile outputs of these kernels are padded to (a 16 x 64 thread tile x 4 threads)
+constexpr int I8_MP = 256;
+
+// ---- s8 activations ----------------------------------------------------------------------
+
+// the s8 tile of 8 rows x 32 k (row-major, v[32 r + k]) with its scale, and each row's sum of the dequantized values
+ESIMD_INLINE void a8_tile(simd<float, 256> v, int8_t * aq, float & s, simd<float, 8> & rsum) {
+    simd<float, 256> av   = abs<float>(v);
+    const float      amax = hmax<float>(av);
+    const float      inv  = amax > 0.0f ? 127.0f / amax : 0.0f;
+    simd<float, 256> qf   = rnde<float>(v * inv);
+    simd<int8_t, 256> qi  = convert<int8_t>(qf);
+    const simd<uint32_t, 64> qw = qi.template bit_cast_view<uint32_t>();
+    block_store<uint32_t, 64>((uint32_t *) aq, qw);
+    s = amax / 127.0f;
+#pragma unroll
+    for (int r = 0; r < 8; ++r) {
+        const simd<float, 32> qr = qf.template select<32, 1>(32 * r);
+        rsum[r] = s * reduce<float>(qr, std::plus<>());
+    }
+}
+
+// f32 x [M][K] (row stride ldx) -> aq / as / xs, one work-item per 8-row panel and 512 k; rows past M pack as zeros.
+// K % 512 == 0
+inline sycl::event a8_pack(sycl::queue & q, const float * x, int64_t ldx, int8_t * aq, float * as, sycl::half * xs, int M,
+                           int K) {
+    const int nkg = K / 32;
+    const int nkc = K / 512;
+    const int nmb = (M + 7) / 8;
+    constexpr int WG = 16;
+    const size_t n = ((size_t) nmb * nkc + WG - 1) / WG * WG;
+    return q.parallel_for(sycl::nd_range<1>(sycl::range<1>(n), sycl::range<1>(WG)),
+        [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL {
+            const int id = (int) it.get_global_id(0);
+            if (id >= nmb * nkc) {
+                return;
+            }
+            const int mb = id / nkc;
+            const int kc = id % nkc;
+            const int nr = M - mb * 8 < 8 ? M - mb * 8 : 8;
+            simd<float, 16>       sc;
+            simd<sycl::half, 128> sums;   // [8 rows][16 tiles]
+#pragma unroll
+            for (int j = 0; j < 16; ++j) {
+                const int       k0 = kc * 512 + j * 32;
+                simd<float, 256> v = 0.0f;
+#pragma unroll
+                for (int r = 0; r < 8; ++r) {
+                    if (r < nr) {
+                        v.template select<32, 1>(32 * r) = block_load<float, 32>(x + (size_t) (mb * 8 + r) * ldx + k0);
+                    }
+                }
+                float          s;
+                simd<float, 8> rs;
+                a8_tile(v, aq + ((size_t) mb * nkg + kc * 16 + j) * 256, s, rs);
+                sc[j] = s;
+                sums.template select<8, 16>(j) = rs;
+            }
+            block_store<float, 16>(as + (size_t) mb * nkg + kc * 16, sc);
+            block_store<sycl::half, 128>(xs + ((size_t) mb * nkc + kc) * 128, sums);
+        });
+}
+
+// the f16 tiles [Mp/8][K/16][8][16] of gguf_gemm_kernels.hpp -> aq / as / xs; rows past M are zeroed first (a tile store
+// may leave anything there). K % 512 == 0
+inline sycl::event a8_from_tiles(sycl::queue & q, const sycl::half * act, int8_t * aq, float * as, sycl::half * xs, int M,
+                                 int K) {
+    const int nkg = K / 32;
+    const int nks = K / 16;
+    const int nkc = K / 512;
+    const int nmb = (M + 7) / 8;
+    constexpr int WG = 16;
+    const size_t n = ((size_t) nmb * nkc + WG - 1) / WG * WG;
+    return q.parallel_for(sycl::nd_range<1>(sycl::range<1>(n), sycl::range<1>(WG)),
+        [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL {
+            const int id = (int) it.get_global_id(0);
+            if (id >= nmb * nkc) {
+                return;
+            }
+            const int mb = id / nkc;
+            const int kc = id % nkc;
+            const int nr = M - mb * 8 < 8 ? M - mb * 8 : 8;
+            simd<float, 16>       sc;
+            simd<sycl::half, 128> sums;
+#pragma unroll
+            for (int j = 0; j < 16; ++j) {
+                const sycl::half *    t0 = act + ((size_t) mb * nks + (kc * 16 + j) * 2) * 128;
+                simd<sycl::half, 256> h  = block_load<sycl::half, 256>(t0);   // tiles 2 g, 2 g + 1: [2][8 rows][16 k]
+                simd<float, 256>      v;
+#pragma unroll
+                for (int r = 0; r < 8; ++r) {
+                    if (r < nr) {
+                        v.template select<16, 1>(32 * r)      = h.template select<16, 1>(16 * r);
+                        v.template select<16, 1>(32 * r + 16) = h.template select<16, 1>(128 + 16 * r);
+                    } else {
+                        v.template select<32, 1>(32 * r) = 0.0f;
+                    }
+                }
+                float          s;
+                simd<float, 8> rs;
+                a8_tile(v, aq + ((size_t) mb * nkg + kc * 16 + j) * 256, s, rs);
+                sc[j] = s;
+                sums.template select<8, 16>(j) = rs;
+            }
+            block_store<float, 16>(as + (size_t) mb * nkg + kc * 16, sc);
+            block_store<sycl::half, 128>(xs + ((size_t) mb * nkc + kc) * 128, sums);
+        });
+}
+
+// acc (8 tokens x 16 rows, f32) += I * S, S = the 16 rows' scale times the 8 tokens' scale, without a convert: a dpas
+// whose accumulator input is I8_MAGIC returns 1.5 * 2^23 + I as the bits of an f32 (exact while |I| < 2^22, as the sum
+// lands in the mantissa), so the epilogue is one mad per row. On B70 a dpas takes ~9.5 issue slots (~14 with an
+// accumulator input) and the rest of the loop adds to that, so the 8 converts it drops are worth 5% of prefill. The bias
+// 1.5 * 2^23 * S is the same for the 8 rows of a tile: the S add up in sumS, and i8_unbias takes 1.5 * 2^23 * sumS out
+// of acc once per 8 or 16 dpas. The price is the rounding of (1.5 * 2^23 + I) * S, some 0.3 of one unit of I per dpas
+// against the ~14 units the s8 activations' own rounding adds (Q4_K): ~0.5% more error variance, which the 27B's
+// wikitext KLD cannot resolve (0.00115 against 0.00114 with the convert)
+constexpr int32_t I8_MAGIC  = 0x4B400000;
+constexpr float   I8_MAGICF = 12582912.0f;
+
+ESIMD_INLINE void i8_acc(simd<float, 128> & acc, simd<int32_t, 128> & I, const simd<float, 16> & S) {
+    auto f = I.template bit_cast_view<float>();
+#pragma unroll
+    for (int r = 0; r < 8; ++r) {
+        acc.template select<16, 1>(16 * r) += f.template select<16, 1>(16 * r) * S;
+    }
+}
+
+ESIMD_INLINE void i8_unbias(simd<float, 128> & acc, simd<float, 16> & sumS) {
+#pragma unroll
+    for (int r = 0; r < 8; ++r) {
+        acc.template select<16, 1>(16 * r) -= sumS * I8_MAGICF;
+    }
+    sumS = 0.0f;
+}
+
+// the work-group -> (k slice, weight panel, token panel) of a KS-sliced gemm in a gn x gm panel grid
+template <int RAST, int KS>
+ESIMD_INLINE void i8_panels(int group, int gn, int gm, int gs, int & wgk, int & gni, int & gmi) {
+    wgk = KS == 1 ? 0 : group / (gn * gm);
+    const int wg = KS == 1 ? group : group % (gn * gm);
+    if constexpr (RAST == 2) {
+        wg_panels<2>(wg, gn, gm, gs, gni, gmi);
+    } else {
+        wg_panels<RAST>(wg, gn, gm, 0, gni, gmi);
+    }
+}
+
+// ---- Q8_0 --------------------------------------------------------------------------------
+// w in the Q8_0 SoA of reorder_qw: qs[N][K/32][32] | d[N][K/32] (f16); a block's gathered qs is the s8 B operand as is.
+// Thread tile NB x 16 rows x MT x 8 tokens. The B gathers run one block pair ahead (ping-pong), and each token panel's
+// epilogue runs behind the next panel's dpas. (Gathering one block ahead with the A tiles loaded per block instead was
+// 1.6x slower on B70.) K % (256 * KS) == 0, N % (16 * NB * TW) == 0
+template <int TW, int TT, int RAST, int NB = 1, int MT = 8, int KS = 1>
+sycl::event gemm_i8_q8_0(sycl::queue & q, const uint8_t * w, const int8_t * aq, const float * as, float * dst, int M, int N,
+                         int K, const gemm_epi epi = {}, int gt = 0) {
+    static_assert(I8_MP % (8 * MT * TT) == 0, "a token panel must tile the rows the s8 activations are padded to");
+    const int      nkg   = K / 32;
+    const int      nks   = nkg / KS;   // blocks per k slice
+    const uint32_t dbase = (uint32_t) N * nkg * 32;
+    const int      gn    = N / (16 * NB * TW);
+    const int      gm    = (M + 8 * MT * TT - 1) / (8 * MT * TT);
+    const int      gs    = gt >= 16 * MT * TT ? gt / (8 * MT * TT) : gt > 0 ? 1 : gm;
+    namespace sx = sycl::ext::oneapi::experimental;
+    sx::properties props{ sycl::ext::intel::experimental::grf_size<GRF> };
+
+    return q.parallel_for(sycl::nd_range<1>(sycl::range<1>((size_t) gn * gm * KS * TW * TT), sycl::range<1>(TW * TT)), props,
+        [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL {
+            const int lid = (int) it.get_local_id(0);
+            int wgk, gni, gmi;
+            i8_panels<RAST, KS>((int) it.get_group(0), gn, gm, gs, wgk, gni, gmi);
+            const int n0  = (gni * TW + lid % TW) * 16 * NB;
+            const int mt0 = (gmi * TT + lid / TW) * MT;
+            if (mt0 * 8 >= M) {
+                return;
+            }
+            const int kb0 = wgk * nks;
+
+            simd<float, 128> acc[NB * MT];
+            simd<float, 16>  sumS[NB * MT];   // the scales behind acc's bias
+#pragma unroll
+            for (int i = 0; i < NB * MT; ++i) {
+                acc[i]  = 0.0f;
+                sumS[i] = 0.0f;
+            }
+            const simd<int32_t, 128> magic = I8_MAGIC;
+            const uint32_t * w32 = (const uint32_t *) w;
+            simd<uint32_t, 16> oq[NB], od[NB];
+#pragma unroll
+            for (int g = 0; g < NB; ++g) {
+                const simd<uint32_t, 16> rows = lane_rows(n0, g);
+                oq[g] = rows * (uint32_t) (nkg * 32) + (uint32_t) (kb0 * 32);
+                od[g] = dbase + rows * (uint32_t) (nkg * 2) + (uint32_t) (kb0 * 2);
+            }
+            const uint32_t * pa[MT];
+            const float *    ps[MT];
+#pragma unroll
+            for (int t = 0; t < MT; ++t) {
+                pa[t] = (const uint32_t *) (aq + ((size_t) (mt0 + t) * nkg + kb0) * 256);
+                ps[t] = as + (size_t) (mt0 + t) * nkg + kb0;
+            }
+            struct pair_t {
+                simd<uint32_t, 128> bq[2][NB];
+                simd<uint32_t, 16>  dd[NB];
+            };
+            auto load = [&](pair_t & p) SYCL_ESIMD_FUNCTION {
+#pragma unroll
+                for (int g = 0; g < NB; ++g) {
+                    p.bq[0][g] = gather<uint32_t, 128, 8>(w32, oq[g]);
+                    p.bq[1][g] = gather<uint32_t, 128, 8>(w32, oq[g] + 32);
+                    p.dd[g]    = gather<uint32_t, 16, 1>(w32, od[g]);
+                    oq[g] += 64;
+                    od[g] += 4;
+                }
+            };
+            auto compute = [&](pair_t & p, int kb) SYCL_ESIMD_FUNCTION {
+                simd<uint32_t, 64> a[2][MT];
+                simd<float, 2>     sa[MT];
+#pragma unroll
+                for (int t = 0; t < MT; ++t) {
+                    a[0][t] = block_load<uint32_t, 64>(pa[t]);
+                    a[1][t] = block_load<uint32_t, 64>(pa[t] + 64);
+                    pa[t] += 128;
+                    simd<float, 4> s4 = block_load<float, 4>(ps[t] + (kb & ~3));
+                    sa[t] = s4.template select<2, 1>(kb & 3);
+                }
+#pragma unroll
+                for (int e = 0; e < 2; ++e) {
+                    simd<float, 16> dw[NB];
+#pragma unroll
+                    for (int g = 0; g < NB; ++g) {
+                        const simd<sycl::half, 16> dh = p.dd[g].template bit_cast_view<sycl::half>().template select<16, 2>(e);
+                        dw[g] = dh;
+                    }
+                    simd<int32_t, 128> Ip[NB], Ic[NB];
+#pragma unroll
+                    for (int t = 0; t <= MT; ++t) {
+                        if (t < MT) {
+#pragma unroll
+                            for (int g = 0; g < NB; ++g) {
+                                Ic[g] = xmx::dpas<8, 8, int32_t, int32_t, uint32_t, uint32_t, xmx::dpas_argument_type::s8,
+                                                  xmx::dpas_argument_type::s8>(magic, p.bq[e][g], a[e][t]);
+                            }
+                        }
+                        if (t > 0) {
+                            const float s = sa[t - 1][e];
+#pragma unroll
+                            for (int g = 0; g < NB; ++g) {
+                                const simd<float, 16> S = dw[g] * s;
+                                i8_acc(acc[g * MT + t - 1], Ip[g], S);
+                                sumS[g * MT + t - 1] += S;
+                            }
+                        }
+                        if (t < MT) {
+#pragma unroll
+                            for (int g = 0; g < NB; ++g) {
+                                Ip[g] = Ic[g];
+                            }
+                        }
+                    }
+                }
+            };
+            pair_t p0, p1;
+            load(p0);
+            // kb counts from the slice start, where ps already points; the bias leaves acc every 8 blocks (nks % 8 == 0)
+            for (int kb = 0; kb < nks; kb += 8) {
+                load(p1);
+                compute(p0, kb);
+                load(p0);
+                compute(p1, kb + 2);
+                load(p1);
+                compute(p0, kb + 4);
+                if (kb + 8 < nks) {
+                    load(p0);
+                }
+                compute(p1, kb + 6);
+#pragma unroll
+                for (int i = 0; i < NB * MT; ++i) {
+                    i8_unbias(acc[i], sumS[i]);
+                }
+            }
+            store_split<NB, MT, KS>(acc, dst, epi, wgk, mt0, M, N, n0);
+        });
+}
+
+// ---- Q4_K --------------------------------------------------------------------------------
+// w in the Q4_K SoA of reorder_qw: qs[nblk][128] | scales[nblk][12] | dm[nblk][4]. The u8 B operand of sub-block 2c
+// (2c+1) is qs chunk c & 0x0F (& 0xF0 = 16 q, its scale / 16). The mins (-dmin m_j, as f16 VNNI pairs over the 16
+// sub-blocks of a super-block pair) meet xs in one f16 dpas per 512 k. The qs arrive one 32 B chunk (two sub-blocks)
+// at a time, the next chunk's gather ahead of the current chunk's dpas: holding the whole super-block spilled 500 sends
+// per super-block. PFA > 0 prefetches the s8 activations PFA super-blocks ahead, for the long-K gemms whose
+// activations outgrow L2 (gguf_i8_pfa). Q5: Q5_K, the SoA qs[nblk][128] | qh[nblk][32] | scales[nblk][12] | dm[nblk][4],
+// whose bit j of qh byte l is bit 4 of weight l of sub-block j: the B operand is the nibble (the high one shifted down,
+// no 16 q) OR-ed with that bit. K % (512 * KS) == 0, N % (16 * NB * TW) == 0
+template <int TW, int TT, int RAST, int NB = 2, int MT = 4, bool PF = true, int KS = 1, int PFA = 0, bool Q5 = false>
+sycl::event gemm_i8_q4_K(sycl::queue & q, const uint8_t * w, const int8_t * aq, const float * as, const sycl::half * xs,
+                         float * dst, int M, int N, int K, const gemm_epi epi = {}, int gt = 0) {
+    static_assert(I8_MP % (8 * MT * TT) == 0, "a token panel must tile the rows the s8 activations are padded to");
+    const int      nsb  = K / 256;
+    const int      nss  = nsb / KS;   // super-blocks per k slice
+    const uint32_t nblk = (uint32_t) N * nsb;
+    const int      nkg  = K / 32;
+    const int      nkc  = K / 512;
+    const int      gn   = N / (16 * NB * TW);
+    const int      gm   = (M + 8 * MT * TT - 1) / (8 * MT * TT);
+    const int      gs   = gt >= 16 * MT * TT ? gt / (8 * MT * TT) : gt > 0 ? 1 : gm;
+    namespace sx = sycl::ext::oneapi::experimental;
+    sx::properties props{ sycl::ext::intel::experimental::grf_size<GRF> };
+
+    return q.parallel_for(sycl::nd_range<1>(sycl::range<1>((size_t) gn * gm * KS * TW * TT), sycl::range<1>(TW * TT)), props,
+        [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL {
+            const int lid = (int) it.get_local_id(0);
+            int wgk, gni, gmi;
+            i8_panels<RAST, KS>((int) it.get_group(0), gn, gm, gs, wgk, gni, gmi);
+            const int n0  = (gni * TW + lid % TW) * 16 * NB;
+            const int mt0 = (gmi * TT + lid / TW) * MT;
+            if (mt0 * 8 >= M) {
+                return;
+            }
+            const int sb0 = wgk * nss;
+
+            simd<float, 128> acc[NB * MT];
+            simd<float, 16>  sumS[NB * MT];   // the scales behind acc's bias
+#pragma unroll
+            for (int i = 0; i < NB * MT; ++i) {
+                acc[i]  = 0.0f;
+                sumS[i] = 0.0f;
+            }
+            const simd<int32_t, 128> magic = I8_MAGIC;
+            const uint32_t * w32 = (const uint32_t *) w;
+            simd<uint32_t, 16> oq[NB], os[NB], om[NB], oh[NB];
+#pragma unroll
+            for (int g = 0; g < NB; ++g) {
+                const simd<uint32_t, 16> blk = lane_rows(n0, g) * (uint32_t) nsb + (uint32_t) sb0;
+                oq[g] = blk * 128;
+                oh[g] = nblk * 128 + blk * 32;   // Q5 only
+                os[g] = nblk * (Q5 ? 160 : 128) + blk * 12;
+                om[g] = nblk * (Q5 ? 172 : 140) + blk * 4;
+            }
+            const uint32_t *   pa[MT];
+            const float *      ps[MT];
+            const sycl::half * px[MT];
+#pragma unroll
+            for (int t = 0; t < MT; ++t) {
+                pa[t] = (const uint32_t *) (aq + ((size_t) (mt0 + t) * nkg + sb0 * 8) * 256);
+                ps[t] = as + (size_t) (mt0 + t) * nkg + sb0 * 8;
+                px[t] = xs + ((size_t) (mt0 + t) * nkc + sb0 / 2) * 128;
+            }
+
+            for (int sp = 0; sp < nss; sp += 2) {
+                simd<sycl::half, 256> bmin[NB];   // [pair i][lane][2]: -dmin m of sub-block 2i + h of the 16
+#pragma unroll
+                for (int e = 0; e < 2; ++e) {
+                    if constexpr (PFA > 0) {   // the A tiles of the super-block PFA ahead into L1, a token tile per thread
+                        const int sbn = sp + e + PFA;
+                        if (sbn < nss) {
+                            namespace esx = sycl::ext::intel::esimd;
+#pragma unroll
+                            for (int t = 0; t < MT; ++t) {
+                                if (t % TW == lid % TW) {
+                                    const uint64_t * pf = (const uint64_t *) (aq + ((size_t) (mt0 + t) * nkg + (sb0 + sbn) * 8) * 256);
+#pragma unroll
+                                    for (int i = 0; i < 4; ++i) {
+                                        esx::prefetch<uint64_t, 64>(pf + 64 * i, sycl::ext::oneapi::experimental::properties{
+                                            esx::cache_hint_L1<esx::cache_hint::cached>, esx::cache_hint_L2<esx::cache_hint::cached> });
+                                    }
+                                }
+                            }
+                        }
+                    }
+                    simd<float, 16> scj[NB][8];
+#pragma unroll
+                    for (int g = 0; g < NB; ++g) {
+                        simd<uint32_t, 64> hdr;   // [d | dmin][scales x 3] per lane
+                        hdr.template select<16, 1>(0)  = gather<uint32_t, 16, 1>(w32, om[g]);
+                        hdr.template select<48, 1>(16) = gather<uint32_t, 48, 3>(w32, os[g]);
+                        auto r8 = hdr.template bit_cast_view<uint8_t>();
+                        auto rh = hdr.template bit_cast_view<sycl::half>();
+                        const simd<float, 16> d    = rh.template replicate_vs_w_hs<16, 2, 1, 0>(0);
+                        const simd<float, 16> dmin = rh.template replicate_vs_w_hs<16, 2, 1, 0>(1);
+                        simd<uint16_t, 16> s[12];
+#pragma unroll
+                        for (int bb = 0; bb < 12; ++bb) {
+                            s[bb] = r8.template replicate_vs_w_hs<16, 4, 1, 0>((1 + bb / 4) * 64 + bb % 4);
+                        }
+#pragma unroll
+                        for (int j = 0; j < 8; ++j) {
+                            simd<uint16_t, 16> sj, mj;
+                            if (j < 4) {
+                                sj = s[j] & 63;
+                                mj = s[j + 4] & 63;
+                            } else {
+                                sj = (s[j + 4] & 0xF) | ((s[j - 4] >> 6) << 4);
+                                mj = (s[j + 4] >> 4) | ((s[j] >> 6) << 4);
+                            }
+                            scj[g][j] = d * convert<float>(sj) * ((j & 1) && !Q5 ? 1.0f / 16 : 1.0f);
+                            const int jj = 8 * e + j;
+                            const simd<float, 16> mnj = -(dmin * convert<float>(mj));
+                            bmin[g].template select<16, 2>((jj / 2) * 32 + jj % 2) = mnj;
+                        }
+                    }
+                    simd<float, 8> sa[MT];
+#pragma unroll
+                    for (int t = 0; t < MT; ++t) {
+                        sa[t] = block_load<float, 8>(ps[t]);
+                        ps[t] += 8;
+                    }
+                    simd<uint32_t, 128> qb[2][NB];   // qs chunk c in qb[c & 1]
+                    simd<uint32_t, 128> qh[NB];      // Q5: the super-block's qh, [dword][lane]
+#pragma unroll
+                    for (int g = 0; g < NB; ++g) {
+                        qb[0][g] = gather<uint32_t, 128, 8>(w32, oq[g]);
+                        if constexpr (Q5) {
+                            qh[g] = gather<uint32_t, 128, 8>(w32, oh[g]);
+                        }
+                    }
+#pragma unroll
+                    for (int c = 0; c < 4; ++c) {
+                        if constexpr (PF) {
+                            if (c < 3) {
+#pragma unroll
+                                for (int g = 0; g < NB; ++g) {
+                                    qb[(c + 1) & 1][g] = gather<uint32_t, 128, 8>(w32, oq[g] + 32 * (c + 1));
+                                }
+                            }
+                        }
+#pragma unroll
+                        for (int h = 0; h < 2; ++h) {
+                            const int j = 2 * c + h;
+                            simd<uint32_t, 128> bj[NB];
+#pragma unroll
+                            for (int g = 0; g < NB; ++g) {
+                                if constexpr (Q5) {   // nibble | qh bit j at bit 4
+                                    const simd<uint32_t, 128> nib = h ? simd<uint32_t, 128>((qb[c & 1][g] >> 4) & 0x0F0F0F0Fu)
+                                                                      : simd<uint32_t, 128>(qb[c & 1][g] & 0x0F0F0F0Fu);
+                                    const int                 sh  = 4 - j;
+                                    const simd<uint32_t, 128> hb  = sh >= 0 ? simd<uint32_t, 128>(qh[g] << sh)
+                                                                            : simd<uint32_t, 128>(qh[g] >> -sh);
+                                    bj[g] = nib | (hb & 0x10101010u);
+                                } else {
+                                    bj[g] = qb[c & 1][g] & (uint32_t) (h ? 0xF0F0F0F0u : 0x0F0F0F0Fu);
+                                }
+                            }
+                            simd<uint32_t, 64> a[MT];
+#pragma unroll
+                            for (int t = 0; t < MT; ++t) {
+                                a[t] = block_load<uint32_t, 64>(pa[t]);
+                                pa[t] += 64;
+                            }
+#pragma unroll
+                            for (int t = 0; t < MT; ++t) {
+                                const float sv = sa[t][j];
+#pragma unroll
+                                for (int g = 0; g < NB; ++g) {
+                                    simd<int32_t, 128> I = xmx::dpas<8, 8, int32_t, int32_t, uint32_t, uint32_t,
+                                                                     xmx::dpas_argument_type::u8, xmx::dpas_argument_type::s8>(
+                                        magic, bj[g], a[t]);
+                                    const simd<float, 16> S = scj[g][j] * sv;
+                                    i8_acc(acc[g * MT + t], I, S);
+                                    sumS[g * MT + t] += S;
+                                }
+                            }
+                        }
+                        if constexpr (!PF) {
+                            if (c < 3) {
+#pragma unroll
+                                for (int g = 0; g < NB; ++g) {
+                                    qb[(c + 1) & 1][g] = gather<uint32_t, 128, 8>(w32, oq[g] + 32 * (c + 1));
+                                }
+                            }
+                        }
+                    }
+#pragma unroll
+                    for (int i = 0; i < NB * MT; ++i) {
+                        i8_unbias(acc[i], sumS[i]);
+                    }
+#pragma unroll
+                    for (int g = 0; g < NB; ++g) {
+                        oq[g] += 128;
+                        oh[g] += 32;
+                        os[g] += 12;
+                        om[g] += 4;
+                    }
+                }
+#pragma unroll
+                for (int t = 0; t < MT; ++t) {
+                    const simd<sycl::half, 128> xa = block_load<sycl::half, 128>(px[t]);
+                    px[t] += 128;
+#pragma unroll
+                    for (int g = 0; g < NB; ++g) {
+                        acc[g * MT + t] = xmx::dpas<8, 8, float, float, sycl::half, sycl::half>(acc[g * MT + t], bmin[g], xa);
+                    }
+                }
+            }
+            store_split<NB, MT, KS>(acc, dst, epi, wgk, mt0, M, N, n0);
+        });
+}
+
+// ---- Q4_K gate + up with swiglu ------------------------------------------------------------
+// gemm_i8_q4_K with its two row groups taken from the same 16 rows of the gate (g 0) and the up (g 1) weight, so every
+// A tile feeds both; the epilogue writes silu(gate) * up as f16 tiles [Mp/8][N/16][8][16], the packed input of the
+// down gemm (see gemm_glu_q4_K). Q5G / Q5U: the gate / the up weight is Q5_K (see gemm_i8_q4_K), else Q4_K; UD quants
+// pair the two in 5 of the 27B's 65 layers. K % 512 == 0, N % (16 * TW) == 0
+template <int TW, int TT, int RAST, int MT = 4, bool Q5G = false, bool Q5U = Q5G>
+sycl::event gemm_i8_glu_q4_K(sycl::queue & q, const uint8_t * wg, const uint8_t * wu, const int8_t * aq, const float * as,
+                             const sycl::half * xs, sycl::half * out, int M, int N, int K, int gt = 0) {
+    static_assert(I8_MP % (8 * MT * TT) == 0, "a token panel must tile the rows the s8 activations are padded to");
+    constexpr int  NB   = 2;
+    const int      nsb  = K / 256;
+    const uint32_t nblk = (uint32_t) N * nsb;
+    const int      nkg  = K / 32;
+    const int      nkc  = K / 512;
+    const int      gn   = N / (16 * TW);
+    const int      gm   = (M + 8 * MT * TT - 1) / (8 * MT * TT);
+    const int      gs   = gt >= 16 * MT * TT ? gt / (8 * MT * TT) : gt > 0 ? 1 : gm;
+    namespace sx = sycl::ext::oneapi::experimental;
+    sx::properties props{ sycl::ext::intel::experimental::grf_size<GRF> };
+
+    return q.parallel_for(sycl::nd_range<1>(sycl::range<1>((size_t) gn * gm * TW * TT), sycl::range<1>(TW * TT)), props,
+        [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL {
+            const int lid = (int) it.get_local_id(0);
+            int wgk, gni, gmi;
+            i8_panels<RAST, 1>((int) it.get_group(0), gn, gm, gs, wgk, gni, gmi);
+            const int n0  = (gni * TW + lid % TW) * 16;
+            const int mt0 = (gmi * TT + lid / TW) * MT;
+            if (mt0 * 8 >= M) {
+                return;
+            }
+
+            simd<float, 128> acc[NB * MT];
+            simd<float, 16>  sumS[NB * MT];
+#pragma unroll
+            for (int i = 0; i < NB * MT; ++i) {
+                acc[i]  = 0.0f;
+                sumS[i] = 0.0f;
+            }
+            const simd<int32_t, 128> magic = I8_MAGIC;
+            // the planes of weight g start at their own bases; the lane offsets into them are shared
+            const bool     q5w[NB] = { Q5G, Q5U };
+            const uint8_t * wb[NB]  = { wg, wu };
+            const uint32_t * w32[NB], * wqh[NB], * wsc[NB], * wdm[NB];
+#pragma unroll
+            for (int g = 0; g < NB; ++g) {
+                w32[g] = (const uint32_t *) wb[g];
+                wqh[g] = (const uint32_t *) (wb[g] + (size_t) nblk * 128);   // Q5 only
+                wsc[g] = (const uint32_t *) (wb[g] + (size_t) nblk * (q5w[g] ? 160 : 128));
+                wdm[g] = (const uint32_t *) (wb[g] + (size_t) nblk * (q5w[g] ? 172 : 140));
+            }
+            simd<uint32_t, 16> oq, os, om, oh;
+            {
+                const simd<uint32_t, 16> blk = lane_rows(n0, 0) * (uint32_t) nsb;
+                oq = blk * 128;
+                oh = blk * 32;
+                os = blk * 12;
+                om = blk * 4;
+            }
+            const uint32_t *   pa[MT];
+            const float *      ps[MT];
+            const sycl::half * px[MT];
+#pragma unroll
+            for (int t = 0; t < MT; ++t) {
+                pa[t] = (const uint32_t *) (aq + (size_t) (mt0 + t) * nkg * 256);
+                ps[t] = as + (size_t) (mt0 + t) * nkg;
+                px[t] = xs + (size_t) (mt0 + t) * nkc * 128;
+            }
+
+            for (int sp = 0; sp < nsb; sp += 2) {
+                simd<sycl::half, 256> bmin[NB];
+#pragma unroll
+                for (int e = 0; e < 2; ++e) {
+                    simd<float, 16> scj[NB][8];
+#pragma unroll
+                    for (int g = 0; g < NB; ++g) {
+                        simd<uint32_t, 64> hdr;
+                        hdr.template select<16, 1>(0)  = gather<uint32_t, 16, 1>(wdm[g], om);
+                        hdr.template select<48, 1>(16) = gather<uint32_t, 48, 3>(wsc[g], os);
+                        auto r8 = hdr.template bit_cast_view<uint8_t>();
+                        auto rh = hdr.template bit_cast_view<sycl::half>();
+                        const simd<float, 16> d    = rh.template replicate_vs_w_hs<16, 2, 1, 0>(0);
+                        const simd<float, 16> dmin = rh.template replicate_vs_w_hs<16, 2, 1, 0>(1);
+                        simd<uint16_t, 16> s[12];
+#pragma unroll
+                        for (int bb = 0; bb < 12; ++bb) {
+                            s[bb] = r8.template replicate_vs_w_hs<16, 4, 1, 0>((1 + bb / 4) * 64 + bb % 4);
+                        }
+#pragma unroll
+                        for (int j = 0; j < 8; ++j) {
+                            simd<uint16_t, 16> sj, mj;
+                            if (j < 4) {
+                                sj = s[j] & 63;
+                                mj = s[j + 4] & 63;
+                            } else {
+                                sj = (s[j + 4] & 0xF) | ((s[j - 4] >> 6) << 4);
+                                mj = (s[j + 4] >> 4) | ((s[j] >> 6) << 4);
+                            }
+                            scj[g][j] = d * convert<float>(sj) * ((j & 1) && !q5w[g] ? 1.0f / 16 : 1.0f);
+                            const int jj = 8 * e + j;
+                            const simd<float, 16> mnj = -(dmin * convert<float>(mj));
+                            bmin[g].template select<16, 2>((jj / 2) * 32 + jj % 2) = mnj;
+                        }
+                    }
+                    simd<float, 8> sa[MT];
+#pragma unroll
+                    for (int t = 0; t < MT; ++t) {
+                        sa[t] = block_load<float, 8>(ps[t]);
+                        ps[t] += 8;
+                    }
+                    simd<uint32_t, 128> qb[2][NB];
+                    simd<uint32_t, 128> qh[NB];   // Q5
+#pragma unroll
+                    for (int g = 0; g < NB; ++g) {
+                        qb[0][g] = gather<uint32_t, 128, 8>(w32[g], oq);
+                        if (q5w[g]) {
+                            qh[g] = gather<uint32_t, 128, 8>(wqh[g], oh);
+                        }
+                    }
+#pragma unroll
+                    for (int c = 0; c < 4; ++c) {
+                        if (c < 3) {
+#pragma unroll
+                            for (int g = 0; g < NB; ++g) {
+                                qb[(c + 1) & 1][g] = gather<uint32_t, 128, 8>(w32[g], oq + 32 * (c + 1));
+                            }
+                        }
+#pragma unroll
+                        for (int h = 0; h < 2; ++h) {
+                            const int j = 2 * c + h;
+                            simd<uint32_t, 128> bj[NB];
+#pragma unroll
+                            for (int g = 0; g < NB; ++g) {
+                                if (q5w[g]) {   // nibble | qh bit j at bit 4
+                                    const simd<uint32_t, 128> nib = h ? simd<uint32_t, 128>((qb[c & 1][g] >> 4) & 0x0F0F0F0Fu)
+                                                                      : simd<uint32_t, 128>(qb[c & 1][g] & 0x0F0F0F0Fu);
+                                    const int                 sh  = 4 - j;
+                                    const simd<uint32_t, 128> hb  = sh >= 0 ? simd<uint32_t, 128>(qh[g] << sh)
+                                                                            : simd<uint32_t, 128>(qh[g] >> -sh);
+                                    bj[g] = nib | (hb & 0x10101010u);
+                                } else {
+                                    bj[g] = qb[c & 1][g] & (uint32_t) (h ? 0xF0F0F0F0u : 0x0F0F0F0Fu);
+                                }
+                            }
+                            simd<uint32_t, 64> a[MT];
+#pragma unroll
+                            for (int t = 0; t < MT; ++t) {
+                                a[t] = block_load<uint32_t, 64>(pa[t]);
+                                pa[t] += 64;
+                            }
+#pragma unroll
+                            for (int t = 0; t < MT; ++t) {
+                                const float sv = sa[t][j];
+#pragma unroll
+                                for (int g = 0; g < NB; ++g) {
+                                    simd<int32_t, 128> I = xmx::dpas<8, 8, int32_t, int32_t, uint32_t, uint32_t,
+                                                                     xmx::dpas_argument_type::u8, xmx::dpas_argument_type::s8>(
+                                        magic, bj[g], a[t]);
+                                    const simd<float, 16> S = scj[g][j] * sv;
+                                    i8_acc(acc[g * MT + t], I, S);
+                                    sumS[g * MT + t] += S;
+                                }
+                            }
+                        }
+                    }
+#pragma unroll
+                    for (int i = 0; i < NB * MT; ++i) {
+                        i8_unbias(acc[i], sumS[i]);
+                    }
+                    oq += 128;
+                    oh += 32;
+                    os += 12;
+                    om += 4;
+                }
+#pragma unroll
+                for (int t = 0; t < MT; ++t) {
+                    const simd<sycl::half, 128> xa = block_load<sycl::half, 128>(px[t]);
+                    px[t] += 128;
+#pragma unroll
+                    for (int g = 0; g < NB; ++g) {
+                        acc[g * MT + t] = xmx::dpas<8, 8, float, float, sycl::half, sycl::half>(acc[g * MT + t], bmin[g], xa);
+                    }
+                }
+            }
+            // [8 tokens][16 columns] of silu(gate) * up is one tile of the down gemm's input
+#pragma unroll
+            for (int t = 0; t < MT; ++t) {
+                const simd<float, 128> gv = acc[t];
+                const simd<float, 128> h  = gv * acc[MT + t] / (1.0f + exp(-gv));
+                block_store<sycl::half, 128>(out + ((size_t) (mt0 + t) * (N / 16) + n0 / 16) * 128, simd<sycl::half, 128>(h));
+            }
+        });
+}
+
+// ---- IQ4_XS / IQ4_NL ----------------------------------------------------------------------
+// w in the reorder layout of gemm_iq4_pair: qs[nblk][128] in the pair order (byte 16 ib + p = weights 2p, 2p + 1 of
+// 32-weight block ib, low nibble first) | the header plane (IQ4_XS d | scales_h | scales_l x 4, IQ4_NL the 8 blocks'
+// d, per 256 weights). Weight 32 ib + i is kvalues_iq4nl[nibble] * that block's scale, and the codebook values are s8,
+// so the s8 B operand of block ib is exact: two SLM tables hold every byte's (kv[lo], kv[hi]) pair, one in the low and
+// one in the high half of a dword, and the dword of k 4d..4d+3 is lo[byte 2d] | hi[byte 2d + 1]. The block's scale
+// goes to the epilogue; there is no min term.
+// The lookups bound this kernel (a thread doing all of its own took two sends per dpas and 110 TOPS on the 27B's FFN,
+// with neither the SLM latency nor bank conflicts to blame), so the TT threads of a row group, which need the same B,
+// share them: each decodes 8 / TT of a super-block's blocks into SLM (two buffers, so one barrier per super-block) and
+// all read the whole B back with 512 B block loads: 138 TOPS. Threads past M decode and meet the barriers but compute
+// nothing. PFA as in gemm_i8_q4_K. GLU: the gate (w) and up (w2) weights of one type in one kernel, their A tiles
+// shared, and silu(gate) * up stored as the down gemm's f16 tiles gout [Mp/8][N/16][8][16] (see gemm_i8_glu_q4_K); its
+// two B sets take one buffer and two barriers per super-block, to keep the SLM at 34 KB.
+// K % (256 * KS) == 0, N % (16 * TW) == 0, TT 2 or 4
+template <int TW, int TT, int RAST, bool NL, int MT = 8, int KS = 1, int PFA = 0, bool GLU = false>
+sycl::event gemm_i8_iq4(sycl::queue & q, const uint8_t * w, const int8_t * aq, const float * as, float * dst, int M, int N,
+                         int K, const gemm_epi epi = {}, int gt = 0, const uint8_t * w2 = nullptr, sycl::half * gout = nullptr) {
+    static_assert(I8_MP % (8 * MT * TT) == 0, "a token panel must tile the rows the s8 activations are padded to");
+    static_assert(TT == 2 || TT == 4, "the TT threads of a row group split a super-block's 8 blocks, 32 B chunks each");
+    static_assert(!GLU || KS == 1, "the swiglu store needs whole k");
+    constexpr int      NB   = 1;
+    constexpr int      NW   = GLU ? 2 : 1;   // weights
+    constexpr int      NBUF = GLU ? 1 : 2;   // B buffers
+    constexpr int      SPT  = 8 / TT;       // blocks a thread decodes per super-block
+    constexpr int      HB   = NL ? 16 : 8;   // header bytes per 256 weights
+    constexpr uint32_t BOFF = 2048;          // the B buffers [NBUF][NW][TW][8][512 B], after the two tables
+    const int      nsb  = K / 256;
+    const int      nss  = nsb / KS;
+    const uint32_t nblk = (uint32_t) N * nsb;
+    const int      nkg  = K / 32;
+    const int      gn   = N / (16 * TW);
+    const int      gm   = (M + 8 * MT * TT - 1) / (8 * MT * TT);
+    const int      gs   = gt >= 16 * MT * TT ? gt / (8 * MT * TT) : gt > 0 ? 1 : gm;
+    namespace sx = sycl::ext::oneapi::experimental;
+    sx::properties props{ sycl::ext::intel::experimental::grf_size<GRF> };
+
+    return q.parallel_for(sycl::nd_range<1>(sycl::range<1>((size_t) gn * gm * KS * TW * TT), sycl::range<1>(TW * TT)), props,
+        [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL {
+            slm_init<BOFF + NBUF * NW * TW * 8 * 512>();
+            {
+                simd<int16_t, 16> kv = simd<int16_t, 16>({ -127, -104, -83, -65, -49, -35, -22, -10, 1, 13, 25, 38, 53, 69, 89, 113 });
+                for (int e = (int) it.get_local_id(0) * 16; e < 256; e += TW * TT * 16) {
+                    const simd<uint16_t, 16> i  = simd<uint16_t, 16>(0, 1) + (uint16_t) e;
+                    const simd<int16_t, 16>  lo = kv.iselect(simd<uint16_t, 16>(i & (uint16_t) 15));
+                    const simd<int16_t, 16>  hi = kv.iselect(simd<uint16_t, 16>(i >> 4));
+                    const simd<uint32_t, 16> pr = (simd<uint32_t, 16>(lo) & 0xFFu) | ((simd<uint32_t, 16>(hi) & 0xFFu) << 8);
+                    slm_block_store<uint32_t, 16>(e * 4, pr);
+                    slm_block_store<uint32_t, 16>(1024 + e * 4, simd<uint32_t, 16>(pr << 16));
+                }
+            }
+            barrier();
+            const int lid = (int) it.get_local_id(0);
+            const int rg  = lid % TW;   // row group
+            const int tt  = lid / TW;   // token group, and the blocks this thread decodes
+            int wgk, gni, gmi;
+            i8_panels<RAST, KS>((int) it.get_group(0), gn, gm, gs, wgk, gni, gmi);
+            const int  n0   = (gni * TW + rg) * 16;
+            const int  mt0  = (gmi * TT + tt) * MT;
+            const bool live = mt0 * 8 < M;
+            const int  sb0  = wgk * nss;
+
+            simd<float, 128> acc[NW * MT];   // [weight][token tile]
+            simd<float, 16>  sumS[NW * MT];
+#pragma unroll
+            for (int i = 0; i < NW * MT; ++i) {
+                acc[i]  = 0.0f;
+                sumS[i] = 0.0f;
+            }
+            const simd<int32_t, 128> magic = I8_MAGIC;
+            const uint32_t * w32s[NW];
+            w32s[0] = (const uint32_t *) w;
+            if constexpr (GLU) {
+                w32s[NW - 1] = (const uint32_t *) w2;
+            }
+            simd<uint32_t, 16> ob = lane_rows(n0, 0) * (uint32_t) nsb + (uint32_t) sb0;
+            const uint32_t * pa[MT];
+            const float *    ps[MT];
+#pragma unroll
+            for (int t = 0; t < MT; ++t) {
+                pa[t] = (const uint32_t *) (aq + ((size_t) (mt0 + t) * nkg + sb0 * 8) * 256);
+                ps[t] = as + (size_t) (mt0 + t) * nkg + sb0 * 8;
+            }
+
+            for (int sb = 0; sb < nss; ++sb) {
+                // B of weight v, block ib: bbuf + (v * TW * 8 + ib) * 512
+                const uint32_t bbuf = BOFF + (uint32_t) ((((NBUF == 2 ? (sb & 1) : 0) * NW) * TW + rg) * 8) * 512;
+#pragma unroll
+                for (int v = 0; v < NW; ++v) {   // decode blocks tt * SPT .. of this super-block of weight v
+                    simd<uint32_t, 64 * SPT> qs;   // their 16 SPT bytes per lane, [dword][lane]
+#pragma unroll
+                    for (int c = 0; c < SPT / 2; ++c) {
+                        qs.template select<128, 1>(c * 128) = gather<uint32_t, 128, 8>(w32s[v], ob * 128 + 16 * SPT * tt + 32 * c);
+                    }
+#pragma unroll
+                    for (int ibl = 0; ibl < SPT; ++ibl) {
+                        simd<uint32_t, 128> bj;
+#pragma unroll
+                        for (int mp = 0; mp < 2; ++mp) {   // qs dwords 4 ibl + 2 mp, + 1
+                            simd<uint32_t, 32> X = qs.template select<32, 1>((4 * ibl + 2 * mp) * 16);
+                            const simd<uint32_t, 32> l0 = slm_gather<uint32_t, 32>((X << 2) & 0x3FCu);
+                            const simd<uint32_t, 32> h0 = slm_gather<uint32_t, 32>(((X >> 6) & 0x3FCu) | 0x400u);
+                            const simd<uint32_t, 32> l1 = slm_gather<uint32_t, 32>((X >> 14) & 0x3FCu);
+                            const simd<uint32_t, 32> h1 = slm_gather<uint32_t, 32>(((X >> 22) & 0x3FCu) | 0x400u);
+                            simd<uint32_t, 32>       b0 = l0 | h0;
+                            simd<uint32_t, 32>       b1 = l1 | h1;
+#pragma unroll
+                            for (int u = 0; u < 2; ++u) {
+                                bj.template select<16, 1>((2 * (2 * mp + u)) * 16)     = b0.template select<16, 1>(16 * u);
+                                bj.template select<16, 1>((2 * (2 * mp + u) + 1) * 16) = b1.template select<16, 1>(16 * u);
+                            }
+                        }
+                        slm_block_store<uint64_t, 64>(bbuf + (uint32_t) (v * TW * 8 + tt * SPT + ibl) * 512,
+                                                      bj.template bit_cast_view<uint64_t>());
+                    }
+                }
+                // the super-block's scales, the activation scales and the prefetch, while the others decode
+                simd<float, 16> sc[NW][8];
+#pragma unroll
+                for (int v = 0; v < NW; ++v) {
+                    simd<uint32_t, HB * 4> hdr = gather<uint32_t, HB * 4, HB / 4>(w32s[v], nblk * 128 + ob * HB);
+                    auto rh = hdr.template bit_cast_view<sycl::half>();   // [dword][lane]
+                    if constexpr (NL) {
+#pragma unroll
+                        for (int ib = 0; ib < 8; ++ib) {
+                            sc[v][ib] = rh.template replicate_vs_w_hs<16, 2, 1, 0>((ib / 2) * 32 + ib % 2);
+                        }
+                    } else {
+                        auto                     r8  = hdr.template bit_cast_view<uint8_t>();
+                        auto                     r16 = hdr.template bit_cast_view<uint16_t>();
+                        const simd<float, 16>    d   = rh.template replicate_vs_w_hs<16, 2, 1, 0>(0);
+                        const simd<uint16_t, 16> sh  = r16.template replicate_vs_w_hs<16, 2, 1, 0>(1);
+#pragma unroll
+                        for (int ib = 0; ib < 8; ++ib) {
+                            const simd<uint16_t, 16> sl = r8.template replicate_vs_w_hs<16, 4, 1, 0>(64 + ib / 2);
+                            const simd<uint16_t, 16> ls = ((sl >> (4 * (ib % 2))) & 0xF) | (((sh >> (2 * ib)) & 3) << 4);
+                            sc[v][ib] = d * (convert<float>(ls) - 32.0f);
+                        }
+                    }
+                }
+                ob += 1;
+                if constexpr (PFA > 0) {
+                    const int sbn = sb + PFA;
+                    if (live && sbn < nss) {
+                        namespace esx = sycl::ext::intel::esimd;
+#pragma unroll
+                        for (int t = 0; t < MT; ++t) {
+                            if (t % TW == rg) {
+                                const uint64_t * pf = (const uint64_t *) (aq + ((size_t) (mt0 + t) * nkg + (sb0 + sbn) * 8) * 256);
+#pragma unroll
+                                for (int i = 0; i < 4; ++i) {
+                                    esx::prefetch<uint64_t, 64>(pf + 64 * i, sycl::ext::oneapi::experimental::properties{
+                                        esx::cache_hint_L1<esx::cache_hint::cached>, esx::cache_hint_L2<esx::cache_hint::cached> });
+                                }
+                            }
+                        }
+                    }
+                }
+                barrier();
+                if (live) {
+                    simd<float, 8> sa[MT];
+#pragma unroll
+                    for (int t = 0; t < MT; ++t) {
+                        sa[t] = block_load<float, 8>(ps[t]);
+                        ps[t] += 8;
+                    }
+#pragma unroll
+                    for (int ib = 0; ib < 8; ++ib) {
+                        simd<uint32_t, 128> bj[NW];
+#pragma unroll
+                        for (int v = 0; v < NW; ++v) {
+                            simd<uint64_t, 64> b64 = slm_block_load<uint64_t, 64>(bbuf + (uint32_t) (v * TW * 8 + ib) * 512);
+                            bj[v] = b64.template bit_cast_view<uint32_t>();
+                        }
+                        simd<uint32_t, 64> a[MT];
+#pragma unroll
+                        for (int t = 0; t < MT; ++t) {
+                            a[t] = block_load<uint32_t, 64>(pa[t]);
+                            pa[t] += 64;
+                        }
+#pragma unroll
+                        for (int t = 0; t < MT; ++t) {
+                            const float sv = sa[t][ib];
+#pragma unroll
+                            for (int v = 0; v < NW; ++v) {
+                                simd<int32_t, 128> I = xmx::dpas<8, 8, int32_t, int32_t, uint32_t, uint32_t,
+                                                                 xmx::dpas_argument_type::s8, xmx::dpas_argument_type::s8>(
+                                    magic, bj[v], a[t]);
+                                const simd<float, 16> S = sc[v][ib] * sv;
+                                i8_acc(acc[v * MT + t], I, S);
+                                sumS[v * MT + t] += S;
+                            }
+                        }
+                    }
+#pragma unroll
+                    for (int i = 0; i < NW * MT; ++i) {
+                        i8_unbias(acc[i], sumS[i]);
+                    }
+                }
+                if constexpr (NBUF == 1) {
+                    barrier();   // everyone has read the buffer before the next super-block's decode writes it
+                }
+            }
+            if (live) {
+                if constexpr (GLU) {
+                    // [8 tokens][16 columns] of silu(gate) * up is one tile of the down gemm's input
+#pragma unroll
+                    for (int t = 0; t < MT; ++t) {
+                        const simd<float, 128> gv = acc[t];
+                        const simd<float, 128> h  = gv * acc[MT + t] / (1.0f + exp(-gv));
+                        block_store<sycl::half, 128>(gout + ((size_t) (mt0 + t) * (N / 16) + n0 / 16) * 128, simd<sycl::half, 128>(h));
+                    }
+                } else {
+                    store_split<NB, MT, KS>(acc, dst, epi, wgk, mt0, M, N, n0);
+                }
+            }
+        });
+}
