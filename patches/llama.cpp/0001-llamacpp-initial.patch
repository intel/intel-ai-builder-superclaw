+// Weight side, per expert, swizzled once at load time so that every operand a thread
+// needs is one contiguous block load:
+//   w   u4  [N/16][K/32] blocks of 256 B. Block dword (kq,nn), kq=0..3, nn=0..15, holds
+//           k = kb*32 + kq*8 + j in nibble j - exactly the dpas u4 B operand (K=32,N=16).
+//   sc  f16 [N/16][K/64][16]
+//   zp  u4  [N/16][K/64][8]    (packed along n, even n = low nibble)
+// Activations are pre-packed as dpas A tiles (8 rows x 32 k, 256 B) with every expert's
+// rows starting at a row-block boundary, so one load feeds one dpas.
+
+namespace {
+
+using namespace sycl::ext::intel::esimd;
+namespace xmx = sycl::ext::intel::esimd::xmx;
+
+// NA row tiles of 8 and NB column tiles of 16 per thread, WGM x WGN threads per group.
+// 1x2 x (8x2) measured best on B390 over the real router distributions (one expert can
+// take 12% of the rows): the 32-column tile keeps the dst stores full cache lines, two
+// accumulator tiles keep the register footprint low enough to hide the epilogue, and
+// 8 row tiles per group bound the activation slice a work-group walks.
+constexpr int NA  = 1;
+constexpr int NB  = 2;
+constexpr int WGM = 8;
+constexpr int WGN = 2;
+constexpr int TM  = 8 * NA;
+constexpr int TN  = 16 * NB;
+
+void moe_gemm(const uint8_t * w, const sycl::half * wsc, const uint8_t * wzp,
+              const int8_t * act, const float * asc, const int32_t * asum,
+              const int32_t * offs, const int32_t * pbeg, sycl::half * dst,
+              int E, int P, int N, int K, queue_ptr stream) {
+    const int KB  = K / 32;
+    const int KG  = K / 64;
+    const int nwg = N / (TN * WGN);
+
+    stream->parallel_for(
+        sycl::nd_range<1>(sycl::range<1>((size_t) E * nwg * (WGM * WGN)), sycl::range<1>(WGM * WGN)),
+        [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL {
+            const int wg  = (int) it.get_group(0);
+            const int e   = wg / nwg;
+            const int nb  = wg % nwg;
+            const int lid = (int) it.get_local_id(0);
+
+            const int row_beg = e > 0 ? offs[e - 1] : 0;
+            const int R       = offs[e] - row_beg;
+            const int n0      = (nb * WGN + lid % WGN) * TN;
+            const int arow    = pbeg[e];
+
+            const uint8_t    * we   = w   + (size_t) e * N * K / 2  + (size_t) (n0 / 16) * KB * 256;
+            const sycl::half * wsce = wsc + (size_t) e * KG * N     + (size_t) (n0 / 16) * KG * 16;
+            const uint8_t    * wze  = wzp + (size_t) e * KG * N / 2 + (size_t) (n0 / 16) * KG * 8;
+
+            for (int r0 = (lid / WGN) * TM; r0 < R; r0 += WGM * TM) {
+                simd<float, 128> acc[NA * NB];
+#pragma unroll
+                for (int t = 0; t < NA * NB; ++t) {
+                    acc[t] = 0.0f;
+                }
+
+                for (int g = 0; g < KG; ++g) {
+                    simd<int32_t, 128> c[NA * NB];
+#pragma unroll
+                    for (int t = 0; t < NA * NB; ++t) {
+                        c[t] = 0;
+                    }
+
+#pragma unroll
+                    for (int kk = 0; kk < 2; ++kk) {
+                        const int kb = g * 2 + kk;
+                        simd<int8_t, 256 * NA> a;
+#pragma unroll
+                        for (int ia = 0; ia < NA; ++ia) {
+                            a.template select<256, 1>(ia * 256) = block_load<int8_t, 256>(
+                                act + ((size_t) (arow / 8 + r0 / 8 + ia) * KB + kb) * 256);
+                        }
+#pragma unroll
+                        for (int ib = 0; ib < NB; ++ib) {
+                            const simd<uint8_t, 256> b =
+                                block_load<uint8_t, 256>(we + ((size_t) ib * KB + kb) * 256);
+#pragma unroll
+                            for (int ia = 0; ia < NA; ++ia) {
+                                c[ia * NB + ib] =
+                                    xmx::dpas<8, 8, int32_t, int32_t, uint8_t, int8_t,
+                                              xmx::dpas_argument_type::u4,
+                                              xmx::dpas_argument_type::s8>(
+                                        c[ia * NB + ib], b, a.template select<256, 1>(ia * 256).read());
+                            }
+                        }
+                    }
+
+#pragma unroll
+                    for (int ib = 0; ib < NB; ++ib) {
+                        const simd<float, 16> wsf =
+                            block_load<sycl::half, 16>(wsce + ((size_t) ib * KG + g) * 16);
+                        const simd<uint8_t, 8> zpb =
+                            block_load<uint8_t, 8>(wze + ((size_t) ib * KG + g) * 8, element_aligned);
+                        simd<int32_t, 16> zpv;
+                        zpv.template select<8, 2>(0) = zpb & 0xF;
+                        zpv.template select<8, 2>(1) = zpb >> 4;
+#pragma unroll
+                        for (int ia = 0; ia < NA; ++ia) {
+                            const size_t ai = (size_t) g * P + arow + r0 + ia * 8;
+                            const simd<float, 8>   asv = block_load<float, 8>(asc + ai);
+                            const simd<int32_t, 8> smv = block_load<int32_t, 8>(asum + ai);
+#pragma unroll
+                            for (int i = 0; i < 8; ++i) {
+                                const simd<int32_t, 16> t =
+                                    c[ia * NB + ib].template select<16, 1>(i * 16) - zpv * smv[i];
+                                acc[ia * NB + ib].template select<16, 1>(i * 16) +=
+                                    (asv[i] * wsf) * simd<float, 16>(t);
+                            }
+                        }
+                    }
+                }
+
+#pragma unroll
+                for (int ia = 0; ia < NA; ++ia) {
+#pragma unroll
+                    for (int i = 0; i < 8; ++i) {
+                        const int r = r0 + ia * 8 + i;
+                        if (r >= R) {
+                            break;
+                        }
+#pragma unroll
+                        for (int ib = 0; ib < NB; ++ib) {
+                            const simd<sycl::half, 16> h = acc[ia * NB + ib].template select<16, 1>(i * 16);
+                            block_store<sycl::half, 16>(dst + (size_t) (row_beg + r) * N + n0 + ib * 16, h);
+                        }
+                    }
+                }
+            }
+        });
+}
+
+// gate_up gemm with silu(gate)*up and the down gemm's activation quantization folded into
+// the epilogue: the [n_rows, 2*n_ff] f16 intermediate never reaches memory (67 MB per layer
+// at 2048 tokens). The dpas repeat count is 4 instead of 8, so one thread holds 4 rows x
+// (64 gate + 64 up) columns - a whole 64-element quantization group - and needs no barrier
+// or SLM to find the group amax. GM threads then cover GM*4 rows of one expert.
+constexpr int GM = 16;
+
+void moe_gemm_glu(const uint8_t * w, const sycl::half * wsc, const uint8_t * wzp,
+                  const int8_t * act, const float * asc, const int32_t * asum,
+                  const int32_t * offs, const int32_t * pbeg,
+                  int8_t * q2, float * sc2, int32_t * sum2,
+                  int E, int P, int n_ff, int K, queue_ptr stream) {
+    const int KB  = K / 32;
+    const int KG  = K / 64;
+    const int nwg = n_ff / 64;
+    const int kb2 = n_ff / 32;          // down-side k blocks per row
+
+    stream->parallel_for(
+        sycl::nd_range<1>(sycl::range<1>((size_t) E * nwg * GM), sycl::range<1>(GM)),
+        [=](sycl::nd_item<1> it) SYCL_ESIMD_KERNEL {
+            const int wg  = (int) it.get_group(0);
+            const int e   = wg / nwg;
+            const int c0  = (wg % nwg) * 64;          // first gate column
+            const int tm  = (int) it.get_local_id(0);
+
+            const int row_beg = e > 0 ? offs[e - 1] : 0;
+            const int R       = offs[e] - row_beg;
+            const int arow    = pbeg[e];
+
+            const uint8_t    * we   = w   + (size_t) e * n_ff * K       + (size_t) (c0 / 16) * KB * 256;
+            const sycl::half * wsce = wsc + (size_t) e * KG * 2 * n_ff  + (size_t) (c0 / 16) * KG * 16;
+            const uint8_t    * wze  = wzp + (size_t) e * KG * n_ff      + (size_t) (c0 / 16) * KG * 8;
+            const size_t       up_w  = (size_t) (n_ff / 16) * KB * 256;
+            const size_t       up_sc = (size_t) (n_ff / 16) * KG * 16;
+            const size_t       up_zp = (size_t) (n_ff / 16) * KG * 8;
+
+            for (int r0 = tm * 4; r0 < R; r0 += GM * 4) {
+                simd<float, 64> acc[8];          // 4 gate tiles then 4 up tiles, 4 rows x 16 cols
+#pragma unroll
+                for (int t = 0; t < 8; ++t) {
+                    acc[t] = 0.0f;
+                }
+
+                for (int g = 0; g < KG; ++g) {
+                    simd<int32_t, 64> c[8];
+#pragma unroll
+                    for (int t = 0; t < 8; ++t) {
+                        c[t] = 0;
+                    }
+#pragma unroll
+                    for (int kk = 0; kk < 2; ++kk) {
+                        const int kb = g * 2 + kk;
+                        // rows r0..r0+3 are the first or second half of a packed A tile
+                        const simd<int8_t, 128> a = block_load<int8_t, 128>(
+                            act + ((size_t) ((arow + r0) / 8) * KB + kb) * 256 + ((r0 & 4) ? 128 : 0));
+#pragma unroll
+                        for (int t = 0; t < 8; ++t) {
+                            const simd<uint8_t, 256> b = block_load<uint8_t, 256>(
+                                we + (t >= 4 ? up_w : 0) + ((size_t) (t % 4) * KB + kb) * 256);
+                            c[t] = xmx::dpas<8, 4, int32_t, int32_t, uint8_t, int8_t,
+                                             xmx::dpas_argument_type::u4,
+                                             xmx::dpas_argument_type::s8>(c[t], b, a);
+                        }
+                    }
+                    const size_t ai = (size_t) g * P + arow + r0;
+                    const simd<float, 4>   asv = block_load<float, 4>(asc + ai);
+                    const simd<int32_t, 4> smv = block_load<int32_t, 4>(asum + ai);
+#pragma unroll
+                    for (int t = 0; t < 8; ++t) {
+                        const simd<float, 16> wsf = block_load<sycl::half, 16>(
+                            wsce + (t >= 4 ? up_sc : 0) + ((size_t) (t % 4) * KG + g) * 16);
+                        const simd<uint8_t, 8> zpb = block_load<uint8_t, 8>(
+                            wze + (t >= 4 ? up_zp : 0) + ((size_t) (t % 4) * KG + g) * 8, element_aligned);
+                        simd<int32_t, 16> zpv;
+                        zpv.template select<8, 2>(0) = zpb & 0xF;
+                        zpv.template select<8, 2>(1) = zpb >> 4;
+#pragma unroll
+                        for (int i = 0; i < 4; ++i) {
+                            const simd<int32_t, 16> d =
+                                c[t].template select<16, 1>(i * 16) - zpv * smv[i];
+                            acc[t].template select<16, 1>(i * 16) +=
+                                (asv[i] * wsf) * simd<float, 16>(d);
+                        }
+                    }
+                }
+
+#pragma unroll
+                for (int i = 0; i < 4; ++i) {
+                    if (r0 + i >= R) {
+                        break;
+                    }
+                    simd<float, 64> gv, uv;
+#pragma unroll
+                    for (int t = 0; t < 4; ++t) {
+                        gv.template select<16, 1>(t * 16) = acc[t].template select<16, 1>(i * 16);
+                        uv.template select<16, 1>(t * 16) = acc[4 + t].template select<16, 1>(i * 16);
+                    }
+                    simd<float, 64> v = gv / (1.0f + sycl::ext::intel::esimd::exp(-gv)) * uv;
+                    const float m   = hmax<float>(abs(v));
+                    const float inv = m > 0.0f ? 127.0f / m : 0.0f;
+                    v = v * inv;
+                    v = max(min(v, simd<float, 64>(127.0f)), simd<float, 64>(-127.0f));
+                    simd<int32_t, 64> q = convert<int32_t>(rnde<float>(v));
+                    simd<int8_t, 64>  qb = q;
+                    // explicit tree: esimd::reduce() gave wrong sums for int32 here
+                    simd<int32_t, 32> s32 = q.template select<32, 1>(0) + q.template select<32, 1>(32);
+                    simd<int32_t, 16> s16 = s32.template select<16, 1>(0) + s32.template select<16, 1>(16);
+                    simd<int32_t, 8>  s8v = s16.template select<8, 1>(0) + s16.template select<8, 1>(8);
+                    simd<int32_t, 4>  s4  = s8v.template select<4, 1>(0) + s8v.template select<4, 1>(4);
+                    simd<int32_t, 2>  s2  = s4.template select<2, 1>(0) + s4.template select<2, 1>(2);
+                    const int32_t     qsum = s2[0] + s2[1];
+
+                    const int pr = arow + r0 + i;
+                    int8_t * dst = q2 + ((size_t) (pr / 8) * kb2 + c0 / 32) * 256 + (pr % 8) * 32;
+                    block_store<int8_t, 32>(dst, qb.template select<32, 1>(0).read());
+                    block_store<int8_t, 32>(dst + 256, qb.template select<32, 1>(32).read());
+                    const size_t oi = (size_t) (c0 / 64) * P + pr;
+                    sc2[oi]  = inv > 0.0f ? 1.0f / inv : 0.0f;
+                    sum2[oi] = qsum;
+                }
+            }
+        });
+}
+
+// One sub-group per (16 output columns, k slice): every lane owns one column, so the u4
+// block reads stay 64 B coalesced and there is no cross-lane reduce over columns. K is
+// split SK ways because one sub-group per column tile leaves the device 3/4 idle at
+// decode (8 experts x 32 tiles = 256 sub-groups); the slices meet in SLM.
+template <bool GATED, int SK>
+void moe_gemv(const uint8_t * w, const sycl::half * sc, const uint8_t * zp,
+              const sycl::half * act, sycl::half * out, const int32_t * offs,
+              const int32_t * actives, int n_slots, int64_t N, int64_t K, queue_ptr stream) {
+    constexpr int WS = 16;   // lanes = columns
+    constexpr int RW = 16;   // sub-groups per work-group (RW/SK column tiles)
+    const int64_t n_eff   = GATED ? N / 2 : N;
+    const int64_t n_tiles = n_eff / WS;
+    const int64_t KB      = K / 32;
+    const int64_t KG      = K / 64;
+    const int64_t kg_sl   = KG / SK;   // groups per slice
+
+    const size_t total  = (size_t) n_slots * n_tiles * SK * WS;
+    const size_t global = (total + WS * RW - 1) / (WS * RW) * (WS * RW);
+
+    stream->submit([&](sycl::handler & cgh) {
+        sycl::local_accessor<float, 1>    red(sycl::range<1>(2 * RW * WS), cgh);
+        // one 256 B block staged per sub-group: the global read becomes 16 B per lane
+        // (one 256 B request) instead of four 64 B requests, then SLM hands each lane the
+        // 4 dwords of its own column
+        sycl::local_accessor<uint32_t, 1> stg(sycl::range<1>(2 * RW * 64), cgh);
+        cgh.parallel_for(
+            sycl::nd_range<1>(sycl::range<1>(global), sycl::range<1>(WS * RW)),
+            [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(WS)]] {
+                const int64_t gid  = it.get_global_id(0);
+                const int     lid  = (int) it.get_local_id(0);
+                const int     lane = lid % WS;
+                const int     sgid = lid / WS;
+                const int64_t nblk = gid / (SK * WS);       // column tile of one expert
+                const int     sl   = (int) ((gid / WS) % SK);
+                const int64_t slot = nblk / n_tiles;
+                const int64_t tile = nblk % n_tiles;
+
+                float acc_g = 0.0f;
+                float acc_u = 0.0f;
+                const int  e       = gid < total && slot < actives[0] ? actives[1 + slot] : -1;
+                const int  row_beg = e > 0 ? offs[e - 1] : 0;
+                const bool live    = e >= 0 && offs[e] - row_beg > 0;
+                if (live) {
+                    const uint32_t   * wg  = (const uint32_t *) (w + (size_t) e * N * (K / 2)) + tile * KB * 64;
+                    const uint32_t   * wu  = wg + (n_eff / 16) * KB * 64;
+                    const sycl::half * scg = sc + (size_t) e * KG * N + tile * KG * 16;
+                    const sycl::half * scu = scg + (n_eff / 16) * KG * 16;
+                    const uint8_t    * zpg = zp + (size_t) e * KG * N / 2 + tile * KG * 8;
+                    const uint8_t    * zpu = zpg + (n_eff / 16) * KG * 8;
+                    const sycl::half * xr  = act + (size_t) row_beg * K;
+
+                    for (int64_t g = sl * kg_sl; g < (sl + 1) * kg_sl; ++g) {
+                        float wxg = 0.0f, wxu = 0.0f, xs = 0.0f;
+#pragma unroll
+                        for (int kk = 0; kk < 2; ++kk) {
+                            const int64_t kb = g * 2 + kk;
+                            const sycl::uint4 bg = *(const sycl::uint4 *) (wg + kb * 64 + lane * 4);
+                            sycl::uint4       bu = {};
+                            if (GATED) {
+                                bu = *(const sycl::uint4 *) (wu + kb * 64 + lane * 4);
+                            }
+                            // lanes read each other's dwords below: all reads of the previous
+                            // block must be done before it is overwritten
+                            sycl::group_barrier(it.get_sub_group());
+#pragma unroll
+                            for (int j = 0; j < 4; ++j) {
+                                stg[sgid * 64 + lane * 4 + j] = bg[j];
+                            }
+                            if (GATED) {
+#pragma unroll
+                                for (int j = 0; j < 4; ++j) {
+                                    stg[RW * 64 + sgid * 64 + lane * 4 + j] = bu[j];
+                                }
+                            }
+                            sycl::group_barrier(it.get_sub_group());
+#pragma unroll
+                            for (int kq = 0; kq < 4; ++kq) {
+                                const uint32_t dg = stg[sgid * 64 + kq * 16 + lane];
+                                const uint32_t du = GATED ? stg[RW * 64 + sgid * 64 + kq * 16 + lane] : 0;
+                                const sycl::vec<sycl::half, 8> xv =
+                                    *(const sycl::vec<sycl::half, 8> *) (xr + kb * 32 + kq * 8);
+#pragma unroll
+                                for (int j = 0; j < 8; ++j) {
+                                    const float x = (float) xv[j];
+                                    xs  += x;
+                                    wxg += (float) ((dg >> (4 * j)) & 0xF) * x;
+                                    if (GATED) {
+                                        wxu += (float) ((du >> (4 * j)) & 0xF) * x;
+                                    }
+                                }
+                            }
+                        }
+                        const uint8_t zbg = zpg[g * 8 + lane / 2];
+                        const int     zvg = (lane & 1) ? (zbg >> 4) : (zbg & 0xF);
+                        acc_g += (float) scg[g * 16 + lane] * (wxg - (float) zvg * xs);
+                        if (GATED) {
+                            const uint8_t zbu = zpu[g * 8 + lane / 2];
+                            const int     zvu = (lane & 1) ? (zbu >> 4) : (zbu & 0xF);
+                            acc_u += (float) scu[g * 16 + lane] * (wxu - (float) zvu * xs);
+                        }
+                    }
+                }
+
+                red[sgid * WS + lane]           = acc_g;
+                red[RW * WS + sgid * WS + lane] = acc_u;
+                it.barrier(sycl::access::fence_space::local_space);
+                if (sl != 0 || !live) {
+                    return;
+                }
+                for (int s = 1; s < SK; ++s) {
+                    acc_g += red[(sgid + s) * WS + lane];
+                    if (GATED) {
+                        acc_u += red[RW * WS + (sgid + s) * WS + lane];
+                    }
+                }
+                const int64_t col = tile * WS + lane;
+                if (GATED) {
+                    out[(size_t) row_beg * n_eff + col] =
+                        (sycl::half) (acc_g / (1.0f + sycl::exp(-acc_g)) * acc_u);
+                } else {
+                    out[(size_t) row_beg * n_eff + col] = (sycl::half) acc_g;
+                }
+            });
+    });
+}
