+// y[row] = sum_g sc[g*N + row] * sum_{k in g} (u4(w[row,k]) - zp[g,row]) * x[k]
+// one subgroup per row; lane t owns CHUNK packed weights per iteration (one wide
+// load), 32-aligned so they never straddle a quant group: scale/zp are per-lane
+// uniform. CHUNK 32 = one uint4 (16B) weight load per lane per iteration.
+template <int CHUNK>
+static void mul_mat_vec_u4_kern(const uint8_t * w, const sycl::half * sc, const uint8_t * zp,
+                                const float * x, float * y, const int K, const int N,
+                                const int gshift, queue_ptr stream) {
+    constexpr int WS = 16;
+    constexpr int RW = 16;
+    const int n_wg = (N + RW - 1) / RW;
+    stream->parallel_for(
+        sycl::nd_range<1>(sycl::range<1>((size_t) n_wg * WS * RW), sycl::range<1>(WS * RW)),
+        [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(WS)]] {
+            const int row  = it.get_group(0) * RW + it.get_local_id(0) / WS;
+            const int lane = it.get_local_id(0) % WS;
+            if (row >= N) {
+                return;
+            }
+            const uint8_t * wr = w + (size_t) row * (K / 2);
+            float acc = 0.0f;
+            for (int k0 = 0; k0 < K; k0 += WS * CHUNK) {
+                const int k = k0 + lane * CHUNK;
+                const int64_t  gi = (int64_t) (k >> gshift) * N + row;
+                const float    scale = (float) sc[gi];
+                const uint8_t  zb = zp[gi >> 1];
+                const int      zv = (gi & 1) ? (zb >> 4) : (zb & 0xF);
+                float part = 0.0f;
+                sycl::uint4 bq;
+                if constexpr (CHUNK == 32) {
+                    bq = *reinterpret_cast<const sycl::uint4 *>(wr + (k >> 1));
+                }
+#pragma unroll
+                for (int c = 0; c < CHUNK / 8; ++c) {
+                    const uint32_t bv = CHUNK == 32 ? bq[c]
+                                                    : *reinterpret_cast<const uint32_t *>(wr + (k >> 1) + 4 * c);
+                    const sycl::float4 xa = *reinterpret_cast<const sycl::float4 *>(x + k + 8 * c);
+                    const sycl::float4 xb = *reinterpret_cast<const sycl::float4 *>(x + k + 8 * c + 4);
+#pragma unroll
+                    for (int j = 0; j < 4; ++j) {
+                        part += (float) ((int) ((bv >> (4 * j)) & 0xF) - zv) * xa[j];
+                        part += (float) ((int) ((bv >> (4 * (j + 4))) & 0xF) - zv) * xb[j];
+                    }
+                }
+                acc += scale * part;
+            }
+            acc = sycl::reduce_over_group(it.get_sub_group(), acc, sycl::plus<float>());
+            if (lane == 0) {
+                y[row] = acc;
+            }
+        });
+}
