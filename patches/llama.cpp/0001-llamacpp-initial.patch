+
+bool llama_context::state_copy_async(const std::vector<llama_state_copy> & copies) {
+    GGML_ASSERT(!state_worker.joinable());
+
+    if (copies.empty()) {
+        return true;
+    }
+
+    ggml_backend_dev_t dev = nullptr;
+    size_t total = 0;
+    for (const auto & c : copies) {
+        ggml_backend_buffer_t      buf  = c.tensor->view_src ? c.tensor->view_src->buffer : c.tensor->buffer;
+        ggml_backend_buffer_type_t buft = ggml_backend_buffer_get_type(buf);
+        ggml_backend_dev_t         d    = ggml_backend_buft_get_device(buft);
+        if (d == nullptr || ggml_backend_buffer_is_host(buf) || buft != ggml_backend_dev_buffer_type(d) || (dev != nullptr && d != dev)) {
+            return false;
+        }
+        dev    = d;
+        total += c.size;
+    }
+
+    ggml_backend_t backend = nullptr;
+    for (const auto & b : backends) {
+        if (ggml_backend_get_device(b.get()) == dev) {
+            backend = b.get();
+            break;
+        }
+    }
+
+    ggml_backend_dev_props props;
+    ggml_backend_dev_get_props(dev, &props);
+
+    ggml_backend_buffer_type_t buft_host = ggml_backend_dev_host_buffer_type(dev);
+    if (backend == nullptr || !props.caps.async || !props.caps.events || buft_host == nullptr) {
+        return false;
+    }
+
+    if (state_event_dev != dev) {
+        state_event.reset(ggml_backend_event_new(dev));
+        state_event_dev = state_event ? dev : nullptr;
+        if (!state_event) {
+            return false;
+        }
+    }
+
+    if (!state_stage || ggml_backend_buffer_get_type(state_stage.get()) != buft_host || ggml_backend_buffer_get_size(state_stage.get()) < total) {
+        state_stage.reset();
+        state_stage.reset(ggml_backend_buft_alloc_buffer(buft_host, total));
+        if (!state_stage) {
+            return false;
+        }
+        LLAMA_LOG_INFO("%s: %10s state staging buffer size = %8.2f MiB\n", __func__,
+                ggml_backend_buffer_name(state_stage.get()), ggml_backend_buffer_get_size(state_stage.get()) / 1024.0 / 1024.0);
+    }
+
+    struct host_copy {
+        uint8_t       * dst;
+        const uint8_t * src;
+        size_t          size;
+    };
+
+    std::vector<host_copy> host_copies;
+    host_copies.reserve(copies.size());
+
+    uint8_t * stage = (uint8_t *) ggml_backend_buffer_get_base(state_stage.get());
+    for (const auto & c : copies) {
+        ggml_backend_tensor_get_async(backend, c.tensor, stage, c.offset, c.size);
+        host_copies.push_back({ c.dst, stage, c.size });
+        stage += c.size;
+    }
+    ggml_backend_event_record(state_event.get(), backend);
+
+    // the device copies land in the staging memory in queue order, after the computations queued so far
+    state_worker = std::thread([ev = state_event.get(), host_copies = std::move(host_copies)]() {
+        ggml_backend_event_synchronize(ev);
+        for (const auto & h : host_copies) {
+            memcpy(h.dst, h.src, h.size);
+        }
+    });
+
+    return true;
+}
