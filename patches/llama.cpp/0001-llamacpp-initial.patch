index 0000000000000000000000000000000000000000..97ae3c7849b447d30815f6b3cbab8f0f0e2c6e2e
--- /dev/null
+++ b/ggml/src/ggml-sycl/mmid.cpp
@@ -0,0 +1,39 @@
+#include "mmid.hpp"
+
+// One work-item per expert. First pass counts how many routed (token, used-expert) pairs belong
+// to lower-indexed experts (that is this expert's start offset); second pass writes this expert's
+// compact slice. The rows within an expert keep (token, iex) ascending order, matching the host
+// counting-sort this replaces. Cheap routing metadata, so a simple per-expert scan is used rather
+// than the warp-cooperative form in ggml-cuda.
+void ggml_sycl_launch_mm_ids_helper(
+    ggml_backend_sycl_context & ctx,
+    const int32_t * ids, int32_t * ids_src1, int32_t * ids_dst, int32_t * expert_bounds,
+    int n_experts, int n_tokens, int n_expert_used, int nchannels_y, int si1, int sis1) {
+
+    ctx.stream()->parallel_for(sycl::range<1>(n_experts), [=](sycl::id<1> idx) {
+        const int expert = (int) idx[0];
+
+        int nex_prev = 0;
+        for (int it = 0; it < n_tokens; ++it) {
+            for (int iex = 0; iex < n_expert_used; ++iex) {
+                nex_prev += ids[it * si1 + iex] < expert;
+            }
+        }
+
+        int cnt = 0;
+        for (int it = 0; it < n_tokens; ++it) {
+            for (int iex = 0; iex < n_expert_used; ++iex) {
+                if (ids[it * si1 + iex] == expert) {
+                    ids_src1[nex_prev + cnt] = it * sis1 + iex % nchannels_y;
+                    ids_dst [nex_prev + cnt] = it * n_expert_used + iex;
+                    ++cnt;
+                }
+            }
+        }
+
+        expert_bounds[expert] = nex_prev;
+        if (expert == n_experts - 1) {
+            expert_bounds[n_experts] = nex_prev + cnt;
+        }
+    });
+}
