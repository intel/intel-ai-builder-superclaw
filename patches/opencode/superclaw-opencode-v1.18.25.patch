+  test("no anchor before any real measurement exists", () => {
+    expect(LLMRouterLocalContext.anchorFor("ses_anchor_a")).toBeUndefined()
+    expect(LLMRouterLocalContext.estimate("ses_anchor_a", localModel, 1000)).toBe(1000)
+  })
+
+  test("anchors the next estimate on the real prompt size plus the raw delta", () => {
+    LLMRouterLocalContext.noteRequestEstimate("ses_anchor_b", localModel, 1000)
+    LLMRouterLocalContext.noteRealUsage("ses_anchor_b", localModel, usageTokens(1270))
+    expect(LLMRouterLocalContext.anchorFor("ses_anchor_b")).toEqual({ real: 1270, raw: 1000 })
+    // The next request grew by 500 raw tokens: real 1270 + delta 500 = 1770,
+    // not the from-scratch 1500.
+    expect(LLMRouterLocalContext.estimate("ses_anchor_b", localModel, 1500)).toBe(1770)
+  })
+
+  test("real prompt tokens include cache read/write, not just `input`", () => {
+    LLMRouterLocalContext.noteRequestEstimate("ses_anchor_c", localModel, 1000)
+    LLMRouterLocalContext.noteRealUsage("ses_anchor_c", localModel, usageTokens(1000, { read: 200, write: 70 }))
+    expect(LLMRouterLocalContext.anchorFor("ses_anchor_c")).toEqual({ real: 1270, raw: 1000 })
+  })
+
+  test("re-anchors on every completed step so it tracks content drift", () => {
+    LLMRouterLocalContext.noteRequestEstimate("ses_anchor_d", localModel, 1000)
+    LLMRouterLocalContext.noteRealUsage("ses_anchor_d", localModel, usageTokens(3000)) // real 3x raw
+    expect(LLMRouterLocalContext.estimate("ses_anchor_d", localModel, 1200)).toBe(3200)
+    LLMRouterLocalContext.noteRequestEstimate("ses_anchor_d", localModel, 1200)
+    LLMRouterLocalContext.noteRealUsage("ses_anchor_d", localModel, usageTokens(1400)) // re-anchor
+    expect(LLMRouterLocalContext.anchorFor("ses_anchor_d")).toEqual({ real: 1400, raw: 1200 })
+    expect(LLMRouterLocalContext.estimate("ses_anchor_d", localModel, 1600)).toBe(1800)
+  })
+
+  test("a shrinking request (compaction/revert) drops the anchor and falls back to raw", () => {
+    LLMRouterLocalContext.noteRequestEstimate("ses_anchor_e", localModel, 5000)
+    LLMRouterLocalContext.noteRealUsage("ses_anchor_e", localModel, usageTokens(6000))
+    expect(LLMRouterLocalContext.estimate("ses_anchor_e", localModel, 2000)).toBe(2000)
+    expect(LLMRouterLocalContext.anchorFor("ses_anchor_e")).toBeUndefined()
+    // ...and re-anchors cleanly on the next completed step.
+    LLMRouterLocalContext.noteRequestEstimate("ses_anchor_e", localModel, 2000)
+    LLMRouterLocalContext.noteRealUsage("ses_anchor_e", localModel, usageTokens(2600))
+    expect(LLMRouterLocalContext.estimate("ses_anchor_e", localModel, 2200)).toBe(2800)
+  })
+
+  test("resetAnchor invalidates explicitly", () => {
+    LLMRouterLocalContext.noteRequestEstimate("ses_anchor_f", localModel, 1000)
+    LLMRouterLocalContext.noteRealUsage("ses_anchor_f", localModel, usageTokens(1270))
+    LLMRouterLocalContext.resetAnchor("ses_anchor_f")
+    expect(LLMRouterLocalContext.anchorFor("ses_anchor_f")).toBeUndefined()
+    expect(LLMRouterLocalContext.estimate("ses_anchor_f", localModel, 1500)).toBe(1500)
+  })
+
+  test("noteRealUsage with no matching pending estimate is a no-op", () => {
+    LLMRouterLocalContext.noteRealUsage("ses_anchor_g", localModel, usageTokens(5000))
+    expect(LLMRouterLocalContext.anchorFor("ses_anchor_g")).toBeUndefined()
+  })
+
+  test("non-local models: noteRequestEstimate/noteRealUsage are no-ops, estimate is identity", () => {
+    LLMRouterLocalContext.noteRequestEstimate("ses_anchor_h", cloudModel, 1000)
+    LLMRouterLocalContext.noteRealUsage("ses_anchor_h", cloudModel, usageTokens(5000))
+    expect(LLMRouterLocalContext.anchorFor("ses_anchor_h")).toBeUndefined()
+    expect(LLMRouterLocalContext.estimate("ses_anchor_h", cloudModel, 1000)).toBe(1000)
+  })
+
+  test("anchor state stays bounded across many distinct sessions", () => {
+    for (let i = 0; i < 1_050; i++) {
+      const sessionID = `ses_anchor_bound_${i}`
+      LLMRouterLocalContext.noteRequestEstimate(sessionID, localModel, 1000)
+      LLMRouterLocalContext.noteRealUsage(sessionID, localModel, usageTokens(1500))
+    }
+    expect(LLMRouterLocalContext.anchorFor("ses_anchor_bound_1049")).toEqual({ real: 1500, raw: 1000 })
+  })
+})
