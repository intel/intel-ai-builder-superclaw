diff --git a/packages/core/test/token.test.ts b/packages/core/test/token.test.ts
new file mode 100644
index 000000000..03a7b2394
--- /dev/null
+++ b/packages/core/test/token.test.ts
@@ -0,0 +1,156 @@
+import { afterEach, describe, expect, test } from "bun:test"
+import { Token } from "../src/util/token"
+
+const text = "x".repeat(1200)
+
+describe("Token.estimate", () => {
+  afterEach(() => {
+    Token.register(undefined)
+  })
+
+  test("prose default stays at 4 chars per token", () => {
+    expect(Token.estimate(text)).toBe(300)
+    expect(Token.estimate("")).toBe(0)
+  })
+
+  test("format tags select the measured density", () => {
+    expect(Token.estimate(text, "csv")).toBe(Math.round(1200 / 1.3))
+    expect(Token.estimate(text, "tsv")).toBe(Math.round(1200 / 1.3))
+    expect(Token.estimate(text, "json")).toBe(800)
+    expect(Token.estimate(text, "ndjson")).toBe(800)
+    expect(Token.estimate(text, "jsonl")).toBe(800)
+    expect(Token.estimate(text, "log")).toBe(600)
+  })
+
+  test("filenames derive the hint from their extension", () => {
+    expect(Token.estimate(text, "data/report.CSV")).toBe(Math.round(1200 / 1.3))
+    expect(Token.estimate(text, "server.log")).toBe(600)
+    expect(Token.estimate(text, "payload.json")).toBe(800)
+  })
+
+  test("unknown hints fall back to the prose default", () => {
+    expect(Token.estimate(text, "notes.md")).toBe(300)
+    expect(Token.estimate(text, "Makefile")).toBe(300)
+    expect(Token.estimate(text, "weird")).toBe(300)
+  })
+
+  test("a registered estimator wins and can be cleared", () => {
+    const seen: Array<{ length: number; hint?: string }> = []
+    Token.register((input, hint) => {
+      seen.push({ length: input.length, hint })
+      return 42.4
+    })
+    expect(Token.estimate(text, "csv")).toBe(42)
+    expect(seen).toEqual([{ length: 1200, hint: "csv" }])
+    Token.register(undefined)
+    expect(Token.estimate(text, "csv")).toBe(Math.round(1200 / 1.3))
+  })
+
+  test("hasInstalledEstimator reflects register()/register(undefined)", () => {
+    expect(Token.hasInstalledEstimator()).toBe(false)
+    Token.register(() => 1)
+    expect(Token.hasInstalledEstimator()).toBe(true)
+    Token.register(undefined)
+    expect(Token.hasInstalledEstimator()).toBe(false)
+  })
+})
+
+describe("Token.estimateSymDig", () => {
+  test("pure prose falls back to chars/4, same as the default density", () => {
+    expect(Token.estimateSymDig(text)).toBe(300)
+  })
+
+  test("digits alone use the 0.803 tokens-per-char coefficient", () => {
+    const digits = "0".repeat(1000)
+    expect(Token.estimateSymDig(digits)).toBe(Math.round(1000 * 0.8030572147361226))
+  })
+
+  test("ASCII symbols get no special coefficient and fall back to chars/4", () => {
+    const symbols = "!".repeat(1000)
+    expect(Token.estimateSymDig(symbols)).toBe(Math.round(1000 / 4))
+  })
+
+  test("mixes digit and prose buckets (symbols count as prose) in one pass", () => {
+    const input = "12" + "!!" + "ab"
+    const expected = 2 * 0.8030572147361226 + 4 / 4
+    expect(Token.estimateSymDig(input)).toBe(Math.round(expected))
+  })
+
+  test("CJK Unified Ideographs use the 0.663 tokens-per-char coefficient", () => {
+    const cjk = "设计文档章节内容"
+    expect(Token.estimateSymDig(cjk)).toBe(Math.round(cjk.length * 0.6627122076124944))
+  })
+
+  test("other non-ASCII content (outside the CJK range) stays in the chars/4 fallback bucket", () => {
+    const other = "café naïve"
+    expect(Token.estimateSymDig(other)).toBe(Math.round(other.length / 4))
+  })
+
+  test("empty input is zero", () => {
+    expect(Token.estimateSymDig("")).toBe(0)
+  })
+
+  test("ASCII punctuation across all former symbol ranges falls back to chars/4", () => {
+    const ranges = "!\"#$%&'()*+,-./" + ":;<=>?@" + "[\\]^_`" + "{|}~"
+    expect(Token.estimateSymDig(ranges)).toBe(Math.round(ranges.length / 4))
+  })
+})
+
+describe("Token.estimateText", () => {
+  afterEach(() => {
+    Token.register(undefined)
+  })
+
+  test("uses the symbol/digit heuristic when no exact tokenizer is installed", () => {
+    const digits = "0".repeat(1000)
+    expect(Token.estimateText(digits)).toBe(Token.estimateSymDig(digits))
+  })
+
+  test("an installed exact tokenizer wins over the symbol/digit heuristic", () => {
+    Token.register(() => 7)
+    expect(Token.estimateText("0".repeat(1000))).toBe(7)
+  })
+})
+
+describe("Token.estimateJSON", () => {
+  afterEach(() => {
+    Token.register(undefined)
+  })
+
+  test("serializes the value and estimates the same as estimateText on its JSON", () => {
+    const value = { a: 1, b: ["x", "y"] }
+    expect(Token.estimateJSON(value)).toBe(Token.estimateText(JSON.stringify(value)))
+  })
+
+  test("returns 0 for undefined instead of degrading to the string 'undefined'", () => {
+    expect(Token.estimateJSON(undefined)).toBe(0)
+  })
+
+  test("falls back to String(value) instead of re-throwing on a circular reference", () => {
+    const circular: Record<string, unknown> = { a: 1 }
+    circular.self = circular
+    // JSON.stringify(circular) throws; String(circular) is "[object Object]" and never throws.
+    expect(Token.estimateJSON(circular)).toBe(Token.estimateText(String(circular)))
+  })
+
+  test("falls back to String(value) instead of re-throwing on a BigInt field", () => {
+    const value = { big: 10n }
+    expect(Token.estimateJSON(value)).toBe(Token.estimateText(String(value)))
+  })
+
+  test("returns 0 instead of re-throwing when String(value) also fails (circular null-prototype object)", () => {
+    const circular: Record<string, unknown> = Object.create(null)
+    circular.self = circular
+    // JSON.stringify throws (circular), and String() throws too: a null-prototype
+    // object has no toString to fall back on.
+    expect(() => String(circular)).toThrow()
+    expect(Token.estimateJSON(circular)).toBe(0)
+  })
+
+  test("an installed exact tokenizer is still used on the fallback path", () => {
+    Token.register(() => 9)
+    const circular: Record<string, unknown> = {}
+    circular.self = circular
+    expect(Token.estimateJSON(circular)).toBe(9)
+  })
+})
