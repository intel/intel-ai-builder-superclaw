new file mode 100644
index 000000000..6bf32c060
--- /dev/null
+++ b/packages/opencode/src/session/search.ts
@@ -0,0 +1,183 @@
+import { Database } from "@opencode-ai/core/database/database"
+import { ProjectTable } from "@opencode-ai/core/project/sql"
+import { NonNegativeInt, optional } from "@opencode-ai/core/schema"
+import { PartTable, SessionTable } from "@opencode-ai/core/session/sql"
+import { and, desc, eq, inArray, isNull, sql } from "drizzle-orm"
+import type { SQL } from "drizzle-orm"
+import { Effect, Schema, Types } from "effect"
+import { MessageID, SessionID } from "./schema"
+import { fromRow, GlobalInfo, type ProjectInfo } from "./session"
+
+type SessionRow = typeof SessionTable.$inferSelect
+
+export const MessageMatch = Schema.Struct({
+  id: MessageID,
+  /** The session holding the message. With `roots`, this can be a subagent session under the hit. */
+  sessionID: SessionID,
+  snippet: Schema.String,
+  time: NonNegativeInt,
+}).annotate({ identifier: "SessionSearchMessageMatch" })
+export type MessageMatch = Types.DeepMutable<Schema.Schema.Type<typeof MessageMatch>>
+
+export const Match = Schema.Struct({
+  title: Schema.Boolean,
+  message: optional(MessageMatch),
+}).annotate({ identifier: "SessionSearchMatch" })
+
+export const Hit = Schema.Struct({
+  ...GlobalInfo.fields,
+  match: Match,
+}).annotate({ identifier: "SessionSearchHit" })
+export type Hit = Types.DeepMutable<Schema.Schema.Type<typeof Hit>>
+
+export type Input = {
+  query: string
+  directory?: string
+  roots?: boolean
+  archived?: boolean
+  limit?: number
+}
+
+const SNIPPET_RADIUS = 80
+export const DEFAULT_LIMIT = 50
+export const MAX_LIMIT = 200
+
+// Matching is SQLite LIKE, which folds case for ASCII letters only: "é" does not
+// match "É". Scripts without case, such as Chinese, are unaffected.
+export const search = Effect.fn("SessionSearch.search")(function* (input: Input) {
+  const query = input.query.trim()
+  if (query === "") return [] as Hit[]
+
+  const { db } = yield* Database.Service
+  const pattern = `%${escapeLike(query)}%`
+  const scope: SQL[] = []
+  if (input.directory) scope.push(eq(SessionTable.directory, input.directory))
+  if (input.roots) scope.push(isNull(SessionTable.parent_id))
+  if (!input.archived) scope.push(isNull(SessionTable.time_archived))
+
+  // Maps each session to the session its matches are credited to. With `roots`,
+  // subagent output lives in child sessions, so their matches go to the root
+  // chat the user would open; otherwise every session owns its own matches.
+  const lineage = db
+    .$with("lineage", { id: sql<string>`id`.as("id"), rootID: sql<string>`root_id`.as("root_id") })
+    .as(
+      input.roots
+        ? sql`select ${SessionTable.id} as id, ${SessionTable.id} as root_id from ${SessionTable} where ${SessionTable.parent_id} is null
+            union all
+            select ${SessionTable.id}, lineage.root_id from ${SessionTable} join lineage on ${SessionTable.parent_id} = lineage.id`
+        : sql`select ${SessionTable.id} as id, ${SessionTable.id} as root_id from ${SessionTable}`,
+    )
+
+  // Every session in scope is scanned. This CTE keeps only the newest matching
+  // text part per credited session, so a session with many matches costs one
+  // row, and `limit` trims the page in SQL without narrowing the scan.
+  // Synthetic and ignored parts (attached file contents, reminders, compaction
+  // follow-ups) are never shown to the user, so a hit there would point at text
+  // the opened chat does not display.
+  const text = sql<string>`json_extract(${PartTable.data}, '$.text')`
+  const newest = db.$with("newest").as(
+    db
+      .select({
+        ownerID: sql<string>`${lineage.rootID}`.as("owner_id"),
+        sessionID: PartTable.session_id,
+        messageID: PartTable.message_id,
+        text: text.as("text"),
+        time: PartTable.time_created,
+        rank: sql<number>`row_number() over (partition by ${lineage.rootID} order by ${PartTable.time_created} desc, ${PartTable.id} desc)`.as(
+          "rank",
+        ),
+      })
+      .from(PartTable)
+      .innerJoin(lineage, eq(lineage.id, PartTable.session_id))
+      .where(
+        and(
+          sql`json_extract(${PartTable.data}, '$.type') = 'text'`,
+          sql`coalesce(json_extract(${PartTable.data}, '$.synthetic'), 0) = 0`,
+          sql`coalesce(json_extract(${PartTable.data}, '$.ignored'), 0) = 0`,
+          sql`${text} LIKE ${pattern} ESCAPE '\\'`,
+        ),
+      ),
+  )
+  const titleMatch = sql<number>`${SessionTable.title} LIKE ${pattern} ESCAPE '\\'`
+  const rows = yield* db
+    .with(lineage, newest)
+    .select({
+      session: SessionTable,
+      titleMatch: titleMatch.as("title_match"),
+      messageSessionID: newest.sessionID,
+      messageID: newest.messageID,
+      text: newest.text,
+      time: newest.time,
+    })
+    .from(SessionTable)
+    .leftJoin(newest, and(eq(newest.ownerID, SessionTable.id), eq(newest.rank, 1)))
+    .where(and(sql`(${newest.ownerID} IS NOT NULL OR ${titleMatch})`, ...scope))
+    .orderBy(desc(SessionTable.time_updated), desc(SessionTable.id))
+    .limit(clampLimit(input.limit))
+    .all()
+    .pipe(Effect.orDie)
+  const projects = yield* lookupProjects(
+    db,
+    rows.map((row) => row.session),
+  )
+
+  return rows.map((row) => ({
+    ...fromRow(row.session),
+    project: projects.get(row.session.project_id) ?? null,
+    match: {
+      title: Boolean(row.titleMatch),
+      ...(row.messageID && row.messageSessionID && row.time !== null
+        ? {
+            message: {
+              id: row.messageID,
+              sessionID: row.messageSessionID,
+              snippet: snippet(row.text ?? "", query),
+              time: row.time,
+            },
+          }
+        : {}),
+    },
+  })) as Hit[]
+})
+
+const lookupProjects = Effect.fnUntraced(function* (db: Database.Interface["db"], rows: SessionRow[]) {
+  const projects = new Map<string, ProjectInfo>()
+  const ids = [...new Set(rows.map((row) => row.project_id))]
+  if (ids.length === 0) return projects
+  const items = yield* db
+    .select({ id: ProjectTable.id, name: ProjectTable.name, worktree: ProjectTable.worktree })
+    .from(ProjectTable)
+    .where(inArray(ProjectTable.id, ids))
+    .all()
+    .pipe(Effect.orDie)
+  for (const item of items) {
+    projects.set(item.id, { id: item.id, name: item.name ?? undefined, worktree: item.worktree })
+  }
+  return projects
+})
+
+/** Escapes the wildcards LIKE would otherwise interpret, so a query matches literally. */
+function escapeLike(value: string) {
+  return value.replace(/[\\%_]/g, (char) => `\\${char}`)
+}
+
+/** Bounds the page; a missing, negative or oversized `limit` never returns an unbounded list. */
+function clampLimit(limit: number | undefined) {
+  if (limit === undefined || !Number.isFinite(limit)) return DEFAULT_LIMIT
+  return Math.min(Math.max(Math.trunc(limit), 0), MAX_LIMIT)
+}
+
+/** Lowercases A-Z only, mirroring LIKE, so the snippet finds what SQL matched without shifting offsets. */
+function foldAscii(value: string) {
+  return value.replace(/[A-Z]/g, (char) => char.toLowerCase())
+}
+
+function snippet(text: string, query: string) {
+  const index = foldAscii(text).indexOf(foldAscii(query))
+  if (index === -1) return text.slice(0, SNIPPET_RADIUS * 2)
+  const start = Math.max(0, index - SNIPPET_RADIUS)
+  const end = Math.min(text.length, index + query.length + SNIPPET_RADIUS)
+  return `${start > 0 ? "…" : ""}${text.slice(start, end)}${end < text.length ? "…" : ""}`
+}
+
+export * as SessionSearch from "./search"
