+
+function model(opts: { providerID: string; id: string }): Provider.Model {
+  return {
+    id: opts.id,
+    providerID: opts.providerID,
+    name: "Test",
+    limit: { context: 262_144, input: undefined, output: 8_192 },
+    cost: { input: 0, output: 0, cache: { read: 0, write: 0 } },
+    capabilities: {
+      toolcall: true,
+      attachment: false,
+      reasoning: false,
+      temperature: true,
+      input: { text: true, image: false, audio: false, video: false },
+      output: { text: true, image: false, audio: false, video: false },
+    },
+    api: { npm: "@ai-sdk/openai-compatible" },
+    options: {},
+  } as Provider.Model
+}
+
+const localModel = model({ providerID: "llmrouter", id: "local-model" })
+
+const json = (req: Parameters<typeof HttpClientResponse.fromWeb>[0], body: unknown, status = 200) =>
+  HttpClientResponse.fromWeb(
+    req,
+    new Response(JSON.stringify(body), { status, headers: { "content-type": "application/json" } }),
+  )
+
+function run<A>(effect: Effect.Effect<A, never, HttpClient.HttpClient>, client: HttpClient.HttpClient) {
+  return Effect.runPromise(effect.pipe(Effect.provide(Layer.succeed(HttpClient.HttpClient, client))))
+}
+
+function runWithLogs<A>(effect: Effect.Effect<A, never, HttpClient.HttpClient>, client: HttpClient.HttpClient) {
+  const messages: unknown[] = []
+  const logger = Logger.layer([
+    Logger.make<unknown, void>((options) => {
+      messages.push(options.message)
+    }),
+  ])
+  return Effect.runPromise(
+    effect.pipe(Effect.provide(Layer.succeed(HttpClient.HttpClient, client)), Effect.provide(logger)),
+  ).then((value) => ({ value, messages }))
+}
+
+const envBackup: Record<string, string | undefined> = {}
+
+function setEnv(key: string, value: string | undefined) {
+  if (!(key in envBackup)) envBackup[key] = process.env[key]
+  if (value === undefined) delete process.env[key]
+  else process.env[key] = value
+}
+
+beforeEach(() => {
+  LLMRouterLocalContext.resetForTest()
+})
+
+afterEach(() => {
+  for (const [key, value] of Object.entries(envBackup)) {
+    if (value === undefined) delete process.env[key]
+    else process.env[key] = value
+  }
+})
+
+describe("LLMRouterLocalContext.resolveLocalContextEffect", () => {
+  test("non-local models return undefined without any HTTP call", async () => {
+    setEnv("LRM_API_BASE_URL", "http://127.0.0.1:18321")
+    const client = HttpClient.make(() => {
+      throw new Error("should not be called")
+    })
+    const cloud = model({ providerID: "llmrouter", id: "cloud-model" })
+    const auto = model({ providerID: "llmrouter", id: "auto" })
+    const other = model({ providerID: "anthropic", id: "local-model" })
+
+    expect(await run(LLMRouterLocalContext.resolveLocalContextEffect(cloud, "ses_a"), client)).toBeUndefined()
+    expect(await run(LLMRouterLocalContext.resolveLocalContextEffect(auto, "ses_a"), client)).toBeUndefined()
+    expect(await run(LLMRouterLocalContext.resolveLocalContextEffect(other, "ses_a"), client)).toBeUndefined()
+  })
+
+  test("local-model with no LRM_API_BASE_URL returns undefined without any HTTP call", async () => {
+    setEnv("LRM_API_BASE_URL", undefined)
+    const client = HttpClient.make(() => {
+      throw new Error("should not be called")
+    })
+    expect(await run(LLMRouterLocalContext.resolveLocalContextEffect(localModel, "ses_b"), client)).toBeUndefined()
+  })
+
+  test("uses `applied` when present", async () => {
+    setEnv("LRM_API_BASE_URL", "http://127.0.0.1:18321")
+    const client = HttpClient.make((req) => Effect.succeed(json(req, { applied: 65_536, ctx_size: 131_072 })))
+    expect(await run(LLMRouterLocalContext.resolveLocalContextEffect(localModel, "ses_c"), client)).toBe(65_536)
+  })
+
+  test("falls back to `ctx_size` when `applied` is absent", async () => {
+    setEnv("LRM_API_BASE_URL", "http://127.0.0.1:18321")
+    const client = HttpClient.make((req) => Effect.succeed(json(req, { ctx_size: 32_768 })))
+    expect(await run(LLMRouterLocalContext.resolveLocalContextEffect(localModel, "ses_d"), client)).toBe(32_768)
+  })
+
+  test("non-ok response resolves to undefined instead of throwing", async () => {
+    setEnv("LRM_API_BASE_URL", "http://127.0.0.1:18321")
+    const client = HttpClient.make((req) => Effect.succeed(json(req, { error: "not ready" }, 503)))
+    expect(await run(LLMRouterLocalContext.resolveLocalContextEffect(localModel, "ses_e"), client)).toBeUndefined()
+  })
+
+  test("transport failure resolves to undefined instead of throwing", async () => {
+    setEnv("LRM_API_BASE_URL", "http://127.0.0.1:18321")
+    const client = HttpClient.make((req) =>
+      Effect.fail(new HttpClientError.HttpClientError({ reason: new HttpClientError.TransportError({ request: req }) })),
+    )
+    expect(await run(LLMRouterLocalContext.resolveLocalContextEffect(localModel, "ses_f"), client)).toBeUndefined()
+  })
+
+  test("second call within the TTL window reuses the cached value without refetching", async () => {
+    setEnv("LRM_API_BASE_URL", "http://127.0.0.1:18321")
+    let calls = 0
+    const client = HttpClient.make((req) => {
+      calls++
+      return Effect.succeed(json(req, { applied: 65_536 }))
+    })
+    expect(await run(LLMRouterLocalContext.resolveLocalContextEffect(localModel, "ses_g"), client)).toBe(65_536)
+    expect(await run(LLMRouterLocalContext.resolveLocalContextEffect(localModel, "ses_g"), client)).toBe(65_536)
+    expect(calls).toBe(1)
+  })
+})
+
