+      output: 0,
+      text: "hello",
+      tools: {
+        lookup: {
+          description: "x".repeat(4_000),
+          inputSchema: jsonSchema({ type: "object", properties: {} }),
+        },
+      },
+    })
+    expect(Number(withTools.headers["x-opencode-next-request-estimate"])).toBeGreaterThan(
+      Number(withoutTools.headers["x-opencode-next-request-estimate"]),
+    )
+  })
+
+  test("omits budget headers when context is unset and auto-compaction is off", async () => {
+    const result = await Effect.runPromise(
+      LLMRequestPrep.prepare({
+        user: {
+          id: "msg_user-budget",
+          sessionID: "ses_output-budget-off",
+          role: "user",
+          time: { created: Date.now() },
+          agent: "test",
+          model: { providerID: "test", modelID: "model" },
+        } as never,
+        sessionID: "ses_output-budget-off",
+        model: model({ context: 0, output: 0 }),
+        agent: { name: "test", mode: "primary", options: {}, permission: [] } as never,
+        system: [],
+        messages: [{ role: "user", content: "hello" }],
+        tools: {},
+        provider: { id: "test", options: {} } as never,
+        auth: undefined,
+        plugin: {
+          trigger: (_name: string, _input: unknown, output: unknown) => Effect.succeed(output),
+          list: () => Effect.succeed([]),
+          init: () => Effect.void,
+        } as never,
+        flags: { client: "test" } as never,
+        cfg: Schema.decodeUnknownSync(ConfigV1.Info)({ compaction: { auto: false } }) as never,
+        isWorkflow: false,
+      }),
+    )
+    expect(result.headers["x-opencode-context-usable"]).toBeUndefined()
+    expect(result.headers["x-opencode-next-request-estimate"]).toBeUndefined()
