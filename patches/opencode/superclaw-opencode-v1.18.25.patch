+import { describe, expect, test } from "bun:test"
+import { Effect, Schema } from "effect"
+import { jsonSchema, type Tool } from "ai"
+import { ConfigV1 } from "@opencode-ai/core/v1/config/config"
+import { ProviderTransform } from "@/provider/transform"
+import { LLMRequestPrep } from "@/session/llm/request"
+
+const config = Schema.decodeUnknownSync(ConfigV1.Info)({})
+
+function model(input: { context: number; output: number }) {
+  return {
+    id: "test/model",
+    providerID: "test",
+    api: { id: "model", url: "https://example.com/v1", npm: "@ai-sdk/openai-compatible" },
+    name: "Test",
+    capabilities: {
+      temperature: true,
+      reasoning: false,
+      attachment: false,
+      toolcall: true,
+      input: { text: true, audio: false, image: false, video: false, pdf: false },
+      output: { text: true, audio: false, image: false, video: false, pdf: false },
+    },
+    cost: { input: 0, output: 0, cache: { read: 0, write: 0 } },
+    limit: input,
+    options: {},
+    headers: {},
+  } as never
+}
+
+function prepare(input: { context: number; output: number; text: string; tools?: Record<string, unknown> }) {
+  return Effect.runPromise(
+    LLMRequestPrep.prepare({
+      user: {
+        id: "msg_user-budget",
+        sessionID: "ses_output-budget",
+        role: "user",
+        time: { created: Date.now() },
+        agent: "test",
+        model: { providerID: "test", modelID: "model" },
+      } as never,
+      sessionID: "ses_output-budget",
+      model: model(input),
+      agent: { name: "test", mode: "primary", options: {}, permission: [] } as never,
+      system: [],
+      messages: [{ role: "user", content: input.text }],
+      tools: (input.tools ?? {}) as never,
+      provider: { id: "test", options: {} } as never,
+      auth: undefined,
+      plugin: {
+        trigger: (_name: string, _input: unknown, output: unknown) => Effect.succeed(output),
+        list: () => Effect.succeed([]),
+        init: () => Effect.void,
+      } as never,
+      flags: { client: "test" } as never,
+      cfg: config as never,
+      isWorkflow: false,
+    }),
+  )
+}
+
+describe("session output budget", () => {
+  test("scales the fallback output budget to a known small context window", () => {
+    expect(ProviderTransform.maxOutputTokens(model({ context: 8_192, output: 0 }))).toBe(2_048)
+    expect(ProviderTransform.maxOutputTokens(model({ context: 2_048, output: 0 }))).toBe(1_024)
+    expect(ProviderTransform.maxOutputTokens(model({ context: 0, output: 0 }))).toBe(32_000)
+  })
+
+  test("clamps output to the remaining request headroom", async () => {
+    const result = await prepare({ context: 8_192, output: 0, text: "x".repeat(14_500) })
+    expect(result.params.maxOutputTokens).toBeLessThan(2_048)
+    expect(result.params.maxOutputTokens).toBeGreaterThan(1)
+  })
+
+  test("leaves output unclamped once the estimate exceeds the budget", async () => {
+    // The estimate is over the 6_144 usable budget. Flooring at 1 output token here never let the
+    // provider-reported usage reach the compaction threshold, so the session stalled for good.
+    const result = await prepare({ context: 8_192, output: 0, text: "x".repeat(40_000) })
+    expect(Number(result.headers["x-opencode-next-request-estimate"])).toBeGreaterThan(6_144)
+    expect(result.params.maxOutputTokens).toBe(2_048)
+  })
+
+  test("does not double-count system messages already in the request", async () => {
+    const result = await prepare({ context: 8_192, output: 0, text: "hello" })
+    expect(result.params.maxOutputTokens).toBe(2_048)
+  })
+
+  test("includes tool definitions in the request estimate", async () => {
+    const withoutTools = await prepare({ context: 8_192, output: 0, text: "x".repeat(10_000) })
+    const withTools = await prepare({
+      context: 8_192,
+      output: 0,
+      text: "x".repeat(10_000),
+      tools: {
+        lookup: {
+          description: "x".repeat(4_000),
+          inputSchema: jsonSchema({ type: "object", properties: {} }),
+        },
+      },
+    })
+    expect(withTools.params.maxOutputTokens).toBeLessThan(withoutTools.params.maxOutputTokens!)
+  })
+})
+
+describe("D2 context budget headers", () => {
+  test("reports reserve/usable/baseline for a known context window", async () => {
+    const result = await prepare({ context: 8_192, output: 0, text: "hello" })
+    expect(result.headers["x-opencode-context-usable"]).toBe("6144")
+    expect(result.headers["x-opencode-context-reserve"]).toBe("2048")
+    expect(Number(result.headers["x-opencode-baseline-prompt"])).toBeGreaterThanOrEqual(0)
+    expect(Number(result.headers["x-opencode-baseline-tools"])).toBeGreaterThanOrEqual(0)
+    expect(Number(result.headers["x-opencode-next-request-estimate"])).toBeGreaterThan(0)
+  })
+
+  test("next-request-estimate grows with tool definitions", async () => {
