+// chars ÷ 4 is 2.7–2.8x optimistic on CSV and 1.8x on logs. Chars ≈ bytes
+// stays the working assumption throughout.
+const DENSITY: Record<string, number> = {
+  csv: 1.3,
+  tsv: 1.3,
+  json: 1.5,
+  ndjson: 1.5,
+  jsonl: 1.5,
+  log: 2,
+}
 
-export const estimate = (input: string) => Math.max(0, Math.round(input.length / CHARS_PER_TOKEN))
+const DEFAULT_DENSITY = 4
+
+export type Estimator = (input: string, hint?: string) => number
+
+// Registration point for an exact tokenizer (e.g. a vendored model tokenizer
+// installed by a plugin). An installed estimator wins over the density table.
+let installed: Estimator | undefined
+
+export const register = (estimator: Estimator | undefined) => {
+  installed = estimator
+}
+
+// Lets callers with their own multi-tier fallback (e.g. the symbol/digit
+// estimator below) skip straight to the exact tokenizer when one is
+// installed, instead of running a heuristic that would just be discarded.
+export const hasInstalledEstimator = () => installed !== undefined
+
+// Resolves a bytes-per-token density from a hint that is either a format tag
+// ("csv") or a filename ("data.csv"); unknown or missing hints fall back to
+// the prose default so general estimates keep today's behavior.
+export const density = (hint?: string) => {
+  if (!hint) return DEFAULT_DENSITY
+  const dot = hint.lastIndexOf(".")
+  const tag = dot === -1 ? hint : hint.slice(dot + 1)
+  return DENSITY[tag.toLowerCase()] ?? DEFAULT_DENSITY
+}
+
+export const estimate = (input: string, hint?: string) => {
+  if (installed) return Math.max(0, Math.round(installed(input, hint)))
+  return Math.max(0, Math.round(input.length / density(hint)))
+}
+
+// Our own heuristic, not a port of infinigence/tokenestimate's Kimi-K2
+// preset model: that model jointly fits ten character-class coefficients
+// (digit, symbol, CJK, space, Latin letter, ja/ko/ru, Latin-ext, ...), and
+// this only borrows two of its ten unmodified values — digit and CJK
+// Unified Ideographs — as tokens-per-char multipliers (unlike DENSITY above,
+// a chars-per-token divisor). Every other character class (symbols,
+// letters, whitespace, other non-ASCII, etc.) falls back to DEFAULT_DENSITY
+// instead of using Kimi-K2's fitted value for that class.
+//
+// ASCII symbols specifically were tried with Kimi-K2's preset coefficient
+// (0.567) and dropped: measured against real SuperClaw traffic (n=2253), it
+// produced a systematic +16.4% overestimate (93.2% of requests over, 42.5%
+// over by 20%+). Folding symbols into DEFAULT_DENSITY instead drops that to
+// a -0.7% mean signed error with an even over/under split. Kimi-K2's ten
+// coefficients are jointly fitted against each other, so swapping one
+// (symbol) for a different value while keeping the rest (digit, CJK) isn't
+// guaranteed safe in general — it just happens to measure well here.
+const COEF_DIGIT = 0.8030572147361226
+const COEF_CHINESE = 0.6627122076124944
+
+// CJK Unified Ideographs; matches the common range used by isChinese() checks
+// elsewhere. Deliberately narrow (no Extension blocks, no punctuation) to
+// stay a cheap per-char range check like the ascii checks above.
+const isChinese = (code: number) => code >= 0x4e00 && code <= 0x9fff
+
+// No hint/installed-tokenizer support here by design: this is one tier in a
+// caller-managed fallback chain (installed tokenizer > this > DEFAULT_DENSITY
+// chars/4), not a replacement for estimate(). Callers should check
+// hasInstalledEstimator() themselves before reaching for this, or just call
+// estimateText()/estimateJSON() below instead of picking a tier by hand.
+export const estimateSymDig = (input: string): number => {
+  let tokens = 0
+  let other = 0
+  for (let i = 0; i < input.length; i++) {
+    const c = input.charCodeAt(i)
+    if (c >= 48 && c <= 57) tokens += COEF_DIGIT
+    else if (isChinese(c)) tokens += COEF_CHINESE
+    else other++
+  }
+  tokens += other / DEFAULT_DENSITY
+  return Math.max(0, Math.round(tokens))
+}
+
+// Shared tier choice for plain text: an installed exact tokenizer always
+// wins, otherwise the symbol/digit-aware heuristic. Every call site that
+// estimates a string (file contents, serialized messages, ...) should go
+// through this instead of re-deriving the same exact/symdig choice, so they
+// can't silently drift onto different scales for the same kind of input.
+export const estimateText = (input: string) => (hasInstalledEstimator() ? estimate(input) : estimateSymDig(input))
+
+// Same tier choice as estimateText(), but for a JSON-serializable value
+// (messages, tool schemas, ...). JSON.stringify(value) returns undefined
+// (not a string, and without throwing) for undefined/functions/symbols, so
+// that's handled explicitly as "nothing to estimate" rather than falling
+// into estimateText(undefined) and relying on the TypeError it'd throw to
+// land in the catch below. JSON.stringify can still throw on circular
+// references or BigInt; on failure this falls back to String(value), which
+// covers those two cases but can itself throw — a null-prototype object
+// (e.g. Object.create(null)) has no toString, so String() on one fails too.
+// That inner failure is caught separately and estimated as 0 rather than
+// retrying JSON.stringify or letting it escape, so a single bad field
+// degrades the estimate rather than escaping as an uncaught defect.
+export const estimateJSON = (value: unknown): number => {
+  try {
+    const serialized = JSON.stringify(value)
+    if (serialized === undefined) return 0
+    return estimateText(serialized)
+  } catch {
+    try {
+      return estimateText(String(value))
+    } catch {
+      return 0
+    }
+  }
+}
