@@ -0,0 +1,159 @@
+import { describe, expect, test } from "bun:test"
+import { Schema } from "effect"
+import { ConfigV1 } from "@opencode-ai/core/v1/config/config"
+import { reserved, usable, isOverflow, shouldWarnUnsetLimit, recordHeadroom, headroom } from "@/session/overflow"
+import type { Provider } from "@/provider/provider"
+
+function cfg(compaction?: ConfigV1.Info["compaction"]) {
+  const base = Schema.decodeUnknownSync(ConfigV1.Info)({}) as ConfigV1.Info
+  return { ...base, compaction }
+}
+
+function model(opts: { context: number; output: number; input?: number }): Provider.Model {
+  return {
+    id: "test-model",
+    providerID: "test",
+    name: "Test",
+    limit: {
+      context: opts.context,
+      input: opts.input,
+      output: opts.output,
+    },
+    cost: { input: 0, output: 0, cache: { read: 0, write: 0 } },
+    capabilities: {
+      toolcall: true,
+      attachment: false,
+      reasoning: false,
+      temperature: true,
+      input: { text: true, image: false, audio: false, video: false },
+      output: { text: true, image: false, audio: false, video: false },
+    },
+    api: { npm: "@ai-sdk/openai-compatible" },
+    options: {},
+  } as Provider.Model
+}
+
+describe("overflow.reserved", () => {
+  test("scales proportionally on small windows", () => {
+    expect(reserved(cfg(), 56_320)).toBe(8_448)
+  })
+
+  test("caps at the legacy 20k buffer on large windows", () => {
+    expect(reserved(cfg(), 200_000)).toBe(20_000)
+  })
+
+  test("floors at 2,048 on tiny windows", () => {
+    expect(reserved(cfg(), 8_192)).toBe(2_048)
+  })
+
+  test("compaction.reserved config keeps absolute priority", () => {
+    expect(reserved(cfg({ reserved: 5_000 }), 56_320)).toBe(5_000)
+    expect(reserved(cfg({ reserved: 30_000 }), 8_192)).toBe(30_000)
+  })
+})
+
+describe("overflow.usable", () => {
+  test("subtracts the proportional reserve from limit.input", () => {
+    expect(usable({ cfg: cfg(), model: model({ context: 56_320, input: 56_320, output: 8_192 }) })).toBe(47_872)
+  })
+
+  test("keeps large explicit windows unchanged (20k reserve)", () => {
+    expect(usable({ cfg: cfg(), model: model({ context: 200_000, input: 200_000, output: 64_000 }) })).toBe(180_000)
+  })
+
+  test("keeps the context minus output path for models without limit.input", () => {
+    expect(usable({ cfg: cfg(), model: model({ context: 200_000, output: 64_000 }) })).toBe(168_000)
+  })
+
+  test("unset context limit has no usable window, regardless of compaction.auto", () => {
+    expect(usable({ cfg: cfg(), model: model({ context: 0, output: 32_000 }) })).toBe(0)
+    expect(usable({ cfg: cfg({ auto: false }), model: model({ context: 0, output: 32_000 }) })).toBe(0)
+  })
+})
+
+describe("overflow.isOverflow", () => {
+  const tokens = (total: number) => ({ input: total, output: 0, reasoning: 0, cache: { read: 0, write: 0 } })
+
+  test("unset context limit never overflows, regardless of token count or compaction.auto", () => {
+    const zero = model({ context: 0, output: 32_000 })
+    expect(isOverflow({ cfg: cfg(), tokens: tokens(1_000_000), model: zero })).toBe(false)
+    expect(isOverflow({ cfg: cfg(), tokens: tokens(0), model: zero })).toBe(false)
+    expect(isOverflow({ cfg: cfg({ auto: false }), tokens: tokens(1_000_000), model: zero })).toBe(false)
+  })
+
+  test("explicit limits behave exactly as before", () => {
+    const explicit = model({ context: 200_000, output: 64_000 })
+    expect(isOverflow({ cfg: cfg(), tokens: tokens(168_000), model: explicit })).toBe(true)
+    expect(isOverflow({ cfg: cfg(), tokens: tokens(167_999), model: explicit })).toBe(false)
+  })
+
+  test("local-model never proactively overflows — the router's 400 drives compaction", () => {
+    const local = {
+      ...model({ context: 200_000, output: 64_000 }),
+      id: "local-model",
+      providerID: "llmrouter",
+    } as Provider.Model
+    // Well past usable(), but proactive detection is off for local-model.
+    expect(isOverflow({ cfg: cfg(), tokens: tokens(200_000), model: local })).toBe(false)
+    expect(isOverflow({ cfg: cfg(), tokens: tokens(1_000_000), model: local })).toBe(false)
+
+    // A same-shaped non-local model still overflows as before.
+    expect(
+      isOverflow({ cfg: cfg(), tokens: tokens(200_000), model: model({ context: 200_000, output: 64_000 }) }),
+    ).toBe(true)
+  })
+})
+
+describe("overflow.recordHeadroom / headroom", () => {
+  test("records and reports usable/estimated/headroom", () => {
+    recordHeadroom("ses_headroom_a", { usable: 100_000, estimated: 40_000 })
+    expect(headroom("ses_headroom_a")).toEqual({ usable: 100_000, estimated: 40_000, headroom: 60_000 })
+  })
+
+  test("clamps headroom at 0 when estimated exceeds usable", () => {
+    recordHeadroom("ses_headroom_b", { usable: 10_000, estimated: 25_000 })
+    expect(headroom("ses_headroom_b")).toEqual({ usable: 10_000, estimated: 25_000, headroom: 0 })
+  })
+
+  test("does not record when usable is 0 or negative — this is the root cause of the local-model read guard silently disabling itself when limit.context is unset", () => {
+    expect(headroom("ses_headroom_c")).toBeUndefined()
+    recordHeadroom("ses_headroom_c", { usable: 0, estimated: 500 })
+    expect(headroom("ses_headroom_c")).toBeUndefined()
+    recordHeadroom("ses_headroom_c", { usable: -10, estimated: 500 })
+    expect(headroom("ses_headroom_c")).toBeUndefined()
+  })
+
+  test("later calls for the same session overwrite earlier ones", () => {
+    recordHeadroom("ses_headroom_d", { usable: 100_000, estimated: 10_000 })
+    recordHeadroom("ses_headroom_d", { usable: 100_000, estimated: 90_000 })
+    expect(headroom("ses_headroom_d")).toEqual({ usable: 100_000, estimated: 90_000, headroom: 10_000 })
+  })
+
+  test("different sessions don't affect each other", () => {
+    recordHeadroom("ses_headroom_e1", { usable: 50_000, estimated: 10_000 })
+    recordHeadroom("ses_headroom_e2", { usable: 50_000, estimated: 40_000 })
+    expect(headroom("ses_headroom_e1")).toEqual({ usable: 50_000, estimated: 10_000, headroom: 40_000 })
+    expect(headroom("ses_headroom_e2")).toEqual({ usable: 50_000, estimated: 40_000, headroom: 10_000 })
+  })
+})
+
+describe("overflow.shouldWarnUnsetLimit", () => {
+  test("warns exactly once per session for unset limits", () => {
+    const input = { cfg: cfg(), model: model({ context: 0, output: 32_000 }), sessionID: "ses_warn_once" }
+    expect(shouldWarnUnsetLimit(input)).toBe(true)
+    expect(shouldWarnUnsetLimit(input)).toBe(false)
+  })
+
+  test("never warns for explicit limits or disabled auto compaction", () => {
+    expect(
+      shouldWarnUnsetLimit({ cfg: cfg(), model: model({ context: 200_000, output: 64_000 }), sessionID: "ses_warn_a" }),
+    ).toBe(false)
+    expect(
+      shouldWarnUnsetLimit({
+        cfg: cfg({ auto: false }),
+        model: model({ context: 0, output: 32_000 }),
+        sessionID: "ses_warn_b",
+      }),
+    ).toBe(false)
+  })
+})
