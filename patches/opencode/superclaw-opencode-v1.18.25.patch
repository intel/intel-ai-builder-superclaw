diff --git a/packages/opencode/test/server/session-search.test.ts b/packages/opencode/test/server/session-search.test.ts
new file mode 100644
index 000000000..e9961e101
--- /dev/null
+++ b/packages/opencode/test/server/session-search.test.ts
@@ -0,0 +1,227 @@
+import { describe, expect } from "bun:test"
+import { CrossSpawnSpawner } from "@opencode-ai/core/cross-spawn-spawner"
+import { Database } from "@opencode-ai/core/database/database"
+import { LayerNode } from "@opencode-ai/core/effect/layer-node"
+import { ModelV2 } from "@opencode-ai/core/model"
+import { ProviderV2 } from "@opencode-ai/core/provider"
+import { SessionProjector } from "@opencode-ai/core/session/projector"
+import { Effect } from "effect"
+import { Project } from "@/project/project"
+import { SessionSearch } from "@/session/search"
+import { MessageID, PartID, type SessionID } from "@/session/schema"
+import { Session } from "@/session/session"
+import { TestInstance } from "../fixture/fixture"
+import { testEffect } from "../lib/effect"
+
+const it = testEffect(
+  LayerNode.compile(
+    LayerNode.group([Session.node, SessionProjector.node, Project.node, Database.node, CrossSpawnSpawner.node]),
+  ),
+)
+
+const model = { providerID: ProviderV2.ID.make("test"), modelID: ModelV2.ID.make("test") }
+
+const withSession = (title: string, parentID?: SessionID) =>
+  Effect.acquireRelease(Session.use.create({ title, parentID }), (created) =>
+    Session.use.remove(created.id).pipe(Effect.ignore),
+  )
+
+type Visibility = { synthetic?: boolean; ignored?: boolean }
+
+const say = Effect.fnUntraced(function* (sessionID: SessionID, text: string, visibility?: Visibility) {
+  const session = yield* Session.Service
+  const message = yield* session.updateMessage({
+    id: MessageID.ascending(),
+    role: "user",
+    sessionID,
+    agent: "build",
+    model,
+    time: { created: Date.now() },
+  })
+  yield* addPart(sessionID, message.id, text, visibility)
+  return message.id
+})
+
+const addPart = Effect.fnUntraced(function* (
+  sessionID: SessionID,
+  messageID: MessageID,
+  text: string,
+  visibility?: Visibility,
+) {
+  const session = yield* Session.Service
+  yield* session.updatePart({
+    id: PartID.ascending(),
+    sessionID,
+    messageID,
+    type: "text",
+    text,
+    ...visibility,
+  })
+})
+
+describe("SessionSearch.search", () => {
+  it.instance(
+    "finds a session by text said inside it",
+    () =>
+      Effect.gen(function* () {
+        const test = yield* TestInstance
+        const target = yield* withSession("Lunch notes")
+        yield* withSession("Unrelated")
+        const messageID = yield* say(target.id, "we settled on the cuban sandwich recipe")
+
+        const hits = yield* SessionSearch.search({ query: "cuban", directory: test.directory })
+
+        expect(hits.map((hit) => hit.id)).toEqual([target.id])
+        expect(hits[0].match.title).toBe(false)
+        expect(hits[0].match.message?.id).toBe(messageID)
+        expect(hits[0].match.message?.snippet).toContain("cuban sandwich")
+      }),
+    { git: true },
+  )
+
+  it.instance(
+    "reports title and message matches on the same session",
+    () =>
+      Effect.gen(function* () {
+        const test = yield* TestInstance
+        const both = yield* withSession("frog research")
+        const titleOnly = yield* withSession("frog sketches")
+        yield* say(both.id, "the frog is nocturnal")
+        yield* say(titleOnly.id, "nothing relevant here")
+
+        const hits = yield* SessionSearch.search({ query: "frog", directory: test.directory })
+        const byID = new Map(hits.map((hit) => [hit.id, hit]))
+
+        expect(byID.get(both.id)?.match).toMatchObject({ title: true })
+        expect(byID.get(both.id)?.match.message?.snippet).toContain("nocturnal")
+        expect(byID.get(titleOnly.id)?.match.title).toBe(true)
+        expect(byID.get(titleOnly.id)?.match.message).toBeUndefined()
+      }),
+    { git: true },
+  )
+
+  it.instance(
+    "searches every session, and limit bounds only the hits returned",
+    () =>
+      Effect.gen(function* () {
+        const test = yield* TestInstance
+        const total = 120
+        for (let index = 0; index < total; index++) {
+          const created = yield* withSession(`task ${index}`)
+          yield* say(created.id, `PURPLE${index} is the answer`)
+        }
+
+        const all = yield* SessionSearch.search({
+          query: "PURPLE",
+          directory: test.directory,
+          limit: SessionSearch.MAX_LIMIT,
+        })
+        expect(all.length).toBe(total)
+        expect(all.every((hit) => hit.match.message !== undefined)).toBe(true)
+
+        // The oldest session is only reachable if the scan was never capped.
+        const oldest = yield* SessionSearch.search({ query: "PURPLE0 ", directory: test.directory })
+        expect(oldest.length).toBe(1)
+
+        const limited = yield* SessionSearch.search({ query: "PURPLE", directory: test.directory, limit: 10 })
+        expect(limited.length).toBe(10)
+
+        const defaulted = yield* SessionSearch.search({ query: "PURPLE", directory: test.directory })
+        expect(defaulted.length).toBe(SessionSearch.DEFAULT_LIMIT)
+
+        const negative = yield* SessionSearch.search({ query: "PURPLE", directory: test.directory, limit: -1 })
+        expect(negative).toEqual([])
+      }),
+    { git: true },
+  )
+
+  it.instance(
+    "treats LIKE wildcards in the query as literal characters",
+    () =>
+      Effect.gen(function* () {
+        const test = yield* TestInstance
+        const literal = yield* withSession("percentages")
+        const other = yield* withSession("plain")
+        yield* say(literal.id, "coverage rose to 50% today")
+        yield* say(other.id, "coverage rose today")
+
+        const hits = yield* SessionSearch.search({ query: "50%", directory: test.directory })
+
+        expect(hits.map((hit) => hit.id)).toEqual([literal.id])
+      }),
+    { git: true },
+  )
+
+  it.instance(
+    "with roots, credits a subagent session's match to its root session",
+    () =>
+      Effect.gen(function* () {
+        const test = yield* TestInstance
+        const root = yield* withSession("Trip planning")
+        const child = yield* withSession("websearch", root.id)
+        const grandchild = yield* withSession("summarize", child.id)
+        yield* say(root.id, "find me flights")
+        const messageID = yield* say(grandchild.id, "the cheapest fare is on AZURELINE")
+
+        const rooted = yield* SessionSearch.search({ query: "azureline", directory: test.directory, roots: true })
+        expect(rooted.map((hit) => hit.id)).toEqual([root.id])
+        expect(rooted[0].match.message).toMatchObject({ id: messageID, sessionID: grandchild.id })
+        expect(rooted[0].match.message?.snippet).toContain("AZURELINE")
+
+        const flat = yield* SessionSearch.search({ query: "azureline", directory: test.directory })
+        expect(flat.map((hit) => hit.id)).toEqual([grandchild.id])
+        expect(flat[0].match.message?.sessionID).toBe(grandchild.id)
+      }),
+    { git: true },
+  )
+
+  it.instance(
+    "folds case for ASCII letters only",
+    () =>
+      Effect.gen(function* () {
+        const test = yield* TestInstance
+        const created = yield* withSession("notes")
+        yield* say(created.id, "the Élan Café menu")
+
+        expect((yield* SessionSearch.search({ query: "élan café", directory: test.directory })).length).toBe(0)
+        expect((yield* SessionSearch.search({ query: "Élan CAFé", directory: test.directory })).length).toBe(1)
+      }),
+    { git: true },
+  )
+
+  it.instance(
+    "matches only parts the user can see",
+    () =>
+      Effect.gen(function* () {
+        const test = yield* TestInstance
+        const created = yield* withSession("attachments")
+        const messageID = yield* say(created.id, "contents of secrets.env: ZEBRAWORD=1", { synthetic: true })
+        yield* addPart(created.id, messageID, "discarded draft about ZEBRAWORD", { ignored: true })
+
+        expect(yield* SessionSearch.search({ query: "zebraword", directory: test.directory })).toEqual([])
+
+        yield* addPart(created.id, messageID, "please rotate the ZEBRAWORD key")
+        // Newer than the visible part, so the snippet proves hidden parts are skipped, not outranked.
+        yield* addPart(created.id, messageID, "file contents again: ZEBRAWORD=2", { synthetic: true })
+
+        const hits = yield* SessionSearch.search({ query: "zebraword", directory: test.directory })
+        expect(hits.map((hit) => hit.id)).toEqual([created.id])
+        expect(hits[0].match.message?.id).toBe(messageID)
+        expect(hits[0].match.message?.snippet).toBe("please rotate the ZEBRAWORD key")
+      }),
+    { git: true },
+  )
+
+  it.instance(
+    "returns nothing for a blank query",
+    () =>
+      Effect.gen(function* () {
+        const test = yield* TestInstance
+        const created = yield* withSession("anything")
+        yield* say(created.id, "anything at all")
+
+        expect(yield* SessionSearch.search({ query: "   ", directory: test.directory })).toEqual([])
+      }),
+    { git: true },
+  )
+})
