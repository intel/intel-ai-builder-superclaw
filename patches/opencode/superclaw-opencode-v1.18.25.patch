@@ -0,0 +1,286 @@
+import { Effect, Schema } from "effect"
+import { FetchHttpClient, HttpClient, HttpClientRequest, HttpClientResponse } from "effect/unstable/http"
+import type { SessionV1 } from "@opencode-ai/core/v1/session"
+import type { Provider } from "./provider"
+
+const LOCAL_PROVIDER_ID = "llmrouter"
+const LOCAL_MODEL_ID = "local-model"
+const AUTO_MODEL_ID = "auto"
+const CTX_SIZE_PATH = "/llm-router/v1/local/ctx-size"
+const CACHE_TTL_MS = 30_000
+
+// The router subtracts this same fixed safety margin on top of the output
+// reserve when it computes ITS OWN upstream clamp (routing/policy/context_cap.py
+// — see the read-output-cap plugin's matching `LRM_READ_SAFETY`/`OUTPUT_RESERVE`
+// derivation). `applied` only reports the raw n_ctx the server is running
+// with; without this, our `usable` disagrees with the router's real ceiling
+// by exactly this amount, which is otherwise invisible until a request that
+// "fits" by our math gets rejected by the real provider.
+const SAFETY = Number.parseInt(process.env.LRM_READ_SAFETY ?? "", 10) || 1_024
+
+const CtxSizeResponse = Schema.Struct({
+  applied: Schema.optional(Schema.Number),
+  ctx_size: Schema.optional(Schema.NullOr(Schema.Number)),
+})
+
+// Real n_ctx is a property of the one running llama-server process, not of any
+// particular session, so a single process-wide cache is correct (and cheaper
+// than keying by sessionID).
+let cache: { nCtx: number | undefined; at: number } | undefined
+const warnedMissingBaseURL = new Set<string>()
+const warnedAutoRoute = new Set<string>()
+
+// Both warned-sets are keyed by sessionID and otherwise never shrink, so a
+// long-running server would accumulate one entry per session forever. Cap
+// each at a bounded size and evict the oldest (insertion-order) entry —
+// mirrors the eviction the superclaw read-output-cap plugin already uses for
+// its own per-call pending-note map.
+const MAX_WARNED_SESSIONS = 1_000
+
+function shouldWarnOnce(warned: Set<string>, sessionID: string): boolean {
+  if (warned.has(sessionID)) return false
+  if (warned.size >= MAX_WARNED_SESSIONS) {
+    const oldest = warned.values().next().value
+    if (oldest !== undefined) warned.delete(oldest)
+  }
+  warned.add(sessionID)
+  return true
+}
+
+// Per-session record of where the turn's window came from: "live" when the
+// router's live local n_ctx was applied, "configured" otherwise (non-local
+// model, missing/failed fetch, or auto). Surfaced on the context-window and
+// read-budget decision logs so a wrong or stale window is visible per turn.
+const contextSources = new Map<string, "live" | "configured">()
+
+export function contextSource(sessionID: string): "live" | "configured" {
+  return contextSources.get(sessionID) ?? "configured"
+}
+
+function isLocalRouterModel(model: Provider.Model) {
+  return model.providerID === LOCAL_PROVIDER_ID && model.id === LOCAL_MODEL_ID
