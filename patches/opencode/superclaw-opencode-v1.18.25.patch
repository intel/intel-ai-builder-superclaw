+// request. Local-model only (see isLocalRouterModel). Callers must skip
+// non-turn requests — the forked title/summary small-model call and the
+// compaction summariser share the session ID but are not turns, so they must
+// not move the anchor.
+export function noteRequestEstimate(sessionID: string, model: Provider.Model, rawEstimate: number) {
+  if (!isLocalRouterModel(model)) return
+  if (!(rawEstimate > 0)) return
+  rememberBounded(pendingRawEstimate, sessionID, rawEstimate)
+}
+
+// Called once the provider's real prompt usage for that same request is known
+// (step-finish). Re-anchors on the real prompt size and the raw estimate that
+// produced it, so the next request only has to estimate its own delta. Callers
+// must skip summariser turns (see processor.ts) for the same reason as
+// noteRequestEstimate.
+export function noteRealUsage(sessionID: string, model: Provider.Model, tokens: SessionV1.Assistant["tokens"]) {
+  if (!isLocalRouterModel(model)) return
+  const raw = pendingRawEstimate.get(sessionID)
+  pendingRawEstimate.delete(sessionID)
+  if (!raw || raw <= 0) return
+  const real = tokens.input + tokens.cache.read + tokens.cache.write
+  if (!(real > 0)) return
+  rememberBounded(anchors, sessionID, { real, raw })
+}
+
+// Turns a from-scratch heuristic estimate into "last real prompt + estimated
+// delta". Returns the input unchanged for non-local models, before any real
+// measurement exists, or when the conversation shrank (compaction/revert) so the
+// anchor no longer describes a prefix of the current request.
+export function estimate(sessionID: string, model: Provider.Model, rawEstimate: number): number {
+  if (!isLocalRouterModel(model)) return rawEstimate
+  const anchor = anchors.get(sessionID)
+  if (!anchor) return rawEstimate
+  if (rawEstimate < anchor.raw) {
+    anchors.delete(sessionID)
+    return rawEstimate
+  }
+  return anchor.real + (rawEstimate - anchor.raw)
+}
+
+export function anchorFor(sessionID: string): Anchor | undefined {
+  return anchors.get(sessionID)
+}
+
+// Explicit invalidation for callers that know the anchored prefix is gone even
+// when the raw estimate wouldn't show a shrink (e.g. compaction rebuilding the
+// history from a summary).
+export function resetAnchor(sessionID: string) {
+  anchors.delete(sessionID)
+  pendingRawEstimate.delete(sessionID)
+}
