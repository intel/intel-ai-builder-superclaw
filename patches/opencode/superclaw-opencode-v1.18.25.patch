+// issue 3557: on a local model, the read tool's budget guard (src/tool/read.ts,
+// backed by SessionOverflow.headroom) must track the REAL, live local n_ctx —
+// not whatever static window is configured in opencode.json — so that two
+// reads that would each individually fit a large static window, but not the
+// session's actual small local window, get caught cumulatively instead of
+// silently overflowing the model's real context on the second one.
+function bigText(minBytes: number) {
+  const lines: string[] = []
+  let bytes = 0
+  let i = 0
+  while (bytes < minBytes) {
+    const line = `line ${i} ${"x".repeat(40)}`
+    lines.push(line)
+    bytes += line.length + 1
+    i++
+  }
+  return lines.join("\n")
+}
+
+function withLrmCtxServer<A, E, R>(nCtx: number, fn: () => Effect.Effect<A, E, R>) {
+  return Effect.acquireUseRelease(
+    Effect.sync(() => {
+      const server = Bun.serve({
+        port: 0,
+        fetch(request) {
+          const url = new URL(request.url)
+          if (url.pathname === "/llm-router/v1/local/ctx-size") return Response.json({ applied: nCtx })
+          return new Response("not found", { status: 404 })
+        },
+      })
+      const previous = process.env.LRM_API_BASE_URL
+      process.env.LRM_API_BASE_URL = server.url.toString()
+      LLMRouterLocalContext.resetForTest()
+      return { server, previous }
+    }),
+    () => fn(),
+    ({ server, previous }) =>
+      Effect.sync(() => {
+        server.stop(true)
+        if (previous === undefined) delete process.env.LRM_API_BASE_URL
+        else process.env.LRM_API_BASE_URL = previous
+        LLMRouterLocalContext.resetForTest()
+      }),
+  )
+}
