{
  "name": "@different-ai/openwork-workspace",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "node scripts/check-before-run.mjs cross-env OPENWORK_DEV_MODE=1 pnpm --filter @different-ai/openwork dev",
    "dev:ui": "pnpm --filter @different-ai/openwork-contracts build && node scripts/check-before-run.mjs cross-env OPENWORK_DEV_MODE=1 pnpm --filter @different-ai/openwork-ui dev",
    "build": "node scripts/check-before-run.mjs pnpm --filter @different-ai/openwork build",
    "build:ui": "pnpm --filter @different-ai/openwork-contracts build && node scripts/check-before-run.mjs pnpm --filter @different-ai/openwork-ui build",
    "build:debug": "pnpm --filter @different-ai/openwork-contracts build && node scripts/check-before-run.mjs pnpm --filter @different-ai/openwork-ui build:debug",
    "preview": "pnpm --filter @different-ai/openwork-ui preview",
    "typecheck": "pnpm --filter @different-ai/openwork-ui typecheck",
    "test:health": "pnpm --filter @different-ai/openwork-ui test:health",
    "test:sessions": "pnpm --filter @different-ai/openwork-ui test:sessions",
    "test:refactor": "pnpm --filter @different-ai/openwork-ui test:refactor",
    "test:events": "pnpm --filter @different-ai/openwork-ui test:events",
    "test:todos": "pnpm --filter @different-ai/openwork-ui test:todos",
    "test:permissions": "pnpm --filter @different-ai/openwork-ui test:permissions",
    "test:session-switch": "pnpm --filter @different-ai/openwork-ui test:session-switch",
    "test:fs-engine": "pnpm --filter @different-ai/openwork-ui test:fs-engine",
    "test:e2e": "pnpm --filter @different-ai/openwork-ui test:e2e",
    "test:e2e-tauri": "pnpm --filter @superclaw/e2e test",
    "test:orchestrator": "pnpm --filter openwork-orchestrator test:router",
    "bump:patch": "pnpm --filter @different-ai/openwork-ui bump:patch",
    "bump:minor": "pnpm --filter @different-ai/openwork-ui bump:minor",
    "bump:major": "pnpm --filter @different-ai/openwork-ui bump:major",
    "bump:set": "pnpm --filter @different-ai/openwork-ui bump:set",
    "release:review": "node scripts/release/review.mjs",
    "release:prepare": "node scripts/release/prepare.mjs",
    "release:prepare:dry": "node scripts/release/prepare.mjs --dry-run",
    "release:ship": "node scripts/release/ship.mjs",
    "release:ship:watch": "node scripts/release/ship.mjs --watch",
    "tauri": "pnpm --filter @different-ai/openwork exec tauri",
    "contracts:gen": "pnpm --filter @different-ai/openwork-contracts gen",
    "product-profiles:check": "pnpm --filter @different-ai/openwork-contracts product-profiles:check",
    "product-profiles:parity": "pnpm --filter @different-ai/openwork-contracts product-profiles:parity"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@whiskeysockets/baileys",
      "better-sqlite3",
      "esbuild",
      "protobufjs"
    ],
    "overrides": {
      "@babel/core": "^7.29.6",
      "@opentelemetry/core": "^2.8.0",
      "axios": "^1.20.0",
      "follow-redirects": "^1.16.1",
      "brace-expansion@1": "1.1.21",
      "brace-expansion@2": "2.1.7",
      "brace-expansion@5": "5.0.12",
      "zod@>=4 <4.6.6": "4.6.6",
      "file-type": "^21.3.1",
      "protobufjs": "^7.6.5",
      "seroval": "1.6.11",
      "seroval-plugins": "1.6.3",
      "tinypool": "2.1.2",
      "ws": "^8.21.0",
      "serialize-javascript": "7.1.3",
      "uuid": "^11.1.1",
      "diff@>=6.0.0 <8.0.3": "^8.0.3",
      "esbuild@>=0.17.0 <0.28.1": "^0.28.1",
      "vite@<=6.4.3": "6.4.4",
      "vite@>=7 <7.3.7": "7.3.7",
      "postcss@>=8 <8.5.24": "8.5.24",
      "source-map-js@<1.2.2": "1.2.2",
      "browserslist@>=4 <4.28.7": "4.28.7",
      "baseline-browser-mapping@>=2 <2.11.0": "2.11.0",
      "nanoid@>=3 <3.3.18": "3.3.18",
      "js-yaml@>=4 <4.3.2": "4.3.2",
      "undici@>=6 <6.29.1": "6.29.1",
      "undici@>=7 <7.30.1": "7.30.1",
      "ip-address@>=10 <10.7.4": "10.7.4",
      "fast-xml-parser@>=5 <5.12.0": "5.12.0",
      "form-data@>=4.0.0 <4.0.6": "^4.0.6",
      "effect": "4.0.0-beta.103",
      "toml": "5.0.1",
      "glob@>=9.0.0 <14.0.2": "14.0.2",
      "deepmerge-ts@<8.0.0": "8.0.0",
      "basic-ftp@<6.2.4": "6.2.4"
    }
  },
  "packageManager": "pnpm@10.34.3",
  "overrides": {
    "zod": "4.6.6"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.18.25"
  },
  "devDependencies": {
    "cross-env": "^10.1.0"
  }
}
